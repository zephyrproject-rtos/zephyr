config LOG_BACKEND_IPC
	bool "IPC service backend"
	imply CBPRINTF_RV32E_USE_DEFAULT_ALIGNMENT if RISCV

if LOG_BACKEND_IPC

config LOG_BACKEND_IPC_ZERO_COPY
	bool "Use zero copy sending"
	default y if IPC_SERVICE_BACKEND_ICBMSG || IPC_SERVICE_BACKEND_RPMSG
	help
	  Use zero copy sending for sending log messages.

config LOG_BACKEND_IPC_PACKET_SIZE
	int "Packet size"
	depends on LOG_BACKEND_IPC_ZERO_COPY
	default 256
	help
	  Target size of the IPC service packets. Log messages are packed into a single
	  packet until it is full. A log message that exceeds that size is sent in a
	  packet of its own.

config LOG_BACKEND_IPC_FSC
	bool "Create fully self-contained messages"
	select LOG_MSG_APPEND_RO_STRING_LOC
	default y
	help
	  Enable if core that processes messages has access to local read-only strings.
	  It allows to reduce processing and message size as read-only strings are not copied
	  into the IPC message.

config LOG_BACKEND_IPC_BIND_TIMEOUT_MS
	int "Timeout for binding the IPC service"
	default 1000
	help
	  Timeout for binding the IPC service. If the binding is not completed within this time,
	  the backend will return an error.

config LOG_BACKEND_IPC_DROPPED_NOTIFY_DELAY_MS
	int "Delay of the dropped messages notification (milliseconds)"
	default 1000
	help
	  Dropped messages are not reported immediately. The first drop schedules the
	  notification with that delay and drops that occur in the meantime only increment
	  the counter. When the notification executes, a single message with the accumulated
	  number of dropped messages is sent to the remote.

endif
