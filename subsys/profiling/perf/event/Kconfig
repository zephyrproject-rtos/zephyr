menuconfig PROFILING_PERF_EVENTS
	bool "Performance event subsystem"
	depends on MULTITHREADING
	help
	  Enable provider-based performance event discovery and counter
	  session management. Applications can resolve named events and
	  capture counter snapshots through the C API.

	  Providers and shell commands are enabled separately. This
	  subsystem does not require stack-sampling support.

if PROFILING_PERF_EVENTS

config PROFILING_PERF_EVENTS_MAX_EVENTS
	int "Maximum events in a stat session"
	default 8
	range 1 32
	help
	  Maximum number of events that can be measured in one stat session.

config PROFILING_PERF_EVENTS_NAME_MAX
	int "Maximum shell event name length"
	default 64
	range 8 128
	help
	  Maximum canonical event name length, including the NUL terminator,
	  retained by the perf stat shell frontend.

config PROFILING_PERF_EVENTS_SHELL
	bool "Performance event shell commands"
	depends on SHELL
	depends on CBPRINTF_FULL_INTEGRAL
	help
	  Enable perf list and perf stat for event discovery and counter
	  sessions. Printing 64-bit event counts requires full integer formatting.
	  SHELL_ARGC_MAX must be at least 3 + 2 * PROFILING_PERF_EVENTS_MAX_EVENTS
	  to accept all event selections in perf stat start.

menuconfig PROFILING_PERF_EVENT_PROVIDER_CPU
	bool "CPU performance counter providers"
	depends on ARM64_PMUV3
	depends on NUM_METAIRQ_PRIORITIES > 0
	depends on !SMP || SCHED_CPU_MASK
	help
	  Register cpuN providers for events described by the PMU backend.
	  Operations run synchronously on each owning CPU using pinned meta-IRQ
	  workers, which can preempt cooperative and scheduler-locked threads.
	  Requires at least one meta-IRQ priority; ordinary workloads must use
	  priorities below the reserved meta-IRQ range.
	  Each selected CPU's PMU must be reserved exclusively for perf, and
	  CPUs must remain online throughout a session.

if PROFILING_PERF_EVENT_PROVIDER_CPU

config PROFILING_PERF_EVENT_PROVIDER_CPU_STACK_SIZE
	int "CPU performance provider worker stack size"
	default 2048
	help
	  Stack size in bytes for each statically allocated per-CPU worker.

endif # PROFILING_PERF_EVENT_PROVIDER_CPU

endif
