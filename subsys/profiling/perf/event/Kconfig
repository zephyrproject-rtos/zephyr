config PROFILING_PERF_EVENTS
	bool "Performance event subsystem"
	depends on MULTITHREADING
	help
	  Enable provider-based performance event discovery and counter
	  session management. Applications can resolve named events and
	  capture counter snapshots through the C API.

	  Providers and shell commands are enabled separately. This
	  subsystem does not require stack-sampling support.

if PROFILING_PERF_EVENTS

config PROFILING_PERF_EVENTS_MAX_EVENTS
	int "Maximum events in a stat session"
	default 8
	range 1 32
	help
	  Maximum number of events that can be measured in one stat session.

config PROFILING_PERF_EVENTS_NAME_MAX
	int "Maximum shell event name length"
	default 64
	range 8 128
	help
	  Maximum canonical event name length, including the NUL terminator,
	  retained by the perf stat shell frontend.

config PROFILING_PERF_EVENTS_SHELL
	bool "Perf counter session shell commands"
	depends on SHELL
	help
	  Add perf list and perf stat commands and stat result buffering to the
	  existing perf shell command.

config PROFILING_PERF_EVENT_PROVIDER_CPU
	bool "CPU performance counter provider"
	depends on ARM64_PMUV3
	help
	  Register a per-CPU provider (cpu0, cpu1, ...) that exposes hardware
	  performance events (cycles, instructions, cache and branch events)
	  through the portable <zephyr/arch/pmu.h> API. The ARMv8-A PMUv3
	  backend is used today; any architecture that implements the pmu_*()
	  primitives can back this provider unchanged.

	  On SMP, each counter session is steered onto the target CPU. Enable
	  CONFIG_SCHED_CPU_MASK to measure a CPU other than the calling one.

endif
