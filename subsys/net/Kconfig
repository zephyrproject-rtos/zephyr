menu "Networking"

config NETWORKING
	bool "Link layer and networking (including IP)"
	select NET_BUF
	select POLL
	select ENTROPY_GENERATOR
	help
	  This option enables generic link layer and networking support
	  and is the basis for higher level protocols (e.g. IP protocols).

if NETWORKING

# Such option should not be configured manually but by device drivers
# which supports PM properly.
config NET_POWER_MANAGEMENT
	bool
	depends on PM_DEVICE

config NET_UNITY_BUILD
	bool "Build the networking libraries as unity builds [EXPERIMENTAL]"
	select EXPERIMENTAL
	help
	  Compile the source files of each networking library as one
	  translation unit, so that the compiler can inline and optimize
	  across the files of the library. Files that cannot be combined
	  are compiled separately.

config NET_UNITY_BUILD_MERGED
	bool "Merge the networking core into one unity build [EXPERIMENTAL]"
	depends on NET_UNITY_BUILD
	help
	  Compile the network driver, L2, IP stack, sockets and net_buf
	  libraries as one translation unit instead of one per library, so
	  that the compiler can also inline across the library boundaries.

source "subsys/net/Kconfig.hostname"

source "subsys/net/l2/Kconfig"

source "subsys/net/ip/Kconfig"

source "subsys/net/pkt_filter/Kconfig"

source "subsys/net/lib/Kconfig"

source "subsys/net/conn_mgr/Kconfig"

endif

endmenu
