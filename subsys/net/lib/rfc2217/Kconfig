menuconfig NET_RFC2217
	bool "Telnet COM port control (RFC 2217)"
	help
	  The server side of the Telnet COM port control option: a client
	  such as pyserial's rfc2217:// sets the line of a serial port and
	  exchanges data with it over a Telnet connection.

if NET_RFC2217

config NET_RFC2217_SIGNATURE
	string "Signature"
	default "Zephyr"
	help
	  The text the server sends when a client asks for its signature.

endif # NET_RFC2217
