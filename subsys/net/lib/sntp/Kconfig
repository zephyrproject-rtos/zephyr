menu "SNTP (Simple Network Time Protocol) support"
	depends on NET_SOCKETS

config SNTP
	bool "SNTP client"
	select SNTP_LIB
	help
	  Enable SNTP client support

if SNTP

config SNTP_UNCERTAINTY
	bool "Calculate SNTP uncertainty and set uptime timestamp"
	help
	  Get a more reliable timestamp by supplying the sntp_time struct with an
	  uptime timestamp of when the time was valid and an uncertainty of the
	  time in microseconds. Time is then given as:
	  seconds,fraction +/- uncertainty at uptime timestamp.
	  Enabling this option uses more resources (memory) and is not normally
	  needed.

endif # SNTP

config SNTP_SERVER
	bool "SNTP server"
	depends on NET_UDP
	depends on NET_IPV4 || NET_IPV6
	select SNTP_LIB
	select NET_SOCKETS_SERVICE
	help
	  Enable SNTP server support. The server answers queries on UDP port
	  123 for every enabled address family. The application is responsible
	  for setting the system clock and for telling the server about the
	  clock source with sntp_server_clock_source().

config SNTP_LIB
	bool
	help
	  SNTP support library

if SNTP_LIB

module = SNTP
module-dep = NET_LOG
module-str = Log level for SNTP
module-help = Enable debug message of SNTP library.
source "subsys/net/Kconfig.template.log_config.net"

endif # SNTP_LIB

endmenu
