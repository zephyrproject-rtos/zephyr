# Wireguard VPN service for Zephyr

# Copyright (c) 2026 Nordic Semiconductor
# SPDX-License-Identifier: Apache-2.0

config WIREGUARD
	bool "Wireguard VPN service [EXPERIMENTAL]"
	depends on NET_UDP
	select NET_VPN
	select NET_IPV4_MAPPING_TO_IPV6 if NET_IPV4 && NET_IPV6
	select NET_MGMT
	select NET_MGMT_EVENT
	select NET_MGMT_EVENT_INFO
	select NET_MGMT_EVENT_OWNED_INFO
	select NET_L2_DUMMY
	select NET_L2_VIRTUAL
	select NET_L2_VIRTUAL_MGMT
	select NET_IP_DSCP_ECN
	select BASE64
	select EXPERIMENTAL
	help
	  Select 'y' if you want to enable Wireguard VPN service.

if WIREGUARD

config WIREGUARD_CRYPTO
	bool
	default y
	imply PSA_WANT_ALG_CHACHA20_POLY1305
	imply PSA_WANT_ALG_ECDH
	imply PSA_WANT_ECC_MONTGOMERY_255
	imply PSA_WANT_ALG_HMAC
	imply PSA_WANT_ALG_SHA_256
	imply PSA_WANT_KEY_TYPE_CHACHA20
	imply PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT
	imply PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT
	imply PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE
	imply PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE
	select PSA_CRYPTO
	help
	  Use PSA Crypto API for cryptographic operations where available.
	  This enables hardware acceleration on platforms that support it.
	  Note:  BLAKE2s and XChaCha20-Poly1305 are not available in PSA
	  yet and will continue to use the reference implementation.
	  XChaCha20 is found in PSA 1.2 but Zephyr does not have it yet.
	  The following operations will use PSA when enabled:
	  - X25519 key exchange
	  - ChaCha20-Poly1305 AEAD encryption/decryption
	  - Random number generation

config WIREGUARD_SHELL
	bool
	depends on NET_SHELL
	select GETOPT_LONG
	select SHELL_GETOPT
	default y

config WIREGUARD_BUF_COUNT
	int "WireGuard receive buffer count"
	default 2
	range 1 256
	help
	  Reserve this many buffers and packet descriptors for decrypted
	  incoming packets. Each receive buffer holds WIREGUARD_BUF_LEN bytes
	  and stays allocated until the network stack consumes the packet.
	  The private receive pool uses fixed-size buffers.

config WIREGUARD_BUF_LEN
	int "WireGuard message buffer length"
	default 1500
	range 1328 1500
	help
	  Reserve this many bytes for each private receive buffer and one
	  transmit scratch buffer shared by all peers. The space includes the
	  WireGuard header, authentication tag, and padding.

config WIREGUARD_MAX_PEER
	int "Maximum number of peer connections"
	default 1
	range 1 256
	help
	  How many Wireguard VPN connections are possible.

config WIREGUARD_MULTI_PEER
	bool "WireGuard peers sharing a local identity"
	help
	  Allow an application to add several peers to one WireGuard virtual
	  interface and share its provisioned key. The core selects a peer by the
	  longest matching allowed prefix for each plaintext packet.

config WIREGUARD_PEER_POLICY
	bool "Managed WireGuard peer-set policy"
	depends on WIREGUARD_MULTI_PEER
	help
	  Allow an application to replace a complete interface peer set and
	  install a plaintext admission callback at the same time. Peer keys
	  are prepared in unused peer slots before publication.

config WIREGUARD_POLICY_STAGING_PEERS
	int "Extra peer slots for atomic policy updates"
	depends on WIREGUARD_PEER_POLICY
	default 0
	range 0 WIREGUARD_MAX_PEER
	help
	  Reserve additional peer slots to prepare new identities and keys
	  while all active connections are in use. Each replacement needs
	  one unused slot until the complete policy is published. This
	  does not increase the number of active peer connections.

config WIREGUARD_USE_REALTIME
	bool
	help
	  Use the system realtime clock for handshake timestamps. A consumer
	  selects this when it provisions a clock that survives a node restart.

config WIREGUARD_HANDSHAKE_WORKQ_STACK_SIZE
	int "Managed WireGuard handshake work queue stack size"
	depends on WIREGUARD_PEER_POLICY && PREEMPT_ENABLED
	depends on MBEDTLS_BUILTIN && TF_PSA_CRYPTO_BUILTIN
	depends on POSIX_THREADS && POSIX_TIMERS && TF_PSA_CRYPTO_USER_CONFIG
	default 0
	help
	  A positive size enables a low-priority queue for native UDP
	  handshakes and managed peer initiations. Established traffic can
	  progress while a managed handshake performs X25519 calculations.
	  Enable the Mbed TLS pthread backend in the TF-PSA-Crypto user
	  configuration header.

config WIREGUARD_MAX_INTERFACES
	int "Maximum number of WireGuard virtual interfaces"
	depends on WIREGUARD_MULTI_PEER
	default WIREGUARD_MAX_PEER
	range 1 WIREGUARD_MAX_PEER
	help
	  Set how many local WireGuard identities can be provisioned. The peer
	  limit is independent of this limit. Multiple peers can use the same
	  virtual interface.

config WIREGUARD_MAX_SRC_IPS
	int "Maximum number of peer source IP addresses"
	default 2
	range 1 256
	help
	  How many IP addresses are allowed / peer.

config WIREGUARD_INTERFACE
	string "Network interface to use"
	help
	  Leave empty if you want to use all network interfaces
	  for the VPN connections. If set, then all VPN traffic
	  is routed via this interface.

config WIREGUARD_PORT
	int "UDP port to use"
	range 0 $(UINT16_MAX)
	default 51820
	help
	  What UDP port to use when listening connections (in server role)
	  or when connecting to other hosts.
	  If set to 0, then let Wireguard code to select the port.

config WIREGUARD_WORKQ_STACK_SIZE
	int "Stack size of the Wireguard work queue"
	default 0
	help
	  The periodic timer of the peers (handshake initiation, keepalive,
	  rekey) runs on a work queue. With 0 it is the system work queue.
	  A positive value starts a work queue of its own with this stack
	  size, so that the X25519 computation of a handshake initiation does
	  not set the stack size of the system work queue. The first
	  initiation to a peer, started by the first packet sent to it or by
	  wireguard_peer_keepalive(), then runs there too instead of in the
	  calling thread. Native UDP handshakes received from a peer run on
	  the network RX thread unless the managed interface uses
	  WIREGUARD_HANDSHAKE_WORKQ_STACK_SIZE.

config WIREGUARD_WORKQ_PRIORITY
	int "Priority of the Wireguard work queue"
	depends on WIREGUARD_WORKQ_STACK_SIZE > 0
	default SYSTEM_WORKQUEUE_PRIORITY
	help
	  Thread priority of the Wireguard work queue.

module = WIREGUARD
module-dep = NET_LOG
module-str = Log level for Wireguard VPN service
module-help = Enables Wireguard to output debug messages
source "subsys/net/Kconfig.template.log_config.net"

config WIREGUARD_TXRX_DEBUG
	bool "Debug received and sent virtual interface packets"
	depends on WIREGUARD_LOG_LEVEL_DBG
	help
	  Enables printing of received and sent network packets.
	  This can produce lot of output so it is disabled by default.
	  This prints data in the virtual interface (wg0) level.

endif # WIREGUARD
