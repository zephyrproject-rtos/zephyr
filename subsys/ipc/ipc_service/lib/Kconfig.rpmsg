config IPC_SERVICE_RPMSG_NUM_ENDPOINTS_PER_INSTANCE
	int "Max number of registered endpoints per instance"
	default IPC_SERVICE_BACKEND_RPMSG_NUM_ENDPOINTS_PER_INSTANCE if IPC_SERVICE_BACKEND_RPMSG
	default 2
	help
	  Maximum number of endpoints that can be registered for one RPMsg
	  library instance.
