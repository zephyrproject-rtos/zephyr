menuconfig IPC_SERVICE_BACKEND_LINK
	bool "IPC link backend [EXPERIMENTAL]"
	select EXPERIMENTAL
	select IPC_SERVICE_LINK
	help
	  IPC service backend over a transport that exchanges frames between
	  two processors. Selected by the transports.

if IPC_SERVICE_BACKEND_LINK

config IPC_SERVICE_BACKEND_LINK_INIT_PRIORITY
	int "Initialization priority"
	default 80
	help
	  Initialization priority of the link instances, after the UART, SPI
	  and GPIO drivers they use. Unlike the backends initialized at
	  IPC_SERVICE_REG_BACKEND_PRIORITY, an instance is only there for
	  code that runs after this priority.

config IPC_SERVICE_BACKEND_LINK_NUM_EP
	int "Endpoints per instance"
	range 1 254
	default 8
	help
	  Number of endpoints an instance can register.

config IPC_SERVICE_BACKEND_LINK_EPT_NAME_MAX
	int "Longest endpoint name"
	range 1 64
	default 32
	help
	  Longest endpoint name in bytes, carried in the bind messages. The
	  peer needs at least the same limit: it drops the bind of a name
	  longer than its own, and the endpoint never binds.

config IPC_SERVICE_BACKEND_LINK_RX_BUFFERS
	int "Receive buffers per instance"
	range 2 8
	default 3
	help
	  Frame buffers to receive into. One is always armed for the next
	  frame, the others hold received frames until their messages are
	  delivered and released: they are the credits given to the peer.
	  One less than this is also the number of payloads sent before the
	  first is acknowledged, as a peer configured alike has no credits
	  for more.

config IPC_SERVICE_BACKEND_LINK_MAX_RETRANSMITS
	int "Timeouts before the session ends"
	range 0 255
	default 10
	help
	  Timeouts in a row without an answer from the peer, while a
	  payload waits for its acknowledgment or for credits, before the
	  session ends, the endpoints are unbound and the link announces
	  its boot again. 0 keeps sending.

# The endpoint callbacks are called from this work queue, shared by all
# instances: a callback that blocks does not stall the system work queue
config IPC_SERVICE_BACKEND_LINK_DEDICATED_WORKQUEUE
	default y

if IPC_SERVICE_BACKEND_LINK_DEDICATED_WORKQUEUE

config IPC_SERVICE_BACKEND_LINK_DEDICATED_WORKQUEUE_STACK_SIZE
	default 2048

config IPC_SERVICE_BACKEND_LINK_DEDICATED_WORKQUEUE_PRIORITY
	default 2

endif # IPC_SERVICE_BACKEND_LINK_DEDICATED_WORKQUEUE

module = IPC_SERVICE_BACKEND_LINK
module-str = IPC link backend
source "kernel/Kconfig.template.workqueue"

config IPC_SERVICE_BACKEND_LINK_SHELL
	bool "Shell commands"
	depends on SHELL
	select IPC_SERVICE_LINK_STATS
	help
	  The ipc_link command shows and clears the counters of the link
	  instances.

module = IPC_SERVICE_BACKEND_LINK
module-str = IPC link backend
module-help = Sets log level for the IPC link backend
source "subsys/logging/Kconfig.template.log_config"

endif # IPC_SERVICE_BACKEND_LINK

config IPC_SERVICE_BACKEND_LINK_UART
	bool "IPC link transport over a UART"
	default y
	depends on DT_HAS_ZEPHYR_IPC_UART_ENABLED
	depends on SERIAL
	depends on UART_ASYNC_API || UART_INTERRUPT_DRIVEN
	select IPC_SERVICE_BACKEND_LINK
	select COBS
	help
	  IPC service instances over a UART, COBS-framed. Uses the
	  asynchronous UART API when enabled and implemented by the UART
	  driver, the interrupt-driven API otherwise.

if IPC_SERVICE_BACKEND_LINK_UART

config IPC_SERVICE_BACKEND_LINK_UART_RX_CHUNK_SIZE
	int "Asynchronous receive buffer size"
	range 8 4096
	default 64
	help
	  Size in bytes of each of the two buffers the asynchronous UART API
	  receives into, per instance. A buffer is handed over when it is
	  full or after the idle timeout, and the frame checks run before
	  the next one is: larger buffers leave them more time at a high
	  baud rate.

config IPC_SERVICE_BACKEND_LINK_UART_RX_IDLE_TIMEOUT_US
	int "Asynchronous receive idle timeout"
	range 1 1000000
	default 1000
	help
	  Time in microseconds without a byte after which the asynchronous
	  UART API hands over what it received.

endif # IPC_SERVICE_BACKEND_LINK_UART

config IPC_SERVICE_BACKEND_LINK_SPI
	bool "IPC link transport over an SPI bus"
	default y
	depends on DT_HAS_ZEPHYR_IPC_SPI_ENABLED || DT_HAS_ZEPHYR_IPC_SPI_PERIPHERAL_ENABLED
	depends on SPI
	depends on GPIO
	depends on (SPI_PERIPHERAL && SPI_ASYNC) || !DT_HAS_ZEPHYR_IPC_SPI_PERIPHERAL_ENABLED
	select IPC_SERVICE_BACKEND_LINK
	help
	  IPC service instances over an SPI bus, one frame each way per
	  transaction, between a controller and a peripheral MCU with a
	  ready and an interrupt line. The peripheral role needs an SPI
	  driver with peripheral mode and the asynchronous API.

if IPC_SERVICE_BACKEND_LINK_SPI

config IPC_SERVICE_BACKEND_LINK_SPI_STACK_SIZE
	int "Transfer thread stack size"
	default 1024
	help
	  Stack of the thread running the transactions.

config IPC_SERVICE_BACKEND_LINK_SPI_PRIORITY
	int "Transfer thread priority"
	default 2
	help
	  Priority of the thread running the transactions.

endif # IPC_SERVICE_BACKEND_LINK_SPI
