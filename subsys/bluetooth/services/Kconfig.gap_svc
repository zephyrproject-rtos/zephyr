menuconfig BT_GAP_SVC
	bool "GATT Generic Access Service"
	default y
	help
	  Enable the default GATT Generic Access Service.
	  Enabled by default provides basic GAP functionality.
	  If disabled, it is the application responsibility to provide its own
	  implementation of GAP service, otherwise the system is not Bluetooth
	  qualification compliant.

if BT_GAP_SVC

config BT_DEVICE_NAME_GATT_WRITABLE
	bool "Allow to write device name by remote GATT clients"
	depends on BT_DEVICE_NAME_DYNAMIC
	default y
	help
	  Enabling this option allows remote GATT clients to write to device
	  name GAP characteristic.

if BT_DEVICE_NAME_GATT_WRITABLE
choice BT_DEVICE_NAME_GATT_WRITABLE_SECURITY
	prompt "Security requirements"
	default BT_DEVICE_NAME_GATT_WRITABLE_NONE if DEVICE_NAME_GATT_WRITABLE_NONE
	default BT_DEVICE_NAME_GATT_WRITABLE_AUTHEN if DEVICE_NAME_GATT_WRITABLE_AUTHEN
	default BT_DEVICE_NAME_GATT_WRITABLE_ENCRYPT if DEVICE_NAME_GATT_WRITABLE_ENCRYPT
	default BT_DEVICE_NAME_GATT_WRITABLE_ENCRYPT
	help
	  Select security requirements for writing device name by remote GATT
	  clients.

config BT_DEVICE_NAME_GATT_WRITABLE_NONE
	bool "No requirements"

config BT_DEVICE_NAME_GATT_WRITABLE_ENCRYPT
	bool "Encryption required"

config BT_DEVICE_NAME_GATT_WRITABLE_AUTHEN
	bool "Encryption and authentication required"

endchoice  #BT_DEVICE_NAME_GATT_WRITABLE_SECURITY

config DEVICE_NAME_GATT_WRITABLE_NONE
	bool "No requirements [DEPRECATED]"
	select DEPRECATED
	help
	  This option is deprecated. Select BT_DEVICE_NAME_GATT_WRITABLE_NONE instead.

config DEVICE_NAME_GATT_WRITABLE_ENCRYPT
	bool "Encryption required [DEPRECATED]"
	select DEPRECATED
	help
	  This option is deprecated. Select BT_DEVICE_NAME_GATT_WRITABLE_ENCRYPT instead.

config DEVICE_NAME_GATT_WRITABLE_AUTHEN
	bool "Encryption and authentication required [DEPRECATED]"
	select DEPRECATED
	help
	  This option is deprecated. Select BT_DEVICE_NAME_GATT_WRITABLE_AUTHEN instead.

endif #BT_DEVICE_NAME_GATT_WRITABLE

config BT_DEVICE_APPEARANCE_GATT_WRITABLE
	bool "Allow to write GAP Appearance by remote GATT clients"
	depends on BT_DEVICE_APPEARANCE_DYNAMIC
	default y
	help
	  Enabling this option allows remote GATT clients to write to device
	  appearance GAP characteristic.

if BT_DEVICE_APPEARANCE_GATT_WRITABLE
choice BT_DEVICE_APPEARANCE_GATT_WRITABLE_SECURITY
	prompt "Security requirements"
	default BT_DEVICE_APPEARANCE_GATT_WRITABLE_AUTHEN if DEVICE_APPEARANCE_GATT_WRITABLE_AUTHEN
	default BT_DEVICE_APPEARANCE_GATT_WRITABLE_AUTHEN
	help
	  Select security requirements for writing device appearance by remote
	  GATT clients.

config BT_DEVICE_APPEARANCE_GATT_WRITABLE_NONE
	bool "No requirements"

config BT_DEVICE_APPEARANCE_GATT_WRITABLE_ENCRYPT
	bool "Encryption required"

config BT_DEVICE_APPEARANCE_GATT_WRITABLE_AUTHEN
	bool "Encryption and authentication required"

endchoice  #BT_DEVICE_APPEARANCE_GATT_WRITABLE_SECURITY

config DEVICE_APPEARANCE_GATT_WRITABLE_AUTHEN
	bool "Encryption and authentication required [DEPRECATED]"
	select DEPRECATED
	help
	  This option is deprecated. Select BT_DEVICE_APPEARANCE_GATT_WRITABLE_AUTHEN instead.

endif #BT_DEVICE_APPEARANCE_GATT_WRITABLE

config BT_GAP_LE_GATT_SECURITY_LEVELS
	bool "LE GATT Security Levels characteristic [EXPERIMENTAL]" if !BT_TAK
	default y if BT_TAK
	select EXPERIMENTAL
	help
	  Add the LE GATT Security Levels characteristic to the GAP service. Its
	  value is the highest LE security mode 1 level that the permissions of
	  the attributes in the database require, followed by LE security mode 4
	  level 2 if BT_TAK is enabled and every attribute that requires security
	  permits a Transient Application Key. An attribute that requires LE
	  Secure Connections counts as mode 1 level 4, the lowest level that
	  implies them, also when it does not require authentication. Always
	  present in this GAP service with BT_TAK: a device that supports LE
	  security mode 4 has to have the characteristic.

endif #BT_GAP_SVC
