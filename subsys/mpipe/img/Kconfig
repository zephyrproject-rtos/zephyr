config MPIPE_IMG
	bool "Image codec plugin support"
	help
	  Elements that turn a coded image stream into frames and decode them: a
	  JPEG parser that finds frame boundaries in undifferentiated bytes, and
	  a software JPEG decoder that produces raw pixels.

	  The two are separate because the split is real. The parser is what
	  first knows the format, and it can be followed either by the software
	  decoder here or by a hardware decoder from the video plugin, without
	  either side knowing which.

if MPIPE_IMG

config MPIPE_IMG_JPEG_PARSER_MAX_FRAME_SIZE
	int "Maximum JPEG frame size in bytes"
	default 0
	help
	  Maximum size of a single JPEG frame that the parser can accumulate when
	  downstream does not provide a usable pool.
	  Default value is set to 0 to disable the internal staging pool entirely
	  (no memory reserved).

config MPIPE_IMG_JPEG_PARSER_POOL_NUM
	int "Staging pool buffer count"
	range 1 255
	default 2
	help
	  Number of buffers in the parser's internal staging pool.
	  2 is usually enough (one partial, one output).

config MPIPE_IMG_JPEG_DECODER_POOL_NUM
	int "Number of buffers in the jpeg decoder's output pool"
	range 1 255
	default 1
	help
	  Number of buffers in the decoder's internal output pool, used when
	  downstream proposes no pool of its own.

	  One is enough where the element downstream consumes each frame before
	  the next arrives, which is the case for a display sink. Raise it when
	  downstream holds frames past the chain call.

config MPIPE_IMG_JPEG_DECODER_MAX_OUT_FRAME_SIZE
	int "Maximum decoded output frame size in bytes"
	default 153600
	help
	  Maximum decoded output frame size in bytes for the SW JPEG decoder internal pool.
	  Default value is set for 320x240 RGB565 format.

endif # MPIPE_IMG
