if LORA_MODULE_BACKEND_NATIVE

config LORAWAN_NATIVE
	bool
	default y
	select PSA_CRYPTO
	select PSA_WANT_ALG_CMAC
	select PSA_WANT_ALG_ECB_NO_PADDING
	select PSA_WANT_KEY_TYPE_AES
	help
	  Hidden config to enable native LoRaWAN backend specific options.

config LORAWAN_NATIVE_ENGINE_STACK_SIZE
	int "Engine thread stack size"
	default 4096
	help
	  Stack size for the native LoRaWAN engine thread.

config LORAWAN_NATIVE_ENGINE_PRIORITY
	int "Engine thread priority"
	default 2
	help
	  Priority for the native LoRaWAN engine thread.

config LORAWAN_NATIVE_RX_SETUP_MARGIN_MS
	int "Receive window setup margin in milliseconds"
	default 400 if LORA_RUI3
	default 50
	range 1 1000
	help
	  How long before a receive window the stack wakes to put the radio
	  into reception, which has to cover the time the driver needs to
	  apply the window's parameters. A radio on SPI is ready in well
	  under a millisecond; one reached over an AT command interface
	  spends a command exchange on each setting it has to change, and
	  the RUI3 modem was measured at 118 ms for a window. The upper
	  bound is the shortest receive delay a device negotiates, 1 s.

config LORAWAN_NATIVE_PUBLIC_NETWORK
	bool "LoRaWAN Public Network"
	default y
	help
	  Enable this option to use a public LoRaWAN network.
	  Disable for private LoRaWAN networks.

endif # LORA_MODULE_BACKEND_NATIVE

rsource "region/Kconfig"
