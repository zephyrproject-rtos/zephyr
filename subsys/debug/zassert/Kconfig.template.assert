# Assertion module level configuration template.
#
# Sourced by a Kconfig file to generate the CONFIG_ASSERT_MODULE_<module>_LEVEL
# symbol consumed by ZASSERT_MODULE(<module>) (see <zephyr/sys/zassert.h>).
# The module name must be an UPPERCASE identifier: the C preprocessor pastes it
# verbatim into CONFIG_ASSERT_MODULE_<module>_LEVEL, so it has to match this symbol
# exactly.
# Use it as:
#	module = MYMODULE
#	module-str = my module
#	source "subsys/debug/zassert/Kconfig.template.assert"
#
# This produces a user-facing choice (Off / Terse / On / Verbose) and the derived,
# non-assignable CONFIG_ASSERT_MODULE_$(module)_LEVEL integer symbol.
# The choice defaults to Verbose.
# The level stays overridable from prj.conf.
#
# SPDX-License-Identifier: Apache-2.0

choice
	prompt "Assertion level for $(module-str)"
	default ASSERT_MODULE_$(module)_LEVEL_VERBOSE
	depends on ASSERT

config ASSERT_MODULE_$(module)_LEVEL_OFF
	bool "Off"
	help
	  ZASSERT_LEVEL_OFF: assertions for this module are compiled out.

config ASSERT_MODULE_$(module)_LEVEL_TERSE
	bool "Terse (only check)"
	help
	  ZASSERT_LEVEL_TERSE: assertions are checked, but the location, message, and its arguments
	  are not compiled in.

config ASSERT_MODULE_$(module)_LEVEL_NORMAL
	bool "Normal (location only)"
	help
	  ZASSERT_LEVEL_NORMAL: assertions are checked, location is printed, but the message and its
	  arguments are not compiled in.

config ASSERT_MODULE_$(module)_LEVEL_VERBOSE
	bool "Verbose (with message)"
	help
	  ZASSERT_LEVEL_VERBOSE: assertions are checked, location, the message, and its arguments
	  are compiled in.

endchoice

config ASSERT_MODULE_$(module)_LEVEL
	int
	default 0 if !ASSERT
	default 0 if ASSERT_MODULE_$(module)_LEVEL_OFF
	default 1 if ASSERT_MODULE_$(module)_LEVEL_TERSE
	default 2 if ASSERT_MODULE_$(module)_LEVEL_NORMAL
	default 3 if ASSERT_MODULE_$(module)_LEVEL_VERBOSE
