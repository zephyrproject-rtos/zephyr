config USBD_MSC_CLASS
	bool "USB Mass Storage Device class support"
	select DISK_ACCESS
	help
	  USB Mass Storage device class (SCSI target) support. LUNs are
	  pre-bound at build time via USBD_DEFINE_MSC_LUN() to a disk_access
	  volume. Command opcodes match the initiator mid-layer through
	  include/zephyr/scsi/scsi_opcode.h only; CONFIG_SCSI is not enabled
	  and scsi_device/scsi_exec are not used on this path.

if USBD_MSC_CLASS

config USBD_MSC_STACK_SIZE
	int "USB MSC thread stack size"
	default 1024
	help
	  USB MSC thread stack size.

config USBD_MSC_LUNS_PER_INSTANCE
	int "Number of LUNs"
	default 1
	range 1 16
	help
	  Maximum number of Logical Units that can be registered per instance.

config USBD_MSC_SCSI_BUFFER_SIZE
	int "SCSI Buffer size"
	default 512
	help
	  Buffer size must be able to hold at least one sector. All LUNs within
	  single instance share the SCSI buffer.

config USBD_MSC_DOUBLE_BUFFERING
	bool "SCSI double buffering"
	default y
	help
	  Allocate two SCSI buffers instead of one to increase throughput by
	  using one buffer by disk subsystem and one by USB at the same time.

module = USBD_MSC
module-str = usbd msc
default-count = 1
source "subsys/logging/Kconfig.template.log_config"

source "subsys/usb/common/Kconfig.template.instances_count"
endif
