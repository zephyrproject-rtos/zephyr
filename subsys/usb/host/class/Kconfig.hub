config USBH_HUB_CLASS
	bool "USB host Hub Class support [EXPERIMENTAL]"
	select EXPERIMENTAL
	help
	  USB Host Hub Class implementation. Devices connected to the
	  downstream ports of a hub are enumerated by the host stack.

if USBH_HUB_CLASS

config USBH_HUB_MAX_PORTS
	int "Maximum number of downstream ports per hub"
	range 1 15
	default 8
	help
	  Downstream ports above this number are ignored.

module = USBH_HUB
module-str = usbh hub
default-count = 1
source "subsys/logging/Kconfig.template.log_config"
source "subsys/usb/common/Kconfig.template.instances_count"

endif # USBH_HUB_CLASS
