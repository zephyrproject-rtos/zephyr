config USBH_VENDOR_CLASS
	bool "USB Vendor Class support [EXPERIMENTAL]"
	select EXPERIMENTAL
	help
	  USB Host Vendor Class implementation.

if USBH_VENDOR_CLASS

# USBH_VENDOR_INIT_PRIORITY = USBH_INIT_PRIO + 1
config USBH_VENDOR_INIT_PRIORITY
	int "Init priority for Vendor class"
	default 91
	help
	  Driver initialization priority.

config USBH_VENDOR_MAX_EPTS
	int "Maximum number of supported endpoints"
	range 2 32
	default 6
	help
	  Maximum number of supported endpoints

module = USBH_VENDOR
module-str = usbh vendor
source "subsys/logging/Kconfig.template.log_config"

endif # USBH_VENDOR_CLASS
