# NET_GPTP selects this shared dependency. Keep the prompt marked experimental
# without propagating EXPERIMENTAL into otherwise stable gPTP configurations.
config PRECISION_TIMING
	bool "Precision timing infrastructure [EXPERIMENTAL]"
	help
	  Enable experimental protocol-neutral precision timing helpers for
	  domain-qualified timestamps, clock adapters, mappings, and clock
	  discipline.
