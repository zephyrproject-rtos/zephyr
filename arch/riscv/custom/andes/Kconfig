config CPU_HAS_ANDES_EXECIT
	bool
	help
	  The AndesCore supports EXEC.IT instruction.

config RISCV_CUSTOM_CSR_ANDES_EXECIT
	bool "Andes V5 EXEC.IT extension"
	depends on CPU_HAS_ANDES_EXECIT
	depends on RISCV_ISA_EXT_C
	depends on !RISCV_GENERIC_TOOLCHAIN
	depends on !LINKER_USE_NO_RELAX
	help
	  The EXEC.IT extension (Execution on Instruction Table) generate
	  a look-up table and replaces suitable 32-bit instructions with
	  the 16-bit "exec.it <INDEX>".

config RISCV_CUSTOM_CSR_ANDES_NEXECIT
	bool "Andes V5 New EXEC.IT opcode encoding"
	depends on RISCV_CUSTOM_CSR_ANDES_EXECIT
	help
	  The New EXEC.IT instruction is an alias of EXEC.IT with different
	  opcode encoding.

config CPU_HAS_ANDES_HWDSP
	bool
	help
	  The AndesCore supports hardware DSP extension.

config RISCV_CUSTOM_CSR_ANDES_HWDSP
	bool "AndeStar V5 DSP ISA"
	depends on CPU_HAS_ANDES_HWDSP
	depends on !RISCV_GENERIC_TOOLCHAIN
	help
	  This option enables the AndeStar v5 hardware DSP, in order to
	  support using the DSP instructions.

config CPU_HAS_ANDES_PFT
	bool
	help
	  The AndesCore supports PowerBrake extension.

config RISCV_CUSTOM_CSR_ANDES_PFT
	bool "Andes V5 PowerBrake extension"
	depends on CPU_HAS_ANDES_PFT
	help
	  The PowerBrake extension throttles performance by reducing instruction
	  executing rate.

config CPU_HAS_ANDES_PMA
	bool
	help
	  The AndesCore supports Programmable PMA.

config RISCV_CUSTOM_CSR_ANDES_PMA
	bool "Andes V5 Physical Memory Attribute (PMA)"
	depends on CPU_HAS_ANDES_PMA
	select ARCH_HAS_NOCACHE_MEMORY_SUPPORT
	help
	  This option enables the Andes V5 PMA, in order to support SW to
	  configure physical memory attribute by PMA CSRs. The address
	  matching of Andes V5 PMA is like RISC-V PMP NAPOT mode
	  (power-of-two alignment).

config RISCV_CUSTOM_CSR_ANDES_PMA_NAPOT_GRANULARITY
	int
	depends on RISCV_CUSTOM_CSR_ANDES_PMA
	default 4096
	help
	  Minimum size (and alignment) of an PMA region. Use this symbol
	  to guarantee minimum size and alignment of PMA regions.

config CPU_HAS_ANDES_HSP
	bool
	help
	  The AndesCore supports StackSafe extension.

config RISCV_CUSTOM_CSR_ANDES_HSP
	bool "Andes V5 StackSafe extension"
	depends on CPU_HAS_ANDES_HSP
	select ARCH_HAS_STACK_PROTECTION
	select RISCV_HAS_CUSTOM_STACK_GUARD
	help
	  This option enables the Andes V5 StackSafe hardware stack protection,
	  in order to support custom stack guard.

config CPU_HAS_ANDES_NMI
	bool
	help
	  The AndesCore supports the Andes NMI extension.

config RISCV_CUSTOM_CSR_ANDES_NMI
	bool "Andes V5 NMI extension"
	depends on CPU_HAS_ANDES_NMI
	help
	  On AndeStar V5 cores such as N25/N25F the NMI vector base address
	  register (mnvec) is read-only and reads back the reset_vector input
	  signal, so an NMI enters at __reset and the boot path destroys the
	  state the NMI was raised to let software examine.

	  Enable this to tell a reset (mcause and mepc both 0) from an NMI
	  (mcause 1, interrupted PC in mepc) and branch to _andes_nmi_entry.

	  A SoC enabling NMIs is expected to provide its own _andes_nmi_entry,
	  overriding the weak one, and to set up what that handler needs, such
	  as an NMI stack in mscratch, before enabling any NMI source. The weak
	  default only parks the core.

config RISCV_CUSTOM_ANDES_PLIC_IPI
	bool "Andes PLIC-SWINT based IPI"
	depends on RISCV_SMP_IPI_CUSTOM
	depends on $(dt_nodelabel_enabled_with_compat,plic_sw,$(DT_COMPAT_ANDESTECH_NCEPLIC100))
	depends on PLIC_SUPPORTS_SOFT_INTERRUPT
	select PLIC_IRQ_AFFINITY if MP_MAX_NUM_CPUS > 1
	select DYNAMIC_INTERRUPTS
	help
	  Use PLIC-SWINT (PLIC-based software interrupts) for the custom
	  Inter-Processor Interrupt implementation on Andes cores.

config RISCV_CUSTOM_ANDES_MORE_SPIN_RELAX_NOPS
	bool "Use Andes specific arch_spin_relax() with more NOPs"
	depends on RISCV_CUSTOM_ANDES_PLIC_IPI
	depends on MP_MAX_NUM_CPUS > 1
	help
	  Add some NOPs after failure to lock a spinlock. This gives
	  the bus extra time to synchronize the RCW transaction
	  among CPUs.

config RISCV_CUSTOM_ANDES_NUM_SPIN_RELAX_NOPS
	int "Number of NOPs to be used in Andes specific arch_spin_relax()"
	depends on RISCV_CUSTOM_ANDES_MORE_SPIN_RELAX_NOPS
	default 128 if MP_MAX_NUM_CPUS = 2
	default 192 if MP_MAX_NUM_CPUS = 3
	default 256 if MP_MAX_NUM_CPUS = 4
	default 320 if MP_MAX_NUM_CPUS = 5
	default 384 if MP_MAX_NUM_CPUS = 6
	default 448 if MP_MAX_NUM_CPUS = 7
	default 512
	help
	  Specify the number of NOPs in Andes specific arch_spin_relax().

config RISCV_CUSTOM_ANDES_SPIN_RELAX_NOPS_JITTER
	bool "Add jitter to the NOPs in Andes specific arch_spin_relax()"
	depends on RISCV_CUSTOM_ANDES_MORE_SPIN_RELAX_NOPS
	help
	  Add a bounded jitter derived from mcycle to the number of NOPs in
	  arch_spin_relax(). This staggers the RCW retries of the CPUs to
	  further avoid them hitting the RCW transactions at the same time.
