menu "TriCore Architecture Options"
	depends on TRICORE

config ARCH
	string
	default "tricore"

config CPU_TC162
	bool
	select CPU_HAS_FPU
	imply FPU

config CPU_TC18
	bool

config TRICORE_CSA_COUNT
	int "Number of Context Save Areas allocated"
	default 256
	help
	  This option controls the number of Context Save Areas (CSAs) allocated by the
	  kernel. CSAs are used to store the upper and lower context information during
	  function calls and interrupts. The default value of 256 is typically sufficient
	  for most applications, but it can be increased if your application has a large
	  number of nested function calls, interrupts or threads.

config TRICORE_CSA_FCD_RESERVE
	int "Context save areas reserved below LCX for the FCD trap handler"
	default 64
	help
	  Number of Context Save Areas kept between the LCX limit register and
	  the end of the free list. When a context save reaches LCX the FCD
	  (Free Context list Depletion) trap fires and its handler runs out of
	  this reserve. The ISA requires at least two, plus one per call the
	  handler makes. The default leaves room for the fault and thread-abort
	  path so depletion is recovered instead of cascading into the
	  non-recoverable FCU trap.

config TRICORE_RESET_TRAMPOLINE
	bool "Trampoline to jump to cached address"
	default y
	help
	  Enable startup trampoline function which jumps from
	  any address (e.g. no cached) to the actual startup
	  function.

menu "TriCore Processor Options"

config CPU_HAS_TRICORE_VIRTUALIZATION
	bool
	depends on CPU_TC18
	help
	  Selected by SoCs whose TriCore 1.8 core implements the hypervisor
	  extension. The core leaves virtualization mode at reset.

endmenu

config GEN_ISR_TABLES
	default y

config GEN_IRQ_VECTOR_TABLE
	default n

config NUM_IRQ_PRIORITIES
	int
	default 256

endmenu
