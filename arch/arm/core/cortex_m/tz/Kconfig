config ARM_TRUSTZONE_M
	bool "ARM TrustZone-M support"
	depends on CPU_HAS_TEE
	depends on ARMV8_M_SE
	help
	  Platform has support for ARM TrustZone-M.

if ARM_TRUSTZONE_M

menu "ARM TrustZone-M Options"
depends on ARM_SECURE_FIRMWARE || ARM_NONSECURE_FIRMWARE

comment "Secure firmware"
	depends on ARM_SECURE_FIRMWARE

comment "Non-secure firmware"
	depends on !ARM_SECURE_FIRMWARE

config ARM_SECURE_BUSFAULT_HARDFAULT_NMI
	bool "BusFault, HardFault, and NMI target Secure state"
	depends on ARM_SECURE_FIRMWARE
	help
	  Force NMI, HardFault, and BusFault (in Mainline ARMv8-M)
	  exceptions as Secure exceptions.

config ARM_FIRMWARE_HAS_SECURE_ENTRY_FUNCS
	bool "Secure Firmware has Secure Entry functions"
	depends on ARM_SECURE_FIRMWARE
	help
	  Option indicates that ARM Secure Firmware contains
	  Secure Entry functions that may be called from
	  Non-Secure state. Secure Entry functions must be
	  located in Non-Secure Callable memory regions.

config ARM_NSC_REGION_BASE_ADDRESS
	hex "ARM Non-Secure Callable Region base address"
	depends on ARM_FIRMWARE_HAS_SECURE_ENTRY_FUNCS
	default 0
	help
	  Start address of Non-Secure Callable section.

	  Notes:
	  - The default value (i.e. when the user does not configure
	  the option explicitly) instructs the linker script to
	  place the Non-Secure Callable section, automatically,
	  inside the .text area.
	  - Certain requirements/restrictions may apply regarding
	  the size and the alignment of the starting address for
	  a Non-Secure Callable section, depending on the available
	  security attribution unit (SAU or IDAU) for a given SOC.

config ARM_NSC_REGION_IN_NS_ALIAS
	bool "NSC region is placed in the Non-Secure alias address space"
	depends on ARM_NSC_REGION_BASE_ADDRESS != 0
	help
	  Select this when ARM_NSC_REGION_BASE_ADDRESS falls in the
	  Non-Secure alias range (e.g. 0x00000000-0x0FFFFFFF on an
	  AN521 with IDAU region 0).  On such platforms the IDAU marks
	  NS-alias addresses as ns=true, which is required for QEMU to
	  preserve the SAU NSC attribute and allow SG veneer calls.

	  The board must define a DTS memory node with the property
	  zephyr,memory-region = "NSC_NS_ALIAS" whose address range
	  covers ARM_NSC_REGION_BASE_ADDRESS.  That region is used as
	  the linker MEMORY region for the .gnu.sgstubs section so that
	  the GNU ld location-counter check does not trigger a
	  "cannot move location counter backwards" error.

config ARM_FIRMWARE_USES_SECURE_ENTRY_FUNCS
	bool "Non-Secure Firmware uses Secure Entry functions"
	depends on ARM_NONSECURE_FIRMWARE
	help
	  Option indicates that ARM Non-Secure Firmware uses Secure
	  Entry functions provided by the Secure Firmware. The Secure
	  Firmware must be configured to provide these functions.

config ARM_ENTRY_VENEERS_LIB_NAME
	string "Entry Veneers symbol file"
	depends on ARM_FIRMWARE_HAS_SECURE_ENTRY_FUNCS \
	        || ARM_FIRMWARE_USES_SECURE_ENTRY_FUNCS
	default "libentryveneers.a"
	help
	  Library file to find the symbol table for the entry veneers.
	  The library will typically come from building the Secure
	  Firmware that contains secure entry functions, and allows
	  the Non-Secure Firmware to call into the Secure Firmware.

config ARM_SAU
	bool "Configure SAU via arch_security_partition API"
	depends on ARM_TRUSTZONE_M && ARM_SECURE_FIRMWARE
	depends on !BUILD_WITH_TFM
	select ARCH_HAS_SECURITY_PARTITION
	help
	  Enables Zephyr's arch-neutral SAU driver (sau.c).  The driver
	  implements arch_security_partition_configure/enable/disable and
	  arch_security_partition_region_count using the ARMv8-M SAU registers.

	  Disable this option when TF-M is used as the Secure-world OS
	  (CONFIG_BUILD_WITH_TFM), since TF-M owns the SAU in that case.

config ARM_SECURE_DOMAIN_ENTRY_SVC
	bool "Enter the Non-Secure domain via SVC exception return"
	depends on ARM_SAU
	help
	  Selects how arch_secure_domain_swap() transfers control into the
	  Non-Secure world.

	  When disabled (default) the Non-Secure world is entered with the
	  architectural BXNS instruction.

	  When enabled it is entered instead via an SVC whose handler performs
	  an EXC_RETURN into Non-Secure Thread mode.  Select this on silicon
	  where BXNS raises INVTRAN despite all architectural preconditions
	  being met (e.g. Infineon PSE84 and PSC3).

config ARM_FIRMWARE_HAS_SECURE_CALLS
	bool "Secure Firmware exposes __secure_call functions"
	depends on ARM_SECURE_FIRMWARE
	select ARM_FIRMWARE_HAS_SECURE_ENTRY_FUNCS
	select SECURE_CALLS
	help
	  Enables the __secure_call code-generation pipeline for this Secure
	  image. The build system will scan headers for __secure_call-decorated
	  function declarations and generate z_secure_mrsh_* entry points with
	  the cmse_nonsecure_entry attribute. These are compiled into the Secure
	  image and exported via libentryveneers.a for use by the Non-Secure image.

config ARM_FIRMWARE_USES_SECURE_CALLS
	bool "Non-Secure Firmware uses __secure_call functions"
	depends on ARM_NONSECURE_FIRMWARE
	select ARM_FIRMWARE_USES_SECURE_ENTRY_FUNCS
	select SECURE_CALLS
	help
	  Enables the __secure_call NS-side inline stubs for this Non-Secure
	  image. The generated stubs pack arguments into uintptr_t values and
	  call through the Secure veneer library (libentryveneers.a). Requires
	  that the Secure image was built with ARM_FIRMWARE_HAS_SECURE_CALLS.

endmenu

endif # ARM_TRUSTZONE_M
