config CPU_ARM926EJ_S
	bool
	select ARMV5TEJ
	select CPU_AARCH32_ARM9
	select CPU_HAS_MMU
	help
	  This option signifies the use of a ARM926EJ-S CPU.

config ARMV5TEJ
	bool
	select ARMV5TE
	help
	  This option signifies the use of a ARMv5TEJ CPU.

config ARMV5TE
	bool
	select ARMV5T
	help
	  This option signifies the use of a ARMv5TE CPU.

config ARMV5T
	bool
	select ARMV5
	help
	  This option signifies the use of a ARMv5T CPU.

config ARMV5
	bool
	help
	  This option signifies the use of a ARMv5 CPU.

if ARMV5

config ARMV5_EXCEPTION_STACK_SIZE
	int "Undefined Instruction and Abort stack size (in bytes)"
	default 256
	help
	  This option specifies the size of the stack used by the undefined
	  instruction and data abort exception handlers.

config ARMV5_FIQ_STACK_SIZE
	int "FIQ stack size (in bytes)"
	default 256
	help
	  This option specifies the size of the stack used by the FIQ handler.

config ARMV5_SVC_STACK_SIZE
	int "SVC stack size (in bytes)"
	default 512
	help
	  This option specifies the size of the stack used by the SVC handler.

config ARMV5_SYS_STACK_SIZE
	int "SYS stack size (in bytes)"
	default 1024
	help
	  This option specifies the size of the stack used by the system mode.

config GEN_ISR_TABLES
	default y

config GEN_IRQ_VECTOR_TABLE
	default n

config DCACHE_LINE_SIZE
	depends on CPU_HAS_DCACHE
	default 32

config ICACHE_LINE_SIZE
	depends on CPU_HAS_ICACHE
	default 32

config ARMV5_FLAT_MMU
	bool "Flat ARMv5 MMU mapping"
	depends on CPU_HAS_MMU && !ARM_AARCH32_MMU
	default y
	help
	  Build a flat (identity) translation table out of 1 MB sections and
	  turn the MMU on during boot. The MMU is what gives memory its
	  cacheability attributes, so the data and instruction caches can only
	  be used when this is enabled.

	  This is deliberately *not* the full Zephyr memory management layer
	  (CONFIG_ARM_AARCH32_MMU): there is no arch_mem_map(), no demand
	  paging and no per-region permissions, just a fixed map described by
	  the SoC. Turn it off, and enable CONFIG_ARM_AARCH32_MMU instead,
	  once the VMSA-v5 back end of arch/arm/core/mmu grows an ARMv5
	  implementation.

config CPU_HAS_DCACHE
	default y

config CPU_HAS_ICACHE
	default y

config ARMV5_IRQ_NESTING
	bool "Allow interrupts to nest"
	help
	  Unmask IRQs while an ISR runs, so that a second interrupt can
	  preempt it.

	  This is only safe when the SoC's interrupt controller masks the
	  active source between z_soc_irq_get_active() and z_soc_irq_eoi(),
	  the way a GIC does. Level sensitive controllers such as the ARM
	  PL190 or the PXA2xx ICU keep the line asserted until the peripheral
	  itself is serviced, so unmasking early would re-enter the handler
	  immediately and recurse until the interrupt stack overflows.

config MP_MAX_NUM_CPUS
	default 1

config STACK_ALIGN_DOUBLE_WORD
	default y

endif # ARMV5
