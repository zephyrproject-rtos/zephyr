menuconfig ZVFS
	bool "Zephyr virtual filesystem (ZVFS) support [EXPERIMENTAL]"
	select EXPERIMENTAL
	help
	  ZVFS is a central, Zephyr-native library that provides a common interoperable API for all
	  types of file descriptors such as those from the non-virtual FS, sockets, eventfds, FILE *'s
	  and more. It is designed to be used by all Zephyr subsystems that need to work with files.

if ZVFS

config ZVFS_FDTABLE
	bool "ZVFS file descriptor table"
	default y
	help
	  This file provides generic file descriptor table implementation, suitable
	  for any I/O object implementing POSIX I/O semantics (i.e. read/write +
	  aux operations).

if ZVFS_FDTABLE

config ZVFS_DEFAULT_FILE_VMETHODS
	bool "ZVFS default virtual methods for files"
	help
	  Provide typical file operations, which can be referenced in a struct fd_op_vtable
	  and subsequently called by ZVFS functions.

endif

config ZVFS_LIBC_FILE_SIZE
	int
	default -1
	help
	  Override for the size, in bytes, of a C library FILE object as stored in the ZVFS FILE
	  store. When positive, zvfs_libc.h exposes this value as ZVFS_LIBC_FILE_SIZE; otherwise
	  ZVFS_LIBC_FILE_SIZE defaults to sizeof(FILE). Picolibc and newlib override this when the
	  active FILE representation (including any embedded stdio buffer and lock) is larger than
	  sizeof(FILE).

config ZVFS_LIBC_FILE_ALIGN
	int
	default -1
	help
	  Override for the alignment, in bytes, of C library FILE objects in the ZVFS FILE store.
	  When positive, zvfs_libc.h exposes this value as ZVFS_LIBC_FILE_ALIGN; otherwise
	  ZVFS_LIBC_FILE_ALIGN defaults to _Alignof(FILE).

config ZVFS_FS
	bool "ZVFS path open via Zephyr file system"
	depends on FILE_SYSTEM
	default y
	help
	  Build the ZVFS path opener (zvfs_open) that wraps Zephyr fs_open() and
	  registers a file in the fd table. Required for ISO C fopen() and for POSIX
	  open() when a mounted file system is present.

config ZVFS_LIBC_FILE
	bool
	default y if ZVFS_FS && !MINIMAL_LIBC
	help
	  Build the C library's statically-allocated FILE-object store
	  (lib/libc/common/source/stdio/zvfs_libc_file.c), in the C library's memory partition.
	  It provides the allocation-free backing storage that each C library's zvfs_libc_fdopen()
	  hook draws from to bind a FILE to a ZVFS file descriptor, usable from user mode.

	  Minimal libc encodes a FILE directly as an fd and does not use this store, so it is not
	  selected there.

	  Every C library that uses the store must provide the two non-POSIX hooks:

	  - FILE *zvfs_libc_fdopen(int fd, const char *mode);
	  - int zvfs_libc_fileno(FILE *fp);

config ZVFS_FS_DESC_MAX
	int
	depends on ZVFS_FS
	default ZVFS_OPEN_MAX if ZVFS_OPEN_MAX > 0
	default 16
	help
	  Maximum concurrent Zephyr FS objects tracked by the ZVFS FS descriptor
	  pool (open files and directory streams).

config ZVFS_FS_RECORD_LOCK_MAX
	int
	depends on ZVFS_FS
	default 4
	range 1 32
	help
	  Maximum POSIX record locks (fcntl F_SETLK/F_GETLK) stored per open file
	  description backed by zvfs_fs_desc.

config ZVFS_OPEN_ADD_SIZE_FS
	int
	depends on ZVFS_FS
	default 4
	help
	  Number of file descriptors reserved for ZVFS path opens via zvfs_open()
	  (ISO C fopen()/freopen() and POSIX open() on a mounted file system).

config ZVFS_RESERVE_STDIO_FDS
	bool
	help
	  Pre-reserve fd slots 0, 1, and 2 for stdin, stdout, and stderr in the ZVFS fd
	  table so dynamically allocated descriptors start at fd 3.

config ZVFS_OPEN_ADD_SIZE_STDIO
	int
	default 3 if ZVFS_RESERVE_STDIO_FDS
	default 0
	help
	  Number of file descriptors reserved for stdin, stdout, and stderr in the ZVFS
	  fd table size calculation.

config ZVFS_EVENTFD
	bool "ZVFS event file descriptor support"
	imply ZVFS_POLL
	select ZVFS_FDTABLE
	help
	  Enable support for ZVFS event file descriptors. An eventfd can
	  be used as an event wait/notify mechanism together with POSIX calls
	  like read, write and poll.

if ZVFS_EVENTFD

config ZVFS_EVENTFD_MAX
	int "Maximum number of ZVFS eventfd's"
	default 1
	range 1 4096
	help
	  Maximum number of supported event file descriptors. If subsystems
	  specify ZVFS_EVENTFD_ADD_SIZE_* options, these will be added together
	  and the sum will be compared to the ZVFS_EVENTFD_MAX value.
	  If the sum is greater than the ZVFS_EVENTFD_MAX option, then the actual
	  eventfd count will be rounded up to the sum of the individual
	  requirements (unless the ZVFS_EVENTFD_IGNORE_MIN option is enabled).

config ZVFS_EVENTFD_IGNORE_MIN
	bool "Ignore the minimum eventfd count requirement"
	help
	  This option can be set to force setting a smaller eventfd count than
	  what's specified by enabled subsystems via ZVFS_EVENTFD_ADD_SIZE_*
	  options. This can be useful when optimizing memory usage and a more
	  precise minimum eventfd count is known for a given application. When
	  enabled, the ZVFS_EVENTFD_MAX value is used as-is.

config ZVFS_OPEN_ADD_SIZE_EVENTFD
	int
	default ZVFS_EVENTFD_MAX

endif # ZVFS_EVENTFD

config ZVFS_POLL
	bool "ZVFS poll"
	select POLL
	select ZVFS_FDTABLE
	help
	  Enable support for zvfs_poll().

if ZVFS_POLL

config ZVFS_POLL_MAX
	int "Max number of supported zvfs_poll() entries"
	default 8 if NRF70_ENABLE_DUAL_VIF
	default 6 if WIFI_NM_WPA_SUPPLICANT
	default 4 if SHELL_BACKEND_TELNET
	default 3
	help
	  Maximum number of entries supported for poll() call.

config ZVFS_SELECT
	bool "ZVFS select"
	help
	  Enable support for zvfs_select().

endif # ZVFS_POLL

endif # ZVFS
