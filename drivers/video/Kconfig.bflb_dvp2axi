config VIDEO_BFLB_DVP2AXI
	bool "BouffaloLab DVP to AXI (DVP2AXI) video stream output"
	default y
	depends on DT_HAS_BFLB_DVP2AXI_ENABLED
	help
	  Enable Bouffalo Lab DVP2AXI parallel camera (DVP2AXI) video stream conversion
	  and DMA engine.

if VIDEO_BFLB_DVP2AXI

config VIDEO_BFLB_DVP2AXI_INIT_PRIORITY
	int "Bouffalo Lab DVP2AXI initialization priority"
	default 61
	help
	  System initialization priority for the BouffaloLab CAMFRONT drivers.
	  This priority needs to be higher (later) than VIDEO_BFLB_DVP2AXI_INIT_PRIORITY (59) so
	  that CANFRONT is initiialized before.

config VIDEO_BFLB_DVP2AXI_MAX_FORMATS
	int "Maximum number of formats listed"
	default 32
	help
	  Configure the maximum number of formats in the format capabilities table.

config VIDEO_BFLB_DVP2AXI_NO_DROP
	bool "Do not drop incomplete frames"
	default y
	help
	  Keep partial frames that had a "VSYNC mismatch", useful for debugging incomplete frames
	  (sometimes filled with 0xdead2010). Without this, incomplete frames will be signaled
	  with a warning and dropped.

	  The vbuf->bytesused field of the video buffer will be the full size, without detection
	  of how many bytes are valid, so some data may be corrupted at the end of the buffer.

endif
