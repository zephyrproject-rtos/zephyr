config VIDEO_IMX662
	bool "IMX662 CMOS digital image sensor"
	select I2C
	select GPIO if $(dt_compat_any_has_prop,$(DT_COMPAT_SONY_IMX662),reset-gpios)
	depends on DT_HAS_SONY_IMX662_ENABLED
	default y
	help
	  Enable driver for IMX662 CMOS digital image sensor device
