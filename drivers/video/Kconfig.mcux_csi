# NXP MCUX CSI driver configuration options

# Copyright (c) 2019, Linaro Limited
# SPDX-License-Identifier: Apache-2.0

config VIDEO_MCUX_CSI
	bool "NXP MCUX CMOS Sensor Interface (CSI) driver"
	default y
	depends on DT_HAS_NXP_IMX_CSI_ENABLED
	select PINCTRL

config VIDEO_MCUX_CSI_INIT_PRIORITY
	int "NXP MCUX CSI init priority"
	default 59
	depends on VIDEO_MCUX_CSI
	help
	  Initialization priority for the CSI interface on an NXP MCUX device.

config VIDEO_MCUX_MIPI_CSI2_MAX_FORMATS
	int "Max number of formats in the capability format list"
	default 32
	help
	  Number of formats that can be generated from the source device. The table of formats is
	  populated once from the source device and the number of formats stays the same during the
	  execution.
