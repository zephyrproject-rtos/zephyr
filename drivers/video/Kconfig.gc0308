config VIDEO_GC0308
	bool "GC0308 CMOS digital image sensor"
	select I2C
	select GPIO if $(dt_compat_any_has_prop,$(DT_COMPAT_GALAXYCORE_GC0308),pwdn-gpios) || \
			$(dt_compat_any_has_prop,$(DT_COMPAT_GALAXYCORE_GC0308),reset-gpios)
	depends on DT_HAS_GALAXYCORE_GC0308_ENABLED
	default y
	help
	  Enable driver for GC0308 CMOS digital image sensor device.
