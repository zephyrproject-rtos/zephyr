config TI_SCI_INTR
	bool "TI K3 TISCI Interrupt Router"
	default y
	depends on DT_HAS_TI_SCI_INTR_ENABLED
	depends on TISCI
	select DYNAMIC_INTERRUPTS
	help
	  Enable support for Texas Instruments K3 Interrupt Router blocks that
	  are programmed through TISCI (for example MAIN/MCU GPIOMUX INTROUTER
	  on J722S). Device trees specify only router input IDs; outputs are
	  allocated and routed at runtime.
