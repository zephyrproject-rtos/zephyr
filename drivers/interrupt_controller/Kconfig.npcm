# NPCM MIWU driver configuration options

# Copyright (c) 2026 Nuvoton Technology Corporation.
# SPDX-License-Identifier: Apache-2.0

config NPCM_MIWU
	bool "Nuvoton NPCM Multi-Input Wake-Up Unit (MIWU) driver"
	default y
	depends on DT_HAS_NUVOTON_NPCM_MIWU_ENABLED
	help
	  This option enables the Multi-Input Wake-Up Unit (MIWU) driver
	  for NPCM family of processors. The MIWU is an interrupt
	  controller in front of the NVIC. It detects events on its
	  wake-up inputs and forwards them to the NVIC as group
	  interrupts.
