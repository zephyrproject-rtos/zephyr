config INTC_ESP32
	bool "Interrupt matrix driver for Espressif SoCs"
	default y if !SOC_ESP32C5_LPCORE && !SOC_ESP32C6_LPCORE && !SOC_ESP32P4_LPCORE
	depends on SOC_FAMILY_ESPRESSIF_ESP32
	help
	  Interrupt matrix driver for Espressif SoCs, modelled as a multi-level
	  interrupt aggregator.
