config ILI98XX_DSI
	bool "ILI98xx DSI display driver"
	default y
	depends on DT_HAS_ILITEK_ILI9806E_ENABLED || DT_HAS_ILITEK_ILI9881C_ENABLED
	select MIPI_DSI
	select GPIO if $(dt_compat_any_has_prop,$(DT_COMPAT_ILITEK_ILI9806E),reset-gpios) || \
		$(dt_compat_any_has_prop,$(DT_COMPAT_ILITEK_ILI9806E),bl-gpios) || \
		$(dt_compat_any_has_prop,$(DT_COMPAT_ILITEK_ILI9881C),reset-gpios) || \
		$(dt_compat_any_has_prop,$(DT_COMPAT_ILITEK_ILI9881C),bl-gpios)
	help
	  Enable driver for ILI9806E_DSI display driver.
