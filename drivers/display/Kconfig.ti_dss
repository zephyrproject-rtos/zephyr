config TI_DSS
	bool "TI display controller driver"
	default y
	depends on DT_HAS_TI_TIDSS_ENABLED
	help
	  Enable the TI K3 Display Sub-System (TIDSS) driver.

if TI_DSS

config TIDSS_INIT_PRIORITY
	int "TI DSS initialisation priority"
	default 91
	help
	  Device initialisation priority for the TI DSS Controller.

endif # TIDSS
