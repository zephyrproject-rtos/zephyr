config ST7262
	bool "Sitronix ST7262 RGB panel on ESP32 LCD-CAM"
	default y
	depends on DT_HAS_SITRONIX_ST7262_ENABLED
	select DMA
	select PINCTRL
	help
	  Enable driver for Sitronix ST7262 RGB panels connected to the
	  ESP32-S3 LCD-CAM parallel RGB interface.

if ST7262

config ST7262_BOUNCE_BUFFER_LINES
	int "RGB bounce buffer height in lines"
	default 20
	range 0 64
	help
	  When non-zero, scanout copies the PSRAM framebuffer into internal
	  SRAM bounce buffers for GDMA (required for reliable ESP32-S3 RGB
	  panels with octal PSRAM). Set to 0 to DMA directly from PSRAM.

endif
