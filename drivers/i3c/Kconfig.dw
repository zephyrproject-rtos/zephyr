module = I3C_DW
module-str = i3c-dw
source "subsys/logging/Kconfig.template.log_config"

menuconfig I3C_DW
	bool "DW I3C support"
	select I3C_IBI_WORKQUEUE if I3C_USE_IBI && I3C_CONTROLLER
	depends on DT_HAS_SNPS_DESIGNWARE_I3C_ENABLED || DT_HAS_MICROCHIP_XEC_I3C_ENABLED
	depends on CLOCK_CONTROL
	default y
	help
	  Enable the Synopsys DesignWare I3C driver. Supports the upstream
	  snps,designware-i3c compatible and the Microchip XEC variant
	  microchip,xec-i3c, which is the same IP behind an XEC wrapper adding
	  ECIA interrupt routing and a HOST_CFG port-select register.

if I3C_DW

config I3C_DW_RW_TIMEOUT_MS
	int "Set the Read/Write timeout in milliseconds"
	default 100

config I3C_DW_PLATFORM_OPS
	bool
	help
	  Selected by vendor glue that needs the platform hook dispatch. When no
	  vendor glue is built the hook pointer is a compile-time NULL, so the
	  dispatch and every hook call fold away.

config I3C_DW_FULL_RESET_SKIP_RESUME_PULSE
	bool "Skip the DEV_CTRL.RESUME pulse when re-priming after a full reset"
	help
	  After a full IP reset the controller is not halted, so the RESUME pulse
	  has nothing to resume. On integrations where the pulse can latch and
	  stall the first CCC, clear any stale RESUME bit instead of pulsing it.

config I3C_DW_INFINEON
	bool
	default y if DT_HAS_INFINEON_I3C_ENABLED
	select I3C_DW_PLATFORM_OPS
	help
	  Build the Infineon implementation of the DW I3C platform ops: the
	  wrapper register gate, the peripheral clock path and the target
	  re-arm sequence the PSE84 integration needs.

endif # I3C_DW
