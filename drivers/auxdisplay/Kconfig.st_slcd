config AUXDISPLAY_ST_SLCD
	bool "ST SLCD display driver"
	default y
	depends on DT_HAS_ST_SLCD_ENABLED
	select RTC
	select PINCTRL
	select USE_STM32_HAL_LCD
	help
	  Enable STMicroelectronics SLCD (Segmented LCD) auxdisplay driver.
	  Provides the standard auxdisplay API for ST SLCD hardware,
	  handling both hardware initialization and the display panel layer
	  in a single unified driver.
