config OTP_NXP_RW6XX
	bool "NXP RW6xx OCOTP driver"
	default y
	depends on DT_HAS_NXP_RW6XX_OCOTP_ENABLED
	help
	  Enable the NXP RW6xx OCOTP (On-Chip OTP) driver for RW610/RW612 SoCs.
	  Fuse programming requires CONFIG_OTP_PROGRAM.
