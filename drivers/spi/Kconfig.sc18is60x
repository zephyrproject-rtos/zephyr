config SPI_SC18IS60X
	bool "NXP SC18IS602/SC18IS606 SPI controller driver"
	default y
	select MFD
	depends on DT_HAS_NXP_SC18IS60X_SPI_ENABLED || DT_HAS_NXP_SC18IS606_SPI_ENABLED
	help
	  Enable the SPI controller child of an NXP SC18IS60x I2C-to-SPI
	  bridge (SC18IS602/SC18IS602B or SC18IS606).

if SPI_SC18IS60X

config SPI_SC18IS60X_INIT_PRIORITY
	int "SC18IS60x SPI init priority"
	default SPI_SC18IS606_INIT_PRIORITY if SPI_SC18IS606
	default 99
	help
	  SC18IS60x SPI controller initialization priority

	  Note: Has to be greater than the parent SC18IS60x bridge init
	  priority.

endif

config SPI_SC18IS606
	bool "NXP SC18IS606 SPI controller driver (deprecated alias) [DEPRECATED]"
	select DEPRECATED
	select SPI_SC18IS60X
	help
	  Deprecated alias for SPI_SC18IS60X. Use SPI_SC18IS60X instead.

if SPI_SC18IS606

config SPI_SC18IS606_INIT_PRIORITY
	int "SC18IS606 SPI init priority (deprecated alias) [DEPRECATED]"
	default 99
	help
	  Deprecated alias for SPI_SC18IS60X_INIT_PRIORITY.
	  Use SPI_SC18IS60X_INIT_PRIORITY instead.

endif
