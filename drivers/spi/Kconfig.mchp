config SPI_MCHP_FLEXCOM_G1
	bool "Microchip FLEXCOM SPI driver"
	default y
	depends on DT_HAS_MICROCHIP_FLEXCOM_G1_SPI_ENABLED
	select PINCTRL
	select GPIO
	help
	  Enable support for the Microchip FLEXCOM SPI driver.

config SPI_MCHP_FLEXCOM_DMA_DRIVEN
	bool "Microchip FLEXCOM SPI DMA Mode"
	default y
	depends on SPI_MCHP_FLEXCOM_G1
	depends on $(dt_compat_all_has_prop,$(DT_COMPAT_MICROCHIP_FLEXCOM_G1_SPI),dmas)
	select DMA
	help
	  This enables DMA driven transfers for the SPI peripheral.
	  Requires DMA controller and dmas property in device tree.

config SPI_MCHP_QSPI_G1
	bool "Microchip G1 QSPI controller in SPI mode"
	default y
	depends on DT_HAS_MICROCHIP_QSPI_G1_SPI_ENABLED
	select PINCTRL
	help
	  Use the G1 QSPI controller (PIC32CX SG, SAM D5x/E5x) as a single-line
	  SPI controller, for example for a serial NOR flash through the
	  jedec,spi-nor driver.

config SPI_MCHP_QSPI_G1_DMA
	bool "DMA transfers for the Microchip G1 QSPI controller"
	default y
	depends on SPI_MCHP_QSPI_G1
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_MICROCHIP_QSPI_G1_SPI),dmas)
	select DMA
	help
	  Use two DMAC channels, given by the dmas property, for transfers of
	  at least SPI_MCHP_QSPI_G1_DMA_THRESHOLD bytes. Instances without
	  dmas, and shorter transfers, stay polled.

config SPI_MCHP_QSPI_G1_DMA_THRESHOLD
	int "Minimum chunk length for a DMA transfer"
	default 32
	range 1 65535
	depends on SPI_MCHP_QSPI_G1_DMA
	help
	  Chunks shorter than this, such as flash commands and addresses, are
	  shifted by the CPU: setting up two DMA channels costs more than it
	  saves on a few bytes.

config SPI_MCHP_SERCOM
	bool
	help
	  Common options for Microchip SPI SERCOM drivers.

config SPI_MCHP_SERCOM_G1
	bool
	default y
	depends on DT_HAS_MICROCHIP_SERCOM_G1_SPI_ENABLED
	select PINCTRL
	select GPIO
	select SPI_MCHP_SERCOM
	help
	  Enable support for the Microchip SERCOM SPI driver.

if SPI_MCHP_SERCOM

config SPI_MCHP_INTER_CHARACTER_SPACE
	int "Microchip SERCOM SPI Inter-Character Spacing (in clock cycles)"
	default 63 if SPI_PERIPHERAL
	default 0
	range 0 63
	depends on SOC_FAMILY_MICROCHIP_SAM_D5X_E5X || SOC_FAMILY_MICROCHIP_PIC32CZ_CA
	help
	  Number of clock cycles to delay between characters on SPI bus.

config SPI_MCHP_DMA_DRIVEN
	bool "Microchip SPI DMA Mode"
	default y
	depends on DMA
	depends on $(dt_compat_all_has_prop,$(DT_COMPAT_MICROCHIP_SERCOM_G1_SPI),dmas)
	help
	  This enables DMA driven transfers for the SPI peripheral.
	  Requires DMA controller and dmas property in device tree.

endif # SPI_MCHP_SERCOM
