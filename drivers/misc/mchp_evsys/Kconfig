config MCHP_EVSYS
	bool
	default y
	depends on CLOCK_CONTROL
	help
	  Enable the Event System driver g1.

	  This driver is not user-selectable and should be enabled by drivers
	  which uses event system

if MCHP_EVSYS

config MCHP_EVSYS_INIT_PRIORITY
	int "mchp evsys driver init priority"
	default KERNEL_INIT_PRIORITY_DEVICE
	help
	  Mirochip EVSYS device driver initialization priority.

config MCHP_EVSYS_G1
	bool
	default y
	depends on DT_HAS_MICROCHIP_EVSYS_G1_ENABLED
	help
	  Enable the Event System driver g1.

	  This driver is not user-selectable and should be enabled by drivers
	  which uses event system

module = MCHP_EVSYS
module-str = mchp_evsys
source "subsys/logging/Kconfig.template.log_config"

endif # MCHP_EVSYS
