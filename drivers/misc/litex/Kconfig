config USE_LITEX_CSR
	bool
	help
	  Indicate accessing LiteX CSR bus.

if USE_LITEX_CSR

# How the LiteX peripheral drivers reach the CSR bus. This is a property of the
# bus the peripherals sit on, not of the CPU, so it is not tied to the LiteX
# SoC family: the CSR bus can be attached to a hardcore such as the Gowin AE350
# as well.

choice LITEX_CSR_ORDERING
	prompt "Select Control/Status register ordering"
	default LITEX_CSR_ORDERING_BIG

config LITEX_CSR_ORDERING_BIG
	bool "Big-endian ordering"
	help
	  Use big-endian ordering for CSR accesses

config LITEX_CSR_ORDERING_LITTLE
	bool "Little-endian ordering"
	help
	  Use little-endian ordering for CSR accesses

endchoice

endif # USE_LITEX_CSR
