config HY4245
	bool "HY4245 Fuel Gauge"
	default y
	depends on DT_HAS_HYCON_HY4245_ENABLED
	select I2C
	help
	  Enable I2C-based driver for HY4245 Fuel Gauge.

if HY4245

config HY4245_RESET_SETTLE_TIME_MS
	int "Settle time after a gauge reset in milliseconds"
	default 2000
	help
	  Time the driver waits after a reset triggered through
	  HY4245_FUEL_GAUGE_RESET or by leaving calibration mode before it
	  returns to the caller. The gauge does not deliver valid
	  measurements until it has restarted its algorithm.


config EMUL_HY4245
	bool "Emulate a HY4245 fuel gauge"
	default y
	depends on EMUL
	help
	  Emulates the I2C interface of the HY4245 including the Control()
	  subcommands, the seal state and a small data flash, so the driver
	  can be tested on native_sim.

endif # HY4245
