# TI AM13 CMPSS DAC Driver Configuration

# Copyright (c) 2026 Texas Instruments Incorporated
# SPDX-License-Identifier: Apache-2.0

config DAC_AM13
	bool "TI AM13 CMPSS low DAC driver"
	default y
	depends on DT_HAS_TI_AM13_CMPSS_DAC_ENABLED
	select SYSCON
	help
	  Enable support for the 12-bit low DAC (DACL) of the CMPSS modules
	  on Texas Instruments AM13 MCUs, used as a general purpose DAC.
