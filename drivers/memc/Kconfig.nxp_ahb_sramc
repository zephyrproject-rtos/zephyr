config MEMC_NXP_AHB_SRAMC
	bool "NXP AHB SRAM Controller (AHB_SRAMC)"
	default y
	depends on DT_HAS_NXP_AHB_SRAMC_ENABLED
	select PINCTRL
	help
	  Enable the NXP AHB SRAM Controller driver. The AHB SRAM
	  Controller is a memory controller for asynchronous SRAM
	  or SRAM like FPGA.

	  This is a different block from the one MEMC_NXP_SRAMC drives, whose
	  registers sit inside BLK_CTRL_WAKEUPMIX on i.MX RT118x. Both SDK HALs
	  ship a header named fsl_sramc.h that declares the same symbols over
	  different register types, so no single build can contain both drivers.
