config MEMC_NXP_AHB_SRAMC
	bool "NXP AHB SRAM Controller (AHB_SRAMC)"
	default y
	depends on DT_HAS_NXP_AHB_SRAMC_ENABLED
	select PINCTRL
	help
	  Enable the NXP AHB SRAM Controller driver. The AHB SRAM Controller is a
	  memory controller for asynchronous SRAM or SRAM-like FPGA devices.

config MEMC_NXP_AHB_SRAMC_INIT_PRIORITY
	int "NXP AHB SRAMC driver initialization priority"
	default MEMC_INIT_PRIORITY
	depends on MEMC_NXP_AHB_SRAMC
	help
	  Initialization priority for the AHB SRAM controller. The controller must
	  be initialized before the devices attached to its chip selects, so this
	  value must not exceed MEMC_INIT_PRIORITY. Equal priorities use devicetree
	  dependency ordering.

if MEMC_NXP_AHB_SRAMC

config MEMC_NXP_AHB_SRAMC_SRAM
	bool "NXP AHB SRAMC SRAM device driver"
	default y
	depends on DT_HAS_NXP_AHB_SRAMC_SRAM_ENABLED
	help
	  Enable the driver for external asynchronous SRAM attached to the NXP AHB
	  SRAM Controller. Each enabled devicetree node with the
	  nxp,ahb-sramc-sram compatible has its chip select programmed during
	  driver initialization and is registered as a memory controller device
	  of its own.

endif # MEMC_NXP_AHB_SRAMC
