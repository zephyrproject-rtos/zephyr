config MBOX_SUNXI_MSGBOX
	bool "Allwinner V851S MSGBOX (RISC/E907 side) driver"
	default y
	depends on DT_HAS_ALLWINNER_SUNXI_MSGBOX_RISCV_ENABLED
	help
	  Enable the Allwinner V851S MSGBOX controller driver for the RISC
	  (E907) co-processor. Provides the mailbox transport used by IPM /
	  OpenAMP / rpmsg to signal the Cortex-A7.
