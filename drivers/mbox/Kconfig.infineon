config MBOX_INFINEON
	bool "Infineon IPC mailbox driver"
	default y
	depends on DT_HAS_INFINEON_MBOX_ENABLED
	help
	  Enable the mailbox (MBOX) driver for the Infineon inter-processor
	  communication (IPC) block using direct register access.
