config PINCTRL_ROCKCHIP
	bool "Rockchip RK3588 pin controller"
	default y
	depends on DT_HAS_ROCKCHIP_RK3588_PINCTRL_ENABLED
	depends on SOC_RK3588
	help
	  Enable the Rockchip RK3588 IOC pin controller.
