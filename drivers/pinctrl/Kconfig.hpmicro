config PINCTRL_HPMICRO
	bool "HPMicro IOC pin controller"
	default y
	depends on DT_HAS_HPMICRO_HPM_PINCTRL_ENABLED
	depends on HAS_HPMSDK_IOC
	help
	  Enable the pin controller driver for the HPMicro IOC and PIOC
	  controllers.
