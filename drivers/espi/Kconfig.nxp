config ESPI_NXP
	bool "NXP eSPI target driver"
	default y
	depends on DT_HAS_NXP_ESPI_ENABLED
	select ESPI_TARGET
	select PINCTRL
	help
	  Enable the eSPI target driver for NXP SoCs.

config ESPI_NXP_TIMEOUT_MS
	int "eSPI operation timeout in milliseconds"
	default 200
	depends on ESPI_NXP
	help
	  Timeout for synchronous eSPI operations such as OOB receive.

config ESPI_TAF_NXP
	bool "NXP eSPI Target Attached Flash (TAF) driver"
	default y
	depends on ESPI_NXP
	depends on DT_HAS_NXP_ESPI_TAF_ENABLED
	select FLASH
	help
	  Enable the NXP eSPI Target Attached Flash (TAF) driver. This is a
	  separate device bound to the espi_saf_driver_api. It shares the parent
	  nxp,espi controller register block and interrupt, the parent driver
	  forwards host flash requests to this driver, which services them
	  against the local flash device and posts the completion back to the
	  host.
