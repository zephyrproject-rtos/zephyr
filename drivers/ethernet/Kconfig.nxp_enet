# NXP ENET ethernet drivers configuration options

# Copyright (c) 2016-2017 ARM Ltd
# Copyright 2024-2025 NXP
# SPDX-License-Identifier: Apache-2.0

DT_NXP_UNIQUE_MAC_PROP := nxp,unique-mac

config ETH_NXP_ENET
	bool "NXP ENET Ethernet driver"
	default y
	depends on DT_HAS_NXP_ENET_MAC_ENABLED
	select NOCACHE_MEMORY if CPU_HAS_DCACHE
	select ARM_MPU if CPU_CORTEX_M7
	imply NET_POWER_MANAGEMENT
	select PINCTRL
	select HWINFO if $(dt_compat_any_has_prop,$(DT_COMPAT_NXP_ENET_MAC),$(DT_NXP_UNIQUE_MAC_PROP),True)
	imply NVMEM if $(dt_compat_any_has_prop,$(DT_COMPAT_NXP_ENET_MAC),nvmem-cells)
	select NET_CHECKSUM_OFFLOAD_SUPPORTED if NET_L2_ETHERNET
	help
	  Enable NXP ENET Ethernet driver.


if ETH_NXP_ENET

config ETH_NXP_ENET_USE_DTCM_FOR_DMA_BUFFER
	bool "Use DTCM for hardware DMA buffers"
	# ERR050396: ENET writes to TCM require CACHE_ENET to be cleared, while
	# ENET_1G writes to TCM can still corrupt data on Cortex-M7.
	default n if CPU_CORTEX_M7
	default y
	help
	  Place the hardware DMA buffers into DTCM for better
	  networking performance.

config ETH_NXP_ENET_HW_ACCELERATION
	bool "Hardware acceleration"
	default y
	depends on NET_CHECKSUM_OFFLOAD
	help
	  Enable hardware acceleration for the following:
	  - IPv4, UDP and TCP checksum (both Rx and Tx)

config ETH_NXP_ENET_RX_BUFFERS
	int "Number of RX buffers for ethernet driver"
	default 6
	range 6 16
	help
	  Depth of the receive DMA buffer-descriptor ring.

config ETH_NXP_ENET_TX_BUFFERS
	int "Number of TX buffers for ethernet driver"
	default 16 if ETH_NXP_ENET_TX_ZERO_COPY
	default 1
	range 2 16 if ETH_NXP_ENET_TX_ZERO_COPY
	range 1 16
	help
	  Depth of the transmit DMA buffer-descriptor ring. Zero-copy TX hands
	  the HAL one buffer descriptor per non-empty net_buf fragment, so the
	  ring must hold a whole worst-case frame: at least
	  ceil(NET_ETH_MAX_FRAME_SIZE / NET_BUF_DATA_SIZE) + 1 descriptors
	  (enforced by a BUILD_ASSERT in the driver). The copy path transmits a
	  linear bounce buffer and works with a single descriptor.

config ETH_NXP_ENET_TX_ZERO_COPY
	bool "Zero-copy TX (DMA directly from net_buf fragments)"
	depends on !ETH_NXP_ENET_USE_DTCM_FOR_DMA_BUFFER
	depends on !PTP_CLOCK_NXP_ENET
	help
	  DMA directly from the net_buf fragments instead of copying each
	  outgoing frame into a driver TX buffer, removing one memcpy per
	  packet. Incompatible with DTCM DMA buffers (no cache maintenance)
	  and the PTP Tx-timestamp path.

config ETH_NXP_ENET_RX_ZERO_COPY
	bool "Zero-copy RX (DMA directly into net_buf-backed buffers)"
	depends on !ETH_NXP_ENET_USE_DTCM_FOR_DMA_BUFFER
	depends on !PTP_CLOCK_NXP_ENET
	depends on NET_BUF_FIXED_DATA_SIZE
	help
	  DMA received frames straight into the network stack's RX data buffers
	  instead of copying each frame out of a driver buffer. The MAC scatters
	  a frame across several buffers, so NET_BUF_DATA_SIZE need not hold a
	  whole frame, but it must meet the HAL minimum and the ENET DMA/cache
	  alignment (enforced by BUILD_ASSERTs); this is why it is not default on.
	  Incompatible with DTCM DMA buffers and the PTP Rx-timestamp path.

config ETH_NXP_ENET_RX_ZERO_COPY_BUFFERS
	int "Zero-copy RX buffer lookup-table size"
	depends on ETH_NXP_ENET_RX_ZERO_COPY
	default 64
	range 8 512
	help
	  Size of the driver table mapping a DMA buffer back to its net_buf. It
	  must cover every buffer the HAL holds at once (the DMA ring plus the
	  replacement it allocates before releasing a received buffer). The
	  buffers themselves come from NET_BUF_RX_COUNT, not from here.

config ETH_NXP_ENET_RX_THREAD_STACK_SIZE
	int "NXP ENET RX thread stack size"
	default 2048 if ETH_NXP_ENET_RX_ZERO_COPY
	default 1600
	help
	  ENET RX thread stack size in bytes. Zero-copy RX walks the HAL
	  rxBuffArray and the net_buf/net_pkt teardown on this thread, so it
	  needs more stack than the copy path.

config ETH_NXP_ENET_RX_THREAD_PRIORITY
	int "NXP ENET driver RX cooperative thread priority"
	default 2
	help
	  Priority level of the RX thread.

config ETH_NXP_ENET_RMII_EXT_CLK
	bool "RMII clock from external sources"
	help
	  Setting this option will configure ENET clock block to feed RMII
	  reference clock from external source (ENET_1588_CLKIN)

config ETH_NXP_ENET_MULTICAST_FILTER
	bool "Multicast destination address filtering"
	default y
	help
	  Enable support for multicast destination address filtering in the
	  MAC. The MAC performs imperfect filtering using a group-address hash
	  table (GAUR/GALR). Only multicast whose computed hash bit is set in
	  the table is received and all other multicast is dropped by the MAC.
	  If disabled, the hash table is opened to every multicast address so
	  that reception does not depend on per-group hash installation.

endif # ETH_NXP_ENET
