menuconfig ETH_ADIN1140
	bool "ADIN1140 10BASE-T1S MAC-PHY"
	default y
	depends on DT_HAS_ADI_ADIN1140_ENABLED
	select SPI
	help
	  The ADIN1140 is a 10BASE-T1S IEEE 802.3™-2022 compliant MAC-PHY
	  for 10Mbps Single-Pair Ethernet (SPE).

if ETH_ADIN1140

config ETH_ADIN1140_RX_THREAD_STACK_SIZE
	int "Stack size for a thread that processes ADIN1140 IRQ"
	default 1024
	help
	  Size of the stack used for internal thread which is ran to
	  process raised ADIN1140 IRQ.

config ETH_ADIN1140_RX_THREAD_PRIO
	int "Priority for internal incoming packet handler"
	default 2
	help
	  Priority level for internal thread which is ran for ADIN1140
	  IRQ processing.

config ETH_ADIN1140_TIMEOUT
	int "IP buffer timeout"
	default 100
	help
	  Timeout in milliseconds. Maximum amount of time
	  that the driver will wait from the IP stack to get
	  a memory buffer before the Ethernet frame is dropped.

config ETH_ADIN1140_TIMESTAMP
	bool "RX/TX frame hardware timestamping (FTSE / TSC)"
	select NET_PKT_TIMESTAMP
	select NET_PKT_TIMESTAMP_THREAD
	help
	  Enable the MAC-PHY's Frame Timestamp Sync Enable/Select
	  (FTSE/FTSS) feature for RX, and per-frame Timestamp Capture
	  (TSC) for TX.

	  RX: an 8-byte hardware timestamp (32-bit seconds + 32-bit
	  nanoseconds) is prepended to every received frame ahead of
	  the destination MAC address. The driver strips this prefix
	  before handing the frame to the network stack and exposes it
	  via net_pkt_set_timestamp() instead of leaving it in the
	  frame payload.

	  TX: when a packet requests it (net_pkt_is_tx_timestamping(),
	  e.g. via a socket's SO_TIMESTAMPING SOF_TIMESTAMPING_TX_HARDWARE
	  option), the driver requests a hardware capture of the frame's
	  actual departure onto the wire and reports it via the standard
	  net_if_add_tx_timestamp() mechanism once available.

config ETH_ADIN1140_PTP
	bool "ADIN1140 hardware gPTP (IEEE 802.1AS) engine support"
	select ETH_ADIN1140_TIMESTAMP
	help
	  Enable use of the MAC-PHY's autonomous hardware gPTP engine
	  (endpoint mode) -- GPTP_LOCKED, GPTP_TIME_ERROR, GPTP_SYNC_COUNT,
	  etc. in the IO_LV register map. Selecting this option enables
	  MAC_CONFIG0.FTSE/FTSS (via ETH_ADIN1140_TIMESTAMP) and has the
	  driver strip the resulting 8-byte RX timestamp prefix before
	  handing frames to the network stack.

	  MAC_CONFIG0.FTSE must be enabled for the internal gPTP
	  time-error computation to run at all, but this dependency is
	  not documented anywhere in the ADIN1140 TRM. Selecting this
	  option enables FTSE automatically so this undocumented
	  requirement can't be missed.

endif # ETH_ADIN1140
