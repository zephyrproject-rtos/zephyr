config PTP_CLOCK_DWC_MAC
	bool "DWC MAC PTP clock driver support"
	default y
	depends on PTP_CLOCK
	depends on DT_HAS_SNPS_DWMAC_PTP_CLOCK_ENABLED
	select NET_L2_PTP_TIMESTAMPING
	help
	  Enable PTP clock support for the Synopsys DesignWare MAC cores.

if PTP_CLOCK_DWC_MAC

config PTP_CLOCK_DWC_MAC_DIGITAL_ROLLOVER
	bool
	default y
	depends on !SOC_SERIES_STM32F1X
	help
	  Run the PTP system time in digital rollover mode, where the sub-second
	  field counts nanoseconds and rolls over at 10^9, instead of binary
	  rollover mode, where it counts in units of 2^-31 s and rolls over at
	  2^31.

endif # PTP_CLOCK_DWC_MAC
