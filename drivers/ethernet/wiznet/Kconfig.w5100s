config ETH_W5100S
	bool "W5100S Ethernet Controller"
	default y
	depends on DT_HAS_WIZNET_W5100S_ENABLED
	select ETH_WIZNET
	select ETH_WIZNET_CORE
	select SPI
	select GPIO if ($(dt_compat_any_has_prop,$(DT_COMPAT_WIZNET_W5100S),reset-gpios) || \
			$(dt_compat_any_has_prop,$(DT_COMPAT_WIZNET_W5100S),int-gpios))
	help
	  W5100S Stand-Alone Ethernet Controller with SPI interface.
