menuconfig ETH_VIRTIO_NET
	bool "VIRTIO networking paravirtualization device driver"
	default y
	depends on DT_HAS_VIRTIO_NET_ENABLED
	select VIRTIO

if ETH_VIRTIO_NET

config ETH_NIC_MODEL
	string
	default "virtio-net-device" if VIRTIO_MMIO
	default "virtio-net-pci" if VIRTIO_PCI
	help
	  Tells QEMU what network model to use. This value is given as
	  a parameter to the -nic QEMU command line option.

config ETH_VIRTIO_NET_RX_BUFFERS
	int "VIRTIO network device receive buffers"
	range 1 32768
	default 4

config ETH_VIRTIO_NET_TX_BUFFERS
	int "Transmit requests"
	range 1 64
	default 4
	help
	  Maximum number of packets queued or waiting for transmit descriptors.
	  Each request includes a full-frame copy buffer for packets whose
	  fragments cannot be submitted directly. Packet references and request
	  buffers are released when the device completes transmission.

endif
