config MFD_BQ2589X
	bool "BQ2589X multi-function device driver"
	default y
	depends on DT_HAS_TI_BQ25896_ENABLED || DT_HAS_SILERGY_SY6970_ENABLED
	select I2C
	help
	  Enable the multi-function device driver for the TI BQ2589X family of
	  single cell switching battery chargers.

	  Supported devices include:
	    - BQ25896
	    - SY6970
