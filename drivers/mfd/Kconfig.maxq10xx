config MFD_MAXQ10XX
	bool "MAXQ10xx mfd driver"
	default y
	depends on DT_HAS_ADI_MAXQ10XX_ENABLED
	# using select SPI at this point introduces a cyclic dependency
	depends on SPI
	help
	  This option enables the mfd driver for the
	  MAXQ10xx crypto chips.
