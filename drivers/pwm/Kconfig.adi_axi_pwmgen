config PWM_ADI_AXI_PWMGEN
	bool "Analog Devices AXI PWM Generator driver"
	default y
	depends on DT_HAS_ADI_AXI_PWMGEN_ENABLED
	help
	  Enable the driver for the Analog Devices AXI PWM Generator core.
	  Generates periodic trigger pulses (e.g. ADC conversion CNV signals).
