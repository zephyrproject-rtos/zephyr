config PWM_MSPM0
	bool "TI MSPM0 MCU family PWM driver"
	default y
	depends on DT_HAS_TI_MSPM0_TIMER_PWM_ENABLED
	select PINCTRL
	help
	  Enable TI MSPM0 MCU family PWM driver.
