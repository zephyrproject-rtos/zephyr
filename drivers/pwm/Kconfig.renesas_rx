config PWM_RENESAS_RX_MTU
	bool "Renesas RX MTU PWM driver"
	default y
	depends on DT_HAS_RENESAS_RX_MTU_PWM_ENABLED
	depends on HAS_RENESAS_RX_RDP
	help
	  Enable the Renesas RX PWM driver.

config PWM_RENESAS_RX_GPT
	bool "Renesas RX GPT PWM driver"
	default y
	depends on DT_HAS_RENESAS_RX_GPT_PWM_ENABLED
	select USE_RX_FSP_GPT
	select PINCTRL
	help
	  Enable the Renesas RX GPT PWM Driver.
