config PWM_TI_AM3352_ECAP
	bool "TI ECAP PWM driver"
	default y
	depends on DT_HAS_TI_AM3352_ECAP_ENABLED
	depends on CLOCK_CONTROL
	select PINCTRL
	help
	  Enable ECAP controller for TI SoCs

if PWM_TI_AM3352_ECAP
config PWM_TI_AM3352_ECAP_VARIANT_AM13
	bool "TI ECAP AM13E variant"
	depends on SOC_SERIES_AM13E
	default y
	select MUX
	select SYSCON
	help
	  Enable AM13E ECAP support : mux-states xbar routing
	  and sysctl for setting PWREN bits.
endif