config PWM_CC27XX_TIMER
	bool "TI SimpleLink CC27XX LGPT PWM driver"
	default y
	depends on DT_HAS_TI_CC27XX_LGPT_PWM_ENABLED
	select PINCTRL
	select DYNAMIC_INTERRUPTS if PWM_CAPTURE
	help
	  Enables TI SimpleLink CC27XX LGPT PWM driver.
