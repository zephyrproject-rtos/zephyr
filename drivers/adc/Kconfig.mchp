config ADC_MCHP_G1
	bool "Microchip ADC support for G1 peripherals"
	depends on DT_HAS_MICROCHIP_ADC_G1_ENABLED
	default y
	select PINCTRL
	select ADC_CONFIGURABLE_INPUTS
	help
	  Enable support for the Microchip ADC driver on G1 ADC peripherals.

config ADC_MCHP_G2
	bool "Microchip ADC support for G2 peripherals"
	depends on DT_HAS_MICROCHIP_ADC_G2_ENABLED
	default y
	select PINCTRL
	select ADC_CONFIGURABLE_INPUTS
	help
	  Enable support for the Microchip ADC driver on G2 ADC peripherals.

config ADC_MCHP_G2_DMA_DRIVEN
	bool "Microchip ADC G2 DMA support"
	default y
	depends on ADC_MCHP_G2
	depends on $(dt_compat_all_has_prop,$(DT_COMPAT_MICROCHIP_ADC_G2),dmas)
	select DMA
	help
	  This enables DMA driven transfers for the ADC peripheral.
	  Requires DMA controller and dmas property in device tree.

config ADC_MCHP_G2_DMA_BUFFER_SIZE
	int "Microchip ADC G2 DMA buffer size"
	default 512
	range 512 4096
	depends on ADC_MCHP_G2_DMA_DRIVEN
	help
	  This driver use a scratch buffer to handle unaligned accesses.
	  Specify the DMA buffer size here.
