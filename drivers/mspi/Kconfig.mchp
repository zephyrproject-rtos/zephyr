config MSPI_MCHP_G1
	bool "Microchip MSPI G1 QSPI driver"
	default y
	depends on DT_HAS_MICROCHIP_QSPI_G1_MSPI_ENABLED
	depends on CLOCK_CONTROL
	depends on PINCTRL
	help
	  Enable support for the Microchip MSPI Group 1 (G1) QSPI driver.
