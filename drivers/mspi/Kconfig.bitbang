config MSPI_BITBANG
	bool "Bitbang MSPI controller driver"
	default y
	depends on DT_HAS_ZEPHYR_MSPI_BITBANG_CONTROLLER_ENABLED
	select GPIO
	help
	  Enable the bitbang MSPI controller driver.
