config MSPI_ESP32
	bool "ESP32 MSPI driver"
	depends on DT_HAS_ESPRESSIF_ESP32_MSPI_ENABLED
	help
	  Enable ESP32 MSPI driver. This driver provides support for the
	  ESP32 SPI peripherals through the Zephyr MSPI interface.

if MSPI_ESP32

config MSPI_DMA_MAX_BUFFER_SIZE
	int "MSPI DMA buffer size (Byte)"
	default 4092
	help
	  Set the size of each buffer used by MSPI DMA.

config MSPI_ESP32_INTERRUPT
	bool "ESP32 MSPI interrupt mode"
	default y
	help
	  Signal transfer completion using the SPI "transaction done"
	  interrupt instead of busy-polling the hardware from the calling
	  thread. This lets other threads run while a transfer is in
	  flight, instead of spinning the calling thread's CPU for the full
	  duration of every transfer. Requires an "interrupts" property on
	  the MSPI controller's devicetree node.

endif # MSPI_ESP32
