config CLOCK_CONTROL_HPMICRO
	bool "HPMicro PLLv2 clock controller"
	default y
	depends on DT_HAS_HPMICRO_HPM_PLLV2_ENABLED
	depends on HAS_HPMSDK_PLLCTLV2
	select USE_HPMSDK_PLLCTLV2
	help
	  Enable the HPMicro PLLv2 clock controller driver.
