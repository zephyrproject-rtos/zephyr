config CLOCK_CONTROL_AD9523
	bool "AD9523(-1) dual-PLL clock generator"
	default y
	depends on DT_HAS_ADI_AD9523_1_ENABLED
	select SPI
	help
	  Enable the Analog Devices AD9523-1 driver: a 14-output, dual-PLL,
	  SPI-programmed clock generator and JESD204 SYSREF distributor.

if CLOCK_CONTROL_AD9523

config CLOCK_CONTROL_AD9523_INIT_PRIORITY
	int "AD9523 clock generator init priority"
	default 60
	help
	  Initialisation priority of the AD9523 clock_control driver, within
	  POST_KERNEL.

endif # CLOCK_CONTROL_AD9523
