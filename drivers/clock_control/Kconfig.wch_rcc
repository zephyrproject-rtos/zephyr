config CLOCK_CONTROL_WCH_RCC
	bool "WCH CH32V00x Reset and Clock Control (RCC) driver"
	default y
	depends on DT_HAS_WCH_RCC_ENABLED

if CLOCK_CONTROL_WCH_RCC

# Micro-controller Clock Output (MCO) configuration options
config CLOCK_WCH_MCO
	bool "WCH CH32 MCO clock output driver"
	default y
	depends on DT_HAS_WCH_CH32V20X_30X_CLOCK_MCO_ENABLED \
			|| DT_HAS_WCH_CH32V00X_CLOCK_MCO_ENABLED \
			|| DT_HAS_WCH_CH32V305_7_V317_CLOCK_MCO_ENABLED \
			|| DT_HAS_WCH_CH32H417_CLOCK_MCO_ENABLED
	depends on PINCTRL
	help
	  Allows to output various different clock sources onto the MCO output pin.

endif # CLOCK_CONTROL_WCH_RCC
