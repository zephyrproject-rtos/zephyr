config CLOCK_CONTROL_MSPM0
	bool "TI MSPM0 clock"
	default y
	depends on $(dt_nodelabel_enabled_with_compat,ckm,$(DT_COMPAT_TI_MSPM0_CKM))
	select SYSCON
	help
	  This option enables the TI MSPM0 Clock Control Enabler
