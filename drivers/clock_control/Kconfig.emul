config CLOCK_CONTROL_EMUL
	bool "Clock controller emulation driver"
	default y
	depends on DT_HAS_ZEPHYR_CLOCK_CONTROLLER_EMUL_ID_ENABLED || \
		DT_HAS_ZEPHYR_CLOCK_CONTROLLER_EMUL_CLKID_ENABLED || \
		DT_HAS_ZEPHYR_CLOCK_CONTROLLER_EMUL_CLK_ID_ENABLED || \
		DT_HAS_ZEPHYR_CLOCK_CONTROLLER_EMUL_RCAR_CPG_MSSR_ENABLED
	help
	  Enable clock controller emulation driver.
