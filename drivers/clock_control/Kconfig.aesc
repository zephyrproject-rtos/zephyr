config CLOCK_CONTROL_AESC
	bool "Aesc Silicon clock controller driver"
	default y
	depends on DT_HAS_AESC_CLOCK_CONTROLLER_ENABLED
	select SYSCON
	help
	  Enable the Aesc Silicon clock controller driver.
	  The reference clock frequency is read from the syscon device
	  referenced by the node's "syscon" property.
