config CLOCK_MONITOR_NXP_ANACTRL
	bool "NXP ANACTRL frequency measure driver"
	default y
	depends on DT_HAS_NXP_ANACTRL_FREQME_ENABLED
	select MUX
	help
	  clock_monitor back-end for the NXP ANACTRL frequency-measurement block.
	  Only support measure mode.
