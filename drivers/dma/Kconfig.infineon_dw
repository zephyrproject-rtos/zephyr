config DMA_INFINEON_DW
	bool "Infineon DataWire (P-DMA) driver"
	default y
	depends on DT_HAS_INFINEON_DW_DMA_ENABLED
	help
	  Register-level driver for the Infineon DataWire (P-DMA) controller.

config DMA_INFINEON_DW_DESCRIPTOR_COUNT
	int "Number of descriptors per DMA channel"
	default 2
	depends on DMA_INFINEON_DW
	help
	  Number of descriptors allocated for each DMA channel. Must be 1 or
	  greater. This is also the maximum block_count accepted by
	  dma_config().
