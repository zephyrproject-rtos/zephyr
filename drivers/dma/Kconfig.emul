config DMA_EMUL
	bool "Emulated DMA driver [EXPERIMENTAL]"
	depends on DT_HAS_ZEPHYR_DMA_EMUL_ENABLED
	# Transfer addresses are native pointers and must not be truncated.
	select DMA_64BIT if 64BIT
	select EXPERIMENTAL
	help
	  Emulated DMA Driver
