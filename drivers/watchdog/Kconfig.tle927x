config WDT_TLE927X
	bool "Infineon TLE927x SBC watchdog driver"
	default y
	depends on DT_HAS_INFINEON_TLE927X_WDT_ENABLED
	depends on MFD_TLE927X
	select HAS_WDT_NO_CALLBACKS
	help
	  Enable the watchdog driver for the Infineon TLE927x System Basis
	  Chip. The SBC watchdog runs in SBC Normal and Stop mode and resets
	  the SoC through the RO pin on a missed trigger. It cannot be
	  disabled.

if WDT_TLE927X

config WDT_TLE927X_INIT_PRIORITY
	int "TLE927x watchdog driver init priority"
	default 78
	help
	  Init priority for the TLE927x watchdog driver. It must be greater
	  than MFD_TLE927X_INIT_PRIORITY.

endif # WDT_TLE927X
