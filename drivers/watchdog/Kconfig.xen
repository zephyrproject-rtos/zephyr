config WDT_XEN
	bool "Xen domain watchdog driver"
	default y
	depends on XEN
	depends on DT_HAS_XEN_WATCHDOG_ENABLED
	select HAS_WDT_NO_CALLBACKS
	help
	  Enable a watchdog driver backed by Xen SCHEDOP_watchdog.

	  This driver exposes Xen domain watchdog timers through Zephyr's
	  watchdog API for the current Xen domain. Xen provides two domain
	  watchdog timer slots, exposed as configurable Zephyr watchdog
	  channels.
	  Expiration is handled by Xen according to the domain's on_watchdog
	  policy, so pre-timeout callbacks are not supported.

config WDT_XEN_CHANNELS
	int "Number of Xen watchdog channels"
	default 1
	range 1 2
	depends on WDT_XEN
	help
	  Number of Zephyr watchdog channels exposed by the Xen watchdog
	  driver. Each channel maps to one Xen domain watchdog timer slot.

	  Xen supports up to two domain watchdog timer slots. Keep the default
	  at one channel for the common single-watchdog use case and select two
	  only when the application needs independent watchdog timers.
