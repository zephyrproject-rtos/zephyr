config UDC_KINETIS
	bool "Kinetis USB device controller driver"
	default y
	depends on DT_HAS_NXP_KINETIS_USBD_ENABLED
	select DYNAMIC_INTERRUPTS if UHC_NXP_KHCI
	help
	  Kinetis USB device controller criver.

if UDC_KINETIS

config UDC_KINETIS_EVENT_COUNT
	int "Number or blocks in event slab"
	range 4 16
	default 4
	help
	  Number of blocks in slab for internal endpoint events.

config UDC_KINETIS_STACK_SIZE
	int "UDC controller driver internal thread stack size"
	default 512
	help
	  Device controller driver internal thread stack size.

config UDC_KINETIS_THREAD_PRIORITY
	int "UDC controller driver thread priority"
	default 8
	help
	  Device controller driver thread priority.

endif # UDC_KINETIS
