config W1_DS2485
	bool "DS2485 1-Wire controller driver"
	select I2C
	depends on DT_HAS_MAXIM_DS2485_ENABLED
	select W1_DS2477_85_COMMON
	default y
	help
	  Enable the ds2485 w1 controller driver.
