# Microchip mec15xx tachometer sensor configuration options

# Copyright (c) 2020 Intel Corporation
# SPDX-License-Identifier: Apache-2.0

config TACH_XEC
	bool "XEC Tachometer sensor"
	default y
	depends on DT_HAS_MICROCHIP_XEC_TACH_ENABLED
	depends on SOC_FAMILY_MICROCHIP_MEC
	select PINCTRL
	help
	  Enable the Microchip XEC tachometer sensor.

	  The number of TACH edges to measure over and the number of TACH
	  periods the fan produces per revolution are set per instance with the
	  tach-edges and pulses-per-round devicetree properties.
