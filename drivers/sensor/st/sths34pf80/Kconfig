config STHS34PF80
	bool "STHS34PF80 infrared presence and motion sensor"
	default y
	depends on DT_HAS_ST_STHS34PF80_ENABLED
	depends on ZEPHYR_HAL_ST_MODULE
	select I2C if $(dt_compat_on_bus,$(DT_COMPAT_ST_STHS34PF80),i2c)
	select I2C_RTIO if $(dt_compat_on_bus,$(DT_COMPAT_ST_STHS34PF80),i2c)
	select SPI if $(dt_compat_on_bus,$(DT_COMPAT_ST_STHS34PF80),spi)
	select SPI_RTIO if $(dt_compat_on_bus,$(DT_COMPAT_ST_STHS34PF80),spi)
	select RTIO
	select HAS_STMEMSC
	select USE_STDC_STHS34PF80
	select SENSOR_ASYNC_API
	help
	  Enable the ST STHS34PF80 infrared presence and motion
	  detection sensor driver (uses the Sensor Read & Decode API).
