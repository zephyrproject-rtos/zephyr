menuconfig LPS22HB
	bool "LPS22HB and LPS33HW pressure and temperature"
	default y
	depends on DT_HAS_ST_LPS22HB_PRESS_ENABLED || DT_HAS_ST_LPS33HW_ENABLED
	select I2C
	help
	  Enable the driver for the LPS22HB and LPS33HW I2C pressure and
	  temperature sensors. Both parts share the register map and
	  WHO_AM_I value.

config LPS22HB_SAMPLING_RATE
	int "Output data rate"
	default 25
	depends on LPS22HB
	help
	  Sensor output data rate expressed in samples per second.
	  Data rates supported by the chip are 1, 10, 25, 50, 75.
