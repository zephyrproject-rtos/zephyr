menuconfig LSM9DS1
	bool "LSM9DS1 I2C/SPI accelerometer and gyroscope chip"
	default y
	depends on DT_HAS_ST_LSM9DS1_ENABLED
	depends on ZEPHYR_HAL_ST_MODULE
	select I2C if $(dt_compat_on_bus,$(DT_COMPAT_ST_LSM9DS1),i2c)
	select SPI if $(dt_compat_on_bus,$(DT_COMPAT_ST_LSM9DS1),spi)
	select HAS_STMEMSC
	select USE_STDC_LSM9DS1

if LSM9DS1

config LSM9DS1_ENABLE_TEMP
	bool "LSM9DS1 Temperature sensor"
	help
	  Enable/disable temperature

endif #LSM9DS1
