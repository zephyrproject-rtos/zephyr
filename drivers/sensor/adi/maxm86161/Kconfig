menuconfig MAXM86161
	bool "MAXM86161 ultra-low-power, completely integrated, optical data-acquisition system."
	default y if DT_HAS_ADI_MAXM86161_ENABLED
	depends on DT_HAS_ADI_MAXM86161_ENABLED
	select I2C
	help
	  Enable driver for MAXM86161 optical sensor.

if MAXM86161

choice
	prompt "Trigger mode"
	default MAXM86161_TRIGGER_NONE
	help
	  Specify the type of trigger handling mode used by the driver.

config MAXM86161_TRIGGER_NONE
	bool "No trigger"

config MAXM86161_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_ADI_MAXM86161),interrupt-gpios)
	select MAXM86161_TRIGGER
	select GPIO

config MAXM86161_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_ADI_MAXM86161),interrupt-gpios)
	select MAXM86161_TRIGGER
	select GPIO

endchoice

config MAXM86161_TRIGGER
	bool

config MAXM86161_STREAM
	bool "Use FIFO to stream data"
	depends on MAXM86161_TRIGGER_OWN_THREAD
	select SENSOR_ASYNC_API
	select I2C_RTIO
	help
	  Enable sensor streaming with RTIO.

if MAXM86161_TRIGGER_OWN_THREAD

config MAXM86161_THREAD_PRIORITY
	int "Thread priority"
	depends on MAXM86161_TRIGGER_OWN_THREAD && MAXM86161_TRIGGER
	default 10
	help
	  Priority of thread used by the driver to handle interrupts.

config MAXM86161_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on MAXM86161_TRIGGER_OWN_THREAD && MAXM86161_TRIGGER
	default 1024
	help
	  Stack size of thread used by the driver to handle interrupts.

endif # MAXM86161_TRIGGER_OWN_THREAD

endif # MAXM86161
