config ADE9000
	bool "ADE9000 polyphase energy metering IC"
	default y
	depends on DT_HAS_ADI_ADE9000_ENABLED
	depends on SENSOR
	select SPI
	select GPIO if $(dt_compat_any_has_prop,$(DT_COMPAT_ADI_ADE9000),reset-gpios)
	help
	  Enable the driver for the Analog Devices ADE9000 polyphase energy
	  metering IC.

if ADE9000

choice ADE9000_TRIGGER_MODE
	prompt "Trigger mode"
	default ADE9000_TRIGGER_GLOBAL_THREAD if $(dt_compat_any_has_prop,$(DT_COMPAT_ADI_ADE9000),irq0-gpios)
	default ADE9000_TRIGGER_GLOBAL_THREAD if $(dt_compat_any_has_prop,$(DT_COMPAT_ADI_ADE9000),irq1-gpios)
	default ADE9000_TRIGGER_NONE
	help
	  Specify the type of triggering used by the driver for IRQ0 and IRQ1.

config ADE9000_TRIGGER_NONE
	bool "No trigger"

config ADE9000_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	select ADE9000_TRIGGER

config ADE9000_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	select ADE9000_TRIGGER

endchoice

config ADE9000_TRIGGER
	bool

config ADE9000_THREAD_PRIORITY
	int "Thread priority"
	depends on ADE9000_TRIGGER_OWN_THREAD
	default 10
	help
	  Priority of the thread that services IRQ0 and IRQ1.

config ADE9000_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on ADE9000_TRIGGER_OWN_THREAD
	default 1024
	help
	  Stack size of the thread that services IRQ0 and IRQ1.

config ADE9000_MULTIPOINT
	bool "Run time multipoint gain and phase calibration"
	default y if $(dt_compat_any_has_prop,$(DT_COMPAT_ADI_ADE9000),multi-point-compensation,True)
	select FPU if CPU_HAS_FPU
	help
	  Adds ade9000_multipoint_set() and ade9000_multipoint_get() to change the
	  thresholds, gains and phase compensation of the multipoint regions at
	  run time, e.g. with a calibration stored in flash.

endif # ADE9000
