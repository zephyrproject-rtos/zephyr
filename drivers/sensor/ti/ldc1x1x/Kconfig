menuconfig LDC1X1X
	bool "LDC1X1X Inductance-to-Digital Converter"
	default y
	depends on DT_HAS_TI_LDC1X1X_ENABLED
	select I2C
	help
	  Enable driver for the Texas Instruments LDC1312, LDC1314,
	  LDC1612, and LDC1614 inductance-to-digital converters.

if LDC1X1X

choice
	prompt "Trigger mode"
	default LDC1X1X_TRIGGER_NONE
	help
	  Specify the type of triggering used by the driver.

config LDC1X1X_TRIGGER_NONE
	bool "No trigger"

config LDC1X1X_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_TI_LDC1X1X),intb-gpios)
	select LDC1X1X_TRIGGER

config LDC1X1X_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_TI_LDC1X1X),intb-gpios)
	select LDC1X1X_TRIGGER

endchoice

config LDC1X1X_TRIGGER
	bool

config LDC1X1X_THREAD_PRIORITY
	int "Thread priority"
	depends on LDC1X1X_TRIGGER_OWN_THREAD && LDC1X1X_TRIGGER
	default 10
	help
	  Priority of thread used by the driver to handle interrupts.

config LDC1X1X_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on LDC1X1X_TRIGGER_OWN_THREAD && LDC1X1X_TRIGGER
	default 1024
	help
	  Stack size of thread used by the driver to handle interrupts.

endif # LDC1X1X
