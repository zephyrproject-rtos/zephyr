config TSL2522
	bool "ams OSRAM TSL2522 ambient light sensing and light flicker detection sensor"
	default y
	depends on DT_HAS_AMS_TSL2522_ENABLED
	select I2C
	select FPU if CPU_HAS_FPU
	help
	  Enable driver for ams OSRAM TSL2522 ambient light sensing and light flicker
	  detection sensor.

if TSL2522

config TSL2522_TRIGGER
	bool

choice
	prompt "Trigger mode"
	default TSL2522_TRIGGER_NONE
	help
	  Specify the type of triggering to be used by the driver.

config TSL2522_TRIGGER_NONE
	bool "No trigger"

config TSL2522_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_AMS_TSL2522),int-gpios)
	select TSL2522_TRIGGER

config TSL2522_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_AMS_TSL2522),int-gpios)
	select TSL2522_TRIGGER

endchoice

config TSL2522_THREAD_PRIORITY
	int "Thread priority"
	depends on TSL2522_TRIGGER_OWN_THREAD
	default 10
	help
	  Priority of thread used by the driver to handle interrupts.

config TSL2522_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on TSL2522_TRIGGER_OWN_THREAD
	default 1024
	help
	  Stack size of thread used by the driver to handle interrupts.

endif # TSL2522
