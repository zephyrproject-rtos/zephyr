config EEPROM_MB85RSXX
	bool "FUJITSU MB85RSXX SPI FRAM"
	default y
	depends on DT_HAS_FUJITSU_MB85RSXX_ENABLED
	select SPI
	help
	  Enable Fujitsu MB85RSxx SPI FRAM (MB85RS2MT, MB85RS2MTA, MB85RS4MT).
