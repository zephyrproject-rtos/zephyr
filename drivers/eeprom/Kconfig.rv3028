config EEPROM_RV3028
	bool "Micro Crystal RV3028 EEPROM driver"
	default y
	depends on DT_HAS_MICROCRYSTAL_RV3028_EEPROM_ENABLED
	depends on DT_HAS_MICROCRYSTAL_RV3028_ENABLED
	select MFD
	help
	  Enable the EEPROM child driver for the Micro Crystal RV3028.
	  The EEPROM is accessed through the EEPROM API.
