config OPAMP_STM32
	bool "STM32 OPAMP driver"
	default y
	select PINCTRL
	depends on DT_HAS_ST_STM32_OPAMP_ENABLED

config OPAMP_LL_API_VER
	int
	depends on OPAMP_STM32
	range 1 2
	default 1 if SOC_SERIES_STM32G4X
	default 2 if SOC_SERIES_STM32U5X
	help
	  Version of the STM32 LL OPAMP API of the series:
	  1: calibration against fractions of VDDA, PGA bias modes with inverting
	     gains, one trimming register (F3, G4, H5, H7).
	  2: NMOS/PMOS calibration, non-inverting PGA, normal and low-power
	     trimming registers (L4, L5, U0, U3, U5).
