config GPIO_CLT01_38SQ7
	bool "ST CLT01-38SQ7 octal digital input current limiter"
	default y
	depends on DT_HAS_ST_CLT01_38SQ7_ENABLED
	depends on SPI
	help
	  GPIO driver for the ST CLT01-38SQ7 octal digital input termination
	  (8 digital inputs, read via 16-bit SPI frames with check bits).

config GPIO_CLT01_38SQ7_INIT_PRIORITY
	int "CLT01-38SQ7 init priority"
	default 75
	depends on GPIO_CLT01_38SQ7
	help
	  Device driver initialization priority. Must be higher than
	  SPI_INIT_PRIORITY.
