config GPIO_MCHP_PORT_G1
	bool "Microchip PORT G1 GPIO driver"
	default y
	depends on DT_HAS_MICROCHIP_PORT_G1_GPIO_ENABLED
	help
	  This option enables GPIO driver for group (g1) of PORT peripherals.

config GPIO_MCHP_GPIO_G1
	bool "Microchip GPIO G1 GPIO driver"
	default y
	depends on DT_HAS_MICROCHIP_GPIO_G1_GPIO_ENABLED
	help
	  This option enables GPIO driver for group (g1) of GPIO peripherals.
