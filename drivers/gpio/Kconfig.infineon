config GPIO_INFINEON
	bool "Infineon GPIO driver"
	default y
	depends on DT_HAS_INFINEON_GPIO_ENABLED
	help
	  Enable GPIO driver for Infineon MCUs using the "infineon,gpio"
	  compatible.

config GPIO_INFINEON_IOSS
	bool "Infineon IOSS GPIO driver"
	default y
	depends on DT_HAS_INFINEON_IOSS_GPIO_ENABLED
	help
	  Enable the register level GPIO driver for the Infineon IOSS GPIO
	  ports using the "infineon,ioss-gpio" compatible.

config GPIO_INFINEON_IOSS_MXS22
	bool
	default y if DT_HAS_INFINEON_MXS22_IOSS_GPIO_ENABLED
	depends on GPIO_INFINEON_IOSS
	help
	  The IOSS is the MXS22IOSS variant, which has the CFG_OUT3 drive
	  mode register.
