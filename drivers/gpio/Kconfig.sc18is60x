config GPIO_SC18IS60X
	bool "NXP SC18IS602/SC18IS606 GPIO Controller driver"
	default y
	select MFD
	depends on DT_HAS_NXP_SC18IS60X_GPIO_ENABLED || DT_HAS_NXP_SC18IS606_GPIO_ENABLED
	help
	  Enables NXP SC18IS60x gpio controller driver

config GPIO_SC18IS60X_INIT_PRIORITY
	int "SC18IS60x GPIO Init Priority"
	default GPIO_SC18IS606_INIT_PRIORITY if GPIO_SC18IS606
	default 81
	depends on GPIO_SC18IS60X
	help
	  SC18IS60x GPIO Controller Init priority

	  Note: Has to be greater than the parent SC18IS60x bridge init priority

config GPIO_SC18IS606
	bool "NXP SC18IS606 GPIO Controller driver (deprecated alias) [DEPRECATED]"
	select DEPRECATED
	select GPIO_SC18IS60X
	help
	  Deprecated alias for GPIO_SC18IS60X. Use GPIO_SC18IS60X instead.

config GPIO_SC18IS606_INIT_PRIORITY
	int "SC18IS606 GPIO Init Priority (deprecated alias) [DEPRECATED]"
	default 80
	depends on GPIO_SC18IS606
	help
	  Deprecated alias for GPIO_SC18IS60X_INIT_PRIORITY.
	  Use GPIO_SC18IS60X_INIT_PRIORITY instead.
