config GPIO_ABOV32
	bool "ABOV32 GPIO driver"
	default y
	depends on DT_HAS_ABOV_ABOV32_GPIO_ENABLED
	help
	  Enable the GPIO driver for the ABOV32 Port Control Unit (PCU), built
	  on the ABOV HAL PCU API (hal_pcu.h).
