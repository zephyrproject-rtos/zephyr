config INFINEON_PPC
	bool "Infineon Peripheral Protection Controller driver"
	depends on ARM_SECURE_FIRMWARE
	default y if DT_HAS_INFINEON_PPC_ENABLED
	select PPC
	help
	  Enables the devicetree-driven driver for the Infineon Peripheral
	  Protection Controller.  ppc_configure_ns_all() opens the peripheral
	  protection regions listed on each enabled "infineon,ppc" node for
	  Non-Secure access.
