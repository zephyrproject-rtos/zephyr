config SOC_FLASH_CC35XX
	bool "TI SimpleLink CC35xx flash driver"
	default y
	depends on DT_HAS_TI_CC35XX_NV_FLASH_ENABLED
	select FLASH_HAS_PAGE_LAYOUT
	select FLASH_HAS_DRIVER_ENABLED
	select FLASH_HAS_EXPLICIT_ERASE
	select MPU_ALLOW_FLASH_WRITE if ARM_MPU
	help
	  Enables TI SimpleLink CC35xx flash driver.
