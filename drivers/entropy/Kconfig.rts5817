config ENTROPY_RTS5817
	bool "RTS5817 Entropy Controller Driver"
	depends on DT_HAS_REALTEK_RTS5817_TRNG_ENABLED
	depends on OTP
	select ENTROPY_HAS_DRIVER
	default y
	help
	  Enable the RTS5817 true random number generator driver.
