config ENTROPY_RISCV_ZKR
	bool "RISC-V Zkr entropy driver"
	default y
	depends on RISCV_ISA_EXT_ZKR
	select ARCH_HAS_ENTROPY
	help
	  Enables the architectural entropy driver based on the seed CSR of the
	  RISC-V Zkr extension.

	  The driver returns the entropy bits as delivered by the seed CSR, without
	  conditioning. The extension guarantees at least 8 bits of min-entropy per
	  16 bits delivered.

	  When the kernel runs in S-mode, the M-mode firmware has to grant access to
	  the seed CSR by setting mseccfg.SSEED.

if ENTROPY_RISCV_ZKR

config ENTROPY_RISCV_ZKR_MAX_RETRIES
	int "Maximum number of retries for RISC-V Zkr entropy driver"
	default 10
	help
	  Maximum number of consecutive seed CSR accesses delivering no entropy
	  after which the driver gives up.

config ENTROPY_RISCV_ZKR_RETRY_WAIT_USEC
	int "Retry wait time for RISC-V Zkr entropy driver"
	default 500
	help
	  Number of microseconds the driver waits before accessing the seed CSR
	  again after an access that delivered no entropy.

endif # ENTROPY_RISCV_ZKR
