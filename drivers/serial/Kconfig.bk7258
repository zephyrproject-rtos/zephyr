config SERIAL_BK7258
	bool "Beken BK7258 UART driver"
	default y
	depends on DT_HAS_BEKEN_BK7258_UART_ENABLED
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	help
	  UART driver for the Beken BK7258. Both modes are
	  implemented: poll_in / poll_out / err_check, and the interrupt-driven API
	  (fifo_fill / fifo_read / irq_tx_* / irq_rx_* / irq_callback_set) behind
	  CONFIG_UART_INTERRUPT_DRIVEN.

	  Register definitions live in drivers/serial/uart_bk7258.c.

	  Interrupts are two-level on this SoC, so the driver also sets the SYSTEM
	  domain enable bit for its NVIC line. No interrupt is armed at init time;
	  irq_tx_enable() / irq_rx_enable() / irq_err_enable() decide, which matters
	  on UART0 -- see UART_BK7258_NO_HW_INIT.

config UART_BK7258_NO_HW_INIT
	bool "Do not re-initialise the UART hardware (sharing it with the peer)"
	default y
	depends on SERIAL_BK7258
	help
	  With this set, the driver init only registers the device and writes no
	  register at all; transmit and receive use the FIFO directly.

	  Why this defaults to y (measured on hardware):
	    UART0 on the BK7258 is owned by the peer: it is that core's console,
	    and this core's log is handed over the mailbox LOG channel and printed
	    there, which is why the vendor output carries an "ap0:" / "ap1:"
	    prefix. This core never touches the UART registers.

	    A normal uart_init (soft reset, pin muxing, rewriting config / clk_div)
	    destroys the port the peer is using: its boot log is cut off mid-line
	    (measured: right after "cal:I(97)") and from then on the console
	    produces nothing readable, only the garbage of the whole-chip reset.

	  Given that UART0 is already at 115200 8N1, this core only has to write
	  fifo_port to emit characters, so Zephyr's printk interleaves with the
	  peer's log on the same port. That is the cheapest observability available
	  during bring-up.

	  Turning this off runs the full hardware init (soft reset, pin setup, baud
	  rate). Only do that when this core owns a UART outright, for instance
	  after moving the console to UART1 or UART2.

config SERIAL_BK7258_MBOX
	bool "Beken BK7258 mailbox console transport"
	default y
	depends on DT_HAS_BEKEN_BK7258_MBOX_UART_ENABLED
	select SERIAL_HAS_DRIVER
	help
	  A serial device whose transport is the inter-core mailbox rather than a
	  UART, so that the shell can be given a console.

	  This core has no UART of its own: UART0 belongs to the peer.
	  Output goes out as LOG messages that the peer prints, and input comes
	  back from the peer's own CLI, which forwards a line typed as
	  `ap_cmd <text>` to this core.

	  Only poll_in / poll_out are implemented. That is enough for the shell's
	  polling backend; there is no interrupt to expose. Builds using this
	  device must therefore select SHELL_BACKEND_SERIAL_API_POLLING.

	  Registering it as a serial device rather than a shell backend is
	  deliberate: Zephyr's serial shell backend is the supported way to
	  attach a shell to something that is not a UART, and in polling mode it
	  asks for nothing else.

# SERIAL_LOG_LEVEL is referenced by LOG_MODULE_REGISTER() in the driver and
# is only generated by this template.
module = SERIAL
module-str = SERIAL
source "subsys/logging/Kconfig.template.log_config"
