config UART_PY32
	bool "Puya PY32 UART driver"
	default y
	depends on DT_HAS_PUYA_PY32_UART_ENABLED
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select RESET
	select PINCTRL
	help
	  Enable the UART driver for Puya PY32 microcontrollers.
