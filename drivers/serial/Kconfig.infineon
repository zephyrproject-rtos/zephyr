config UART_INFINEON_CAT1_HAL
	bool "Infineon CAT1 UART driver"
	default y
	depends on DT_HAS_INFINEON_UART_ENABLED
	depends on USE_INFINEON_LEGACY_HAL
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select SERIAL_SUPPORT_ASYNC if !(SOC_FAMILY_INFINEON_CAT1C || SOC_CY8C6244LQI_S4D92)
	select USE_INFINEON_UART
	select PINCTRL
	select DMA if UART_ASYNC_API
	help
	  This option enables the Legacy HAL based UART driver for Infineon CAT1 family.

config UART_INFINEON_CAT1_PDL
	bool "Infineon CAT1 UART driver (PDL)"
	default y
	depends on DT_HAS_INFINEON_UART_ENABLED
	depends on !USE_INFINEON_LEGACY_HAL
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select SERIAL_SUPPORT_ASYNC if !SOC_FAMILY_INFINEON_CAT1C
	select USE_INFINEON_UART
	select PINCTRL
	select DMA if UART_ASYNC_API
	select USE_INFINEON_DMA if UART_ASYNC_API
	help
	  This option enables the PDL based UART driver for Infineon CAT1 family.

config UART_INFINEON_PDL_MP_FIELD_QUIRK
	bool
	default y if SOC_DIE_PSC3M6 || SOC_SERIES_PSE84
	help
	  Enabled for SoCs whose PDL fixed the SCB UART config field name
	  "enableMultiProcessorMode". Older PDL revisions misspell it as
	  "enableMutliProcessorMode"; the driver picks the field name from
	  this symbol.

config UART_INFINEON_PDL_BYTE_WIDTH_ONLY
	bool
	default y if SOC_SERIES_PSOC4HVMS64K || SOC_SERIES_PSOC4HVMS128K
	help
	  Hidden option enabled for SoC series whose SCB is the v2 (M0S8) IP
	  block, which has no MEM_WIDTH field in the control register and
	  only supports byte-width transfers.
