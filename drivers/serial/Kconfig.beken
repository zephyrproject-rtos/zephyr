config UART_BEKEN_BK7258
	bool "Beken BK7258 serial driver"
	default y
	depends on DT_HAS_BEKEN_BK7258_UART_ENABLED
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select PINCTRL
	help
	  This option enables the Beken BK7258 serial driver.
