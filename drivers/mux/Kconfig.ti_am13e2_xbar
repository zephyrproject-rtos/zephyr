TI_AM13E2_XBAR_PWREN_PROP := ti,pwren

config MUX_TI_AM13E2_XBAR_IN
	bool "TI AM13E2 Input XBAR driver"
	default y
	depends on DT_HAS_TI_AM13E2_XBAR_IN_ENABLED
	select SYSCON if \
		$(dt_compat_any_has_prop,$(DT_COMPAT_TI_AM13E2_XBAR_IN),$(TI_AM13E2_XBAR_PWREN_PROP))
	help
	  Enable the TI AM13E2 Input XBAR (crossbar) multiplexer driver.

config MUX_TI_AM13E2_XBAR_OUT
	bool "TI AM13E2 Output XBAR driver"
	default y
	depends on DT_HAS_TI_AM13E2_XBAR_OUT_ENABLED
	select SYSCON if \
		$(dt_compat_any_has_prop,$(DT_COMPAT_TI_AM13E2_XBAR_OUT),$(TI_AM13E2_XBAR_PWREN_PROP))
	help
	  Enable the TI AM13E2 Output XBAR (crossbar) multiplexer driver.
