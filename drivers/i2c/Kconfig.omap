config I2C_OMAP
	bool "TI OMAP I2C Driver"
	default y
	depends on DT_HAS_TI_OMAP_I2C_ENABLED
	select PINCTRL
	select I2C_OMAP_INTERRUPT if I2C_TARGET || I2C_RTIO
	help
	  Enable the I2C driver for TI OMAP SoCs.

	  When CONFIG_I2C_TARGET is also enabled, the driver exposes I2C
	  target (slave) register/unregister callbacks. Target mode and
	  native RTIO both require interrupt-driven operation
	  (CONFIG_I2C_OMAP_INTERRUPT).

config I2C_OMAP_INTERRUPT
	bool "Interrupt-driven transfers"
	default y
	depends on I2C_OMAP
	help
	  Handle I2C events in the ISR and block the caller on a completion
	  semaphore. When disabled, status is polled in thread context.
	  Required for CONFIG_I2C_TARGET and CONFIG_I2C_RTIO support on this
	  driver.

config I2C_OMAP_BUS_RECOVERY
	bool "Bus recovery support"
	default y if I2C_BUS_RECOVERY
	depends on I2C_OMAP
	select I2C_BITBANG
	help
	  Enable OMAP I2C driver bus recovery support via bitbanging.
