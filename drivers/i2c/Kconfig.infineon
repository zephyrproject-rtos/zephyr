config I2C_INFINEON_CAT1_HAL
	bool "Infineon CAT1 I2C HAL based driver"
	default y
	depends on DT_HAS_INFINEON_I2C_ENABLED
	depends on USE_INFINEON_LEGACY_HAL
	select USE_INFINEON_I2C
	select PINCTRL
	help
	  This option enables the HAL based I2C driver for Infineon CAT1 family.

config I2C_INFINEON_CAT1_PDL
	bool "Infineon CAT1 I2C PDL based driver"
	default y
	depends on DT_HAS_INFINEON_I2C_ENABLED
	depends on !USE_INFINEON_LEGACY_HAL
	select USE_INFINEON_I2C
	select PINCTRL
	select I2C_TRANSFER_TIMEOUT_SUPPORTED
	help
	  This option enables the PDL based I2C driver for the Infineon CAT1 family.

config I2C_INFINEON_BUS_RECOVERY
	bool "Bus recovery support"
	default y
	depends on USE_INFINEON_I2C
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_INFINEON_I2C),scl-gpios)
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_INFINEON_I2C),sda-gpios)
	select I2C_BITBANG
	help
	  Enable Infineon I2C driver bus recovery support via GPIO bitbanging.

config I2C_INFINEON_CAT1_TARGET_BUF
	int "I2C Target data buffer length"
	depends on USE_INFINEON_I2C
	range 1 1024
	default 64
	help
	  Buffer to receive data as an I2C Target.

config I2C_INFINEON_SCB
	bool "Infineon SCB I2C driver"
	default y
	depends on DT_HAS_INFINEON_SCB_I2C_ENABLED
	depends on DT_HAS_INFINEON_PERI_CLK_ENABLED
	depends on CLOCK_CONTROL
	select PINCTRL
	select I2C_TRANSFER_TIMEOUT_SUPPORTED
	help
	  Enable the native driver for the Serial Communication Block of
	  Infineon TRAVEO T2G devices in I2C controller and target mode.

config I2C_INFINEON_SCB_BUS_RECOVERY
	bool "Infineon SCB I2C bus recovery"
	default y
	depends on I2C_INFINEON_SCB
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_INFINEON_SCB_I2C),scl-gpios)
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_INFINEON_SCB_I2C),sda-gpios)
	select I2C_BITBANG
	help
	  Recover a stuck bus by clocking SCL through the scl-gpios and
	  sda-gpios pins of the instance.
