config AUDIO_CODEC_CS42L51
	bool "Cirrus CS42L51 driver"
	default y
	select I2C
	select GPIO
	depends on DT_HAS_CIRRUS_CS42L51_ENABLED
	help
	  Enable the driver for the Cirrus CS42L51 low power stereo
	  audio codec with headphone driver.
