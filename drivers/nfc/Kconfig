menuconfig NFC_DRIVERS
	bool "Near Field Communication (NFC) drivers [EXPERIMENTAL]"
	select EXPERIMENTAL
	help
	  Enable NFC controller driver configuration.

if NFC_DRIVERS

module = NFC_DRIVERS
module-str = NFC_DRIVERS
source "subsys/logging/Kconfig.template.log_config"

config NFC_INIT_PRIORITY
	int "NFC driver init priority"
	default 80
	help
	  NFC controller driver device initialization priority.

source "drivers/nfc/pn53x/Kconfig"

endif # NFC_DRIVERS
