config LPF3_CLOCKP_TIMER
	bool "SYSTIM timer"
	default y
	depends on SOC_SERIES_CC27XX || SOC_SERIES_CC23X0
	select TICKLESS_CAPABLE
	select TIMER_HAS_64BIT_CYCLE_COUNTER if SOC_SERIES_CC27XX
	help
	  This module provides ClockP DPL as "system clock driver" interfaces
	  for the TI Simplelink CC23X0 and CC27XX devices.
