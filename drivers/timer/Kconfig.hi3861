config HI3861_TIMER
	bool
	default y
	depends on DT_HAS_HISILICON_HI3861_TIMER_ENABLED
	select TICKLESS_CAPABLE
	help
	  Hi3861 system timer using an APB timer for alarms and a second
	  APB timer as the free-running cycle counter.
