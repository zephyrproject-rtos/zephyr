config AMD_ACP_TIMER
	bool "AMD ACP External Timer"
	default y
	depends on DT_HAS_AMD_ACP_TIMER_ENABLED
	depends on XTENSA
	depends on !XTENSA_TIMER
	select TICKLESS_CAPABLE
	select TIMER_HAS_64BIT_CYCLE_COUNTER
	select SYSTEM_CLOCK_LOCK_FREE_COUNT
	help
	  System timer driver for the AMD ACP DSP external timer. The timer
	  runs in periodic mode from the ACP reference clock and raises the
	  kernel tick interrupt.
