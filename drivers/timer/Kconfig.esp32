config ESP32_SYS_TIMER
	bool "ESP32 sys-timer support (ESP32Cx series)"
	depends on SOC_SERIES_ESP32C2 || SOC_SERIES_ESP32C3 || \
		(SOC_SERIES_ESP32C5 && !SOC_ESP32C5_LPCORE) || SOC_SERIES_ESP32C61 || \
		(SOC_SERIES_ESP32C6 && !SOC_ESP32C6_LPCORE) || SOC_SERIES_ESP32H2 || \
		(SOC_SERIES_ESP32P4 && !SOC_ESP32P4_LPCORE)
	default y
	select TICKLESS_CAPABLE
	select TIMER_HAS_64BIT_CYCLE_COUNTER
	select SYSTEM_TIMER_HAS_DISABLE_SUPPORT if MCUBOOT
	help
	  This option enables the system timer driver for the Espressif ESP32Cx
	  and provides the standard "system clock driver" interface.

	  With CONFIG_SMP, each CPU arms and acknowledges its own alarm
	  channel (TARGET0 for CPU0, TARGET1 for CPU1) on the shared
	  counter, and the systimer devicetree node must describe the
	  interrupt of both channels. No SoC in the tree enables this
	  driver together with CONFIG_SMP yet.
