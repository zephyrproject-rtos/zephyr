DT_CHOSEN_ZEPHYR_SYSTEM_TIMER := zephyr,system-timer
DT_CHOSEN_ZEPHYR_SYSTEM_TIMER_PATH := $(dt_chosen_path,$(DT_CHOSEN_ZEPHYR_SYSTEM_TIMER))
DT_COMPAT_GOOGLE_GOLDFISH_RTC := google,goldfish-rtc

config GOLDFISH_RTC_TIMER
	bool "Google Goldfish RTC system timer"
	default y
	depends on $(dt_chosen_enabled,$(DT_CHOSEN_ZEPHYR_SYSTEM_TIMER))
	depends on $(dt_node_has_compat,$(DT_CHOSEN_ZEPHYR_SYSTEM_TIMER_PATH),$(DT_COMPAT_GOOGLE_GOLDFISH_RTC))
	select TIMER_HAS_64BIT_CYCLE_COUNTER
	help
	  Use the Goldfish RTC counter and alarm as the system timer.
	  The instance is selected by zephyr,system-timer.
