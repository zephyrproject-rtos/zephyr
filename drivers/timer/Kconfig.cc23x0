config CC23X0_SYSTIM_TIMER
	bool "SYSTIM timer"
	default y
	depends on HAS_CC23X0_SDK
	select TICKLESS_CAPABLE
	help
	  This module provides SYSTIM as "system clock driver" interfaces
	  for the TI Simplelink CC23X0 devices.
