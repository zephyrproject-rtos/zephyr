config XLNX_SDHC
	bool "xlnx sdhc driver"
	default y
	depends on DT_HAS_XLNX_VERSAL_8_9A_ENABLED || DT_HAS_XLNX_ZYNQ_8_9A_ENABLED
	select SDHC_SUPPORTS_NATIVE_MODE
	select SDHC_SUPPORTS_UHS
	select EVENTS
	# Only the Versal controller sources its input clock from a
	# clock_control provider; Zynq-7000 uses a fixed "clock-frequency"
	# devicetree property instead, so a Zynq-only build must not pull in
	# the (then unused) fixed-rate clock driver.
	select CLOCK_CONTROL if DT_HAS_XLNX_VERSAL_8_9A_ENABLED
	select CLOCK_CONTROL_FIXED_RATE_CLOCK if DT_HAS_XLNX_VERSAL_8_9A_ENABLED
	help
	  Enable the Xilinx SD/eMMC host controller driver. Covers the Versal
	  SDHC (ADMA2, UHS, PHY tap-delay) and, in PIO/polling mode, the older
	  Zynq-7000 PS SD/SDIO controller. Per-SoC differences (DMA vs PIO,
	  clock source, UHS) are selected from devicetree.

if XLNX_SDHC

# Xilinx SDHC DMA buffers require cache-line alignment
config SDHC_BUFFER_ALIGNMENT
	default DCACHE_LINE_SIZE if DCACHE_LINE_SIZE > 32
	default 32

config HOST_ADMA2_DESC_SIZE
	int "Max descriptor SIZE"
	default 32
	help
	  Set max number of descriptors supported

endif
