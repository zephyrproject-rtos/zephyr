config CRYPTO_CC23XX_CC27XX
	bool "CC23XX/CC27XX AES accelerator driver"
	default y
	depends on DT_HAS_TI_CC23XX_CC27XX_AES_ENABLED
	help
	  Enable TI CC23XX/CC27XX AES accelerator driver.
	  This driver supports the following modes:
	  - ECB (Electronic Code Book) encryption only (decryption not supported by the hardware)
	  - CTR (Counter)
	  - CCM (CTR with CBC-MAC)

config CRYPTO_CC23XX_CC27XX_DMA
	bool "DMA support for TI CC23XX/CC27XX AES accelerator devices"
	depends on CRYPTO_CC23XX_CC27XX
	select DMA
	help
	  DMA driven transactions for the AES peripheral.
	  DMA driven mode offloads data transfer tasks from the CPU
	  and requires fewer interrupts to handle the AES operations.
