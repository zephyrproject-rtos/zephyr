if SOC_FAMILY_ATMEL_SAM0

rsource "*/Kconfig.defconfig"

config GPIO
	default y

config HWINFO_SAM0
	default HWINFO

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency)

if USB_DEVICE_DRIVER

config HEAP_MEM_POOL_ADD_SIZE_SOC
	def_int 1024

endif # USB_DEVICE_DRIVER

# The Arduino and Adafruit UF2 bootloaders are entered by placing a magic
# value in the last word of SRAM before a reset. Boards describe that word as
# the zephyr,boot-mode retention area, which the CDC ACM serial backend uses
# to reboot into the bootloader when the host opens the port at 1200 baud.
if (BOOTLOADER_BOSSA_ARDUINO || BOOTLOADER_BOSSA_ADAFRUIT_UF2) && \
	DT_HAS_ZEPHYR_RETENTION_ENABLED && CDC_ACM_SERIAL_INITIALIZE_AT_BOOT

config RETAINED_MEM
	default y

config RETENTION
	default y

config RETENTION_BOOT_MODE
	default y

config REBOOT
	default y

endif # BOSSA bootloader boot mode

endif # SOC_FAMILY_ATMEL_SAM0
