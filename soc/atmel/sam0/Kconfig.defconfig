if SOC_FAMILY_ATMEL_SAM0

rsource "*/Kconfig.defconfig"

config GPIO
	default y

config HWINFO_SAM0
	default HWINFO

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency)

if USB_DEVICE_DRIVER

config HEAP_MEM_POOL_ADD_SIZE_SOC
	def_int 1024

endif # USB_DEVICE_DRIVER

if SOC_ATMEL_SAM0_HAS_CMCC

configdefault CACHE_MANAGEMENT
	default y

# The CMCC line is 4 words
configdefault ICACHE_LINE_SIZE
	default 16

choice CACHE_TYPE
	default EXTERNAL_CACHE
endchoice

endif # SOC_ATMEL_SAM0_HAS_CMCC

endif # SOC_FAMILY_ATMEL_SAM0
