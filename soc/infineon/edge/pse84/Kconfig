config SOC_SERIES_PSE84
	select ARM
	select CPU_HAS_FPU
	select ARMV8_M_DSP
	select CPU_HAS_ARM_MPU
	select BUILD_OUTPUT_HEX
	select BUILD_OUTPUT_BIN
	select DYNAMIC_INTERRUPTS
	select SOC_EARLY_INIT_HOOK
	select HAS_PM
	select PM_STATE_SET_IRQ_UNLOCKED
	select HAS_POWEROFF
	select CPU_HAS_CUSTOM_FIXED_SOC_MPU_REGIONS

config SOC_SERIES_PSE84_M33
	select CPU_CORTEX_M33
	select CPU_HAS_ARM_SAU
	select ARM_TRUSTZONE_M
	select ARCH_HAS_TRUSTED_EXECUTION

config SOC_SERIES_PSE84_M55
	select CPU_CORTEX_M55
	select ARMV8_1_M_MVEI
	select ARMV8_1_M_MVEF
	select CACHE_MANAGEMENT

config SOC_SERIES_PSE84_M33
	select SOC_LATE_INIT_HOOK

config PSOC_EDGE_M55_SRF_SUPPORT
	bool "Select whether to enable the SRF support on m55"
	select USE_INFINEON_ABSTRACTION_RTOS
	help
	  This option enables the SRF support on m55 core on pse84 and the infrastructure setup on m33/ns to deal with that.

if SOC_SERIES_PSE84_M33

config SOC_PSE84_M55_ENABLE
	bool "m55 core support"
	help
	  This option enables the m55 core on pse84, by m33 core.

config SOC_PSE84_M55_RAM_LOAD
	bool "Copy the m55 image into RAM before release"
	depends on SOC_PSE84_M55_ENABLE
	help
	  Instead of launching the m55 core in place from flash0_sahb/m55_xip
	  (XIP), copy its code, rodata, and data to RAM first and launch it
	  there. The image is still stored in m55_xip -- this only changes
	  where it executes from -- so SMIF0 never needs to stay in
	  XIP/memory-mapped mode once the m55 core is running there (see
	  CONFIG_SOC_PSE84_M55_DISABLE_SMIF_XIP, set independently on the m55
	  core's own build). The copy destination is the
	  "zephyr,boot-ram-load-region" devicetree chosen node, provided by a
	  board/application overlay; it must be kept equal to the address and
	  size the m55 core's own CONFIG_FLASH_BASE_ADDRESS/CONFIG_FLASH_SIZE
	  resolve to (set directly in m55's own board/application .conf,
	  rather than derived from a zephyr,flash chosen node -- m55's
	  separate zephyr,sram region is never touched by m33 at all).

endif # SOC_SERIES_PSE84_M33

if SOC_SERIES_PSE84_M55

config SOC_PSE84_M55_DISABLE_SMIF_XIP
	bool "Leave SMIF0 XIP mode once m55 init is done"
	select USE_INFINEON_SMIF
	help
	  Once this core's own code/data are fully resident in RAM (copied
	  there by m33 before release -- see CONFIG_SOC_PSE84_M55_RAM_LOAD on
	  the m33 side), nothing on either core needs SMIF0 in
	  XIP/memory-mapped mode anymore. Leaving it set keeps
	  Cy_SMIF_MemEraseSector()'s critical-section guard engaged for every
	  flash_area erase performed later, freezing this core's interrupts
	  for the duration of the erase. This clears it once, for the
	  system's whole remaining life.

	  CONFIG_SOC_PSE84_M55_RAM_LOAD lives in the m33 image's own Kconfig
	  tree, a separate build this one cannot see into, so enabling this
	  without it is a real, unchecked-by-Kconfig way to hang this core:
	  it would still be executing from m55_xip when SMIF0 leaves XIP
	  mode. A BUILD_ASSERT in soc_pse84_m55.c catches the one symptom
	  visible from this side instead -- a zephyr,flash chosen node still
	  being present, which would mean this core is still linked to
	  execute from m55_xip rather than from its RAM destination.

endif # SOC_SERIES_PSE84_M55

config SOC_PSE84_LPM_TIMER
	bool
	default y if SYSTEM_TIMER_LPM_COMPANION_HOOKS
	select USE_INFINEON_LPTIMER
	help
	  Enable MCWDT as a low-power companion timer for the SysTick.
	  The MCWDT runs from PILO (32 kHz) and provides timekeeping
	  during deepsleep when HF clocks (and thus SysTick) are stopped.
