# SOC series
config SOC_SERIES_CYT4XX
	bool
	select SOC_FAMILY_INFINEON_CAT1C

# Shared CPU-cluster selectors for the cyt4xx series.
config SOC_SERIES_CYT4XX_M0P
	bool

config SOC_SERIES_CYT4XX_M7_0
	bool

config SOC_SERIES_CYT4XX_M7_1
	bool

config SOC_SERIES
	default "cyt4xx" if SOC_SERIES_CYT4XX

config SOC_DIE_CYT4DN
	bool

# cyt4dnjbzs
config SOC_CYT4DNJBZS
	bool
	select SOC_SERIES_CYT4XX
	select SOC_DIE_CYT4DN

config SOC_CYT4DNJBZS_M0P
	bool
	select SOC_CYT4DNJBZS
	select SOC_SERIES_CYT4XX_M0P

config SOC_CYT4DNJBZS_M7_0
	bool
	select SOC_CYT4DNJBZS
	select SOC_SERIES_CYT4XX_M7_0

config SOC_CYT4DNJBZS_M7_1
	bool
	select SOC_CYT4DNJBZS
	select SOC_SERIES_CYT4XX_M7_1

config SOC
	default "cyt4dnjbzs" if SOC_CYT4DNJBZS
