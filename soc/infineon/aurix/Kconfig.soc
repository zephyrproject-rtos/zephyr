config SOC_FAMILY_AURIX
	bool

config SOC_FAMILY
	default "aurix" if SOC_FAMILY_AURIX

config SOC_SERIES_TC3X
	bool
	select SOC_FAMILY_AURIX

config SOC_SERIES_TC4X
	bool
	select SOC_FAMILY_AURIX

config SOC_SERIES
	default "tc3x" if SOC_SERIES_TC3X
	default "tc4x" if SOC_SERIES_TC4X

rsource "*/Kconfig.soc"
