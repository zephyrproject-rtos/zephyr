if SOC_SERIES_TC3X

# Highest service request node index: 1021
config NUM_IRQS
	default 1024

config CLOCK_CONTROL
	default y

endif

if SOC_SERIES_TC4X

# Highest service request node index: 2035
config NUM_IRQS
	default 2048

config CLOCK_CONTROL
	default y

endif

rsource "*/Kconfig.defconfig"
