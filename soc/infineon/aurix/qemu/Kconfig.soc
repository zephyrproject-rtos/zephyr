config SOC_QEMU_TC3X
	bool
	select SOC_SERIES_TC3X

config SOC_QEMU_TC4X
	bool
	select SOC_SERIES_TC4X

config SOC
	default "qemu_tc3x" if SOC_QEMU_TC3X
	default "qemu_tc4x" if SOC_QEMU_TC4X
