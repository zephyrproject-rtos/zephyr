# SOC Packages for Infineon PSOC4HVMS64K series MCUs
config SOC_PACKAGE_PSOC4HVMS64K_32_QFN
	bool
	help
	  32-pin QFN package

config SOC_PACKAGE_PSOC4HVMS64K_48_QFN
	bool
	help
	  48-pin QFN package

config SOC_PACKAGE_PSOC4HVMS64K_56_QFN
	bool
	help
	  56-pin QFN package

# Hardware configuration for PSOC4HVMS64K series
config SOC_SERIES_PSOC4HVMS64K
	select ARM
	select CPU_CORTEX_M0PLUS
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_HAS_ARM_MPU
	select BUILD_OUTPUT_HEX
	select BUILD_OUTPUT_BIN
	select DYNAMIC_INTERRUPTS
	select SOC_EARLY_INIT_HOOK
	select SOC_EARLY_RESET_HOOK
	select CPU_CORTEX_M_HAS_SYSTICK

