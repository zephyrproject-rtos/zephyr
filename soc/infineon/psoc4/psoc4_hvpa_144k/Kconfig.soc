# MCU series
config SOC_SERIES_PSOC4_HVPA_144K
	bool
	select SOC_FAMILY_INFINEON_PSOC4
	help
	  PSOC4 HVPA 144K Series MCU

config SOC_SERIES
	default "psoc4_hvpa_144k" if SOC_SERIES_PSOC4_HVPA_144K

config SOC_CY8C4147LCE_HV423
	bool
	select SOC_SERIES_PSOC4_HVPA_144K

config SOC
	default "cy8c4147lce_hv423" if SOC_CY8C4147LCE_HV423
