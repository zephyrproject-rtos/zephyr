# SOC Packages for Infineon PSOC4 HVPA 144K series MCUs
config SOC_PACKAGE_PSOC4_HVPA_144K_32_QFN
	bool
	help
	  32-pin QFN package

# Hardware configuration for PSOC4 HVPA 144K series
config SOC_SERIES_PSOC4_HVPA_144K
	select ARM
	select CPU_CORTEX_M0PLUS
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_HAS_ARM_MPU
	select BUILD_OUTPUT_HEX
	select BUILD_OUTPUT_BIN
	select DYNAMIC_INTERRUPTS
	select SOC_EARLY_INIT_HOOK
	select CPU_CORTEX_M_HAS_SYSTICK

config SOC_CY8C4147LCE_HV423
	select SOC_PACKAGE_PSOC4_HVPA_144K_32_QFN
