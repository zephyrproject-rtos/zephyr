# Infineon PSC3 based MCU default configuration

if SOC_SERIES_PSC3

# PSC3 uses SysTick as the primary system timer by default. When PM is
# enabled, the MCWDT serves as a low-power companion timer via the
# SYSTEM_TIMER_LPM_COMPANION_HOOKS mechanism, providing timekeeping during
# deepsleep when the SysTick (and HF clocks) stop. To use the LP timer as the
# primary system timer instead, set CONFIG_CORTEX_M_SYSTICK=n and
# CONFIG_INFINEON_LP_TIMER_PDL=y.
config INFINEON_LP_TIMER_PDL
	default n

choice SYSTEM_TIMER_LPM_COMPANION
	default SYSTEM_TIMER_LPM_COMPANION_HOOKS if PM
endchoice

config NUM_IRQS
	default 140

# SysTick freezes in every deepsleep-class state (HF clocks stop; a DS-RAM warm
# boot also cold-boots the device), so the driver stops it before idle and
# restarts it on wake, leaving the companion as the sole time reference.
config SYSTEM_TIMER_RESET_BY_LPM
	default y if PM

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency) if CORTEX_M_SYSTICK
	default $(dt_node_int_prop_int,/clocks/clk_wco,clock-frequency) if USE_INFINEON_LPTIMER

config SYS_CLOCK_TICKS_PER_SEC
	default $(div,$(dt_node_int_prop_int,/clocks/clk_wco,clock-frequency),4) if USE_INFINEON_LPTIMER

# add additional die specific params

endif # SOC_SERIES_PSC3
