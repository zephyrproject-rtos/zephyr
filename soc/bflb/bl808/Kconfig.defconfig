if SOC_SERIES_BL808

config SOC_RESET_HOOK
	default y

config SYS_CLOCK_TICKS_PER_SEC
	default 5000

config NUM_IRQS
	default 80

config ARCH_SW_ISR_TABLE_ALIGN
	default 64

config RISCV_MCAUSE_EXCEPTION_MASK
	default 0xFFF

if WIFI_BFLB

# Key install runs on the system work queue; the Zephyr default
# overflows on RISC-V.
configdefault SYSTEM_WORKQUEUE_STACK_SIZE
	default 2048

# The supplicant only holds a handful of transient keys at a time; the
# default key-slot table wastes several KB of RAM, and static slots are
# sized for the RSA keys hostap selects (2 KB each) although the keys
# actually stored are 16-64 bytes.
configdefault MBEDTLS_PSA_KEY_SLOT_COUNT
	default 6

configdefault MBEDTLS_PSA_STATIC_KEY_SLOTS
	default n

# Trade flash for RAM, most of WRAM goes to the firmware shared memory.
configdefault MBEDTLS_AES_ROM_TABLES
	default y

# Scan results are delivered via the net_mgmt event thread.
configdefault NET_MGMT_EVENT_STACK_SIZE
	default 2048

# The TX path runs in the caller's thread: net_pkt_read -> blob TX chain.
# The shell default of 5200 overflows.
configdefault SHELL_STACK_SIZE
	default 8192 if SHELL

# Net buffer sizing for the small SRAM budget.
configdefault NET_PKT_RX_COUNT
	default 8

configdefault NET_PKT_TX_COUNT
	default 4

configdefault NET_BUF_RX_COUNT
	default 16

configdefault NET_BUF_TX_COUNT
	default 8

# Unicast DHCP replies use the MAC HW's dedicated unicast RX path.
configdefault NET_DHCPV4_ACCEPT_UNICAST
	default y

endif # WIFI_BFLB

endif # SOC_SERIES_BL808
