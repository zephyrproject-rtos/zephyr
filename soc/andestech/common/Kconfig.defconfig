configdefault PMP_GRANULARITY
	default 4096 if CPU_ANDES_65
	default 4 if CPU_ANDES_22
	default 8

configdefault PMP_NO_TOR
	default y if CPU_ANDES_22

configdefault NULL_POINTER_EXCEPTION_REGION_SIZE
	default 0x1000 if CPU_ANDES_65
