config SOC_SERIES_PY32F0X
	bool
	select SOC_FAMILY_PY32

config SOC_SERIES
	default "py32f0x" if SOC_SERIES_PY32F0X

config SOC_PY32F003X6
	bool
	select SOC_SERIES_PY32F0X

config SOC_PY32F030X4
	bool
	select SOC_SERIES_PY32F0X

config SOC_PY32F030X6
	bool
	select SOC_SERIES_PY32F0X

config SOC_PY32F030X8
	bool
	select SOC_SERIES_PY32F0X

config SOC
	default "py32f003x6" if SOC_PY32F003X6
	default "py32f030x4" if SOC_PY32F030X4
	default "py32f030x6" if SOC_PY32F030X6
	default "py32f030x8" if SOC_PY32F030X8
