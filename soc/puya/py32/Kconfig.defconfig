if SOC_FAMILY_PY32

config CLOCK_CONTROL
	default y

config NUM_IRQS
	default 32

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_nodelabel_int_prop,rcc,clock-frequency)

config SYS_CLOCK_TICKS_PER_SEC
	default 8000

config CLOCK_CONTROL_INIT_PRIORITY
	default 1
	depends on CLOCK_CONTROL

endif # SOC_FAMILY_PY32
