config SOC_SERIES_RP2350
	select HAS_RPI_PICO
	select HAS_SEGGER_RTT if ZEPHYR_SEGGER_MODULE
	select SOC_RESET_HOOK
	imply XIP
	select CLOCK_CONTROL_RPI_PICO if PM_S2RAM
	select HAS_PM if ARM
	select HAS_PM_S2RAM_CUSTOM_MARKING if PM_S2RAM
	select PICOSDK_USE_POWMAN if PM_S2RAM
	select TICKLESS_KERNEL if PM_S2RAM

config SOC_RP2350A_HAZARD3
	select DEPRECATED

config SOC_RP2350A_HAZARD3_0
	select ARCH_HAS_RAMFUNC_SUPPORT if XIP
	select HAS_FLASH_LOAD_OFFSET
	select INCLUDE_RESET_VECTOR
	select RISCV

config SOC_RP2350A_M33
	select DEPRECATED

config SOC_RP2350A_M33_0
	select ARM
	select ARM_TRUSTZONE_M
	select CPU_CORTEX_M_HAS_SYSTICK
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_CORTEX_M33
	select CPU_HAS_ARM_MPU
	select CPU_HAS_ARM_SAU
	select CPU_HAS_FPU
	select ARMV8_M_DSP

config SOC_RP2350A_M33_1
	select ARM
	select ARM_TRUSTZONE_M
	select CPU_CORTEX_M_HAS_SYSTICK
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_CORTEX_M33
	select CPU_HAS_ARM_MPU
	select CPU_HAS_ARM_SAU
	select CPU_HAS_FPU
	select ARMV8_M_DSP
	select SOC_FAMILY_RPI_PICO_CPU1

config SOC_RP2350A_M33_SMP
	select SOC_RP2350_M33_SMP

config SOC_RP2350B_HAZARD3
	select DEPRECATED

config SOC_RP2350B_HAZARD3_0
	select ARCH_HAS_RAMFUNC_SUPPORT if XIP
	select HAS_FLASH_LOAD_OFFSET
	select INCLUDE_RESET_VECTOR
	select RISCV

config SOC_RP2350B_M33
	select DEPRECATED

config SOC_RP2350B_M33_0
	select ARM
	select ARM_TRUSTZONE_M
	select CPU_CORTEX_M_HAS_SYSTICK
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_CORTEX_M33
	select CPU_HAS_ARM_MPU
	select CPU_HAS_ARM_SAU
	select CPU_HAS_FPU
	select ARMV8_M_DSP

config SOC_RP2350B_M33_1
	select ARM
	select ARM_TRUSTZONE_M
	select CPU_CORTEX_M_HAS_SYSTICK
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_CORTEX_M33
	select CPU_HAS_ARM_MPU
	select CPU_HAS_ARM_SAU
	select CPU_HAS_FPU
	select ARMV8_M_DSP
	select SOC_FAMILY_RPI_PICO_CPU1

config SOC_RP2350B_M33_SMP
	select SOC_RP2350_M33_SMP

config SOC_RP2350_M33_SMP
	bool
	help
	  Both Cortex-M33 cores of an RP2350 run one SMP image.
	select ARM
	select ARM_TRUSTZONE_M
	select CPU_CORTEX_M_HAS_SYSTICK
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_CORTEX_M33
	select CPU_HAS_ARM_MPU
	select CPU_HAS_ARM_SAU
	select CPU_HAS_FPU
	select ARMV8_M_DSP
	select SOC_PER_CORE_INIT_HOOK if SMP || MP_MAX_NUM_CPUS > 1
	select SCHED_IPI_SUPPORTED if SMP
	select ARCH_HAS_DIRECTED_IPIS if SMP

if SOC_SERIES_RP2350

config RP2_REQUIRES_IMAGE_DEFINITION_BLOCK
	bool
	# IMAGE_DEF should be used to define the image for booting CPU0
	default y if !SOC_FAMILY_RPI_PICO_CPU1
	help
	  Include an Image Definition Block (IMAGE_DEF) to enable the bootroom in
	  RP23XX devices to consider this a valid image in flash.

config RPI_PICO_SIGNING_KEY
	string "Secure boot signing key"
	help
	  Provide a path to the private key to sign the image for secure boot.
	  The key must be in PEM format and match the expectations of the
	  picotool utility. Please see picotool documentation for details.
	  Setting this config option enables west sign command
	  to produce a signed ELF file. If this is not provided west sign
	  cannot be used.

config RPI_PICO_SMP_FLASH_PARK
	bool "Park the other core in RAM while flash is written or erased"
	default y
	depends on SOC_SERIES_RP2350 && SMP && MP_MAX_NUM_CPUS > 1
	help
	  Writing or erasing the flash takes the XIP interface away from both
	  cores. This option adds rp2350_smp_park_other() and
	  rp2350_smp_unpark_other(), which stop the other core in a loop in RAM
	  with all of its interrupts masked. It uses doorbell 1 of the SIO; doorbell
	  0 is the scheduler IPI. The flash driver needs it with SMP.

if RPI_PICO_SMP_FLASH_PARK

config RPI_PICO_SMP_FLASH_PARK_SHORT_WAIT_US
	int "Time to wait for the other core to park before trying again (microseconds)"
	default 100
	range 10 10000
	help
	  The other core may be waiting for this one with its interrupts masked,
	  for example in the cross-CPU abort of a thread. After this time the
	  request is withdrawn and this core takes the interrupts that are
	  pending for it before the request is made again.

config RPI_PICO_SMP_FLASH_PARK_TIMEOUT_MS
	int "Total time to try to park the other core before giving up (milliseconds)"
	default 100
	range 1 60000
	help
	  The flash driver gives up with -EBUSY when the other core cannot be
	  parked in this time. It applies to each page written and each erase
	  unit, not to a whole write or erase call.

config RPI_PICO_SMP_FLASH_PARK_DIAG
	bool "Count parking requests (for tests)"
	help
	  Exposes rp2350_smp_park_stats. Not for production images: it adds a
	  read of TIMER1 to the loop of the parked core.

endif # RPI_PICO_SMP_FLASH_PARK

endif # SOC_SERIES_RP2350
