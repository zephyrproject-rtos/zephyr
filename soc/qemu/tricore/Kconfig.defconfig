if SOC_SERIES_TC3X

config NUM_IRQS
	default 256

endif

if SOC_SERIES_TC4X

config NUM_IRQS
	default 16

endif

if SOC_QEMU_TC3X || SOC_QEMU_TC4X

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/clocks/fstm,clock-frequency)

