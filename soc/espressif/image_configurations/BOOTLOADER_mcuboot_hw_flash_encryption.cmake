# Espressif MCUboot bootloader image configuration for hardware flash encryption.

set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENC_ENABLED y)

if(SB_CONFIG_MCUBOOT_ESP_FLASH_ENCRYPTION_DEVELOPMENT)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT y)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE n)
elseif(SB_CONFIG_MCUBOOT_ESP_FLASH_ENCRYPTION_RELEASE)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT n)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE y)
endif()

if(SB_CONFIG_MCUBOOT_ESP_FLASH_ENCRYPTION_AES128_DERIVED)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_AES128_DERIVED y)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_AES128 n)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_AES256 n)
elseif(SB_CONFIG_MCUBOOT_ESP_FLASH_ENCRYPTION_AES256)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_AES128_DERIVED n)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_AES128 n)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_AES256 y)
else()
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_AES128_DERIVED n)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_AES128 y)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SECURE_FLASH_ENCRYPTION_AES256 n)
endif()

if(SB_CONFIG_MCUBOOT_ESP_EFUSE_VIRTUAL)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_ESP32_EFUSE_VIRTUAL y)
endif()

if(SB_CONFIG_MCUBOOT_ESP_EFUSE_VIRTUAL_KEEP_IN_FLASH)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_ESP32_EFUSE_VIRTUAL_KEEP_IN_FLASH y)
endif()
