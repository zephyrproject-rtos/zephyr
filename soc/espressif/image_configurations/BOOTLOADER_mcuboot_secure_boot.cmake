# Espressif MCUboot bootloader image configuration for Secure Boot v2.
# ROM verifies this image. Application images stay imgtool-signed only.

set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT y)
set_config_bool(${ZCMAKE_APPLICATION} CONFIG_BOOT_GO_HOOKS y)
set_config_bool(${ZCMAKE_APPLICATION} CONFIG_BOOT_VALIDATE_SLOT0 y)

if(SB_CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_ECDSA_V2)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_ECDSA_V2 y)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_RSA n)
else()
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_RSA y)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_ECDSA_V2 n)
endif()

if(SB_CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_FLASH_ENC_KEYS_BURN_TOGETHER)
  set_config_bool(${ZCMAKE_APPLICATION}
                  CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_FLASH_ENC_KEYS_BURN_TOGETHER y)
endif()

set(espressif_sb_key "${SB_CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_SIGNING_KEY}")
if(NOT espressif_sb_key AND ESPRESSIF_SECURE_BOOT_SIGNING_KEY)
  set(espressif_sb_key "${ESPRESSIF_SECURE_BOOT_SIGNING_KEY}")
endif()
if(NOT espressif_sb_key)
  message(FATAL_ERROR
    "Secure Boot v2 requires a PEM signing key. Set "
    "SB_CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_SIGNING_KEY to the key path.")
endif()
if(NOT IS_ABSOLUTE "${espressif_sb_key}")
  set(espressif_sb_key "${APPLICATION_SOURCE_DIR}/${espressif_sb_key}")
endif()
set_config_string(${ZCMAKE_APPLICATION}
                  CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_SIGNING_KEY
                  "${espressif_sb_key}")

if(SB_CONFIG_SOC_FAMILY_ESPRESSIF_EFUSE_VIRTUAL)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_EFUSE_VIRTUAL y)
endif()

if(SB_CONFIG_SOC_FAMILY_ESPRESSIF_EFUSE_VIRTUAL_KEEP_IN_FLASH)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_EFUSE_VIRTUAL_KEEP_IN_FLASH y)
endif()

if(SB_CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_ALLOW_ROM_BASIC)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_ALLOW_ROM_BASIC y)
endif()

if(SB_CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_ALLOW_JTAG)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_BOOT_ALLOW_JTAG y)
endif()

if(SB_CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_DISABLE_ROM_DL_MODE)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_DISABLE_ROM_DL_MODE y)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_ENABLE_SECURE_ROM_DL_MODE n)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_INSECURE_ALLOW_DL_MODE n)
elseif(SB_CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_ENABLE_SECURE_ROM_DL_MODE)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_DISABLE_ROM_DL_MODE n)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_ENABLE_SECURE_ROM_DL_MODE y)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_INSECURE_ALLOW_DL_MODE n)
else()
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_DISABLE_ROM_DL_MODE n)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_ENABLE_SECURE_ROM_DL_MODE n)
  set_config_bool(${ZCMAKE_APPLICATION} CONFIG_SOC_FAMILY_ESPRESSIF_SECURE_INSECURE_ALLOW_DL_MODE y)
endif()
