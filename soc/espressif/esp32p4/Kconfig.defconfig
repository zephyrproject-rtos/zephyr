if SOC_ESP32P4_HPCORE

config FPU
	default y

# Multi-level interrupts: L1 = intc (CPU lines, slot = 16 + line), L2 = intmux
# (the interrupt matrix as one aggregator, slot = 48 + source). The intmux
# window spans the 4 contiguous status words (sources 0..127; the highest
# source used on this SoC is 111), so the level-3 window starts at
# 48 + 128 = 176 and NUM_IRQS = 176 + 16.
config NUM_IRQS
	default 192

config RISCV_MCAUSE_EXCEPTION_MASK
	default 0xFFF

config RISCV_RESERVED_IRQ_ISR_TABLES_OFFSET
	default 16

config MULTI_LEVEL_INTERRUPTS
	default y

config 2ND_LEVEL_INTERRUPTS
	default y

config 1ST_LEVEL_INTERRUPT_BITS
	default 8

config 2ND_LEVEL_INTERRUPT_BITS
	default 8

config 2ND_LVL_ISR_TBL_OFFSET
	default 48

# Key line of intmux, the "interrupts" line of the intmux node. Line 6 is
# permanently disabled, so no matrix source is ever routed to it. The level-1
# IRQ number carries no reserved-IRQ offset; only the table slots do.
config 2ND_LVL_INTR_00_OFFSET
	default 6

config MAX_IRQ_PER_2ND_LEVEL_AGGREGATOR
	default 128

config NUM_2ND_LEVEL_AGGREGATORS
	default 1

# Level-3: both analog comparator units share GPIO_PAD_COMP_INTR_SOURCE and are
# demuxed by ana_cmpr_l3_intc (see the SoC dtsi). Window base is the end of the
# level-2 window.
config 3RD_LEVEL_INTERRUPTS
	default y

config 3RD_LEVEL_INTERRUPT_BITS
	default 8

config NUM_3RD_LEVEL_AGGREGATORS
	default 1

config 3RD_LVL_INTR_00_OFFSET
	default 78	# GPIO_PAD_COMP_INTR_SOURCE, ana_cmpr_l3_intc

config MAX_IRQ_PER_3RD_LEVEL_AGGREGATOR
	default 16

config 3RD_LVL_ISR_TBL_OFFSET
	default 176

config RISCV_SOC_CONTEXT_SAVE
	default y

config RISCV_ALWAYS_SWITCH_THROUGH_ECALL
	default y if MULTITHREADING

config RISCV_SOC_HAS_SYSCALL_INTMASK
	default y if USERSPACE && RISCV_SOC_CONTEXT_SAVE && RISCV_ALWAYS_SWITCH_THROUGH_ECALL

config RISCV_USER_STRING_NLEN_VALIDATE
	default y if USERSPACE

config RISCV_SOC_SYSCALL_CLOSE_ECALL
	default y if USERSPACE

config PMP_SLOTS
	default 16

config PMP_NO_LOCK_GLOBAL
	default y

config PMP_GRANULARITY
	default 128 if SOC_ESP32P4_HPCORE && RISCV_PMP

config NULL_POINTER_EXCEPTION_REGION_SIZE
	default 0x80 if SOC_ESP32P4_HPCORE && NULL_POINTER_EXCEPTION_DETECTION_PMP

configdefault CACHE_MANAGEMENT
	default y

choice CACHE_TYPE
	default EXTERNAL_CACHE if CACHE_MANAGEMENT
endchoice

config MAIN_STACK_SIZE
	default 2048

config ISR_STACK_SIZE
	default 4096

configdefault ESP32_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP
	default n if SOC_ESP32P4_REV_1_3

endif # SOC_ESP32P4_HPCORE

if SOC_ESP32P4_LPCORE

config GEN_ISR_TABLES
	default n

config SYS_CLOCK_EXISTS
	default n

config KERNEL_MEM_POOL
	default n

config COMMON_LIBC_MALLOC_ARENA_SIZE
	default 0

config MULTITHREADING
	default n

config NUM_PREEMPT_PRIORITIES
	default 0

endif
