if SOC_SERIES_ESP32C6

config NUM_IRQS
	default 32

config PMP_SLOTS
	default 16

# The core does not implement mstatus.MPRV, so unlocked PMP entries never
# apply to machine mode. The global entries stay locked to protect the
# kernel's text and rodata. The whole-address-space NAPOT entry used for
# data execution prevention does not match on this core, so it is off.
config PMP_DATA_EXECUTION_PREVENTION
	default n

config MAIN_STACK_SIZE
	default 2048

endif # SOC_SERIES_ESP32C6

if SOC_ESP32C6_LPCORE

config GEN_ISR_TABLES
	default n

config SYS_CLOCK_EXISTS
	default n

config KERNEL_MEM_POOL
	default n

config COMMON_LIBC_MALLOC_ARENA_SIZE
	default 0

config MULTITHREADING
	default n

config NUM_PREEMPT_PRIORITIES
	default 0

endif
