if SOC_SERIES_ESP32

config BOOTLOADER_MCUBOOT
	default y if SOC_ESP32_APPCPU

config MAIN_STACK_SIZE
	default 2048

config BUILD_OUTPUT_UF2_FAMILY_ID
	default "0x1c5f21b0"

config SHARED_IRQ_MAX_NUM_CLIENTS
	default 10

if SMP

config SCHED_CPU_MASK
	default y if SCHED_SIMPLE

config MP_MAX_NUM_CPUS
	default 2

endif # SMP config

if GDBSTUB

# ESP32 GDB expects 420 bytes G-packet.
# So double for hexadecimal digits.
config GDBSTUB_BUF_SZ
	default 840 if GDBSTUB

endif # GDBSTUB config

if PM && TICKLESS_KERNEL

choice XTENSA_TIMER_LPM_TIMER
	default XTENSA_TIMER_LPM_TIMER_HOOK
endchoice

endif # PM && TICKLESS_KERNEL

# Multi-level interrupt hierarchy
#   L1 = intc     : CPU interrupt lines
#   L2 = intmux   : interrupt matrix as one aggregator, slot = 32 + source
#   L3 = rtc_intc : RTC_CNTL status bits sharing RTC_CORE_INTR_SOURCE
#
# _sw_isr_table: 32 + 69 + 16 = 117 entries. On Xtensa NUM_IRQS is the
# CONFIG_NUM_IRQS macro in <zephyr/arch/xtensa/irq.h>, derived from the values
# below.

config MULTI_LEVEL_INTERRUPTS
	default y

config 2ND_LEVEL_INTERRUPTS
	default y

config 1ST_LEVEL_INTERRUPT_BITS
	default 8

config 2ND_LEVEL_INTERRUPT_BITS
	default 8

config 2ND_LVL_ISR_TBL_OFFSET
	default 32

# The whole interrupt matrix is one aggregator whose window is indexed by the
# INTMUX source, so it must span every source (MAX_INTR_SOURCE).
config MAX_IRQ_PER_2ND_LEVEL_AGGREGATOR
	default 69

config NUM_2ND_LEVEL_AGGREGATORS
	default 1

# Key line of intmux, the "interrupts" line of the intmux node. Line 6 is the
# internal CPU timer line, so no matrix source is ever routed to it.
config 2ND_LVL_INTR_00_OFFSET
	default 6

# Level-3: the RTC_CNTL peripherals share RTC_CORE_INTR_SOURCE and are demuxed
# by rtc_intc (see the SoC dtsi). Window base is the end of the level-2 window.
config 3RD_LEVEL_INTERRUPTS
	default y

config 3RD_LEVEL_INTERRUPT_BITS
	default 8

config NUM_3RD_LEVEL_AGGREGATORS
	default 1

config 3RD_LVL_INTR_00_OFFSET
	default 46	# RTC_CORE_INTR_SOURCE, rtc_intc

config MAX_IRQ_PER_3RD_LEVEL_AGGREGATOR
	default 16

config 3RD_LVL_ISR_TBL_OFFSET
	default 101

endif # SOC_SERIES_ESP32 config

if BT_ESP32

# Temporary workaround to prevent HCI command timeouts on ESP32.
# A proper fix will be implemented in the BLE proprietary blobs.
config BT_BUF_CMD_TX_COUNT
	default 2

endif
