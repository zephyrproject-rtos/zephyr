config SOC_SERIES_ESP32C5
	select RISCV
	select RISCV_SOC_HAS_GP_RELATIVE_ADDRESSING
	select RISCV_PMP if SOC_ESP32C5_HPCORE && !MCUBOOT
	select DYNAMIC_INTERRUPTS if SOC_ESP32C5_HPCORE
	select CLOCK_CONTROL if SOC_ESP32C5_HPCORE
	select PINCTRL if SOC_ESP32C5_HPCORE
	select HAS_ESPRESSIF_HAL
	select CPU_HAS_DCACHE if SOC_ESP32C5_HPCORE
	select HAS_PM
	select HAS_POWEROFF
	select SOC_HAS_TIMING_FUNCTIONS if SOC_ESP32C5_HPCORE

if SOC_SERIES_ESP32C5

rsource "Kconfig.caps"

endif # SOC_SERIES_ESP32C5
