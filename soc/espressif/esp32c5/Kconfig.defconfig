if SOC_SERIES_ESP32C5

configdefault CACHE_MANAGEMENT
	default y

choice CACHE_TYPE
	default EXTERNAL_CACHE if CACHE_MANAGEMENT
endchoice

# HP core uses the multi-level/INTMUX model. With RISCV_RESERVED_IRQ_ISR_TABLES_OFFSET
# = 16, CPU lines occupy table slots 16..47, so the source window starts at 48;
# NUM_IRQS = 48 + ETS_MAX_INTR_SOURCE (84). The LP core keeps the flat model.
config NUM_IRQS
	default 132 if SOC_ESP32C5_HPCORE
	default 48

config RISCV_MCAUSE_EXCEPTION_MASK
	default 0xFFF

config RISCV_RESERVED_IRQ_ISR_TABLES_OFFSET
	default 16

config RISCV_SOC_CONTEXT_SAVE
	default y

config RISCV_ALWAYS_SWITCH_THROUGH_ECALL
	default y if MULTITHREADING

config RISCV_SOC_HAS_SYSCALL_INTMASK
	default y if SOC_ESP32C5_HPCORE && USERSPACE && RISCV_SOC_CONTEXT_SAVE && \
		RISCV_ALWAYS_SWITCH_THROUGH_ECALL

config RISCV_USER_STRING_NLEN_VALIDATE
	default y if SOC_ESP32C5_HPCORE && USERSPACE

config RISCV_SOC_SYSCALL_CLOSE_ECALL
	default y if SOC_ESP32C5_HPCORE && USERSPACE

config PMP_SLOTS
	default 16

config PMP_GRANULARITY
	default 128 if SOC_ESP32C5_HPCORE && RISCV_PMP

config NULL_POINTER_EXCEPTION_REGION_SIZE
	default 0x80 if SOC_ESP32C5_HPCORE && NULL_POINTER_EXCEPTION_DETECTION_PMP

# ESP32-C5 uses MMU to map flash to virtual addresses for code execution.
# The PMP init code runs from IRAM while the main rom region is in flash.
# Locked PMP entries would block IRAM execution before proper coverage is set.
# Use unlocked entries with MPRV-based enforcement instead.
config PMP_NO_LOCK_GLOBAL
	default y

config MAIN_STACK_SIZE
	default 2048

endif # SOC_SERIES_ESP32C5

if SOC_ESP32C5_HPCORE

# Multi-level interrupts: L1 = intc (CPU lines, slot = 16 + line), L2 = intmux
# (the interrupt matrix as one aggregator, slot = 48 + source).
config MULTI_LEVEL_INTERRUPTS
	default y

config 2ND_LEVEL_INTERRUPTS
	default y

config 1ST_LEVEL_INTERRUPT_BITS
	default 8

config 2ND_LEVEL_INTERRUPT_BITS
	default 8

config 2ND_LVL_ISR_TBL_OFFSET
	default 48

# Key line of intmux, the "interrupts" line of the intmux node. Line 6 is
# permanently disabled, so no matrix source is ever routed to it. The level-1
# IRQ number carries no reserved-IRQ offset; only the table slots do.
config 2ND_LVL_INTR_00_OFFSET
	default 6

config MAX_IRQ_PER_2ND_LEVEL_AGGREGATOR
	default 84

config NUM_2ND_LEVEL_AGGREGATORS
	default 1

endif # SOC_ESP32C5_HPCORE

if SOC_ESP32C5_LPCORE

config GEN_ISR_TABLES
	default n

config SYS_CLOCK_EXISTS
	default n

config KERNEL_MEM_POOL
	default n

config COMMON_LIBC_MALLOC_ARENA_SIZE
	default 0

config MULTITHREADING
	default n

config NUM_PREEMPT_PRIORITIES
	default 0

endif
