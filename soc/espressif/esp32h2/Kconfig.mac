if SOC_SERIES_ESP32H2

choice SOC_ESP32H2_UNIVERSAL_MAC_ADDRESSES
	bool "Number of universally administered (by IEEE) MAC address"
	default SOC_ESP32H2_UNIVERSAL_MAC_ADDRESSES_TWO
	help
	  Configure the number of universally administered (by IEEE) MAC addresses.
	  During initialization, MAC addresses for each network interface are generated
	  or derived from a single base MAC address.

config SOC_ESP32H2_UNIVERSAL_MAC_ADDRESSES_TWO
	bool "Two"
	select SOC_FAMILY_ESP32_MAC_ADDRESSES_TWO
	select SOC_FAMILY_ESP32_MAC_ADDR_UNIVERSE_IEEE802154
	select SOC_FAMILY_ESP32_MAC_ADDR_UNIVERSE_BT

endchoice # SOC_ESP32H2_UNIVERSAL_MAC_ADDRESSES

config SOC_ESP32H2_UNIVERSAL_MAC_ADDRESSES
	int
	default 2 if SOC_ESP32H2_UNIVERSAL_MAC_ADDRESSES_TWO

endif # SOC_SERIES_ESP32H2
