if SOC_SERIES_ESP32S31

configdefault FPU
	default y if SOC_ESP32S31_HPCORE

configdefault RISCV_IMPRECISE_FPU_STATE_TRACKING
	default y

configdefault CACHE_MANAGEMENT
	default y

choice CACHE_TYPE
	default EXTERNAL_CACHE if CACHE_MANAGEMENT
endchoice

configdefault NUM_IRQS
	default 48

configdefault RISCV_MCAUSE_EXCEPTION_MASK
	default 0xFFF

configdefault RISCV_RESERVED_IRQ_ISR_TABLES_OFFSET
	default 16

configdefault RISCV_SOC_CONTEXT_SAVE
	default y

configdefault RISCV_ALWAYS_SWITCH_THROUGH_ECALL
	default y if MULTITHREADING

configdefault RISCV_SOC_HAS_SYSCALL_INTMASK
	default y if SOC_ESP32S31_HPCORE && USERSPACE && RISCV_SOC_CONTEXT_SAVE && \
		RISCV_ALWAYS_SWITCH_THROUGH_ECALL

configdefault RISCV_USER_STRING_NLEN_VALIDATE
	default y if SOC_ESP32S31_HPCORE && USERSPACE

configdefault RISCV_SOC_SYSCALL_CLOSE_ECALL
	default y if SOC_ESP32S31_HPCORE && USERSPACE

configdefault PMP_SLOTS
	default 16

configdefault PMP_GRANULARITY
	default 128 if SOC_ESP32S31_HPCORE && RISCV_PMP

configdefault NULL_POINTER_EXCEPTION_REGION_SIZE
	default 0x80 if SOC_ESP32S31_HPCORE && NULL_POINTER_EXCEPTION_DETECTION_PMP

# ESP32-S31 uses MMU to map flash to virtual addresses for code execution.
# The PMP init code runs from IRAM while the main rom region is in flash.
# Locked PMP entries would block IRAM execution before proper coverage is set.
# Use unlocked entries with MPRV-based enforcement instead.
configdefault PMP_NO_LOCK_GLOBAL
	default y

configdefault MAIN_STACK_SIZE
	default 2048

endif # SOC_SERIES_ESP32S31

if SOC_ESP32S31_LPCORE

configdefault GEN_ISR_TABLES
	default n

configdefault SYS_CLOCK_EXISTS
	default n

configdefault KERNEL_MEM_POOL
	default n

configdefault COMMON_LIBC_MALLOC_ARENA_SIZE
	default 0

configdefault MULTITHREADING
	default n

configdefault NUM_PREEMPT_PRIORITIES
	default 0

endif
