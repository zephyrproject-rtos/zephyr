if SOC_SERIES_ESP32C61

configdefault CACHE_MANAGEMENT
	default y

choice CACHE_TYPE
	default EXTERNAL_CACHE if CACHE_MANAGEMENT
endchoice

# The HP core uses the multi-level/INTMUX model. With
# RISCV_RESERVED_IRQ_ISR_TABLES_OFFSET = 16, CPU lines occupy table slots
# 16..47, so the source window starts at 48; NUM_IRQS = 48 + ETS_MAX_INTR_SOURCE (66).
config NUM_IRQS
	default 114

config RISCV_MCAUSE_EXCEPTION_MASK
	default 0xFFF

config RISCV_RESERVED_IRQ_ISR_TABLES_OFFSET
	default 16

config RISCV_SOC_CONTEXT_SAVE
	default y

config RISCV_ALWAYS_SWITCH_THROUGH_ECALL
	default y if MULTITHREADING

config PMP_SLOTS
	default 16

# ESP32-C61 uses MMU to map flash to virtual addresses for code execution.
# The PMP init code runs from IRAM while the main rom region is in flash.
# Locked PMP entries would block IRAM execution before proper coverage is set.
# Use unlocked entries with MPRV-based enforcement instead.
config PMP_NO_LOCK_GLOBAL
	default y

config MAIN_STACK_SIZE
	default 2048

# Multi-level interrupts: L1 = intc (CPU line), L2 = cpu_interrupt_<N>
# (INTMUX source -> CPU line). One flat 2nd-level aggregator spanning every
# source.
config MULTI_LEVEL_INTERRUPTS
	default y

config 2ND_LEVEL_INTERRUPTS
	default y

config 1ST_LEVEL_INTERRUPT_BITS
	default 8

config 2ND_LEVEL_INTERRUPT_BITS
	default 8

config 2ND_LVL_ISR_TBL_OFFSET
	default 48

config 2ND_LVL_INTR_00_OFFSET
	default 48

config MAX_IRQ_PER_2ND_LEVEL_AGGREGATOR
	default 66

config NUM_2ND_LEVEL_AGGREGATORS
	default 1

# That single aggregator is the interrupt matrix, so its window is indexed by
# the source number rather than by an aggregator slot.
config INTERRUPT_MATRIX_LAYOUT
	default y

endif # SOC_SERIES_ESP32C61
