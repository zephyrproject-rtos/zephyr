if SOC_SERIES_ESP32C61

configdefault CACHE_MANAGEMENT
	default y

choice CACHE_TYPE
	default EXTERNAL_CACHE if CACHE_MANAGEMENT
endchoice

config NUM_IRQS
	default 48

config RISCV_MCAUSE_EXCEPTION_MASK
	default 0xFFF

config RISCV_RESERVED_IRQ_ISR_TABLES_OFFSET
	default 16

config RISCV_SOC_CONTEXT_SAVE
	default y

config RISCV_ALWAYS_SWITCH_THROUGH_ECALL
	default y if MULTITHREADING

config PMP_SLOTS
	default 16

# ESP32-C61 uses MMU to map flash to virtual addresses for code execution.
# The PMP init code runs from IRAM while the main rom region is in flash.
# Locked PMP entries would block IRAM execution before proper coverage is set.
# Use unlocked entries with MPRV-based enforcement instead.
config PMP_NO_LOCK_GLOBAL
	default y

config MAIN_STACK_SIZE
	default 2048

endif # SOC_SERIES_ESP32C61
