menu "Deprecated options"

config BOOTLOADER_FLASH_XMC_SUPPORT
	bool "Support flash chips of XMC (READ HELP FIRST) [DEPRECATED]"
	default y
	help
	  Deprecated. Use SOC_FAMILY_ESPRESSIF_BOOTLOADER_FLASH_XMC_SUPPORT instead.

config BOOTLOADER_REGION_PROTECTION_ENABLE
	bool "Protect unmapped memory regions from unintended accesses [DEPRECATED]"
	default y if !RISCV_PMP && BOOTLOADER_MCUBOOT
	imply SOC_FAMILY_ESPRESSIF_BOOTLOADER_REGION_PROTECTION_ENABLE if !(!RISCV_PMP && \
		BOOTLOADER_MCUBOOT)
	help
	  Deprecated. Use SOC_FAMILY_ESPRESSIF_BOOTLOADER_REGION_PROTECTION_ENABLE instead.

config BOOTLOADER_VDDSDIO_BOOST_1_8V
	bool "1.8V [DEPRECATED]"
	depends on (SOC_SERIES_ESP32 || SOC_SERIES_ESP32S2 || \
		SOC_SERIES_ESP32S3) && !SOC_FAMILY_ESPRESSIF_FLASH_FREQ_80M
	select DEPRECATED
	help
	  Deprecated. Use SOC_FAMILY_ESPRESSIF_BOOTLOADER_VDDSDIO_BOOST_1_8V instead.

