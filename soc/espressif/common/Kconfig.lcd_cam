config ESP32_LCD_CAM
	bool
	default y if DT_HAS_ESPRESSIF_ESP32_LCD_CAM_DVP_ENABLED
	default y if DT_HAS_ESPRESSIF_ESP32_LCD_CAM_MIPI_DBI_ENABLED
	depends on DT_HAS_ESPRESSIF_ESP32_LCD_CAM_ENABLED

configdefault VIDEO_BUFFER_SMH_ATTRIBUTE
	default 2 if ESP_SPIRAM # SMH_REG_ATTR_EXTERNAL

configdefault VIDEO_BUFFER_POOL_ZEPHYR_REGION
	default y

configdefault VIDEO_BUFFER_POOL_ZEPHYR_REGION_NAME
	default ".ext_ram_noinit.video"

configdefault DMA_ESP32_MAX_DESCRIPTOR_NUM
	default 64
