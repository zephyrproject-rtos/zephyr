# The I2S camera driver fills the video buffers with the CPU, so they go to
# PSRAM when it is available. Kconfig.lcd_cam sets the same default for every
# Espressif SoC, but that one belongs to the LCD_CAM.
if VIDEO_ESP32_I2S_CAM && ESP_SPIRAM

configdefault VIDEO_BUFFER_SMH_ATTRIBUTE
	default 2 # SMH_REG_ATTR_EXTERNAL

endif # VIDEO_ESP32_I2S_CAM && ESP_SPIRAM
