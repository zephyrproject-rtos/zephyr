choice SOC_FAMILY_ESPRESSIF_TIMER_TASK_CORE
	prompt "esp_timer task core"
	depends on SMP && SCHED_CPU_MASK
	default SOC_FAMILY_ESPRESSIF_TIMER_TASK_PINNED_TO_CORE_1 if ESP32_WIFI_TASK_PINNED_TO_CORE_1
	default SOC_FAMILY_ESPRESSIF_TIMER_TASK_PINNED_TO_CORE_0
	help
	  Core the esp_timer dispatch task is pinned to under SMP. esp_timer
	  callbacks drive Wi-Fi housekeeping, so the task should share the
	  core where the Wi-Fi task runs to avoid cross-core wakeups and lock
	  contention.

config SOC_FAMILY_ESPRESSIF_TIMER_TASK_PINNED_TO_CORE_0
	bool "Core 0"

config SOC_FAMILY_ESPRESSIF_TIMER_TASK_PINNED_TO_CORE_1
	bool "Core 1"
	depends on MP_MAX_NUM_CPUS > 1

endchoice # SOC_FAMILY_ESPRESSIF_TIMER_TASK_CORE

config SOC_FAMILY_ESPRESSIF_TIMER_TASK_CORE_ID
	int
	default 1 if SOC_FAMILY_ESPRESSIF_TIMER_TASK_PINNED_TO_CORE_1
	default 0
	help
	  Resolved core id for the esp_timer task (0 or 1). Consumed by the
	  esp_timer task-create path to pin the task.
