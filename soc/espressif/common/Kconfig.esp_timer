choice SOC_ESP32_TIMER_TASK_CORE
	prompt "esp_timer task core"
	depends on SMP && SCHED_CPU_MASK
	default SOC_ESP32_TIMER_TASK_PINNED_TO_CORE_0
	help
	  Core the esp_timer dispatch task is pinned to under SMP. esp_timer
	  callbacks drive Wi-Fi and BLE housekeeping, so the task should share
	  the core where those stacks run (core 0 by default) to avoid
	  cross-core wakeups and lock contention.

config SOC_ESP32_TIMER_TASK_PINNED_TO_CORE_0
	bool "Core 0"

config SOC_ESP32_TIMER_TASK_PINNED_TO_CORE_1
	bool "Core 1"

endchoice # SOC_ESP32_TIMER_TASK_CORE

config SOC_ESP32_TIMER_TASK_CORE_ID
	int
	default 1 if SOC_ESP32_TIMER_TASK_PINNED_TO_CORE_1
	default 0
	help
	  Resolved core id for the esp_timer task (0 or 1). Consumed by the
	  esp_timer task-create path to pin the task.

config ESP32_TIMER_IN_IRAM
	bool
	help
	  Place the esp_timer arm, disarm and time query paths in IRAM so
	  they can run while the flash cache is suspended. Selected by the
	  light sleep IRAM option and enabled for SMP builds, where the radio
	  blobs call these from IRAM interrupt handlers on a core that may be
	  parked during a flash operation on the other core.
