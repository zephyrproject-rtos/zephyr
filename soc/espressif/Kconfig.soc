config SOC_FAMILY_ESPRESSIF
	bool

config SOC_FAMILY_ESPRESSIF_ESP32
	bool
	default y
	depends on SOC_FAMILY_ESPRESSIF
	help
	  Deprecated. Use SOC_FAMILY_ESPRESSIF instead.

config SOC_FAMILY
	default "espressif" if SOC_FAMILY_ESPRESSIF

rsource "*/Kconfig.soc"
