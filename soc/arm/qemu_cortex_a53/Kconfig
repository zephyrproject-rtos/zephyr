config SOC_QEMU_CORTEX_A53
	select ARM64 if QEMU_CORTEX_A53_EXECUTION_STATE_AARCH64
	select CPU_CORTEX_A53 if QEMU_CORTEX_A53_EXECUTION_STATE_AARCH64
	select ARM if QEMU_CORTEX_A53_EXECUTION_STATE_AARCH32
	select CPU_CORTEX_A53_AARCH32 if QEMU_CORTEX_A53_EXECUTION_STATE_AARCH32
	select QEMU_TARGET
