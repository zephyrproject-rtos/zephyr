config QEMU_CORTEX_A53_EXECUTION_STATE_AARCH64
	bool
	default y if !QEMU_CORTEX_A53_EXECUTION_STATE_AARCH32

config QEMU_CORTEX_A53_EXECUTION_STATE_AARCH32
	bool

config SOC_QEMU_CORTEX_A53
	bool
	select SOC_FAMILY_ARM64 if QEMU_CORTEX_A53_EXECUTION_STATE_AARCH64
	select SOC_FAMILY_ARM if QEMU_CORTEX_A53_EXECUTION_STATE_AARCH32

config SOC
	default "qemu_cortex_a53" if SOC_QEMU_CORTEX_A53
