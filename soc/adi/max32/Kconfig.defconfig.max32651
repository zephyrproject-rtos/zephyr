if SOC_MAX32651

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/clocks/clk_ipo,clock-frequency)

choice SOC_FAMILY_MAX32_SECURE_SOC_SIGNING_ALGO
	default SOC_FAMILY_MAX32_SECURE_SOC_SIGNING_ALGO_RSA2048
endchoice

endif # SOC_MAX32651
