rsource "*/Kconfig.defconfig"

if SOC_FAMILY_SILABS_S2 || SOC_FAMILY_SILABS_S3

configdefault SILABS_SISDK_RAIL_MULTIPROTOCOL
	default y if BT_SILABS_EFR32 && IEEE802154_SILABS_EFR32

if NET_L2_PHY_IEEE802154

configdefault NET_PKT_RX_COUNT
	default 16

configdefault NET_PKT_TX_COUNT
	default 16

configdefault NET_BUF_RX_COUNT
	default 64

configdefault NET_BUF_TX_COUNT
	default 64

endif

if OPENTHREAD

choice OPENTHREAD_IMPLEMENTATION
	default OPENTHREAD_SOURCES
endchoice

choice OPENTHREAD_STACK_VERSION
	default OPENTHREAD_THREAD_VERSION_1_4
endchoice

configdefault OPENTHREAD_MANUAL_START
	default y

configdefault OPENTHREAD_RADIO_WORKQUEUE_STACK_SIZE
	default 2048

configdefault OPENTHREAD_MAC_SOFTWARE_CSMA_BACKOFF_ENABLE
	default n

configdefault OPENTHREAD_MIN_RECEIVE_ON_AFTER
	default 0

configdefault OPENTHREAD_MAC_SOFTWARE_TX_SECURITY_ENABLE
	default n

configdefault OPENTHREAD_IP6_MAX_EXT_MCAST_ADDRS
	default 4

configdefault OPENTHREAD_DNS_CLIENT
	default y

configdefault OPENTHREAD_DUA
	default y

configdefault OPENTHREAD_EXTERNAL_HEAP
	default y

configdefault OPENTHREAD_LINK_METRICS_INITIATOR
	default y

configdefault OPENTHREAD_LINK_METRICS_SUBJECT
	default y

configdefault OPENTHREAD_MAC_BEACON_PAYLOAD_PARSING
	default y

configdefault OPENTHREAD_MLR
	default y

configdefault OPENTHREAD_MULTIPLE_INSTANCE_NUM
	default 2

configdefault OPENTHREAD_NETDIAG_CLIENT
	default y

configdefault OPENTHREAD_PING_SENDER
	default y

configdefault OPENTHREAD_SLAAC
	default y

configdefault OPENTHREAD_SRP_CLIENT
	default y

configdefault OPENTHREAD_UPTIME
	default y if OPENTHREAD_FTD || OPENTHREAD_MTD

configdefault OPENTHREAD_CSL_AUTO_SYNC
	default y

configdefault NET_PKT_TIMESTAMP
	default y

configdefault NET_PKT_TXTIME
	default y

configdefault OPENTHREAD_CSL_RECEIVE_TIME_AHEAD
	default 1000 if SILABS_SISDK_RAIL_MULTIPROTOCOL
	default 600

configdefault OPENTHREAD_PLATFORM_CSL_UNCERT
	default 175 if OPENTHREAD_REFERENCE_DEVICE
	default 20 if OPENTHREAD_FTD
	default 12

if OPENTHREAD_COMMISSIONER

configdefault MBEDTLS_HEAP_SIZE
	default 16384

endif

endif

endif

if SOC_FAMILY_SILABS_S0 || SOC_FAMILY_SILABS_S1

config SILABS_GECKO_EMU
	default y
	select SILABS_GECKO_CORE
	depends on PM

config CORTEX_M_SYSTICK
	default n if GECKO_BURTC_TIMER

endif

if SOC_FAMILY_SILABS_S2 || SOC_FAMILY_SILABS_S3

configdefault TF_PSA_CRYPTO_DISPATCH_DIR
	default "${ZEPHYR_HAL_SILABS_MODULE_DIR}/simplicity_sdk/util/third_party/mbedtls/dispatch" \
		if SILABS_SISDK_PSA_CRYPTO

configdefault TF_PSA_CRYPTO_DRIVER_CONFIG_FILE
	default "sl_psa_crypto_config_zephyr.h" if SILABS_SISDK_PSA_CRYPTO

endif
