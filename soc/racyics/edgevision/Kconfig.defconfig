if SOC_EDGEVISION

configdefault INCLUDE_RESET_VECTOR
	default y

configdefault GEN_IRQ_VECTOR_TABLE
	default y

configdefault NUM_IRQS
	default 32

configdefault DYNAMIC_INTERRUPTS
	default y

configdefault GEN_ISR_TABLES
	default y

configdefault SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency) if CORTEX_M_SYSTICK

configdefault SYS_CLOCK_TICKS_PER_SEC
	default 1000

configdefault USE_DT_CODE_PARTITION
	default y

configdefault INIT_STACKS
	default y

endif
