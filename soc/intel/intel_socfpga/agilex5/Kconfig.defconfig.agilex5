if SOC_AGILEX5

# must be >= the highest interrupt number used
# - include the UART interrupts 173 or 274
config NUM_IRQS
	default 274

config KERNEL_VM_SIZE
	default 0x400000

# Syscon (sysmgr) must be ready before the Agilex5 clock driver, which
# reads boot-scratch registers through it during get_rate().
config SYSCON_INIT_PRIORITY
	default 20
endif
