if SOC_FAMILY_MICROCHIP_PIC32CK_SG_GC

config NUM_IRQS
	default 158

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency)

config ARM_TRUSTZONE_M
	default y
	depends on SOC_SERIES_PIC32CK_SG00 || SOC_SERIES_PIC32CK_SG01

config CPU_HAS_ARM_SAU
	default y
	depends on SOC_SERIES_PIC32CK_SG00 || SOC_SERIES_PIC32CK_SG01

endif # SOC_FAMILY_MICROCHIP_PIC32CK_SG_GC
