if SOC_FAMILY_MICROCHIP_PIC32CM_SG_GC

config NUM_IRQS
	default 141

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency)

# When running under MCUboot, each application image is self-contained
# in PFM (flash0) with its own vector table. The ROM_START_OFFSET
# reserves space for the MCUboot image header.
# 0x400 (1024 bytes) is required because VTOR alignment on Cortex-M23
# with NUM_IRQS=141 needs next_power_of_2((16+141)*4) = 1024.
# ROMSTART_RELOCATION_ROM must be disabled so the vector table lives
# in FLASH (PFM) rather than being relocated to BFM.
config ROM_START_OFFSET
	default 0x400 if BOOTLOADER_MCUBOOT && !MCUBOOT

config ROMSTART_RELOCATION_ROM
	default n if BOOTLOADER_MCUBOOT || MCUBOOT
	default y

config ROMSTART_REGION_ADDRESS
	default $(dt_nodelabel_reg_addr_hex,flash0)

config ROMSTART_REGION_SIZE
	default $(dt_nodelabel_reg_size_hex,flash0,0,k)

config ARM_TRUSTZONE_M
	default y
	depends on SOC_SERIES_PIC32CM_SG00

endif # SOC_FAMILY_MICROCHIP_PIC32CM_SG_GC
