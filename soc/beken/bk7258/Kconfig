# Dependency declarations for the BK7258 series: select only, no type and
# no help. The visible symbols and their defaults live in Kconfig.soc and
# Kconfig.defconfig.

config SOC_SERIES_BK7258
	# BK7236 is the same die with the multimedia interfaces removed, so it
	# belongs to this series as well.
	select SOC_FAMILY_BEKEN_ARM

	# CPU_CORTEX_M33 already selects CPU_CORTEX_M and ARMV8_M_MAINLINE
	# itself, so they are not repeated here.
	select CPU_CORTEX_M33

	# CPU_CORTEX_M only selects CPU_CORTEX, so ARM has to be pulled in here.
	select ARM

	# TrustZone-M is deliberately not selected. This core runs in the
	# TrustZone secure state (the vendor's reference configuration sets
	# SPE=1) but does not manage the secure/non-secure split, so nothing
	# has to be programmed for it; ARM_TRUSTZONE_M in Zephyr means the
	# latter.

config SOC_BK7258
	select SOC_SERIES_BK7258

# Generates SOC_BK7258_LOG_LEVEL for LOG_MODULE_REGISTER() in soc.c and
# soc_ipc.c.
module = SOC_BK7258
module-str = SOC_BK7258
source "subsys/logging/Kconfig.template.log_config"
