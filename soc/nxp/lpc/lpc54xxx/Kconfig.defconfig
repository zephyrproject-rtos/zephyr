# NXP LPC54114 M0 platform configuration options

# Copyright 2017, 2024 NXP
# SPDX-License-Identifier: Apache-2.0

if SOC_SERIES_LPC54XXX

config GPIO
	default n if SOC_LPC54114_M0

config NUM_IRQS
	# must be >= the highest interrupt number used
	default 57 if SOC_LPC54628
	default 40

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency) if SOC_LPC54628

endif # SOC_SERIES_LPC54XXX
