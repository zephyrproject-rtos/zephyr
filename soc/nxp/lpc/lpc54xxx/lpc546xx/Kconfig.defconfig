if SOC_LPC54628

config NUM_IRQS
	# must be >= the highest interrupt number used
	default 57

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency)

endif # SOC_LPC54628
