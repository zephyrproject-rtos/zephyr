if(SB_CONFIG_SECOND_CORE_MCUX_LAUNCHER)
  # CPU0 is the boot core, and will start the secondary core.
  set(launcher_core "cm33_cpu0")
  set(launcher_soc "${SB_CONFIG_SOC}")

  # The board selects the XSPI0 flash part by revision, and the launcher is the
  # image that owns that flash, so it has to keep the revision the user asked
  # for instead of falling back to the board default.
  if(DEFINED BOARD_REVISION)
    set(launcher_name "${BOARD}@${BOARD_REVISION}")
  else()
    set(launcher_name "${BOARD}")
  endif()

  string(CONCAT launcher_board ${launcher_name} "/" ${launcher_soc} "/" ${launcher_core})

  set(launcher_image "cpu0_launcher")

  ExternalZephyrProject_Add(
    APPLICATION ${launcher_image}
    SOURCE_DIR ${ZEPHYR_BASE}/samples/basic/minimal
    BOARD ${launcher_board}
  )

  set(remote_dir "${APPLICATION_BINARY_DIR}/${DEFAULT_IMAGE}/zephyr/include/public")

  # Enable CONFIG_SECOND_CORE_MCUX and CONFIG_BUILD_OUTPUT_HEX for the
  # application running on the CPU1 core.
  set_config_bool(${DEFAULT_IMAGE} CONFIG_SECOND_CORE_MCUX 1)
  set_config_bool(${DEFAULT_IMAGE} CONFIG_BUILD_OUTPUT_HEX 1)

  # Enable CONFIG_SECOND_CORE_MCUX for the image running on the CPU0 core, and
  # point it at the image header output by the CPU1 image.
  set_config_bool(${launcher_image} CONFIG_SECOND_CORE_MCUX 1)
  set_config_string(${launcher_image} CONFIG_SECOND_CORE_MCUX_REMOTE_DIR ${remote_dir})

  # CPU0 includes a header generated by the CPU1 image, so build CPU1 first.
  add_dependencies(${launcher_image} ${DEFAULT_IMAGE})
  sysbuild_add_dependencies(CONFIGURE ${launcher_image} ${DEFAULT_IMAGE})
endif()
