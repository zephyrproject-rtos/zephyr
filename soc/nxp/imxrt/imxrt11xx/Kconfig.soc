	default "MIMXRT1152AVM6B" if SOC_PART_NUMBER_MIMXRT1152AVM6B
	default "MIMXRT1152DHM8B" if SOC_PART_NUMBER_MIMXRT1152DHM8B
	default "MIMXRT1152DVM8B" if SOC_PART_NUMBER_MIMXRT1152DVM8B
	default "MIMXRT1152XHM8B" if SOC_PART_NUMBER_MIMXRT1152XHM8B
	default "MIMXRT1152XVM8B" if SOC_PART_NUMBER_MIMXRT1152XVM8B
	default "MIMXRT1176AVM8A" if SOC_PART_NUMBER_MIMXRT1176AVM8A
	default "MIMXRT1176CVM8A" if SOC_PART_NUMBER_MIMXRT1176CVM8A
