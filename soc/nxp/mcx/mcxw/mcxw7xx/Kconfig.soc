config SOC_SERIES_MCXW7XX
	bool
	select SOC_FAMILY_MCXW

config SOC_SERIES
	default "mcxw7xx" if SOC_SERIES_MCXW7XX

config SOC_MCXW70AC
	bool
	select SOC_SERIES_MCXW7XX

config SOC_MCXW716C
	bool
	select SOC_SERIES_MCXW7XX

config SOC_MCXW727C
	bool
	select SOC_SERIES_MCXW7XX

config SOC
	default "mcxw70ac" if SOC_MCXW70AC
	default "mcxw716c" if SOC_MCXW716C
	default "mcxw727c" if SOC_MCXW727C

config SOC_PART_NUMBER_MCXW70ACMFT
	bool

config SOC_PART_NUMBER_MCXW70AAMFT
	bool

config SOC_PART_NUMBER_MCXW70ADMFT
	bool

config SOC_PART_NUMBER_MCXW716CMFTA
	bool

config SOC_PART_NUMBER_MCXW716CMFPA
	bool

config SOC_PART_NUMBER_MCXW716AMFTA
	bool

config SOC_PART_NUMBER_MCXW716AMFPA
	bool

config SOC_PART_NUMBER_MCXW727CMFTA
	bool

config SOC_PART_NUMBER
	default "MCXW70ACMFT"  if SOC_PART_NUMBER_MCXW70ACMFT
	default "MCXW70AAMFT"  if SOC_PART_NUMBER_MCXW70AAMFT
	default "MCXW70ADMFT"  if SOC_PART_NUMBER_MCXW70ADMFT
	default "MCXW716CMFTA" if SOC_PART_NUMBER_MCXW716CMFTA
	default "MCXW716CMFPA" if SOC_PART_NUMBER_MCXW716CMFPA
	default "MCXW716AMFTA" if SOC_PART_NUMBER_MCXW716AMFTA
	default "MCXW716AMFPA" if SOC_PART_NUMBER_MCXW716AMFPA
	default "MCXW727CMFTA" if SOC_PART_NUMBER_MCXW727CMFTA
