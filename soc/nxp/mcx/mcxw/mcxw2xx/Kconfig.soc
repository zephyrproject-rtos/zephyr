config SOC_SERIES_MCXW2XX
	bool
	select SOC_FAMILY_MCXW

config SOC_SERIES
	default "mcxw2xx" if SOC_SERIES_MCXW2XX

config SOC_MCXW236
	bool
	select SOC_SERIES_MCXW2XX

config SOC_MCXW235
	bool
	select SOC_SERIES_MCXW2XX

config SOC
	default "mcxw236" if SOC_MCXW236
	default "mcxw235" if SOC_MCXW235

config SOC_PART_NUMBER_MCXW236BIHNAR
	bool

config SOC_PART_NUMBER_MCXW236AIHNAR
	bool

config SOC_PART_NUMBER_MCXW236AIUKAR
	bool

config SOC_PART_NUMBER_MCXW236BIUKAR
	bool

config SOC_PART_NUMBER_MCXW235BIHNAR
	bool

config SOC_PART_NUMBER_MCXW235AIHNAR
	bool

config SOC_PART_NUMBER_MCXW235AIUKAR
	bool

config SOC_PART_NUMBER_MCXW235BIUKAR
	bool

config SOC_PART_NUMBER
	default "MCXW236BIHNAR" if SOC_PART_NUMBER_MCXW236BIHNAR
	default "MCXW236AIHNAR" if SOC_PART_NUMBER_MCXW236AIHNAR
	default "MCXW236AIUKAR" if SOC_PART_NUMBER_MCXW236AIUKAR
	default "MCXW236BIUKAR" if SOC_PART_NUMBER_MCXW236BIUKAR
	default "MCXW235BIHNAR" if SOC_PART_NUMBER_MCXW235BIHNAR
	default "MCXW235AIHNAR" if SOC_PART_NUMBER_MCXW235AIHNAR
	default "MCXW235AIUKAR" if SOC_PART_NUMBER_MCXW235AIUKAR
	default "MCXW235BIUKAR" if SOC_PART_NUMBER_MCXW235BIUKAR
