if SOC_SERIES_MCXE31X

DT_CHOSEN_Z_SYSTEM_TIMER := zephyr,system-timer
DT_SYSTEM_TIMER_PATH := $(dt_chosen_path,$(DT_CHOSEN_Z_SYSTEM_TIMER))

config NUM_IRQS
	default 240

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency) if CORTEX_M_SYSTICK
	# Right where the prescaler is 1; the driver asserts the two agree.
	default $(dt_node_int_prop_int,$(DT_SYSTEM_TIMER_PATH),clock-frequency) \
		if MCUX_RTC_JDP_TIMER

# 1000 ticks/sec divides the 32 kHz RTC clock without rounding.
config SYS_CLOCK_TICKS_PER_SEC
	default 1000 if MCUX_RTC_JDP_TIMER

config CORTEX_M_SYSTICK
	default n if (MCUX_LPTMR_TIMER || MCUX_OS_TIMER || MCUX_STM_TIMER || MCUX_RTC_JDP_TIMER)

config ROM_START_OFFSET
	default 0x1000

# The MC_CGM clock driver cannot program an audio PLL; the SAI driver
# derives the bit clock from the SAI module clock instead.
config I2S_HAS_PLL_SETTING
	default n

endif # SOC_SERIES_MCXE31X
