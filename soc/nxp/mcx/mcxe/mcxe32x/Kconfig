config SOC_SERIES_MCXE32X
	select CPU_CORTEX_M7
	select CPU_CORTEX_M_HAS_DWT
	select CPU_HAS_FPU
	select CPU_HAS_ARM_MPU
	select ARM
	select HAS_MCUX
	select CPU_HAS_ICACHE
	select CPU_HAS_DCACHE
	select SOC_EARLY_RESET_HOOK
	select CODE_DATA_RELOCATION
	select SPI_NXP_LPSPI_ERR050456 if SPI_NXP_LPSPI

config SOC_MCXE32B_CPU0
	select CLOCK_CONTROL
	select SOC_EARLY_INIT_HOOK
	select SOC_LATE_INIT_HOOK
	select HAS_POWEROFF

if SOC_SERIES_MCXE32X

config MCUX_CORE_SUFFIX
	default "_core0" if SOC_MCXE32B_CPU0
	default "_core1" if SOC_MCXE32B_CPU1

if CODE_DATA_RELOCATION

config SRAM_CONFIG_RELOCATE_MEM
	string
	default "ITCM"
	help
	  Select memory to relocate sram_config.c code

endif # CODE_DATA_RELOCATION

config SOC_NXP_MCXE32X_BOOT_HEADER
	bool
	help
	  Enable boot header configuration for NXP MCXE32X SoC.
	  This should be selected by boards that need boot header support.

if SOC_NXP_MCXE32X_BOOT_HEADER

config BOOT_HEADER_OFFSET
	hex "Flash config data offset"
	default 0x0

config IMAGE_VECTOR_TABLE_OFFSET
	hex "Image vector table offset"
	default 0x1000

endif # SOC_NXP_MCXE32X_BOOT_HEADER

endif # SOC_SERIES_MCXE32X
