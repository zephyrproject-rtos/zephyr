if SOC_SERIES_MCXE32X

config NUM_IRQS
	default 240

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency) if CORTEX_M_SYSTICK && SOC_MCXE32B_CPU0
	default $(dt_node_int_prop_int,/cpus/cpu@1,clock-frequency) if CORTEX_M_SYSTICK && SOC_MCXE32B_CPU1

config SYS_CLOCK_TICKS_PER_SEC
	default 1000 if MCUX_RTC_JDP_TIMER

config CORTEX_M_SYSTICK
	default n if (MCUX_LPTMR_TIMER || MCUX_OS_TIMER || MCUX_STM_TIMER || MCUX_RTC_JDP_TIMER)

config ROM_START_OFFSET
	default 0x1000

config I2S_HAS_PLL_SETTING
	default n

endif # SOC_SERIES_MCXE32X
