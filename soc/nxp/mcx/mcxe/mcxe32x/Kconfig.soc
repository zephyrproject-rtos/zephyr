config SOC_SERIES_MCXE32X
	bool
	select SOC_FAMILY_MCXE

config SOC_SERIES
	default "mcxe32x" if SOC_SERIES_MCXE32X

config SOC_MCXE32B_CPU0
	bool
	select SOC_SERIES_MCXE32X

config SOC_MCXE32B_CPU1
	bool
	select SOC_SERIES_MCXE32X

config SOC
	default "mcxe32b" if SOC_MCXE32B_CPU0 || SOC_MCXE32B_CPU1

config SOC_PART_NUMBER_MCXE32BMPB
	bool
	select SOC_MCXE32B_CPU0 if BOARD_FRDM_MCXE32B_MCXE32B_CPU0
	select SOC_MCXE32B_CPU1 if BOARD_FRDM_MCXE32B_MCXE32B_CPU1

config SOC_PART_NUMBER
	default "MCXE32BMPB" if SOC_PART_NUMBER_MCXE32BMPB
