config SOC_FAMILY_MCXC
	bool

config SOC_FAMILY
	default "mcxc" if SOC_FAMILY_MCXC

config SOC_MCXC141
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC142
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC143
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC144
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC242
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC243
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC244
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC443
	bool
	select SOC_FAMILY_MCXC

config SOC_MCXC444
	bool
	select SOC_FAMILY_MCXC

config SOC
	default "mcxc141" if SOC_MCXC141
	default "mcxc142" if SOC_MCXC142
	default "mcxc143" if SOC_MCXC143
	default "mcxc144" if SOC_MCXC144
	default "mcxc242" if SOC_MCXC242
	default "mcxc243" if SOC_MCXC243
	default "mcxc244" if SOC_MCXC244
	default "mcxc443" if SOC_MCXC443
	default "mcxc444" if SOC_MCXC444

config SOC_PART_NUMBER_MCXC141VLH
	bool
	select SOC_MCXC141

config SOC_PART_NUMBER_MCXC141VFM
	bool
	select SOC_MCXC141

config SOC_PART_NUMBER_MCXC142VFM
	bool
	select SOC_MCXC142

config SOC_PART_NUMBER_MCXC143VFT
	bool
	select SOC_MCXC143

config SOC_PART_NUMBER_MCXC143VFM
	bool
	select SOC_MCXC143

config SOC_PART_NUMBER_MCXC144VFM
	bool
	select SOC_MCXC144

config SOC_PART_NUMBER_MCXC144VFT
	bool
	select SOC_MCXC144

config SOC_PART_NUMBER_MCXC242VLH
	bool
	select SOC_MCXC242

config SOC_PART_NUMBER_MCXC242VFM
	bool
	select SOC_MCXC242

config SOC_PART_NUMBER_MCXC243VFT
	bool
	select SOC_MCXC243

config SOC_PART_NUMBER_MCXC244VFT
	bool
	select SOC_MCXC244

config SOC_PART_NUMBER_MCXC244VFM
	bool
	select SOC_MCXC244

config SOC_PART_NUMBER_MCXC443VLH
	bool
	select SOC_MCXC443

config SOC_PART_NUMBER_MCXC443VMP
	bool
	select SOC_MCXC443

config SOC_PART_NUMBER_MCXC444VLH
	bool
	select SOC_MCXC444

config SOC_PART_NUMBER_MCXC444VMP
	bool
	select SOC_MCXC444

config SOC_PART_NUMBER
	default "MCXC141VLH" if SOC_PART_NUMBER_MCXC141VLH
	default "MCXC141VFM" if SOC_PART_NUMBER_MCXC141VFM
	default "MCXC142VFM" if SOC_PART_NUMBER_MCXC142VFM
	default "MCXC143VFT" if SOC_PART_NUMBER_MCXC143VFT
	default "MCXC143VFM" if SOC_PART_NUMBER_MCXC143VFM
	default "MCXC144VFM" if SOC_PART_NUMBER_MCXC144VFM
	default "MCXC144VFT" if SOC_PART_NUMBER_MCXC144VFT
	default "MCXC242VLH" if SOC_PART_NUMBER_MCXC242VLH
	default "MCXC242VFM" if SOC_PART_NUMBER_MCXC242VFM
	default "MCXC243VFT" if SOC_PART_NUMBER_MCXC243VFT
	default "MCXC244VFT" if SOC_PART_NUMBER_MCXC244VFT
	default "MCXC244VFM" if SOC_PART_NUMBER_MCXC244VFM
	default "MCXC443VLH" if SOC_PART_NUMBER_MCXC443VLH
	default "MCXC443VMP" if SOC_PART_NUMBER_MCXC443VMP
	default "MCXC444VLH" if SOC_PART_NUMBER_MCXC444VLH
	default "MCXC444VMP" if SOC_PART_NUMBER_MCXC444VMP
