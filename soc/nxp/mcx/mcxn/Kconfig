if SOC_FAMILY_MCXN

config SOC_FAMILY_MCXN_DEBUG_IN_LOW_POWER
	bool "Keep the debug logic enabled in low power modes"
	depends on PM
	help
	  Leave the debug logic operational while the core is in a low power
	  mode (CMC DBGCTL[SOD] cleared) so that a debug probe keeps its
	  connection across suspend and resume, at the cost of a higher low
	  power current.

	  Say n to shut the debug logic off on low power entry. A suspended
	  target can then no longer be halted, inspected or reflashed without
	  a reset.

	  Power modes that gate the whole core power domain, such as Deep Power
	  Down, lose the debug logic regardless of this option.

if SOC_MCXN947 || SOC_MCXN947T || SOC_MCXN946 || SOC_MCXN946T || \
	SOC_MCXN557S || SOC_MCXN557T || SOC_MCXN556S || SOC_MCXN556T || \
	SOC_MCXN547 || SOC_MCXN547T || SOC_MCXN546 || SOC_MCXN546T || \
	SOC_MCXN537 || SOC_MCXN537T || SOC_MCXN536 || SOC_MCXN536T || \
	SOC_MCXN527 || SOC_MCXN527T || SOC_MCXN526 || SOC_MCXN526T

config SECOND_CORE_MCUX
	bool "MCXN secondary core"
	depends on HAS_MCUX
	select SOC_LATE_INIT_HOOK if SOC_MCXN947_CPU0 || SOC_MCXN947T_CPU0 || \
		SOC_MCXN946_CPU0 || SOC_MCXN946T_CPU0 || SOC_MCXN557S_CPU0 || \
		SOC_MCXN557T_CPU0 || SOC_MCXN556S_CPU0 || SOC_MCXN556T_CPU0 || \
		SOC_MCXN547_CPU0 || SOC_MCXN547T_CPU0 || SOC_MCXN546_CPU0 || \
		SOC_MCXN546T_CPU0 || SOC_MCXN537_CPU0 || SOC_MCXN537T_CPU0 || \
		SOC_MCXN536_CPU0 || SOC_MCXN536T_CPU0 || SOC_MCXN527_CPU0 || \
		SOC_MCXN527T_CPU0 || SOC_MCXN526_CPU0 || SOC_MCXN526T_CPU0
	help
	  Indicates the second core will be enabled, and the part will run
	  in dual core mode.

config FLASH_DISABLE_CACHE64
	bool "Disable the CACHE64 cache for FlexSPI flash accesses"
	help
	  Disable cache64 cache.

