	select CPU_CORTEX_M_HAS_DWT

config SOC_FAMILY_MCXN_DUAL_CORE_CPU0
	bool
	select CPU_CORTEX_M33
	select CPU_HAS_ARM_SAU
	select CPU_HAS_ARM_MPU
	select CPU_HAS_FPU
	select ARMV8_M_DSP
	select SOC_RESET_HOOK
	select SOC_EARLY_RESET_HOOK if PM_S2RAM
	select ARM_TRUSTZONE_M
	select HAS_MCUX_CACHE
	select CPU_HAS_ICACHE
	select HAS_MCUX_SYSCON_LPCAC
	select HAS_MCUX_ELS_PKC
	select HAS_PM
	select WUC if PM
	select HAS_POWEROFF

config SOC_FAMILY_MCXN_DUAL_CORE_CPU1
	bool
	select CPU_CORTEX_M33
	# Secondary core does not have FPU/MPU/SAU/DSP extensions enabled.

config SOC_FAMILY_MCXN_SINGLE_CORE
	bool
	select CPU_CORTEX_M33
	select CPU_HAS_ARM_SAU
	select CPU_HAS_ARM_MPU
	select CPU_HAS_FPU
	select ARMV8_M_DSP
	select SOC_RESET_HOOK
	select SOC_EARLY_RESET_HOOK if PM_S2RAM
	select ARM_TRUSTZONE_M
	select HAS_CPU_FREQ
	select CPU_HAS_ICACHE
	select HAS_MCUX_SYSCON_LPCAC
	select HAS_MCUX_ELS_PKC
	select HAS_PM
	select WUC if PM
	select HAS_POWEROFF

