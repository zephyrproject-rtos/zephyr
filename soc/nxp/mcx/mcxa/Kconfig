	select SOC_EARLY_RESET_HOOK

# Parts within the MCXA family that integrate the SGI PKC crypto accelerator.
config SOC_MCXA266
	select HAS_MCUX_SGI_PKC

config SOC_MCXA366
	select HAS_MCUX_SGI_PKC

config SOC_MCXA577
	select HAS_MCUX_SGI_PKC

if SOC_FAMILY_MCXA

config SOC_FAMILY_MCXA_DEBUG_IN_LOW_POWER
	bool "Keep the debug logic enabled in low power modes"
	depends on PM
	help
	  Leave the debug logic operational while the core is in a low power
	  mode (CMC DBGCTL[SOD] cleared) so that a debug probe keeps its
	  connection across suspend and resume, at the cost of a higher low
	  power current.

	  Say n to shut the debug logic off on low power entry. A suspended
	  target can then no longer be halted, inspected or reflashed without
	  a reset.

	  Power modes that gate the whole core power domain, such as Deep Power
	  Down, lose the debug logic regardless of this option.

endif # SOC_FAMILY_MCXA
