if SOC_FAMILY_MCXA

config CORTEX_M_SYSTICK
	default n if (MCUX_LPTMR_TIMER || MCUX_OS_TIMER)

config NUM_IRQS
	default 80 if SOC_SERIES_MCXA1X3
	default 89 if SOC_SERIES_MCXA1X6
	default 122 if SOC_SERIES_MCXAXX4 || SOC_SERIES_MCXAXX6
	default 146 if SOC_SERIES_MCXAXX7
	default 88

# Default offset 0x200 is not enough with higher ISR count
config ROM_START_OFFSET
	default 0x400 if BOOTLOADER_MCUBOOT && SOC_SERIES_MCXAXX7

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 1000000 if MCUX_OS_TIMER
	default 16000 if MCUX_LPTMR_TIMER
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency) if CORTEX_M_SYSTICK

# Set to the minimal size of data which can be written.
config FLASH_FILL_BUFFER_SIZE
	default 128

config RESET
	default y if DT_HAS_NXP_MRCC_RESET_ENABLED

if PM

configdefault SYSTEM_TIMER_RESET_BY_LPM
	default y

endif # PM

if HAS_MCUX_SYSCON_LPCAC

configdefault CACHE_MANAGEMENT
	default y

choice CACHE_TYPE
	default EXTERNAL_CACHE
endchoice

configdefault ICACHE_LINE_SIZE
	default 256

endif # HAS_MCUX_SYSCON_LPCAC

if MBEDTLS_PSA_CRYPTO_C

config PSA_CRYPTO_DRIVER_SGI_PKC
	bool
	# Only enable the SGI PKC driver on MCXA parts that actually have the SGI
	# IP and a matching SGI_PKC platform mapping below.
	default y if SOC_MCXA266 || SOC_MCXA366 || SOC_MCXA577
	select SGI_PKC
	select SGI_PKC_PLATFORM_MCXA if SOC_MCXA266 || SOC_MCXA366
	select SGI_PKC_PLATFORM_MCXA5 if SOC_MCXA577

if PSA_CRYPTO_DRIVER_SGI_PKC

# The SGI PKC builds its CPU and PKC "workareas" in the stack frame of the calling thread.
# These are defaults only, so an application remains free to lower or raise them.
configdefault MAIN_STACK_SIZE
	default 4096

configdefault SYSTEM_WORKQUEUE_STACK_SIZE
	default 2048

endif # PSA_CRYPTO_DRIVER_SGI_PKC

endif # MBEDTLS_PSA_CRYPTO_C

endif # SOC_FAMILY_MCXA


