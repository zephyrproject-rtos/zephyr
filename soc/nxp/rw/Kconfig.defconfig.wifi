choice NXP_WIFI_PART
	default NXP_RW610
endchoice # NXP_WIFI_PART

if NETWORKING

if NET_DHCPV4_SERVER

config NET_DHCPV4_SERVER_ADDR_COUNT
	default 32

config NET_DHCPV4_SERVER_ICMP_PROBE_TIMEOUT
	default 100

endif # NET_DHCPV4_SERVER

if NET_L2_WIFI_MGMT

configdefault WIFI_MGMT_AP_MAX_NUM_STA
	default 8 if NXP_WIFI_SOFTAP_SUPPORT

configdefault WIFI_SHELL_MAX_AP_STA
	default 8

endif # NET_L2_WIFI_MGMT

endif # NETWORKING

if WIFI_NM_HOSTAPD_AP

config WIFI_NM_HOSTAPD_REGULATORY_REGION
	default "US"

endif # WIFI_NM_HOSTAPD_AP

if NXP_WIFI_FW_DEBUG

config NXP_FW_DUMP_FLASH_START_ADDR
	default 0x0B000000

endif # NXP_WIFI_FW_DEBUG

if NXP_WIFI_PRESET

source "drivers/wifi/nxp/Kconfig.preset"

if NETWORKING

configdefault NET_PKT_RX_COUNT
	default 36

configdefault NET_PKT_TX_COUNT
	default 36

configdefault NET_BUF_RX_COUNT
	default 40

configdefault NET_BUF_TX_COUNT
	default 40

if NET_TCP

configdefault NET_TCP_MAX_SEND_WINDOW_SIZE
	default 46720

configdefault NET_TCP_MAX_RECV_WINDOW_SIZE
	default 46720

endif # NET_TCP

endif # NETWORKING

endif # NXP_WIFI_PRESET
