if SOC_MIMX9375_M7

DT_CHOSEN_Z_FLASH := zephyr,flash

configdefault MCUX_CORE_SUFFIX
	default "_cm7"

# Multi-level interrupts
configdefault MULTI_LEVEL_INTERRUPTS
	default y

configdefault 1ST_LEVEL_INTERRUPT_BITS
	default 8

configdefault MAX_IRQ_PER_AGGREGATOR
	default 16

configdefault 2ND_LEVEL_INTERRUPTS
	default y

configdefault 2ND_LVL_ISR_TBL_OFFSET
	default 234

configdefault NUM_2ND_LEVEL_AGGREGATORS
	default 1

configdefault 2ND_LEVEL_INTERRUPT_BITS
	default 8

configdefault 2ND_LVL_INTR_00_OFFSET
	default 224

configdefault 3RD_LEVEL_INTERRUPTS
	default n

configdefault NUM_IRQS
	default 250 # 2ND_LVL_ISR_TBL_OFFSET + MAX_IRQ_PER_AGGREGATOR * NUM_2ND_LEVEL_AGGREGATORS

configdefault MCUX_LPTMR_TIMER
	default y if !COUNTER_MCUX_LPTMR

DT_CHOSEN_ZEPHYR_SYSTEM_TIMER := zephyr,system-timer
DT_CHOSEN_ZEPHYR_SYSTEM_TIMER_PATH := $(dt_chosen_path,$(DT_CHOSEN_ZEPHYR_SYSTEM_TIMER))

configdefault CORTEX_M_SYSTICK
	default n if MCUX_LPTMR_TIMER

configdefault SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency) if CORTEX_M_SYSTICK
	default $(dt_node_int_prop_int,$(DT_CHOSEN_ZEPHYR_SYSTEM_TIMER_PATH),clock-frequency) if MCUX_LPTMR_TIMER

configdefault SYS_CLOCK_TICKS_PER_SEC
	default 1024 if MCUX_LPTMR_TIMER
	default 1000 if CORTEX_M_SYSTICK

configdefault CACHE_MANAGEMENT
	default y

configdefault ETH_NXP_IMX_MSGINTR
	default 2

if PM

# PM code that runs from the idle loop has a large
# Footprint. Hence increase the size when PM is enabled.
configdefault IDLE_STACK_SIZE
	default 640

endif

if PM_DEVICE

configdefault POWER_DOMAIN
	default y

endif # PM_DEVICE

configdefault ROM_START_OFFSET
	default 0x800 if BOOTLOADER_MCUBOOT

endif # SOC_MIMX9375_M7
