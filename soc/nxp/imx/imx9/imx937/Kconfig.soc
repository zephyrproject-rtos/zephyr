config SOC_MIMX9375
	bool
	select SOC_SERIES_IMX9

config SOC_MIMX9375_M7
	bool
	select SOC_MIMX9375
	help
	  NXP i.MX937 M7

configdefault SOC
	default "mimx9375" if SOC_MIMX9375

config SOC_PART_NUMBER_MIMX9375XXVZX
	bool

configdefault SOC_PART_NUMBER
	default "MIMX9375xxVZx" if SOC_PART_NUMBER_MIMX9375XXVZX
