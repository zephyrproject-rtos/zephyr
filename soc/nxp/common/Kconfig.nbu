config NXP_NBU
	bool
	default y if BT || IEEE802154 || NXP_IEEE802154_MAC
	depends on DT_HAS_NXP_NBU_ENABLED
	select NVMEM if $(dt_compat_any_has_prop,$(DT_COMPAT_NXP_NBU),nvmem-cells)
	help
	  NXP Narrow Band Unit interrupt initialization.

config NXP_NBU_IFR_TRIM_INIT_PRIORITY
	int "NBU XTAL32M factory trim init priority"
	default 51
	depends on NXP_NBU
	help
	  POST_KERNEL initialization priority of the step which applies the
	  factory 32 MHz crystal trim read from non-volatile memory. It must be
	  higher than the priority of the driver providing the NVMEM cell, for
	  instance FLASH_INIT_PRIORITY.
