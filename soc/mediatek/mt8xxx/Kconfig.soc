config SOC_FAMILY_MTK
	bool

config SOC_FAMILY
	default "mt8xxx" if SOC_FAMILY_MTK

# Selected by every Xtensa audio DSP cluster in this family.  The family also
# hosts Arm application processor clusters, so everything specific to the audio
# DSPs hangs off this symbol rather than off the family itself.
config SOC_MTK_ADSP
	bool
	select SOC_FAMILY_MTK

config SOC_SERIES_MT8195
	bool
	select SOC_FAMILY_MTK
	help
	  Mediatek MT8195

config SOC_SERIES_MT818X
	bool
	select SOC_FAMILY_MTK
	help
	  Mediatek MT818x

config SOC_SERIES_MT8196
	bool
	select SOC_FAMILY_MTK
	help
	  Mediatek MT8196

config SOC_SERIES_MT8365
	bool
	select SOC_FAMILY_MTK
	help
	  Mediatek MT8365

config SOC_SERIES
	default "mt8195" if SOC_SERIES_MT8195
	default "mt818x" if SOC_SERIES_MT818X
	default "mt8196" if SOC_SERIES_MT8196
	default "mt8365" if SOC_SERIES_MT8365

orsource "*/Kconfig.soc"
