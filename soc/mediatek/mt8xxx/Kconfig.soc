config SOC_FAMILY_MT8XXX
	bool

config SOC_FAMILY
	default "mt8xxx" if SOC_FAMILY_MT8XXX

# Set by every Xtensa audio DSP cluster in the family.  The family also hosts
# Arm application processor clusters, so anything specific to the audio DSPs
# hangs off this rather than off the family symbol.  It is deliberately not
# named SOC_*: that namespace belongs to the SoCs listed in soc.yml.
config MTK_ADSP
	bool

config SOC_SERIES_MT8195
	bool
	select SOC_FAMILY_MT8XXX
	help
	  Mediatek MT8195

config SOC_SERIES_MT818X
	bool
	select SOC_FAMILY_MT8XXX
	help
	  Mediatek MT818x

config SOC_SERIES_MT8196
	bool
	select SOC_FAMILY_MT8XXX
	help
	  Mediatek MT8196

config SOC_SERIES_MT8365
	bool
	select SOC_FAMILY_MT8XXX
	help
	  Mediatek MT8365

config SOC_SERIES
	default "mt8195" if SOC_SERIES_MT8195
	default "mt818x" if SOC_SERIES_MT818X
	default "mt8196" if SOC_SERIES_MT8196
	default "mt8365" if SOC_SERIES_MT8365

orsource "*/Kconfig.soc"
