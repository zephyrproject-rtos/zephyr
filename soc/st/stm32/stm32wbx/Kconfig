config SOC_SERIES_STM32WBX
	# Architecture options & CPU model selection
	select ARM
	select CPU_CORTEX_M4
	# Hardware options
	select CPU_CORTEX_M_HAS_DWT
	select CPU_HAS_ARM_MPU
	select CPU_HAS_FPU
	select HAS_SWO
	# Software options
	select HAS_PM
	select HAS_POWEROFF
	select PM_STATE_SET_IRQ_UNLOCKED
	select SOC_EARLY_INIT_HOOK
	# STM32-specific options
	select HAS_STM32CUBE
	select HAS_STM32_FLASH_PREFETCH
