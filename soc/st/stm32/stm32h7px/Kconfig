config SOC_SERIES_STM32H7PX
	# Architecture options & CPU model selection
	select ARM
	select CPU_CORTEX_M7
	# Hardware options
	select CPU_CORTEX_M_HAS_DWT
	select CPU_HAS_ARM_MPU
	select CPU_HAS_DCACHE
	select CPU_HAS_FPU
	select CPU_HAS_FPU_DOUBLE_PRECISION
	select CPU_HAS_ICACHE
	select HAS_SWO
	# Software options
	select SOC_EARLY_INIT_HOOK
	select SOC_EARLY_RESET_HOOK
	# STM32-specific options
	select HAS_STM32CUBE
	select STM32_HAL2
	select HAS_STM32_RTC_READ_GATED_BY_BKP_DOMAIN
