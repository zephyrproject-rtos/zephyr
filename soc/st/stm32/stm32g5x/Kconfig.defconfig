if SOC_SERIES_STM32G5X

configdefault ROM_START_OFFSET
	default 0x400 if BOOTLOADER_MCUBOOT

configdefault ICACHE
	default y

configdefault CACHE_MANAGEMENT
	default y

choice CACHE_TYPE
	default EXTERNAL_CACHE
endchoice

endif # SOC_SERIES_STM32G5X
