if SOC_SERIES_STM32N6X

DT_STM32_CPU_CLOCK_PATH := $(dt_nodelabel_path,cpusw)
DT_STM32_CPU_CLOCK_FREQ := $(dt_node_int_prop_int,$(DT_STM32_CPU_CLOCK_PATH),clock-frequency)

DT_CHOSEN_Z_FLASH := zephyr,flash
DT_CHOSEN_FLASH_NODE := $(dt_chosen_path,$(DT_CHOSEN_Z_FLASH))
DT_FLASH_HAS_SIZE_PROP := $(dt_node_has_prop,$(DT_CHOSEN_FLASH_NODE),size)

# When XiP in Ext Flash, get FLASH size from size property of XSPI device node
config FLASH_SIZE
	default $(dt_node_int_prop_int,$(DT_CHOSEN_FLASH_NODE),size,kb) \
		if $(DT_FLASH_HAS_SIZE_PROP) && XIP

# Default the Zephyr cycle rate to the selected system timer.
# SysTick uses cpusw; LPTIM uses its LSE/LSI clock source.
config SYS_CLOCK_HW_CYCLES_PER_SEC
	default STM32_LPTIM_CLOCK if STM32_LPTIM_TIMER
	default "$(DT_STM32_CPU_CLOCK_FREQ)" if CORTEX_M_SYSTICK && "$(dt_nodelabel_enabled,cpusw)"

config STM32_LTDC_FB_SMH_ALIGN
	default 256 if MEMC_STM32_XSPI_PSRAM && SHARED_MULTI_HEAP && \
		       STM32_LTDC_FB_USE_SHARED_MULTI_HEAP

if STM32_IOCELL

configdefault OTP
	default y

configdefault NVMEM
	default y

endif # STM32_IOCELL

# Add LVGL HAL include file for SOC supporting DMA2D
configdefault LV_Z_DRAW_DMA2D_HAL_INCLUDE
	default "stm32n6xx.h" if LVGL && DT_HAS_ST_STM32_DMA2D_ENABLED

endif # SOC_SERIES_STM32N6X
