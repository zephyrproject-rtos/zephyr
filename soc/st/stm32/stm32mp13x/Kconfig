config SOC_SERIES_STM32MP13X
	# Architecture options & CPU model selection
	select ARM
	select CPU_CORTEX_A7
	# Hardware options
	select ARM_ARCH_TIMER
	select CPU_HAS_FPU
	# Software options
	select KERNEL_DIRECT_MAP if MMU
	select SOC_EARLY_INIT_HOOK
	select SYS_CLOCK_EXISTS
	select XIP if !SOC_SERIES_STM32MP13X_FSBL
	# STM32-specific options
	select HAS_STM32CUBE

config SOC_SERIES_STM32MP13X_FSBL
	bool
	help
	  Build Zephyr for direct startup as an STM32MP13 first-stage image,
	  before DDR and the full clock tree have been initialized by a previous
	  boot stage. This enables the clock configuration and memory mappings
	  required to initialize external DDR.

config SOC_SERIES_STM32MP13X_DDR_INIT
	bool
	default y if DT_HAS_ST_STM32MP13_DDR_ENABLED
	depends on SOC_SERIES_STM32MP13X_FSBL
	select USE_STM32_HAL_DDR
	help
	  Initialize the STM32MP13 DDR (Double Data Rate) controller and PHY
	  (Physical Interface) from devicetree.

config SOC_SERIES_STM32MP13X_DDR_INIT_PRIORITY
	int
	default 2
	depends on SOC_SERIES_STM32MP13X_DDR_INIT
