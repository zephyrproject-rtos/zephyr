if SOC_CC3220SF

config NUM_IRQS
	# must be >= the highest interrupt number used
	# This includes the NWP interrupt
	default 178

config ROM_START_OFFSET
	default 0x800 if XIP
	default 0x0   if !XIP

endif # SOC_CC3220SF
