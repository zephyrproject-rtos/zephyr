	bool "Allow main app ease by SACI. Only available for SCFG."
	default y
	help
	  Determines whether main app erase is enabled.

config CC27XX_ALLOW_FAKE_STANDBY
	bool "Allow fake standby."
	default y
	help
	  Determines whether fake standby is enabled.

endmenu # "Device Permission Settings"

menu "EM Sensor Settings"

choice CC27XX_EM_SENSOR
	prompt "Enable or disable HW EM Sensor"
	default CC27XX_EM_SENSOR_ENABLED

config CC27XX_EM_SENSOR_ENABLED
	bool "HW EM Sensor enabled"

config CC27XX_EM_SENSOR_DISABLED
	bool "HW EM Sensor disabled"

endchoice # CC27XX_EM_SENSOR_CFG

endmenu # "EM Sensor Settings"

endmenu # Secure Configuration (SCFG)
