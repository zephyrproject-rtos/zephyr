config SOC_AM13E23019
	select ARM
	select ARMV8_M_DSP
	select ARMV8_M_CDE_CP0
	select BUILD_OUTPUT_BIN
	select BUILD_OUTPUT_HEX
	select CPU_CORTEX_M33
	select CPU_CORTEX_M_HAS_SYSTICK
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_HAS_ARM_MPU
	select CPU_HAS_FPU
	select CLOCK_CONTROL

# AM13E TRM section 3.3.6 Perpheral Enable suggests waiting at least 4 ULPCLK
# cycles after power enable. ULPCLK can be MCLK/4, so the safest option will
# be 16 cycles.
config MSPM0_PERIPH_STARTUP_DELAY
	int
	default 16
