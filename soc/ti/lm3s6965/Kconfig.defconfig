if SOC_TI_LM3S6965

config NUM_IRQS
	# must be >= the highest interrupt number used
	# - include the UART interrupts and ethernet interrupts
	default 43

if UART_STELLARIS

config UART_STELLARIS_PORT_0
	def_bool y
	depends on $(dt_nodelabel_enabled,uart0)

config UART_STELLARIS_PORT_1
	def_bool y
	depends on $(dt_nodelabel_enabled,uart1)

config UART_STELLARIS_PORT_2
	def_bool y
	depends on $(dt_nodelabel_enabled,uart2)

endif # UART_STELLARIS

endif
