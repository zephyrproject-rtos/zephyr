if SOC_SERIES_RZA3UL

config SYS_CLOCK_EXISTS
	default y

config NUM_IRQS
	default 512

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default	$(dt_node_int_prop_int,/osc,clock-frequency)

config FLASH_SIZE
	default $(dt_chosen_reg_size_int,$(DT_CHOSEN_Z_FLASH),0,K)

config FLASH_BASE_ADDRESS
	default $(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_FLASH))

config FLASH_LOAD_OFFSET
	default $(sub_hex, $(dt_nodelabel_reg_addr_hex,header), \
	$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_FLASH)))

config BUILD_OUTPUT_ADJUST_LMA
	default "$(sub_hex, $(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_CODE_PARTITION)), \
	$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_SRAM)))"

config BUILD_OUTPUT_ADJUST_LMA_SECTIONS
	default "*;!.header"

endif # SOC_SERIES_RZA3UL
