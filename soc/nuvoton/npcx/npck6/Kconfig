config SOC_SERIES_NPCK6
	select ARM
	select CPU_CORTEX_M33
	select CPU_CORTEX_M_HAS_DWT
	select CPU_HAS_ARM_SAU
	select CPU_HAS_ARM_MPU
	select CPU_HAS_FPU
	select HAS_PM
	select PM_STATE_SET_IRQ_UNLOCKED
	select HAS_SWO
	select SOC_EARLY_INIT_HOOK

if SOC_SERIES_NPCK6

config SOC_NPCK_EPURST_DISABLE
	bool "Disable all External Power-Up Reset Inputs"
	default y
	help
	  Disable all External Power-Up Reset Inputs during initialization. All
	  signals such as EXT_PURST# are disabled by default. The users can
	  enable it if needed.

config SOC_NPCK_DEBUG_DISABLE
	bool "Disable all K6 debug interfaces"
	help
	  Disable all K6 debug interface during initialization.

config NPCK_EPURST_DEBOUNCE_TIME_SEC
	int "Debounce time of the EXT_PURST"
	default 10
	help
	  This option specifices the debounce time for EXT_PURST. The unit is seconds,
	  and the valid value is from 1 to 31.

endif # SOC_SERIES_NPCK6
