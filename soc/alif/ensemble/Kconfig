if SOC_FAMILY_ENSEMBLE

config SOC_FAMILY_ENSEMBLE_RTSS
	bool
	select ARM
	select ARMV8_M_DSP
	select ARMV8_1_M_MVEI
	select ARMV8_1_M_MVEF
	select CPU_CORTEX_M55
	select CPU_CORTEX_M_HAS_SYSTICK
	select CPU_CORTEX_M_HAS_DWT
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_HAS_ARM_MPU
	select CPU_HAS_CUSTOM_FIXED_SOC_MPU_REGIONS
	select CPU_HAS_FPU
	select HAS_FLASH_LOAD_OFFSET
	select SOC_RESET_HOOK
	select XIP
	select HAS_SEGGER_RTT if ZEPHYR_SEGGER_MODULE

config SOC_FAMILY_ENSEMBLE_RTSS_HE
	bool
	select SOC_FAMILY_ENSEMBLE_RTSS

config SOC_FAMILY_ENSEMBLE_RTSS_HP
	bool
	select SOC_FAMILY_ENSEMBLE_RTSS

config SOC_FAMILY_ENSEMBLE_APSS
	bool
	select ARM
	select CPU_CORTEX_A32
	select ARM_ARCH_TIMER if SYS_CLOCK_EXISTS
	imply XIP

config ENSEMBLE_APSS_SECURE
	bool "APSS runs in Secure state, without TF-A"
	depends on SOC_FAMILY_ENSEMBLE_APSS
	select AARCH32_ARMV8_A_MONITOR_INIT
	select CPU_CORTEX_A32_SMPEN
	select SOC_PREP_HOOK
	help
	  Select when the Secure Enclave boots Zephyr directly on the APSS,
	  in Secure state, instead of Zephyr running in Non-secure state
	  behind TF-A. Zephyr then does the parts of TF-A's set-up it relies
	  on: it sets CPUECTLR.SMPEN and zeroes the virtual counter offset
	  (CNTVOFF) on each core, and enables the REFCLK system counter that
	  drives the Generic Timer.

rsource "*/Kconfig"

endif # SOC_FAMILY_ENSEMBLE
