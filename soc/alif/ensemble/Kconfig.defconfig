# Default configurations applied to the whole Ensemble family

if SOC_FAMILY_ENSEMBLE

# Source series Kconfig files first, so SoCs
# can override the defaults given here
rsource "*/Kconfig.defconfig"

# Compute the IRQ table size of the RTSS cores from DT.
# dt_highest_controller_irq_number() returns a zero-based IRQn, increment it
# to obtain the table size. APSS has no NVIC and keeps its per-SoC value.
DT_NVIC_PATH := $(dt_nodelabel_path,nvic)
DT_NVIC_MAX_IRQN := $(dt_highest_controller_irq_number,$(DT_NVIC_PATH),irq)

configdefault NUM_IRQS
	default $(inc,$(DT_NVIC_MAX_IRQN)) if $(dt_path_enabled,$(DT_NVIC_PATH))

config CLOCK_CONTROL
	default y

configdefault CACHE_MANAGEMENT
	default y

configdefault I2C_DW_IC_CLK_FREQ_OPTIMIZATION
	default y

# The SPI instances are DWC_ssi, which lays out CTRLR0 differently
configdefault SPI_DW_HSSI
	default y

if SOC_FAMILY_ENSEMBLE_RTSS

# Keep images without a code partition below the Device memory storage partition
ALIF_CHOSEN_FLASH := zephyr,flash

configdefault FLASH_SIZE
	default $(sub,$(dt_nodelabel_reg_addr_int,storage_partition,0,K),$(dt_chosen_reg_addr_int,$(ALIF_CHOSEN_FLASH),0,K)) \
		if $(dt_nodelabel_enabled,storage_partition)

# Keep the application out of the Device memory sector holding its MCUboot trailer
configdefault ROM_END_OFFSET
	default $(dt_node_int_prop_hex,$(dt_chosen_path,$(ALIF_CHOSEN_FLASH)),erase-block-size) \
		if BOOTLOADER_MCUBOOT

endif # SOC_FAMILY_ENSEMBLE_RTSS

endif # SOC_FAMILY_ENSEMBLE
