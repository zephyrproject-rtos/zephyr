# Default configurations applied to the whole Balletto family

if SOC_FAMILY_BALLETTO

# Source series Kconfig files first, so SoCs
# can override the defaults given here
rsource "*/Kconfig.defconfig"

# Compute the IRQ table size from DT. dt_highest_controller_irq_number()
# returns a zero-based IRQn, increment it to obtain the table size.
DT_NVIC_PATH := $(dt_nodelabel_path,nvic)
DT_NVIC_MAX_IRQN := $(dt_highest_controller_irq_number,$(DT_NVIC_PATH),irq)

configdefault NUM_IRQS
	default $(inc,$(DT_NVIC_MAX_IRQN)) if $(dt_path_enabled,$(DT_NVIC_PATH))

configdefault CLOCK_CONTROL
	default y

configdefault CACHE_MANAGEMENT
	default y

configdefault I2C_DW_IC_CLK_FREQ_OPTIMIZATION
	default y

endif # SOC_FAMILY_BALLETTO
