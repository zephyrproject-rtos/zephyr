if SOC_HI3861

DT_CHOSEN_ZEPHYR_SYSTEM_TIMER := zephyr,system-timer
DT_CHOSEN_ZEPHYR_SYSTEM_TIMER_PATH := $(dt_chosen_path,$(DT_CHOSEN_ZEPHYR_SYSTEM_TIMER))

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,$(DT_CHOSEN_ZEPHYR_SYSTEM_TIMER_PATH),clock-frequency)

config NUM_IRQS
	default 62

config INCLUDE_RESET_VECTOR
	default n

config RISCV_GENERIC_TOOLCHAIN
	default y

config KERNEL_ENTRY
	default "__reset"

endif
