config COMPILER_FREESTANDING
	default y if "$(TOOLCHAIN_HAS_NEWLIB)" != "y"

config RISCV_USE_MSAVE_RESTORE
	default y if SIZE_OPTIMIZATIONS

config RISCV_ISA_EXT_F
	default n if TOOLCHAIN_ANDES_SUPPORTS_FLOAT_SOFT

config RISCV_ISA_EXT_D
	default n if TOOLCHAIN_ANDES_SUPPORTS_FLOAT_SOFT
	default n if TOOLCHAIN_ANDES_SUPPORTS_FLOAT_SINGLE

config RISCV_ISA_EXT_ZCF
	default n if TOOLCHAIN_ANDES_SUPPORTS_FLOAT_SOFT

config RISCV_ISA_EXT_ZCD
	default n if TOOLCHAIN_ANDES_SUPPORTS_FLOAT_SOFT
	default n if TOOLCHAIN_ANDES_SUPPORTS_FLOAT_SINGLE

config NEWLIB_LIBC_USE_POSIX_LIMITS_H
	default n if "$(TOOLCHAIN_HAS_NEWLIB)" = "y"
