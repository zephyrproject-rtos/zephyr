#include <zephyr/dt-bindings/interrupt-controller/arm-gic.h>
#include <zephyr/dt-bindings/interrupt-controller/rp1-irq.h>

&pcie2 {
	rp1 {
		#address-cells = <2>;
		#size-cells = <1>;

		rp1_uartclk: uartclk {
			compatible = "fixed-clock";
			clock-frequency = <50000000>;
			#clock-cells = <0>;
		};

		rp1_uart0: serial@1f00030000 {
			compatible = "arm,pl011";
			reg = <0x1f 0x30000 0x100>;
			interrupt-parent = <&rp1_intc>;
			interrupts = <RP1_IRQ_UART0 IRQ_TYPE_LEVEL>;
			interrupt-names = "uart0";
			clocks = <&rp1_uartclk>;
			clock-names = "uartclk";
			status = "disabled";
		};

		rp1_uart1: serial@1f00034000 {
			compatible = "arm,pl011";
			reg = <0x1f 0x34000 0x100>;
			interrupt-parent = <&rp1_intc>;
			interrupts = <RP1_IRQ_UART1 IRQ_TYPE_LEVEL>;
			interrupt-names = "uart1";
			clocks = <&rp1_uartclk>;
			clock-names = "uartclk";
			status = "disabled";
		};

		rp1_uart2: serial@1f00038000 {
			compatible = "arm,pl011";
			reg = <0x1f 0x38000 0x100>;
			interrupt-parent = <&rp1_intc>;
			interrupts = <RP1_IRQ_UART2 IRQ_TYPE_LEVEL>;
			interrupt-names = "uart2";
			clocks = <&rp1_uartclk>;
			clock-names = "uartclk";
			status = "disabled";
		};

		rp1_uart3: serial@1f0003c000 {
			compatible = "arm,pl011";
			reg = <0x1f 0x3c000 0x100>;
			interrupt-parent = <&rp1_intc>;
			interrupts = <RP1_IRQ_UART3 IRQ_TYPE_LEVEL>;
			interrupt-names = "uart3";
			clocks = <&rp1_uartclk>;
			clock-names = "uartclk";
			status = "disabled";
		};

		rp1_uart4: serial@1f00040000 {
			compatible = "arm,pl011";
			reg = <0x1f 0x40000 0x100>;
			interrupt-parent = <&rp1_intc>;
			interrupts = <RP1_IRQ_UART4 IRQ_TYPE_LEVEL>;
			interrupt-names = "uart4";
			clocks = <&rp1_uartclk>;
			clock-names = "uartclk";
			status = "disabled";
		};

		rp1_pinctrl: pinctrl@1f000d0000 {
			compatible = "raspberrypi,rp1-pinctrl";
			reg = <0x1f 0xd0000 0x128>,
			      <0x1f 0xf0004 0x70>;
			reg-names = "gpio", "pads";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			gpio0_0: gpio@0 {
				compatible = "raspberrypi,rp1-gpio";
				reg = <0x0 0x10000 0x20000>;
				#gpio-cells = <2>;
				gpio-controller;
				ngpios = <28>;
				status = "disabled";
			};

			gpio0_1: gpio@4000 {
				compatible = "raspberrypi,rp1-gpio";
				reg = <0x4000 0x14000 0x24000>;
				#gpio-cells = <2>;
				gpio-controller;
				ngpios = <6>;
				status = "disabled";
			};

			gpio0_2: gpio@8000 {
				compatible = "raspberrypi,rp1-gpio";
				reg = <0x8000 0x18000 0x28000>;
				#gpio-cells = <2>;
				gpio-controller;
				ngpios = <20>;
				status = "disabled";
			};
		};

		rp1_intc: interrupt-controller@1f00108000 {
			compatible = "raspberrypi,rp1-intc";
			reg = <0x1f 0x108000 0x1000>;
			interrupt-controller;
			#interrupt-cells = <2>;
			#address-cells = <0>;
			msi-parent = <&mip0>;
			interrupt-map = <RP1_IRQ_IO_BANK0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_IO_BANK0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_IO_BANK1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_IO_BANK1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_IO_BANK2 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_IO_BANK2 IRQ_TYPE_EDGE>,
					<RP1_IRQ_AUDIO_IN IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_AUDIO_IN IRQ_TYPE_EDGE>,
					<RP1_IRQ_AUDIO_OUT IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_AUDIO_OUT IRQ_TYPE_EDGE>,
					<RP1_IRQ_PWM0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_PWM0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_ETH IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_ETH IRQ_TYPE_EDGE>,
					<RP1_IRQ_I2C0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_I2C0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_I2C1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_I2C1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_I2C2 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_I2C2 IRQ_TYPE_EDGE>,
					<RP1_IRQ_I2C3 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_I2C3 IRQ_TYPE_EDGE>,
					<RP1_IRQ_I2C4 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_I2C4 IRQ_TYPE_EDGE>,
					<RP1_IRQ_I2C5 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_I2C5 IRQ_TYPE_EDGE>,
					<RP1_IRQ_I2C6 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_I2C6 IRQ_TYPE_EDGE>,
					<RP1_IRQ_I2S0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_I2S0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_I2S1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_I2S1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_I2S2 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_I2S2 IRQ_TYPE_EDGE>,
					<RP1_IRQ_SDIO0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SDIO0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_SDIO1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SDIO1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_SPI0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SPI0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_SPI1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SPI1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_SPI2 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SPI2 IRQ_TYPE_EDGE>,
					<RP1_IRQ_SPI3 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SPI3 IRQ_TYPE_EDGE>,
					<RP1_IRQ_SPI4 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SPI4 IRQ_TYPE_EDGE>,
					<RP1_IRQ_SPI5 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SPI5 IRQ_TYPE_EDGE>,
					<RP1_IRQ_UART0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_UART0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_TIMER0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_TIMER0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_TIMER1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_TIMER1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_TIMER2 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_TIMER2 IRQ_TYPE_EDGE>,
					<RP1_IRQ_TIMER3 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_TIMER3 IRQ_TYPE_EDGE>,
					<RP1_IRQ_USBHOST0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_USBHOST0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_USBHOST0_0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_USBHOST0_0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_USBHOST0_1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_USBHOST0_1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_USBHOST0_2 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_USBHOST0_2 IRQ_TYPE_EDGE>,
					<RP1_IRQ_USBHOST0_3 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_USBHOST0_3 IRQ_TYPE_EDGE>,
					<RP1_IRQ_USBHOST1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_USBHOST1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_USBHOST1_0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_USBHOST1_0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_USBHOST1_1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_USBHOST1_1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_USBHOST1_2 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_USBHOST1_2 IRQ_TYPE_EDGE>,
					<RP1_IRQ_USBHOST1_3 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_USBHOST1_3 IRQ_TYPE_EDGE>,
					<RP1_IRQ_DMA IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_DMA IRQ_TYPE_EDGE>,
					<RP1_IRQ_PWM1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_PWM1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_UART1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_UART1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_UART2 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_UART2 IRQ_TYPE_EDGE>,
					<RP1_IRQ_UART3 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_UART3 IRQ_TYPE_EDGE>,
					<RP1_IRQ_UART4 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_UART4 IRQ_TYPE_EDGE>,
					<RP1_IRQ_UART5 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_UART5 IRQ_TYPE_EDGE>,
					<RP1_IRQ_MIPI0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_MIPI0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_MIPI1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_MIPI1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_VIDEO_OUT IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_VIDEO_OUT IRQ_TYPE_EDGE>,
					<RP1_IRQ_PIO0 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_PIO0 IRQ_TYPE_EDGE>,
					<RP1_IRQ_PIO1 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_PIO1 IRQ_TYPE_EDGE>,
					<RP1_IRQ_ADC_FIFO IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_ADC_FIFO IRQ_TYPE_EDGE>,
					<RP1_IRQ_PCIE_OUT IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_PCIE_OUT IRQ_TYPE_EDGE>,
					<RP1_IRQ_SPI6 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SPI6 IRQ_TYPE_EDGE>,
					<RP1_IRQ_SPI7 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SPI7 IRQ_TYPE_EDGE>,
					<RP1_IRQ_SPI8 IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SPI8 IRQ_TYPE_EDGE>,
					<RP1_IRQ_PROC_MISC IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_PROC_MISC IRQ_TYPE_EDGE>,
					<RP1_IRQ_SYSCFG IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_SYSCFG IRQ_TYPE_EDGE>,
					<RP1_IRQ_CLOCKS IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_CLOCKS IRQ_TYPE_EDGE>,
					<RP1_IRQ_VBUSCTRL IRQ_TYPE_LEVEL
					 &mip0 RP1_IRQ_VBUSCTRL IRQ_TYPE_EDGE>;
		};
	};
};
