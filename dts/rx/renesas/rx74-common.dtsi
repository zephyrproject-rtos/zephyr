				reg = <0x86c2e9e0 0x4>;
				zephyr,memory-region = "OFS_BANKSEL_SEL";
				status = "disabled";
			};

			ofs_blsel_sel: ofs-blsel-sel@86c2e9f0 {
				compatible = "zephyr,memory-region";
				reg = <0x86c2e9f0 0x4>;
