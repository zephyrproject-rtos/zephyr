				status = "disabled";
			};
		};

		sci8: sci8@87458800 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458800 0x100>;
			channel = <8>;
			clocks = <&sciclk MSTPB 23>;
			status = "disabled";

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci9: sci9@87458900 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458900 0x100>;
			channel = <9>;
			clocks = <&sciclk MSTPB 22>;
			status = "disabled";

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci10: sci10@87458a00 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458a00 0x100>;
			channel = <10>;
			clocks = <&sciclk MSTPB 21>;
			status = "disabled";

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci11: sci11@87458b00 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458b00 0x100>;
			channel = <11>;
			clocks = <&sciclk MSTPB 20>;
			status = "disabled";

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		sci12: uart12@87458c00 {
			compatible = "renesas,rx-sci-b";
			reg = <0x87458c00 0x100>;
			channel = <12>;
			clocks = <&sciclk MSTPB 0>;
			status = "disabled";

			uart {
				compatible = "renesas,rx-uart-sci-b";
				status = "disabled";
			};
		};

		cmt: timer@87826000 {
			compatible = "renesas,rx-timer-cmt-start-control";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x87826000 0x02>;
			clocks = <&pclkb MSTPF 15>;
			reg-names = "CMSTR0";
			status = "okay";

			cmt0: timer@87826002 {
				compatible = "renesas,rx-timer-cmt";
				#address-cells = <1>;
				#size-cells = <1>;
				reg = <0x87826002 0x02>,
				      <0x87826004 0x02>,
				      <0x87826006 0x02>;
				reg-names = "CMCR", "CMCNT", "CMCOR";
				interrupts = <28 1>;
				interrupt-names = "cmi";
				status = "okay";
			};

			cmt1: timer@87826008 {
				compatible = "renesas,rx-timer-cmt";
				reg = <0x87826008 0x02>,
				      <0x8782600a 0x02>,
				      <0x8782600c 0x02>;
				reg-names = "CMCR", "CMCNT", "CMCOR";
				interrupts = <29 1>;
				interrupt-names = "cmi";
				status = "disabled";
			};
		};

		pinctrl: pin-controller@87c00000 {
			compatible = "renesas,rx-pinctrl";
			reg = <0x87C00000 0x3c0>;
			status = "okay";
		};

		ofs_mem_cfg_sec: ofs-mem-cfg-sec@86c2e850 {
			compatible = "renesas,ofs-memory";
			reg = <0x86c2e850 0x715b0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			ofs_dualsel: ofs-dualsel0@86c2e850 {
				compatible = "zephyr,memory-region";
				zephyr,memory-region = "OFS_DUALSEL";
				reg = <0x86c2e850 0x4>;
				status = "disabled";
			};

			ofs_sas: ofs-sas@86c2e870 {
				compatible = "zephyr,memory-region";
				zephyr,memory-region = "OFS_SAS";
				reg = <0x86c2e870 0x4>;
				status = "disabled";
			};

			ofs_sas2: ofs-sas2@86c2e874 {
				compatible = "zephyr,memory-region";
				reg = <0x86c2e874 0x4>;
				zephyr,memory-region = "OFS_SAS2";
				status = "disabled";
