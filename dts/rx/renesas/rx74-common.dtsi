				reg = <0x86c9f080 0x20>;
				zephyr,memory-region = "OFS_BPSDM_SEC";
				status = "disabled";
			};

			ofs_bps_sec: ofs-bps-sec@86c9f200 {
				compatible = "zephyr,memory-region";
				reg = <0x86c9f200 0x40>;
