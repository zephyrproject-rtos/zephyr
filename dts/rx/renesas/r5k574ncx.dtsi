#include <rx/renesas/r5k574x.dtsi>

/delete-node/ &escclk;
/delete-node/ &dsmifclk;

&mram_ctrl {
	mram0: mram@fff00000 {
		compatible = "soc-nv-flash";
		reg = <0xfff00000 0x100000>;
		ranges = <0x0 0xfff00000 0x100000>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};
