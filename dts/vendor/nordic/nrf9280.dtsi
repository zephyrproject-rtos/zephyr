#include <mem.h>
#include <nordic/nrf_common.dtsi>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/misc/nordic-nrf-ficr-nrf9230-engb.h>
#include <zephyr/dt-bindings/misc/nordic-domain-id-nrf9230.h>
#include <zephyr/dt-bindings/misc/nordic-owner-id-nrf9230.h>
#include <zephyr/dt-bindings/reserved-memory/nordic-owned-memory.h>
#include <zephyr/dt-bindings/clock/nrf-auxpll.h>

/delete-node/ &sw_pwm;

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpuapp: cpu@2 {
			compatible = "arm,cortex-m33";
			reg = <2>;
			device_type = "cpu";
			clock-frequency = <DT_FREQ_M(320)>;
		};

		cpurad: cpu@3 {
			compatible = "arm,cortex-m33";
			reg = <3>;
			device_type = "cpu";
			clock-frequency = <DT_FREQ_M(256)>;
		};

		cpuppr: cpu@d {
			compatible = "nordic,vpr", "riscv";
			reg = <13>;
			device_type = "cpu";
			clock-frequency = <DT_FREQ_M(16)>;
			riscv,isa-base = "rv32e";
			riscv,isa-extensions = "e", "m", "c", "zicsr";
			nordic,bus-width = <32>;

			cpuppr_vevif_rx: mailbox {
				compatible = "nordic,nrf-vevif-task-rx";
				interrupt-parent = <&cpuppr_clic>;
				interrupts = <0 NRF_DEFAULT_IRQ_PRIORITY>,
					     <1 NRF_DEFAULT_IRQ_PRIORITY>,
					     <2 NRF_DEFAULT_IRQ_PRIORITY>,
					     <3 NRF_DEFAULT_IRQ_PRIORITY>,
					     <4 NRF_DEFAULT_IRQ_PRIORITY>,
					     <5 NRF_DEFAULT_IRQ_PRIORITY>,
					     <6 NRF_DEFAULT_IRQ_PRIORITY>,
					     <7 NRF_DEFAULT_IRQ_PRIORITY>,
					     <8 NRF_DEFAULT_IRQ_PRIORITY>,
					     <9 NRF_DEFAULT_IRQ_PRIORITY>,
					     <10 NRF_DEFAULT_IRQ_PRIORITY>,
					     <11 NRF_DEFAULT_IRQ_PRIORITY>,
					     <12 NRF_DEFAULT_IRQ_PRIORITY>,
					     <13 NRF_DEFAULT_IRQ_PRIORITY>,
					     <14 NRF_DEFAULT_IRQ_PRIORITY>,
					     <15 NRF_DEFAULT_IRQ_PRIORITY>;
				#mbox-cells = <1>;
				nordic,tasks = <16>;
				nordic,tasks-mask = <0x0000fff0>;
				status = "disabled";
			};
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;

		suit_storage_partition: memory@e6b7000 {
			reg = <0xe6b7000 DT_SIZE_K(40)>;
		};
	};

	clocks {
		hfxo: hfxo {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <DT_FREQ_M(64)>;
			status = "disabled";
		};

		lfxo: lfxo {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32768>;
			status = "disabled";
		};

		fll16m: fll16m {
			compatible = "nordic,nrf-fll16m";
			#clock-cells = <0>;
			clock-frequency = <DT_FREQ_M(16)>;
			open-loop-accuracy-ppm = <20000>;
			open-loop-startup-time-us = <200>; /* To be measured */
			clocks = <&hfxo>, <&lfxo>;
			clock-names = "hfxo", "lfxo";
		};

		hsfll120: hsfll120 {
			compatible = "nordic,nrf-hsfll-global";
			clocks = <&fll16m>;
			#clock-cells = <0>;
			clock-frequency = <320000000>;
			supported-clock-frequencies = <64000000
						       128000000
						       256000000
						       320000000>;
		};

		lfclk: lfclk {
			compatible = "nordic,nrfs-lfclk";
			#clock-cells = <0>;
			clock-frequency = <32768>;
			lfrc-accuracy-ppm = <500>;
			lflprc-accuracy-ppm = <1000>;
			lfrc-startup-time-us = <200>; /* To be measured */
			lflprc-startup-time-us = <200>; /* To be measured */
			clocks = <&hfxo>, <&lfxo>;
			clock-names = "hfxo", "lfxo";
			status = "okay";
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;

		uicr: uicr@fff8000 {
			compatible = "nordic,nrf-uicr";
			reg = <0xfff8000 DT_SIZE_K(3)>;
			ranges = <0x0 0xfff8000 DT_SIZE_K(3)>;
			#address-cells = <1>;
			#size-cells = <1>;

			bicr: bicr@800 {
				compatible = "nordic,nrf-bicr";
				reg = <0x800 204>;
			};
		};

		ficr: ficr@fffe000 {
			compatible = "nordic,nrf-ficr";
			reg = <0xfffe000 DT_SIZE_K(2)>;
			#nordic,ficr-cells = <1>;
		};

		cpuapp_ram0: sram@22000000 {
			compatible = "mmio-sram";
			reg = <0x22000000 DT_SIZE_K(32)>;
			ranges = <0x0 0x22000000 0x8000>;
			#address-cells = <1>;
			#size-cells = <1>;
		};

		cpurad_ram0: sram@23000000 {
			compatible = "mmio-sram";
			reg = <0x23000000 DT_SIZE_K(192)>;
			ranges = <0x0 0x23000000 0x30000>;
			#address-cells = <1>;
			#size-cells = <1>;
		};

		cpurad_ram1: sram@23040000 {
			compatible = "mmio-sram";
			reg = <0x23040000 DT_SIZE_K(32)>;
			ranges = <0x0 0x23040000 0x8000>;
			#address-cells = <1>;
			#size-cells = <1>;
		};

		cpuapp_peripherals: peripheral@52000000 {
			ranges = <0x0 0x52000000 0x1000000>;
			#address-cells = <1>;
			#size-cells = <1>;

			cpuapp_ieee802154: ieee802154 {
				compatible = "nordic,nrf-ieee802154";
				status = "disabled";
			};

			cpuapp_hsfll: clock@d000 {
				compatible = "nordic,nrf-hsfll-local";
				reg = <0xd000 0x1000>;
				#clock-cells = <0>;
				clocks = <&fll16m>;
				clock-frequency = <DT_FREQ_M(320)>;
				nordic,ficrs = <&ficr
						NRF_FICR_TRIM_APPLICATION_HSFLL_TRIM_VSUP>,
					       <&ficr
						NRF_FICR_TRIM_APPLICATION_HSFLL_TRIM_COARSE_0>,
					       <&ficr
						NRF_FICR_TRIM_APPLICATION_HSFLL_TRIM_FINE_0>;
				nordic,ficr-names = "vsup", "coarse", "fine";
			};

			cpuapp_ipct: ipct@13000 {
				compatible = "nordic,nrf-ipct-local";
				reg = <0x13000 0x1000>;
				channels = <4>;
				interrupts = <64 NRF_DEFAULT_IRQ_PRIORITY>,
					     <65 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			cpuapp_wdt010: watchdog@14000 {
				compatible = "nordic,nrf-wdt";
				reg = <0x14000 0x1000>;
				interrupts = <20 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			cpuapp_wdt011: watchdog@15000 {
				compatible = "nordic,nrf-wdt";
				reg = <0x15000 0x1000>;
				interrupts = <21 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			cpuapp_resetinfo: resetinfo@1e000 {
				compatible = "nordic,nrf-resetinfo";
				reg = <0x1e000 0x1000>;
			};
		};

		cpurad_peripherals: peripheral@53000000 {
			ranges = <0x0 0x53000000 0x1000000>;
			#address-cells = <1>;
			#size-cells = <1>;

			cpurad_hsfll: clock@d000 {
				compatible = "nordic,nrf-hsfll-local";
				reg = <0xd000 0x1000>;
				#clock-cells = <0>;
				clocks = <&fll16m>;
				clock-frequency = <DT_FREQ_M(256)>;
				nordic,ficrs = <&ficr NRF_FICR_TRIM_RADIOCORE_HSFLL_TRIM_VSUP>,
					       <&ficr NRF_FICR_TRIM_RADIOCORE_HSFLL_TRIM_COARSE_1>,
					       <&ficr NRF_FICR_TRIM_RADIOCORE_HSFLL_TRIM_FINE_1>;
				nordic,ficr-names = "vsup", "coarse", "fine";
			};

			cpurad_wdt010: watchdog@13000 {
				compatible = "nordic,nrf-wdt";
				reg = <0x13000 0x1000>;
				interrupts = <19 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			cpurad_wdt011: watchdog@14000 {
				compatible = "nordic,nrf-wdt";
				reg = <0x14000 0x1000>;
				interrupts = <20 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			cpurad_resetinfo: resetinfo@1e000 {
				compatible = "nordic,nrf-resetinfo";
				reg = <0x1e000 0x1000>;
			};

			dppic020: dppic@22000 {
				compatible = "nordic,nrf-dppic-local";
				reg = <0x22000 0x1000>;
				channels = <32>;
				groups = <4>;
				status = "disabled";
			};

			cpurad_ipct: ipct@24000 {
				compatible = "nordic,nrf-ipct-local";
				reg = <0x24000 0x1000>;
				channels = <8>;
				interrupts = <64 NRF_DEFAULT_IRQ_PRIORITY>,
					     <65 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			egu020: egu@25000 {
				compatible = "nordic,nrf-egu";
				reg = <0x25000 0x1000>;
				interrupts = <37 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			timer020: timer@28000 {
				compatible = "nordic,nrf-timer";
				reg = <0x28000 0x1000>;
				cc-num = <8>;
				interrupts = <40 NRF_DEFAULT_IRQ_PRIORITY>;
				max-bit-width = <32>;
				clocks = <&hfxo>;
				prescaler = <0>;
				status = "disabled";
			};

			timer021: timer@29000 {
				compatible = "nordic,nrf-timer";
				reg = <0x29000 0x1000>;
				cc-num = <8>;
				interrupts = <41 NRF_DEFAULT_IRQ_PRIORITY>;
				max-bit-width = <32>;
				clocks = <&hfxo>;
				prescaler = <0>;
				status = "disabled";
			};

			timer022: timer@2a000 {
				compatible = "nordic,nrf-timer";
				reg = <0x2a000 0x1000>;
				cc-num = <8>;
				interrupts = <42 NRF_DEFAULT_IRQ_PRIORITY>;
				max-bit-width = <32>;
				clocks = <&hfxo>;
				prescaler = <0>;
				status = "disabled";
			};

			rtc: rtc@2b000 {
				compatible = "nordic,nrf-rtc";
				reg = <0x2b000 0x1000>;
				cc-num = <4>;
				clock-frequency = <32768>;
				interrupts = <43 NRF_DEFAULT_IRQ_PRIORITY>;
				prescaler = <1>;
				status = "disabled";
			};

			radio: radio@2c000 {
				compatible = "nordic,nrf-radio";
				reg = <0x2c000 0x1000>;
				ble-2mbps-supported;
				ble-coded-phy-supported;
				dfe-supported;
				ieee802154-supported;
				interrupts = <44 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";

				cpurad_ieee802154: ieee802154 {
					compatible = "nordic,nrf-ieee802154";
					status = "disabled";
				};
			};

			ccm030: ccm@3a000 {
				compatible = "nordic,nrf-ccm";
				reg = <0x3a000 0x1000>;
				interrupts = <58 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			ecb030: ecb@3b000 {
				compatible = "nordic,nrf-ecb";
				reg = <0x3b000 0x1000>;
				interrupts = <59 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			ccm031: ccm@3c000 {
				compatible = "nordic,nrf-ccm";
				reg = <0x3c000 0x1000>;
				interrupts = <60 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			ecb031: ecb@3d000 {
				compatible = "nordic,nrf-ecb";
				reg = <0x3d000 0x1000>;
				interrupts = <61 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};
		};

		global_peripherals: peripheral@5f000000 {
			ranges = <0x0 0x5f000000 0x1000000>;
			#address-cells = <1>;
			#size-cells = <1>;

			usbhs: usbhs@86000 {
				compatible = "nordic,nrf-usbhs", "snps,dwc2";
				reg = <0x86000 0x1000>, <0x2f700000 0x40000>;
				reg-names = "wrapper", "core";
				interrupts = <134 NRF_DEFAULT_IRQ_PRIORITY>;
				num-in-eps = <8>;
				num-out-eps = <10>;
				ghwcfg1 = <0xaa555000>;
				ghwcfg2 = <0x22abfc72>;
				ghwcfg4 = <0x1e10aa60>;
				status = "disabled";
			};

			exmif: exmif@95000 {
				compatible = "nordic,nrf-exmif", "snps,designware-ssi";
				reg = <0x95000 0x500 0x95500 0xb00>;
				#address-cells = <1>;
				#size-cells = <0>;
				reg-names = "wrapper", "core";
				interrupts = <149 NRF_DEFAULT_IRQ_PRIORITY>;
				clock-frequency = <DT_FREQ_M(400)>;
				packet-data-limit = <65536>;
				fifo-depth = <32>;
				memmap-write-support;
				status = "disabled";
			};

			cpusec_bellboard: mailbox@99000 {
				reg = <0x99000 0x1000>;
				#mbox-cells = <1>;
				status = "disabled";
			};

			cpuapp_bellboard: mailbox@9a000 {
				reg = <0x9a000 0x1000>;
				#mbox-cells = <1>;
				status = "disabled";
			};

			cpurad_bellboard: mailbox@9b000 {
				reg = <0x9b000 0x1000>;
				#mbox-cells = <1>;
				status = "disabled";
			};

			cpucell_bellboard: mailbox@9c000 {
				reg = <0x9c000 0x1000>;
				#mbox-cells = <1>;
				status = "disabled";
			};

			canpll: clock-controller@8c2000 {
				compatible = "nordic,nrf-auxpll";
				reg = <0x8c2000 0x1000>;
				interrupts = <194 NRF_DEFAULT_IRQ_PRIORITY>;
				clocks = <&hfxo>;
				#clock-cells = <0>;
				nordic,ficrs = <&ficr NRF_FICR_TRIM_GLOBAL_CANPLL_TRIM_CTUNE>;
				nordic,frequency = <NRF_AUXPLL_FREQ_DIV_MIN>;
				nordic,out-div = <2>;
				nordic,out-drive = <0>;
				nordic,current-tune = <6>;
				nordic,sdm-disable;
				nordic,range = "high";
				status = "disabled";
			};

			cpusys_vevif_tx: mailbox@8c8000 {
				compatible = "nordic,nrf-vevif-task-tx";
				reg = <0x8c8000 0x1000>;
				#mbox-cells = <1>;
				nordic,tasks = <32>;
				nordic,tasks-mask = <0xfffff0ff>;
				status = "disabled";
			};

			ipct120: ipct@8d1000 {
				compatible = "nordic,nrf-ipct-global";
				reg = <0x8d1000 0x1000>;
				channels = <8>;
				global-domain-id = <12>;
				status = "disabled";
			};

			dppic120: dppic@8e1000 {
				compatible = "nordic,nrf-dppic-global";
				reg = <0x8e1000 0x1000>;
				channels = <8>;
				groups = <2>;
				status = "disabled";
			};

			timer120: timer@8e2000 {
				compatible = "nordic,nrf-timer";
				reg = <0x8e2000 0x1000>;
				cc-num = <6>;
				interrupts = <226 NRF_DEFAULT_IRQ_PRIORITY>;
				max-bit-width = <32>;
				clocks = <&hsfll120>;
				prescaler = <0>;
				status = "disabled";
			};

			timer121: timer@8e3000 {
				compatible = "nordic,nrf-timer";
				reg = <0x8e3000 0x1000>;
				cc-num = <6>;
				interrupts = <227 NRF_DEFAULT_IRQ_PRIORITY>;
				max-bit-width = <32>;
				clocks = <&hsfll120>;
				prescaler = <0>;
				status = "disabled";
			};

			pwm120: pwm@8e4000 {
				compatible = "nordic,nrf-pwm";
				reg = <0x8e4000 0x1000>;
				interrupts = <228 NRF_DEFAULT_IRQ_PRIORITY>;
				#pwm-cells = <3>;
				idleout-supported;
				status = "disabled";
			};

			spi120: spi@8e6000 {
				compatible = "nordic,nrf-spim";
				reg = <0x8e6000 0x1000>;
				easydma-maxcnt-bits = <15>;
				interrupts = <230 NRF_DEFAULT_IRQ_PRIORITY>;
				max-frequency = <DT_FREQ_M(32)>;
				#address-cells = <1>;
				#size-cells = <0>;
				rx-delay-supported;
				rx-delay = <1>;
				nordic,clockpin-enable = <NRF_FUN_SPIM_SCK>,
							 <NRF_FUN_SPIS_SCK>;
				status = "disabled";
			};

			uart120: uart@8e6000 {
				compatible = "nordic,nrf-uarte";
				reg = <0x8e6000 0x1000>;
				interrupts = <230 NRF_DEFAULT_IRQ_PRIORITY>;
				endtx-stoptx-supported;
				frame-timeout-supported;
				status = "disabled";
			};

			spi121: spi@8e7000 {
				compatible = "nordic,nrf-spim";
				reg = <0x8e7000 0x1000>;
				easydma-maxcnt-bits = <15>;
				interrupts = <231 NRF_DEFAULT_IRQ_PRIORITY>;
				max-frequency = <DT_FREQ_M(32)>;
				#address-cells = <1>;
				#size-cells = <0>;
				rx-delay-supported;
				rx-delay = <1>;
				nordic,clockpin-enable = <NRF_FUN_SPIM_SCK>,
							 <NRF_FUN_SPIS_SCK>;
				status = "disabled";
			};

			cpuppr_vpr: vpr@908000 {
				compatible = "nordic,nrf-vpr-coprocessor";
				reg = <0x908000 0x1000>;
				ranges = <0x0 0x908000 0x1000>;
				#address-cells = <1>;
				#size-cells = <1>;
				status = "disabled";

				cpuppr_vevif_tx: mailbox@0 {
					compatible = "nordic,nrf-vevif-task-tx";
					reg = <0x0 0x1000>;
					#mbox-cells = <1>;
					nordic,tasks = <16>;
					nordic,tasks-mask = <0x0000fff0>;
					status = "disabled";
				};
			};

			ipct130: ipct@921000 {
				compatible = "nordic,nrf-ipct-global";
				reg = <0x921000 0x1000>;
				channels = <8>;
				global-domain-id = <13>;
				status = "disabled";
			};

			dppic130: dppic@922000 {
				compatible = "nordic,nrf-dppic-global";
				reg = <0x922000 0x1000>;
				channels = <8>;
				groups = <2>;
				status = "disabled";
			};

			rtc130: rtc@928000 {
				compatible = "nordic,nrf-rtc";
				reg = <0x928000 0x1000>;
				cc-num = <4>;
				clock-frequency = <32768>;
				interrupts = <296 NRF_DEFAULT_IRQ_PRIORITY>;
				prescaler = <1>;
				status = "disabled";
			};

			rtc131: rtc@929000 {
				compatible = "nordic,nrf-rtc";
				reg = <0x929000 0x1000>;
				cc-num = <4>;
				clock-frequency = <32768>;
				interrupts = <297 NRF_DEFAULT_IRQ_PRIORITY>;
				prescaler = <1>;
				status = "disabled";
			};

			wdt131: watchdog@92b000 {
				compatible = "nordic,nrf-wdt";
				reg = <0x92b000 0x1000>;
				interrupts = <299 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			wdt132: watchdog@92c000 {
				compatible = "nordic,nrf-wdt";
				reg = <0x92c000 0x1000>;
				interrupts = <300 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			gpiote130: gpiote@934000 {
				compatible = "nordic,nrf-gpiote";
				reg = <0x934000 0x1000>;
				instance = <130>;
				status = "disabled";
			};

			gpiote131: gpiote@935000 {
				compatible = "nordic,nrf-gpiote";
				reg = <0x935000 0x1000>;
				instance = <131>;
				status = "disabled";
			};

			gpio0: gpio@938000 {
				compatible = "nordic,nrf-gpio";
				reg = <0x938000 0x200>;
				#gpio-cells = <2>;
				gpio-controller;
				gpiote-instance = <&gpiote130>;
				ngpios = <13>;
				port = <0>;
				status = "disabled";
			};

			gpio1: gpio@938200 {
				compatible = "nordic,nrf-gpio";
				reg = <0x938200 0x200>;
				#gpio-cells = <2>;
				gpio-controller;
				gpiote-instance = <&gpiote130>;
				ngpios = <12>;
				port = <1>;
				status = "disabled";
			};

			gpio2: gpio@938400 {
				compatible = "nordic,nrf-gpio";
				reg = <0x938400 0x200>;
				#gpio-cells = <2>;
				gpio-controller;
				gpiote-instance = <&gpiote130>;
				ngpios = <12>;
				port = <2>;
				status = "disabled";
			};

			gpio6: gpio@938c00 {
				compatible = "nordic,nrf-gpio";
				reg = <0x938c00 0x200>;
				#gpio-cells = <2>;
				gpio-controller;
				ngpios = <14>;
				port = <6>;
				status = "disabled";
			};

			gpio8: gpio@939000 {
				compatible = "nordic,nrf-gpio";
