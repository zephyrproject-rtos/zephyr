		#address-cells = <1>;
		#size-cells = <1>;

		cpuppr_clic: interrupt-controller@5f909000 {
			compatible = "nordic,nrf-clic";
			reg = <0x5f909000 0x3000>;
			#interrupt-cells = <2>;
			interrupt-controller;
			#address-cells = <1>;
			status = "disabled";
		};
	};

	temp_nrfs: temp {
		compatible = "nordic,nrf-temp-nrfs";
		status = "disabled";
	};
};
