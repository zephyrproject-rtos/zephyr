		mram1x_controller: mram-controller@5f092000 {
			compatible = "nordic,mram";
			reg = <0x5f092000 0x2000>;
			ranges = <0x0 0xe000000 DT_SIZE_K(8192)>;
			#address-cells = <1>;
			#size-cells = <1>;

			mram1x: mram-memory@0 {
				compatible = "soc-nv-flash";
				reg = <0x0 DT_SIZE_K(8192)>;
				ranges;
				erase-block-size = <4096>;
				write-block-size = <16>;
				#address-cells = <1>;
				#size-cells = <1>;

				mram10: mram-bank@0 {
					reg = <0 DT_SIZE_K(6144)>;
				};

				mram11: mram-bank@600000 {
					reg = <DT_SIZE_K(6144) DT_SIZE_K(2048)>;
				};
			};
		};

		tdd_peripherals: peripheral@bf000000 {
			reg = <0xbf000000 0x1000000>;
			ranges = <0x0 0xbf000000 0x1000000>;
			#address-cells = <1>;
			#size-cells = <1>;

			tbm: tbm@3000 {
				compatible = "nordic,nrf-tbm";
				reg = <0x3000 0x408>;
				interrupts = <127 NRF_DEFAULT_IRQ_PRIORITY>;
				status = "disabled";
			};

			hsfll200: clock@4000 {
				compatible = "fixed-clock";
				reg = <0x4000 0x1000>;
				#clock-cells = <0>;
				clock-frequency = <DT_FREQ_M(320)>;
				status = "disabled";
			};
		};
	};

	cpuapp_ppb: cpuapp-ppb-bus {
		#address-cells = <1>;
		#size-cells = <1>;

		cpuapp_systick: timer@e000e010 {
			compatible = "arm,armv8m-systick";
			reg = <0xe000e010 0x10>;
			status = "disabled";
		};

		cpuapp_nvic: interrupt-controller@e000e100 {
			compatible = "arm,v8m-nvic";
			reg = <0xe000e100 0xc00>;
			#interrupt-cells = <2>;
			interrupt-controller;
			#address-cells = <1>;
			arm,num-irq-priority-bits = <3>;
		};
	};

	cpurad_ppb: cpurad-ppb-bus {
		#address-cells = <1>;
		#size-cells = <1>;

		cpurad_systick: timer@e000e010 {
