/*
 * ESP_CPU_INTERRUPT(n, flags) defines the "espressif,esp32-cpu-interrupt"
 * node of CPU line n.
 *
 * Use inside the "espressif,esp32-intc" node, next to the &intmux node. The
 * result is node and label cpu_interrupt_<n>, an interrupt nexus whose single
 * map row sends every consumer to intmux as <n flags source>: the mask reduces
 * any consumer cell to the row key 0, and pass-thru copies the consumer cell
 * (the matrix source) into the rightmost parent cell. The line is written
 * once, for both "cpu-line" and the map.
 *
 * flags apply to the whole line and are 0 or ESP_INTR_FLAG_IRAM, which keeps
 * the line unmasked while the flash cache is off; the intc driver rejects any
 * other flag at build time.
 *
 * n is the CPU interrupt line as a plain decimal number.
 */

#define ESP_CPU_INTERRUPT(n, flags)                                                                \
	cpu_interrupt_##n: cpu_interrupt_##n {                                                     \
		compatible = "espressif,esp32-cpu-interrupt";                                      \
		#interrupt-cells = <1>;                                                            \
		#address-cells = <0>;                                                              \
		cpu-line = <n>;                                                                    \
		interrupt-map-mask = <0>;                                                          \
		interrupt-map-pass-thru = <0xffffffff>;                                            \
		interrupt-map = <0 &intmux n (flags) 0>;                                           \
	};
