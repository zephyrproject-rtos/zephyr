#include <zephyr/dt-bindings/pinctrl/infineon-aurix-pinctrl.h>

/* TC4Dx data sheet v1.2, port function tables */
&pinctrl {
	/omit-if-no-ref/ asclin0_tx_p14_0: asclin0_tx_p14_0 {
		pinmux = <AURIX_PINMUX(14, 0, 2)>;
		output-enable;
	};

	/omit-if-no-ref/ asclin0_rx_p14_1: asclin0_rx_p14_1 {
		pinmux = <AURIX_PINMUX(14, 1, 0)>;
	};
};
