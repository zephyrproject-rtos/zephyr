#include <infineon/tc4x/tc4x.dtsi>

/ {
	/* Data scratch-pad RAM of CPU0 */
	dsram0: memory@70000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x70000000 DT_SIZE_K(240)>;
		zephyr,memory-region = "DSRAM0";
	};
};

&flashctrl {
	flash0: flash@80000000 {
		compatible = "soc-nv-flash";
		reg = <0x80000000 DT_SIZE_M(4)>;
		ranges = <0x0 0x80000000 DT_SIZE_M(4)>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&pinctrl {
	p03: gpio@f003ac00 {
		compatible = "infineon,aurix-tc4x-gpio", "infineon,aurix-gpio";
		reg = <0xf003ac00 0x400>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <16>;
		status = "disabled";
	};
};
