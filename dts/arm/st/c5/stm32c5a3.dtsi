#include <st/c5/stm32c593.dtsi>

/ {
	soc {
		compatible = "st,stm32c5a3", "st,stm32c5", "simple-bus";

		xspi1: spi@47001400 {
			compatible = "st,stm32-xspi";
			reg = <0x47001400 0x400>, <0x90000000 DT_SIZE_M(16)>;
			interrupts = <91 0>;
			clock-names = "xspix", "xspi-ker";
			clocks = <&rcc STM32_CLOCK(AHB4, 20)>,
				 <&rcc STM32_SRC_HSIK XSPI1_SEL(2)>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};
	};
};
