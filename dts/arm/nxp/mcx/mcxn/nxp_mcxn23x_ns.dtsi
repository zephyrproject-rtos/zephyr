/ {
	soc {
		sram: sram@4000000 {
			ranges = <0x4000000 0x4000000 0x20000000>;
		};

		peripheral: peripheral@40000000 {
			ranges = <0x0 0x40000000 0x10000000>;
		};
	};
};

#include "nxp_mcxn23x_common.dtsi"

/*
 * Explicit non-secure identity ranges for flash, mirroring the
 * secure-alias override in nxp_mcxn23x.dtsi.
 */
&flash {
	ranges = <0x0 0x0 0x4000000>;
};
