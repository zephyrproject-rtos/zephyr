		compatible = "nxp,lpit";
		reg = <0x42860000 0x1000>;
		interrupts = <116 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPIT1,
					   IMX_CCM_ROOT_MAIN_LPIT1_FCLK)>;
		max-load-value = <0xffffffff>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";

		lpit1_channel0: lpit_channel@0 {
			compatible = "nxp,lpit-channel";
			reg = <0>;
			status = "disabled";
		};

		lpit1_channel1: lpit_channel@1 {
			compatible = "nxp,lpit-channel";
			reg = <1>;
