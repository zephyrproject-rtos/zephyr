	/* LPTMR (WAKE domain), IRQ 222/223 */
	lptmr1: wake_lptmr_0: timer@46130000 {
		compatible = "nxp,lptmr";
		reg = <0x46130000 0x1000>;
		interrupts = <222 0>;
		clock-frequency = <DT_FREQ_M(80)>;
		prescale-glitch-filter-bypass;
		clk-source = <0>;
		resolution = <32>;
		status = "disabled";
	};

	lptmr2: wake_lptmr_1: timer@46140000 {
		compatible = "nxp,lptmr";
		reg = <0x46140000 0x1000>;
		interrupts = <223 0>;
		clock-frequency = <DT_FREQ_M(80)>;
		prescale-glitch-filter-bypass;
		clk-source = <0>;
		resolution = <32>;
		status = "disabled";
	};

	lptmr0: vbat_lptmr: timer@46330000 {
		compatible = "nxp,lptmr";
		reg = <0x46330000 0x1000>;
		interrupts = <250 0>;
		clock-frequency = <DT_FREQ_M(80)>;
		prescale-glitch-filter-bypass;
		clk-source = <0>;
		resolution = <32>;
		status = "disabled";
	};

