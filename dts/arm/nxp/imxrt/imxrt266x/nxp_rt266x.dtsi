	/* eDMA3 (MAIN domain) version 4. Channels 0..31 = IRQ 29..60. */
	edma0: main_edma3: dma-controller@400e0000 {
		#dma-cells = <2>;
		compatible = "nxp,mcux-edma";
		nxp,version = <4>;
		reg = <0x400e0000 0x20000>;
		dma-channels = <32>;
		/* eDMA3 takes the Mux1 request set, whose highest source is 200. */
		dma-requests = <201>;
		no-error-irq;
		interrupts = <29 0>, <30 0>, <31 0>, <32 0>,
			     <33 0>, <34 0>, <35 0>, <36 0>,
			     <37 0>, <38 0>, <39 0>, <40 0>,
			     <41 0>, <42 0>, <43 0>, <44 0>,
			     <45 0>, <46 0>, <47 0>, <48 0>,
			     <49 0>, <50 0>, <51 0>, <52 0>,
			     <53 0>, <54 0>, <55 0>, <56 0>,
			     <57 0>, <58 0>, <59 0>, <60 0>;
		status = "disabled";
	};

	edma1: main_edma5: dma-controller@40300000 {
		#dma-cells = <2>;
		compatible = "nxp,mcux-edma";
		nxp,version = <5>;
		reg = <0x40300000 0x20000>;
		dma-channels = <16>;
		/* eDMA5 takes the Mux0 request set, whose highest source is 76. */
		dma-requests = <77>;
		no-error-irq;
		interrupts = <61 0>, <62 0>, <63 0>, <64 0>,
			     <65 0>, <66 0>, <67 0>, <68 0>,
			     <69 0>, <70 0>, <71 0>, <72 0>,
			     <73 0>, <74 0>, <75 0>, <76 0>;
		status = "disabled";
	};

	edma2: wake_edma3: dma-controller@46270000 {
		#dma-cells = <2>;
		compatible = "nxp,mcux-edma";
		nxp,version = <4>;
		reg = <0x46270000 0x20000>;
		dma-channels = <8>;
		/* The WAKE eDMA takes the Mux3 request set, highest source 37. */
		dma-requests = <38>;
		no-error-irq;
		interrupts = <208 0>, <209 0>, <210 0>, <211 0>,
			     <212 0>, <213 0>, <214 0>, <215 0>;
		status = "disabled";
	};

	edma3: audio_edma3: dma-controller@48170000 {
		#dma-cells = <2>;
		compatible = "nxp,mcux-edma";
		nxp,version = <4>;
		reg = <0x48170000 0x20000>;
		dma-channels = <8>;
		/* The AUDIO eDMA takes the Mux2 request set, highest source 22. */
		dma-requests = <23>;
		no-error-irq;
		interrupts = <271 0>, <272 0>, <273 0>, <274 0>,
			     <275 0>, <276 0>, <277 0>, <278 0>;
		status = "disabled";
	};

	/* USDHC (COMM domain), IRQ 307/308 */
	usdhc0: comm_usdhc_0: memory-controller@4a080000 {
		compatible = "nxp,imx-usdhc";
		reg = <0x4a080000 0x10000>;
		interrupts = <307 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_COMM_USDHC0,
					   IMX_CCM_ROOT_COMM_USDHC0_FCLK)>;
		max-current-330 = <1020>;
		max-current-180 = <1020>;
		max-bus-freq = <DT_FREQ_M(208)>;
		min-bus-freq = <DT_FREQ_K(400)>;
		status = "disabled";
	};

	usdhc1: comm_usdhc_1: memory-controller@4a090000 {
		compatible = "nxp,imx-usdhc";
		reg = <0x4a090000 0x10000>;
		interrupts = <308 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_COMM_USDHC1,
					   IMX_CCM_ROOT_COMM_USDHC1_FCLK)>;
		max-current-330 = <1020>;
		max-current-180 = <1020>;
		max-bus-freq = <DT_FREQ_M(208)>;
		min-bus-freq = <DT_FREQ_K(400)>;
		status = "disabled";
	};

	/* USB OTG (COMM domain) - EHCI controller, IRQ 304 */
	usb0: comm_usbc: usbd@4a0a0000 {
		compatible = "nxp,ehci";
		reg = <0x4a0a0000 0x200>;
		interrupts = <304 0>;
		interrupt-names = "usb_otg";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_COMM_USB0,
					   IMX_CCM_ROOT_COMM_USB0_PHYCLK)>;
		num-bidir-endpoints = <8>;
		status = "disabled";
	};

	usbphy0: comm_usbphy: usb-phy@4a0f0000 {
		compatible = "nxp,usbphy";
		reg = <0x4a0f0000 0x1000>;
		status = "disabled";
	};

	/* SAI (AUDIO domain), IRQ 256..258 */
	sai0: audio_sai_0: sai@480c0000 {
		compatible = "nxp,mcux-i2s";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x480c0000 0x10000>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_AUDIO_SAI0,
					   IMX_CCM_ROOT_AUDIO_SAI0_MCLK0)>;
		interrupts = <256 0>;
		nxp,tx-channel = <1>;
		status = "disabled";
	};

	sai1: audio_sai_1: sai@480d0000 {
		compatible = "nxp,mcux-i2s";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x480d0000 0x10000>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_AUDIO_SAI1,
					   IMX_CCM_ROOT_AUDIO_SAI1_MCLK0)>;
		interrupts = <257 0>;
		nxp,tx-channel = <1>;
		status = "disabled";
	};

	sai2: audio_sai_2: sai@480e0000 {
		compatible = "nxp,mcux-i2s";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x480e0000 0x10000>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_AUDIO_SAI2,
					   IMX_CCM_ROOT_AUDIO_SAI2_MCLK0)>;
		interrupts = <258 0>;
		nxp,tx-channel = <1>;
		status = "disabled";
	};

	/* Ethernet 1G MAC (COMM domain), IRQ 299/300/301/302 */
	enet: comm_enet: ethernet@4a0d0000 {
		compatible = "nxp,enet";
		reg = <0x4a0d0000 0x10000>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_COMM_ETH0,
					   IMX_CCM_ROOT_COMM_ETH0_TRXCLK)>;
		status = "disabled";

		enet_mac: ethernet {
			compatible = "nxp,enet-mac";
			interrupts = <299 0>, <300 0>;
			interrupt-names = "TX", "RX";
			nxp,mdio = <&enet_mdio>;
			ptp-clock = <&enet_ptp_clock>;
			status = "disabled";
		};

		enet_mdio: mdio {
			compatible = "nxp,enet-mdio";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		enet_ptp_clock: ptp_clock {
			compatible = "nxp,enet-ptp-clock";
			interrupts = <302 0>;
			interrupt-names = "IEEE1588_TMR";
			clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_COMM_ETH0,
						   IMX_CCM_ROOT_COMM_ETH0_TRXCLK)>;
			status = "disabled";
		};
	};

	enet_qos: comm_enet_qos: ethernet@4a0c0000 {
		compatible = "nxp,enet-qos";
		reg = <0x4a0c0000 0x10000>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_COMM_ETH1,
					   IMX_CCM_ROOT_COMM_ETH1_TRXCLK)>;
		status = "disabled";

		enet_qos_mac: ethernet {
			compatible = "nxp,enet-qos-mac", "snps,dwmac";
			interrupts = <296 0>, <297 0>, <298 0>;
			interrupt-names = "mac", "tx", "rx";
			status = "disabled";
		};

		enet_qos_mdio: mdio {
			compatible = "nxp,enet-qos-mdio";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};
	};

	/*
	 * Parallel CSI (MEDIA__CSI, NS alias 0x4C090000, MEDIA_CSI_IRQn = 326),
	 * described by the existing nxp,imx-csi binding.
	 *
	 * It is the only "Display and Graphics" peripheral with an applicable
	 * Zephyr binding today, so it is the only node the per-part overlays
	 * delete.
	 */
	csi: media_csi: csi@4c090000 {
		compatible = "nxp,imx-csi";
		reg = <0x4c090000 0x1000>;
		interrupts = <326 0>;
		status = "disabled";
	};

	/*
	 * XSPI controllers. Each instance has two AHB-mapped windows: the
	 * direct window at XSPI<n>_AMBA_BASE_NS and an LLC-cached alias
	 * 0x08000000 above it (MEM_XSPI<n>_LLC_START in fsl_memory.h):
	 *
	 *   XSPI0   direct 0x60000000   LLC-cached 0x68000000
	 *   XSPI1   direct 0x80000000   LLC-cached 0x88000000
	 *
	 * reg[1] is the direct window, which is what the device linker script
	 * XIPs from and therefore what CONFIG_FLASH_BASE_ADDRESS must resolve
	 * to (see soc/nxp/common/Kconfig.xspi_xip, which reads reg index 1 of
	 * the chosen flash node's grandparent). A board that places data in an
	 * external memory through the cached alias uses the +0x08000000
	 * address for that memory node, and then the LLC must be initialized
	 * before those accesses.
	 */

	/*
	 * The FlexSPI follower (COMM__FLEXSPI_FLR @ 0x4A0E0000, IRQ 303) is a
	 * peripheral-mode interface rather than a NOR controller, and has no
	 * Zephyr binding; it is deliberately not declared.
	 */
};

&xspi0 {
	compatible = "nxp,xspi";
	interrupts = <82 0>;
	/*
	 * The functional clock root belongs to this instance, not to the
	 * controller node: nothing else muxes from it, so the peripheral
	 * owns it (path-2). The declared values are the steady state --
	 * SYSPLLDIV4 (500 MHz) / 2 = 250 MHz, second divider 2 giving a
	 * 125 MHz SCK, close to the ROM's ~120 MHz operating point.
	 *
	 * These values are currently duplicated: soc_clock.c writes this
	 * root by hand from ITCM inside the PLL hand-over window, while
	 * XIP is parked, because the switch cuts the clock of the memory
	 * that window's caller executes from. That write does not read
	 * this node, so editing the cell alone changes what get_rate
	 * reports without changing the hardware -- keep the two in step.
	 *
	 * The XSPI driver does not call clock_control_configure() yet.
	 * Doing so means switching the clock of the memory the code is
	 * executing from, which needs the controller quiesced and
	 * disabled and the switching code resident in on-chip RAM -- that
	 * belongs in this driver when the feature lands, and is why the
	 * instance stays disabled for now.
	 */
	clock-names = "gate", "source";
	clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_XSPI0,
				   IMX_CCM_ROOT_MAIN_XSPI0_FCLK_DIVIDED)>,
		 <&ccm IMX_CCM_ROOT_CFG(IMX_CCM_ROOT_MAIN_XSPI0_FCLK_DIVIDED,
					IMX_CCM_MUX_XSPI0_SYSPLLDIV4, 2, 2)>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "disabled";
};

&xspi1 {
	compatible = "nxp,xspi";
	interrupts = <83 0>;
	/*
	 * Same ownership as xspi0, and the same duplication with
	 * soc_clock.c's in-window write: SYSPLLDIV4 (500 MHz) / 1, second
	 * divider 2, giving a 250 MHz SCK. That frequency is not free to
	 * change -- the ROM's DLL calibration for the Xccela PSRAM is tied
	 * to it, so a different value leaves the DDR read strobe
	 * misaligned.
	 */
	clock-names = "gate", "source";
	clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_XSPI1,
				   IMX_CCM_ROOT_MAIN_XSPI1_FCLK_DIVIDED)>,
		 <&ccm IMX_CCM_ROOT_CFG(IMX_CCM_ROOT_MAIN_XSPI1_FCLK_DIVIDED,
					IMX_CCM_MUX_XSPI1_SYSPLLDIV4, 1, 2)>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "disabled";
};

/*
 * GPIO pin count and pad mux, kept out of the node bodies so the peripheral
 * definitions stay readable. Both are SoC facts, not board configuration: the
 * same 151 pads on every part and both packages. The pinmux property is
 * positional -- the Nth phandle is that port's pin N -- and the lists are
 * generated from hal_nxp's canonical pinctrl file, whose pin nodes a board brings
 * in with its per-part include. Note gpio5 is VBAT and gpio6 is WAKE.
 */

&gpio0 {
	ngpios = <28>;
	pinmux = <&main__iomuxc_pio2_0_hsp_gpio0_gpio0>,
		 <&main__iomuxc_pio2_1_hsp_gpio0_gpio1>,
		 <&main__iomuxc_pio2_2_hsp_gpio0_gpio2>,
