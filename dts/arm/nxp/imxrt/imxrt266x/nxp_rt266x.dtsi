		 <&main__iomuxc_pio2_4_hsp_gpio0_gpio4>,
		 <&main__iomuxc_pio2_5_hsp_gpio0_gpio5>,
		 <&main__iomuxc_pio2_6_hsp_gpio0_gpio6>,
		 <&main__iomuxc_pio2_7_hsp_gpio0_gpio7>,
		 <&main__iomuxc_pio2_8_hsp_gpio0_gpio8>,
		 <&main__iomuxc_pio2_9_hsp_gpio0_gpio9>,
		 <&main__iomuxc_pio2_10_hsp_gpio0_gpio10>,
		 <&main__iomuxc_pio2_11_hsp_gpio0_gpio11>,
