#include <mem.h>
#include <freq.h>
#include <nxp/imxrt/imxrt266x/clock/imx_ccm_rev3_rt266x.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/*
 * i.MX RT266x shared peripheral tree. The CPU, its TCMs and its NVIC
 * configuration are in nxp_rt266x_cm85.dtsi.
 *
 * System SRAM declared here (RM 3.2 Table 6, system memory map (CM85)):
 *
 *   SRAM0  0x22000000   256K
 *   SRAM1  0x22040000   256K
 *   SRAM2  0x22080000   256K
 *
 * The core-local ITCM and DTCM are declared in the per-core file. The data
 * sheet's "1.5M SRAM" is the die total across the subsystem memory controllers;
 * these 768 KB are what the CM85 map exposes as general-purpose.
 *
 * No zephyr,memory-attr here: MPU regions come only from the generic
 * arm_mpu_regions.c (FLASH_0/SRAM_0 from the chosen nodes). Adding memory-attr
 * would program them from devicetree as well, and on ARMv8-M two enabled regions
 * over the same address are UNPREDICTABLE and fault when the MPU is enabled. A
 * memory that is neither chosen node does need it -- see the board files.
 */

/*
 * Family feature axes (IMXRT2660EC Table 3, per part in Table 2):
 *
 *              NPU (Neutron N256)   Display and Graphics
 *   MIMXRT2660        no                    no
 *   MIMXRT2661        yes                   no
 *   MIMXRT2662        no                    yes
 *   MIMXRT2663        yes                   yes
 *
 * Zephyr has no NPU binding, so that axis has no devicetree delta. On the
 * display axis only the parallel CSI has a binding, so it is the only node a
 * part removes.
 *
 * The memory and peripheral apertures this file's nodes sit in are declared by
 * the part file a board includes, which is what selects the secure or
 * non-secure view; this file is not usable on its own.
 */

/*
 * System SRAM. Offsets from the memory aperture, so these are the non-secure
 * addresses. The core-local TCMs are in the per-core file.
 */
&memory {
	sram0: memory@22000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x22000000 DT_SIZE_K(256)>;
		zephyr,memory-region = "SRAM0";
	};

	sram1: memory@22040000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x22040000 DT_SIZE_K(256)>;
		zephyr,memory-region = "SRAM1";
	};

	sram2: memory@22080000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x22080000 DT_SIZE_K(256)>;
		zephyr,memory-region = "SRAM2";
	};
};

/*
 * i.MX RT266x peripheral definitions shared by the whole die. Core-private nodes
 * are in the per-core file.
 *
 * All peripheral nodes use the non-secure (NS) peripheral base aliases
 * (0x4xxxxxxx). This matches the SoC pinctrl data generated into hal_nxp
 * (nxp/imxrt/imxrt266x/pinctrl/, one file per part and package; this board's
 * part uses mimxrt2663cvvaa-pinctrl.dtsi), whose pinmux tuples bake the NS
 * IOMUXC register addresses (MAIN 0x421Cxxxx, WAKE 0x4622xxxx, VBAT
 * 0x4636xxxx). The secure aliases (0x5xxxxxxx) are offset by +0x10000000 from
 * these.
 *
 * Register/interrupt values are taken from the device header:
 *   devices/RT/RT2660/MIMXRT2663/MIMXRT2663_COMMON.h
 * Clock IDs are the LPCG enum values from that device's fsl_clock.h, exposed
 * via <nxp/imxrt/imxrt266x/clock/imx_ccm_rev3_rt266x.h>.
 *
 * Peripherals are left "disabled" by default; boards enable what they use.
 */

&peripheral {
	/*
	 * CGU analog block -- the clocks this SoC *generates*, as against the CCM
	 * below, which *distributes* them. The two are different classes and are
	 * modelled differently: nothing calls clock_control on the sources here,
	 * because their bring-up is hazard-ordered and strongly SoC-specific, so the
	 * SoC layer owns them (soc_clock.c) and this node plus its children is a
	 * description of the hardware and a data table that C reads by node label.
	 * The CCM below is the clock_control abstraction and keeps its own shape.
	 *
	 * Values are the reference Over Drive Run tree; a board overrides what its
	 * hardware dictates -- the crystal above all, which is a board fact rather
	 * than a SoC one.
	 *
	 * Children are ordered by bring-up dependency rather than by address, which
	 * is the order the comments below read in. Each reg is an offset inside this
	 * block from the CGUANA_Type register map, split into control and status
	 * groups (plus a calibration group on the AVPLLs) because the block reserves
	 * address space between them. Offsets rather than absolute addresses, so this
	 * one file serves both the secure and non-secure views through `ranges`.
	 */
	cguana: clock-generation@40500000 {
		compatible = "nxp,imx-cguana";
		reg = <0x40500000 0x10000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x40500000 0x10000>;

		sxosc: sxosc@20a0 {
			compatible = "nxp,imx-cguana-sxosc", "nxp,imx-clock-source";
			reg = <0x20a0 0x4>, <0x20a8 0x4>;
			reg-names = "ctrl", "status";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
			/*
			 * TBD (board / hardware team): these trim values are the
			 * ones the SDK ships and are not measured. gm-sel is 4
			 * here while the reference manual's crystal table
			 * recommends 3 for a 24 MHz crystal, and the load
			 * capacitance trim has not been checked against the
			 * board's crystal and stray capacitance. Everything
			 * derived from the crystal inherits any error.
			 */
			nxp,gm-sel = <4>;
			nxp,cap-trim = <16>, <16>;
		};

		fro192m: fro192m@2060 {
			compatible = "nxp,imx-cguana-fro192m", "nxp,imx-clock-source";
			reg = <0x2060 0x4>, <0x206c 0x4>;
			reg-names = "ctrl", "status";
			#clock-cells = <0>;
			clock-frequency = <192000000>;
		};

		fro12m: fro12m@2080 {
			compatible = "nxp,imx-cguana-fro12m", "nxp,imx-clock-source";
			reg = <0x2080 0x4>, <0x208c 0x4>;
			reg-names = "ctrl", "status";
			#clock-cells = <0>;
			clock-frequency = <12000000>;
		};

		/* 24 MHz x 33 = 792 MHz, within the low VCO band. */
		core_pll: core-pll@20c0 {
			compatible = "nxp,imx-cguana-core-pll", "nxp,imx-clock-source";
			reg = <0x20c0 0xc>, <0x20d8 0x4>;
			reg-names = "ctrl", "status";
			#clock-cells = <0>;
			clocks = <&sxosc>;
			nxp,loop-div = <33>;
			clock-frequency = <792000000>;
		};

		/*
		 * 2 GHz VCO. The fractional outputs are what the compute and bus
		 * roots run from, so this is where the CPU frequency is decided:
		 * selector 8 on the second output is 2000 * 4 / 8 = 1000 MHz,
		 * which reaches CMPT cpu_clk through PLL_PFDX and MAIN_ROOTCLK.
		 */
		main_pll: main-pll@20f0 {
			compatible = "nxp,imx-cguana-frac-pll", "nxp,imx-clock-source";
			reg = <0x20f0 0x14>, <0x2114 0x4>;
			reg-names = "ctrl", "status";
			#clock-cells = <0>;
			clocks = <&sxosc>;
			nxp,vco-frequency = <2000000000>;
			nxp,int-divs = <5>, <8>, <10>, <20>;
			nxp,frac-div-sels = <12>, <8>, <10>;
		};

		/*
		 * 2 GHz VCO. The external memories run from this one: the clock
		 * bring-up moves XSPI0 and XSPI1 onto its DIV4 output so that
		 * flash and PSRAM stop depending on the main PLL and the main
		 * PLL can then be reconfigured.
		 */
		sys_pll: sys-pll@2130 {
			compatible = "nxp,imx-cguana-frac-pll", "nxp,imx-clock-source";
			reg = <0x2130 0x14>, <0x2154 0x4>;
			reg-names = "ctrl", "status";
			#clock-cells = <0>;
			clocks = <&sxosc>;
			nxp,vco-frequency = <2000000000>;
			nxp,int-divs = <5>, <8>, <10>, <20>;
			nxp,frac-div-sels = <8>, <8>, <16>;
		};

		/*
		 * Audio and Video PLLs. Locked fresh on the crystal after the
		 * reference hand-over. Audio: band 6, post-divide 16 -> 49.152
		 * MHz. Video: band 5, post-divide 11, fractional numerator
		 * 0x181B4E82 -> 70.64 MHz.
		 */
		avpll_audio: avpll-audio@2170 {
			compatible = "nxp,imx-cguana-avpll", "nxp,imx-clock-source";
			reg = <0x2170 0x10>, <0x2188 0x8>, <0x2190 0x4>;
			reg-names = "ctrl", "cal", "status";
			#clock-cells = <0>;
			clocks = <&sxosc>;
			nxp,cco-band-sel = <6>;
			nxp,post-div-ratio = <16>;
		};

		avpll_video: avpll-video@21b0 {
			compatible = "nxp,imx-cguana-avpll", "nxp,imx-clock-source";
			reg = <0x21b0 0x10>, <0x21c8 0x8>, <0x21d0 0x4>;
			reg-names = "ctrl", "cal", "status";
			#clock-cells = <0>;
			clocks = <&sxosc>;
			nxp,cco-band-sel = <5>;
			nxp,post-div-ratio = <11>;
			nxp,dnum = <0x181b4e82>;
		};
	};

	/*
	 * Clock distribution: seven CCM instances, one per subsystem. The HAL reaches
	 * all of them through one flat identifier space, so any instance resolves any
	 * specifier and every consumer names the CGU one, which carries the `ccm` label.
	 * A root is declared under the instance that owns it; nothing enforces that, so
	 * a misplaced root still works while describing the hardware wrongly.
	 *
	 * A root carries two numbers, neither derived from the other: reg is its
	 * register block in this instance (N * 0x10 for RM 20.8.1's CLOCK_ROOT<N>), and
	 * nxp,root-id is the flat identifier the HAL dispatches on.
	 *
	 * Two consequences of one device per instance, worth knowing before adding a
	 * root here:
	 *
	 *   - Order across instances is not controllable from this file: device init
	 *     order at equal priority follows the devicetree dependency ordinal, not
	 *     the order written here. Roots needing a fixed relative order must share
	 *     an instance, where devicetree order does govern. The instances are listed
	 *     by address because rearranging them buys nothing.
	 *   - Root programming is not atomic across instances. Nothing at PRE_KERNEL_1
	 *     consumes these roots today; the CMPT SysTick root is read at PRE_KERNEL_2.
	 */
	main_ccm: clock-controller@40060000 {
		compatible = "nxp,imx-ccm-rev3";
		reg = <0x40060000 0x4000>;
		#clock-cells = <1>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x40060000 0x4000>;
	};

	/*
	 * Steady-state clock roots, at their Over Drive Run values. Every
	 * mux/divider is a devicetree value, so a board or application
	 * overlay retargets a root without touching C.
	 *
	 * Who programs a root -> how it appears here:
	 *
	 *   Programmed by      When            Node here
	 *   -----------------  --------------  ----------------------
	 *   CCM controller     PRE_KERNEL_1    plain node
	 *                      init loop
	 *   SoC bring-up       soc_early_      plain node too -- the SoC
	 *   (soc_clock.c)      init_hook       reads it by label and
	 *                                      programs it early; the
	 *                                      controller re-applies the
	 *                                      same value later, which is
	 *                                      idempotent
	 *   Boot ROM, or       before the      node marked
	 *   soc_clock.c by     controller's    nxp,preconfigured
	 *   hand from ITCM     init loop runs  (controller skips it)
	 *   Owning peripheral  device init     no node -- inline "source"
	 *                      (its driver)    clocks entry on the device
	 *
	 * The marker means "the controller must not touch this", not
	 * "someone else also touches this" -- hence exactly one marked
	 * root here, sysplldiv4_rootclk. It feeds the XIP flash and the
	 * PSRAM, and the controller's init loop runs from that flash, so it
	 * must not write the slice for a value already correct. It stays a
	 * controller child because both XSPI instances source from it and a
	 * peripheral node carries only one "source" cell. A board booting
	 * from another medium can /delete-property/ the marker: the boot
	 * medium is a board fact, not a SoC fact.
	 *
	 * Scope: the PLL-distribution/PFD layer, the core and bus roots,
	 * and the peripheral roots this baseline uses. Unused SDK-residue
	 * roots are added per use.
	 */
	ccm: syscon_ccm: clock-controller@40510000 {
		compatible = "nxp,imx-ccm-rev3";
		reg = <0x40510000 0x4000>;
		#clock-cells = <1>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x40510000 0x4000>;

		/* PLL-distribution and PFD layer -- feeds the core, bus and XSPI roots. */
		/* CLOCK_ROOT3 */
		mainpll_divx_rootclk: clock-root@30 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x30 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_MAINPLL_DIVX>;
			clock-mux = <IMX_CCM_MUX_MAINPLL_DIVX_MAINPLL_DIV5>;
			clock-div = <1>;
		};

		/* CLOCK_ROOT4 */
		syspll_divx_rootclk: clock-root@40 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x40 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_SYSPLL_DIVX>;
			clock-mux = <IMX_CCM_MUX_SYSPLL_DIVX_SYSPLL_DIV5>;
			clock-div = <1>;
		};

		/* CLOCK_ROOT5 */
		pll_pfdx_rootclk: clock-root@50 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x50 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_PLL_PFDX>;
			clock-mux = <IMX_CCM_MUX_PLL_PFDX_MAINPLL_DIVOUT1>;
			clock-div = <1>;
		};

		/* CLOCK_ROOT6 */
		media_pfdx_rootclk: clock-root@60 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x60 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_MEDIA_PFDX>;
			clock-mux = <IMX_CCM_MUX_MEDIA_PFDX_SYSPLL_DIVOUT1>;
			clock-div = <1>;
		};

		/* CLOCK_ROOT7 */
		mainpfdx_rootclk: clock-root@70 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x70 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_MAINPFDX_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_MAINPFDX_SYSPLL_DIVOUT1>;
			clock-div = <1>;
		};

		/* CLOCK_ROOT8 */
		commpfdx_rootclk: clock-root@80 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x80 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_COMMPFDX_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_COMMPFDX_COREPLL_OUT>;
			clock-div = <1>;
		};

		/* CLOCK_ROOT9 */
		maindivx_rootclk: clock-root@90 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x90 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_MAINDIVX_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_MAINDIVX_MAINPLL_DIV5>;
			clock-div = <1>;
		};

		/* CLOCK_ROOT21 */
		sysplldiv4_rootclk: clock-root@150 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x150 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_SYSPLLDIV4_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_SYSPLLDIV4_SYSPLL_DIV4>;
			clock-div = <1>;
			nxp,preconfigured;
		};

		/* CLOCK_ROOT22 */
		sysplldiv5_rootclk: clock-root@160 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x160 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_SYSPLLDIV5_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_SYSPLLDIV5_SYSPLL_DIV5>;
			clock-div = <1>;
		};

		/* CLOCK_ROOT23 */
		sysplldivx_rootclk: clock-root@170 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x170 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_SYSPLLDIVX_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_SYSPLLDIVX_SYSPLL_DIV5>;
			clock-div = <1>;
		};

		/* CLOCK_ROOT24 */
		mainplldivx_rootclk: clock-root@180 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x180 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_MAINPLLDIVX_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_MAINPLLDIVX_MAINPLL_DIV5>;
			clock-div = <1>;
		};

		/*
		 * Core and bus roots (30-36). MAIN_ROOTCLK feeds the CM85 core
		 * through its divider (1000 MHz) and the MAIN bus through its
		 * second divider (333 MHz), so it uniquely sets clock-second-div.
		 */
		/* CLOCK_ROOT30 */
		main_rootclk: clock-root@1e0 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x1e0 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_MAIN_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_CGU_MAIN_PLL_PFDX>;
			clock-div = <1>;
			clock-second-div = <3>;
		};

		/* CLOCK_ROOT31 */
		npu_rootclk: clock-root@1f0 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x1f0 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_NPU_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_NPU_COREPLL_OUT>;
			clock-div = <1>;
		};

		/* CLOCK_ROOT32 */
		mediabus_rootclk: clock-root@200 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x200 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_MEDIABUS_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_MEDIABUS_PLL_PFDX>;
			clock-div = <3>;
		};

		/* CLOCK_ROOT33 */
		audiobus_rootclk: clock-root@210 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x210 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_AUDIOBUS_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_AUDIOBUS_MAINPLL_DIVX>;
			clock-div = <2>;
		};

		/* CLOCK_ROOT34 */
		commbus_rootclk: clock-root@220 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x220 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_COMMBUS_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_COMMBUS_MAINPLL_DIVX>;
			clock-div = <2>;
		};

		/* CLOCK_ROOT35 */
		wakebus_rootclk: clock-root@230 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x230 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_WAKEBUS_ROOTCLK>;
			clock-mux = <IMX_CCM_MUX_WAKEBUS_MAINPLL_DIVX>;
			clock-div = <10>;
		};

		/* CLOCK_ROOT36 */
		syscon_pdmain_rootclk: clock-root@240 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x240 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_SYSCON_PDMAIN_CLK>;
			clock-mux = <IMX_CCM_MUX_SYSCON_PDMAIN_SYSPLL_DIV10>;
			clock-div = <1>;
		};

		/* Peripheral distribution root used by the console LPUART. */
		/* CLOCK_ROOT40 */
		peri3_rootclk: clock-root@280 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x280 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CGU_PERI_ROOTCLK3>;
			clock-mux = <IMX_CCM_MUX_PERI3_MAINPLL_DIVX>;
			clock-div = <1>;
		};
	};

	cmpt_ccm: clock-controller@44060000 {
		compatible = "nxp,imx-ccm-rev3";
		reg = <0x44060000 0x4000>;
		#clock-cells = <1>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x44060000 0x4000>;

		/* CLOCK_ROOT3 */
		cmpt_systick0_rootclk: clock-root@30 {
			compatible = "nxp,imx-ccm-rev3-root";
			reg = <0x30 0x10>;
			nxp,root-id = <IMX_CCM_ROOT_CMPT_SYSTICK_CLK0>;
			clock-mux = <IMX_CCM_MUX_SYSTICK0_SXOSC>;
			clock-div = <1>;
		};
	};

	wake_ccm: clock-controller@46060000 {
		compatible = "nxp,imx-ccm-rev3";
		reg = <0x46060000 0x4000>;
		#clock-cells = <1>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x46060000 0x4000>;
	};

	audio_ccm: clock-controller@48060000 {
		compatible = "nxp,imx-ccm-rev3";
		reg = <0x48060000 0x4000>;
		#clock-cells = <1>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x48060000 0x4000>;
	};

	comm_ccm: clock-controller@4a060000 {
		compatible = "nxp,imx-ccm-rev3";
		reg = <0x4a060000 0x4000>;
		#clock-cells = <1>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x4a060000 0x4000>;
	};

	media_ccm: clock-controller@4c060000 {
		compatible = "nxp,imx-ccm-rev3";
		reg = <0x4c060000 0x4000>;
		#clock-cells = <1>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x4c060000 0x4000>;
	};

	/*
	 * MAIN IOMUXC (NS alias 0x421C0000). The generated SoC pinctrl nodes are
	 * attached to this &iomuxc anchor. The child pinctrl node provides the
	 * pin configuration driver compatible.
	 */
	iomuxc: pinctrl@421c0000 {
		compatible = "nxp,imx-iomuxc";
		reg = <0x421c0000 0x10000>;

		pinctrl: pinctrl {
			status = "okay";
			compatible = "nxp,mcux-rt266x-pinctrl";
		};
	};

	/*
	 * WAKE IOMUXC (0x46220000, PD_WAKE domain). This is a distinct IOMUXC
	 * instance from MAIN; the generated pinctrl nodes for pads in the WAKE
	 * domain are attached to the &iomuxc_wake anchor. Its function clock is
	 * a separate LPCG gate (WAKE__IOMUXC) enabled by the pinctrl driver.
	 */
	iomuxc_wake: pinctrl@46220000 {
		compatible = "nxp,imx-iomuxc";
		reg = <0x46220000 0x10000>;

		pinctrl_wake: pinctrl {
			status = "okay";
			compatible = "nxp,mcux-rt266x-pinctrl";
		};
	};

	/*
	 * VBAT IOMUXC (0x46360000, VBAT domain). A third IOMUXC instance for
	 * always-on VBAT-domain pads (RTC tamper, PMIC mode, VBAT GPIO). The
	 * VBAT domain is always powered and has no dedicated IOMUXC clock gate.
	 */
	iomuxc_vbat: pinctrl@46360000 {
		compatible = "nxp,imx-iomuxc";
		reg = <0x46360000 0x10000>;

		pinctrl_vbat: pinctrl {
			status = "okay";
			compatible = "nxp,mcux-rt266x-pinctrl";
		};
	};

	/* LPUART (HSP domain), IRQ 184..189 */
	lpuart0: hsp_lpuart_0: serial@42190000 {
		compatible = "nxp,lpuart";
		reg = <0x42190000 0x4000>;
		interrupts = <184 0>;
		/* "gate" = the peripheral gate, and the root the rate is read
		 * from; "source" = this node owns that root's mux/dividers.
		 * PERI3 (400 MHz) / 5 = 80 MHz.
		 */
		clock-names = "gate", "source";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPUART0,
					   IMX_CCM_ROOT_MAIN_LPUART0_FCLK)>,
			 <&ccm IMX_CCM_ROOT_CFG(IMX_CCM_ROOT_MAIN_LPUART0_FCLK,
						IMX_CCM_MUX_LPUART0_PERI3, 5, 1)>;
		status = "disabled";
	};

	lpuart1: hsp_lpuart_1: serial@421a0000 {
		compatible = "nxp,lpuart";
		reg = <0x421a0000 0x4000>;
		interrupts = <185 0>;
		clock-names = "gate", "source";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPUART1,
					   IMX_CCM_ROOT_MAIN_LPUART1_FCLK)>,
			 <&ccm IMX_CCM_ROOT_CFG(IMX_CCM_ROOT_MAIN_LPUART1_FCLK,
						IMX_CCM_MUX_LPUART1_PERI3, 5, 1)>;
		status = "disabled";
	};

	lpuart2: hsp_lpuart_2: serial@421b0000 {
		compatible = "nxp,lpuart";
		reg = <0x421b0000 0x4000>;
		interrupts = <186 0>;
		clock-names = "gate", "source";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPUART2,
					   IMX_CCM_ROOT_MAIN_LPUART2_FCLK)>,
			 <&ccm IMX_CCM_ROOT_CFG(IMX_CCM_ROOT_MAIN_LPUART2_FCLK,
						IMX_CCM_MUX_LPUART2_PERI3, 5, 1)>;
		status = "disabled";
	};

	lpuart3: hsp_lpuart_3: serial@42950000 {
		compatible = "nxp,lpuart";
		reg = <0x42950000 0x4000>;
		interrupts = <187 0>;
		clock-names = "gate", "source";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPUART3,
					   IMX_CCM_ROOT_MAIN_LPUART3_FCLK)>,
			 <&ccm IMX_CCM_ROOT_CFG(IMX_CCM_ROOT_MAIN_LPUART3_FCLK,
						IMX_CCM_MUX_LPUART3_PERI3, 5, 1)>;
		status = "disabled";
	};

	lpuart4: hsp_lpuart_4: serial@42960000 {
		compatible = "nxp,lpuart";
		reg = <0x42960000 0x4000>;
		interrupts = <188 0>;
		clock-names = "gate", "source";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPUART4,
					   IMX_CCM_ROOT_MAIN_LPUART4_FCLK)>,
			 <&ccm IMX_CCM_ROOT_CFG(IMX_CCM_ROOT_MAIN_LPUART4_FCLK,
						IMX_CCM_MUX_LPUART4_PERI3, 5, 1)>;
		status = "disabled";
	};

	lpuart5: hsp_lpuart_5: serial@42970000 {
		compatible = "nxp,lpuart";
		reg = <0x42970000 0x4000>;
		interrupts = <189 0>;
		clock-names = "gate", "source";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPUART5,
					   IMX_CCM_ROOT_MAIN_LPUART5_FCLK)>,
			 <&ccm IMX_CCM_ROOT_CFG(IMX_CCM_ROOT_MAIN_LPUART5_FCLK,
						IMX_CCM_MUX_LPUART5_PERI3, 5, 1)>;
		status = "disabled";
	};

	lpuart6: wake_lpuart_0: serial@461f0000 {
		compatible = "nxp,lpuart";
		reg = <0x461f0000 0x4000>;
		interrupts = <238 0>;
		clock-names = "gate", "source";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_WAKE_LPUART0,
					   IMX_CCM_ROOT_WAKE_LPUART0_FCLK)>,
			 <&ccm IMX_CCM_ROOT_CFG(IMX_CCM_ROOT_WAKE_LPUART0_FCLK,
						IMX_CCM_MUX_WAKE_LPUART0_PERI7, 1, 1)>;
		status = "disabled";
	};

	lpuart7: wake_lpuart_1: serial@46200000 {
		compatible = "nxp,lpuart";
		reg = <0x46200000 0x4000>;
		interrupts = <239 0>;
		clock-names = "gate", "source";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_WAKE_LPUART1,
					   IMX_CCM_ROOT_WAKE_LPUART1_FCLK)>,
			 <&ccm IMX_CCM_ROOT_CFG(IMX_CCM_ROOT_WAKE_LPUART1_FCLK,
						IMX_CCM_MUX_WAKE_LPUART1_PERI7, 1, 1)>;
		status = "disabled";
	};

	/*
	 * RGPIO (HSP domain). Each instance exposes two NVIC channels (CH0/CH1);
	 * both are listed. GPIO ports are numbered to match the SDK GPIO0..4.
	 */
	/*
	 * RGPIO ports are left "disabled" by default (matching every other
	 * peripheral here); a board enables the ports it uses AND must supply the
	 * per-port "pinmux" list the nxp,imx-rgpio driver needs to mux pads to
	 * their GPIO alt-function.
	 */
	gpio0: hsp_gpio_0: gpio@43800000 {
		compatible = "nxp,imx-rgpio";
		reg = <0x43800000 0x4000>;
		interrupts = <190 0>, <191 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_RGPIO0,
					   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "disabled";
	};

	gpio1: hsp_gpio_1: gpio@43810000 {
		compatible = "nxp,imx-rgpio";
		reg = <0x43810000 0x4000>;
		interrupts = <192 0>, <193 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_RGPIO1,
					   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "disabled";
	};

	gpio2: hsp_gpio_2: gpio@43820000 {
		compatible = "nxp,imx-rgpio";
		reg = <0x43820000 0x4000>;
		interrupts = <194 0>, <195 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_RGPIO2,
					   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "disabled";
	};

	gpio3: hsp_gpio_3: gpio@43830000 {
		compatible = "nxp,imx-rgpio";
		reg = <0x43830000 0x4000>;
		interrupts = <196 0>, <197 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_RGPIO3,
					   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "disabled";
	};

	gpio4: hsp_gpio_4: gpio@43840000 {
		compatible = "nxp,imx-rgpio";
		reg = <0x43840000 0x4000>;
		interrupts = <198 0>, <199 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_RGPIO4,
					   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "disabled";
	};

	/*
	 * WAKE-domain RGPIO instance (WAKE__GPIO, NS alias 0x46210000 from
	 * MIMXRT2663_COMMON.h; the secure alias is 0x56210000). This is a
	 * separate RGPIO from the HSP gpio0..4 above and hosts the on-board
	 * WAKE buttons. Two NVIC channels: WAKE_GPIO_CH0 = 240, CH1 = 241.
	 */
	gpio6: wake_gpio: gpio@46210000 {
		compatible = "nxp,imx-rgpio";
		reg = <0x46210000 0x4000>;
		interrupts = <240 0>, <241 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_WAKE_RGPIO0,
					   IMX_CCM_ROOT_WAKE_WAKE_CLK)>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "disabled";
	};

	gpio5: vbat_gpio: gpio@46350000 {
		compatible = "nxp,imx-rgpio";
		reg = <0x46350000 0x4000>;
		interrupts = <252 0>, <253 0>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "disabled";
	};

	/* LPI2C (HSP domain), IRQ 175/176 */
	lpi2c0: hsp_lpi2c_0: i2c@42140000 {
		compatible = "nxp,lpi2c";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x42140000 0x4000>;
		interrupts = <175 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPI2C0,
					   IMX_CCM_ROOT_MAIN_LPI2C0_FCLK)>;
		status = "disabled";
	};

	lpi2c1: hsp_lpi2c_1: i2c@42910000 {
		compatible = "nxp,lpi2c";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x42910000 0x4000>;
		interrupts = <176 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPI2C1,
					   IMX_CCM_ROOT_MAIN_LPI2C1_FCLK)>;
		status = "disabled";
	};

	lpi2c2: wake_lpi2c_0: i2c@461c0000 {
		compatible = "nxp,lpi2c";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x461c0000 0x4000>;
		interrupts = <235 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_WAKE_LPI2C0,
					   IMX_CCM_ROOT_WAKE_LPI2C0_FCLK)>;
		status = "disabled";
	};

	lpi2c3: wake_lpi2c_1: i2c@461d0000 {
		compatible = "nxp,lpi2c";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x461d0000 0x4000>;
		interrupts = <236 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_WAKE_LPI2C1,
					   IMX_CCM_ROOT_WAKE_LPI2C1_FCLK)>;
		status = "disabled";
	};

	/* LPSPI (HSP domain), IRQ 179..183 */
	lpspi0: hsp_lpspi_0: spi@42160000 {
		compatible = "nxp,lpspi";
		reg = <0x42160000 0x4000>;
		interrupts = <179 0>;
		clock-names = "gate";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPSPI0,
					   IMX_CCM_ROOT_MAIN_LPSPI0_FCLK)>;
		tx-fifo-size = <16>;
		rx-fifo-size = <16>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	lpspi1: hsp_lpspi_1: spi@42170000 {
		compatible = "nxp,lpspi";
		reg = <0x42170000 0x4000>;
		interrupts = <180 0>;
		clock-names = "gate";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPSPI1,
					   IMX_CCM_ROOT_MAIN_LPSPI1_FCLK)>;
		tx-fifo-size = <16>;
		rx-fifo-size = <16>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	lpspi2: hsp_lpspi_2: spi@42180000 {
		compatible = "nxp,lpspi";
		reg = <0x42180000 0x4000>;
		interrupts = <181 0>;
		clock-names = "gate";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPSPI2,
					   IMX_CCM_ROOT_MAIN_LPSPI2_FCLK)>;
		tx-fifo-size = <16>;
		rx-fifo-size = <16>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	lpspi3: hsp_lpspi_3: spi@42930000 {
		compatible = "nxp,lpspi";
		reg = <0x42930000 0x4000>;
		interrupts = <182 0>;
		clock-names = "gate";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPSPI3,
					   IMX_CCM_ROOT_MAIN_LPSPI3_FCLK)>;
		tx-fifo-size = <16>;
		rx-fifo-size = <16>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	lpspi4: hsp_lpspi_4: spi@42940000 {
		compatible = "nxp,lpspi";
		reg = <0x42940000 0x4000>;
		interrupts = <183 0>;
		clock-names = "gate";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_LPSPI4,
					   IMX_CCM_ROOT_MAIN_LPSPI4_FCLK)>;
		tx-fifo-size = <16>;
		rx-fifo-size = <16>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	lpspi5: wake_lpspi: spi@461e0000 {
		compatible = "nxp,lpspi";
		reg = <0x461e0000 0x4000>;
		interrupts = <237 0>;
		clock-names = "gate";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_WAKE_LPSPI,
					   IMX_CCM_ROOT_WAKE_LPSPI0_FCLK)>;
		tx-fifo-size = <16>;
		rx-fifo-size = <16>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	/* I3C (HSP domain), IRQ 174 */
	i3c0: hsp_i3c: i3c@42130000 {
		compatible = "nxp,mcux-i3c";
		reg = <0x42130000 0x1000>;
		interrupts = <174 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_I3C0,
					   IMX_CCM_ROOT_MAIN_I3C0_FCLK)>;
		clk-divider = <2>;
		clk-divider-slow = <1>;
		clk-divider-tc = <1>;
		#address-cells = <3>;
		#size-cells = <0>;
		status = "disabled";
	};

	i3c1: wake_i3c: i3c@461b0000 {
		compatible = "nxp,mcux-i3c";
		reg = <0x461b0000 0x1000>;
		interrupts = <234 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_WAKE_I3C0,
					   IMX_CCM_ROOT_WAKE_I3C0_FCLK)>;
		clk-divider = <2>;
		clk-divider-slow = <1>;
		clk-divider-tc = <1>;
		#address-cells = <3>;
		#size-cells = <0>;
		status = "disabled";
	};

	/* FlexCAN (HSP domain). Each has a common + error IRQ. */
	flexcan0: hsp_flexcan_0: can@420f0000 {
		compatible = "nxp,flexcan-fd", "nxp,flexcan";
		reg = <0x420f0000 0x10000>;
		interrupts = <165 0>, <166 0>;
		interrupt-names = "common", "error";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_CAN0,
					   IMX_CCM_ROOT_MAIN_FLEXCAN0_FCLK)>;
		clk-source = <0>;
		clock-names = "clksrc0";
		number-of-mb = <96>;
		status = "disabled";
	};

	flexcan1: hsp_flexcan_1: can@42100000 {
		compatible = "nxp,flexcan-fd", "nxp,flexcan";
		reg = <0x42100000 0x10000>;
		interrupts = <167 0>, <168 0>;
		interrupt-names = "common", "error";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_CAN1,
					   IMX_CCM_ROOT_MAIN_FLEXCAN1_FCLK)>;
		clk-source = <0>;
		clock-names = "clksrc0";
		number-of-mb = <96>;
		status = "disabled";
	};

	flexcan2: hsp_flexcan_2: can@428f0000 {
		compatible = "nxp,flexcan-fd", "nxp,flexcan";
		reg = <0x428f0000 0x10000>;
		interrupts = <169 0>, <170 0>;
		interrupt-names = "common", "error";
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_CAN2,
					   IMX_CCM_ROOT_MAIN_FLEXCAN2_FCLK)>;
		clk-source = <0>;
		clock-names = "clksrc0";
		number-of-mb = <96>;
		status = "disabled";
	};

	/* FlexIO (HSP domain), IRQ 171..173 */
	flexio0: hsp_flexio_0: flexio@42110000 {
		compatible = "nxp,flexio";
		reg = <0x42110000 0x4000>;
		interrupts = <171 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_FLEXIO0,
					   IMX_CCM_ROOT_MAIN_FLEXIO0_FCLK)>;
		status = "disabled";
	};

	flexio1: hsp_flexio_1: flexio@42120000 {
		compatible = "nxp,flexio";
		reg = <0x42120000 0x4000>;
		interrupts = <172 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_FLEXIO1,
					   IMX_CCM_ROOT_MAIN_FLEXIO1_FCLK)>;
		status = "disabled";
	};

	flexio2: hsp_flexio_2: flexio@42900000 {
		compatible = "nxp,flexio";
		reg = <0x42900000 0x4000>;
		interrupts = <173 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_FLEXIO2,
					   IMX_CCM_ROOT_MAIN_FLEXIO2_FCLK)>;
		status = "disabled";
	};

	/*
	 * eFlexPWM (HSP domain). Each module has four sub-modules plus a fault
	 * interrupt: EFLEXPWM0 channels = IRQ 117..120, fault = 121, etc.
	 */
	flexpwm0: hsp_flexpwm_0: pwm@42080000 {
		compatible = "nxp,flexpwm";
		reg = <0x42080000 0x4000>;
		interrupts = <121 0>;

		flexpwm0_pwm0: flexpwm0_pwm0 {
			compatible = "nxp,imx-pwm";
			index = <0>;
			interrupts = <117 0>;
			#pwm-cells = <3>;
			clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_FLEXPWM0,
						   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
			nxp,prescaler = <128>;
			status = "disabled";
		};

		flexpwm0_pwm1: flexpwm0_pwm1 {
			compatible = "nxp,imx-pwm";
			index = <1>;
			interrupts = <118 0>;
			#pwm-cells = <3>;
			clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_FLEXPWM0,
						   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
			nxp,prescaler = <128>;
			status = "disabled";
		};

		flexpwm0_pwm2: flexpwm0_pwm2 {
			compatible = "nxp,imx-pwm";
			index = <2>;
			interrupts = <119 0>;
			#pwm-cells = <3>;
			clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_FLEXPWM0,
						   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
			nxp,prescaler = <128>;
			status = "disabled";
		};

		flexpwm0_pwm3: flexpwm0_pwm3 {
			compatible = "nxp,imx-pwm";
			index = <3>;
			interrupts = <120 0>;
			#pwm-cells = <3>;
			clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_FLEXPWM0,
						   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
			nxp,prescaler = <128>;
			status = "disabled";
		};
	};

	flexpwm1: hsp_flexpwm_1: pwm@42090000 {
		compatible = "nxp,flexpwm";
		reg = <0x42090000 0x4000>;
		interrupts = <126 0>;

		flexpwm1_pwm0: flexpwm1_pwm0 {
			compatible = "nxp,imx-pwm";
			index = <0>;
			interrupts = <122 0>;
			#pwm-cells = <3>;
			clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_FLEXPWM1,
						   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
			nxp,prescaler = <128>;
			status = "disabled";
		};

		flexpwm1_pwm1: flexpwm1_pwm1 {
			compatible = "nxp,imx-pwm";
			index = <1>;
			interrupts = <123 0>;
			#pwm-cells = <3>;
			clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_FLEXPWM1,
						   IMX_CCM_ROOT_MAIN_MAIN_CLK_DIVIDED)>;
			nxp,prescaler = <128>;
			status = "disabled";
		};

		flexpwm1_pwm2: flexpwm1_pwm2 {
			compatible = "nxp,imx-pwm";
			index = <2>;
			interrupts = <124 0>;
			#pwm-cells = <3>;
