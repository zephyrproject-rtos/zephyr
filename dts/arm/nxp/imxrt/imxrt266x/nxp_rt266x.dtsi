		compatible = "nxp,lpc-lpadc";
		reg = <0x42050000 0x304>;
		interrupts = <112 0>;
		clocks = <&ccm IMX_CCM_CLK(IMX_CCM_LPCG_MAIN_HSP_ADC0,
					   IMX_CCM_ROOT_MAIN_ADC0_FCLK)>;
		voltage-ref = <1>;
		calibration-average = <128>;
		power-level = <0>;
		offset-value-a = <10>;
		offset-value-b = <10>;
		#io-channel-cells = <1>;
		status = "disabled";
	};

