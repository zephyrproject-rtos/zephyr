	};
	/omit-if-no-ref/ pin_gpio06_pwm9: pin-gpio06-pwm9 {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 3 1>,
			       <NPCM_SCFG_DEVALT9 3 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};

	/* GPIO07 / EMAC_MDC / RIB / TA9: DEVALT4.TA9_SL DEVALT9.RI2_SL EMC_CTL.MDIO_EN */
	/omit-if-no-ref/ pin_gpio07_gpio: pin-gpio07-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 1 0>,
			       <NPCM_SCFG_DEVALT9 5 0>,
			       <NPCM_SCFG_EMC_CTL 1 0>;
	};
	/omit-if-no-ref/ pin_gpio07_emac_mdc: pin-gpio07-emac-mdc {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 1 0>,
			       <NPCM_SCFG_DEVALT9 5 0>,
			       <NPCM_SCFG_EMC_CTL 1 1>;
	};
	/omit-if-no-ref/ pin_gpio07_rib: pin-gpio07-rib {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 1 0>,
			       <NPCM_SCFG_DEVALT9 5 1>,
			       <NPCM_SCFG_EMC_CTL 1 0>;
	};
	/omit-if-no-ref/ pin_gpio07_ta9: pin-gpio07-ta9 {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 1 1>,
			       <NPCM_SCFG_DEVALT9 5 0>,
			       <NPCM_SCFG_EMC_CTL 1 0>;
	};

	/* GPIOB1 / CLKRUN: DEVALT0.CLKRN_SL */
	/omit-if-no-ref/ pin_gpiob1_gpio: pin-gpiob1-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT0 5 0>;
	};
	/omit-if-no-ref/ pin_gpiob1_clkrun: pin-gpiob1-clkrun {
		nuvoton,alts = <NPCM_SCFG_DEVALT0 5 1>;
	};

	/* GPIOB2 / LPCPD / ESPI_RST / LDRQ: DEVALTB.LDRQ_SL DEVALT0.LPCPD_SL */
	/omit-if-no-ref/ pin_gpiob2_gpio: pin-gpiob2-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 7 0>, <NPCM_SCFG_DEVALT0 6 0>;
	};
	/omit-if-no-ref/ pin_gpiob2_lpcpd: pin-gpiob2-lpcpd {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 7 0>, <NPCM_SCFG_DEVALT0 6 1>;
	};
	/omit-if-no-ref/ pin_gpiob2_espi_rst: pin-gpiob2-espi-rst {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 7 0>, <NPCM_SCFG_DEVALT0 6 0>;
	};
	/omit-if-no-ref/ pin_gpiob2_ldrq: pin-gpiob2-ldrq {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 7 1>, <NPCM_SCFG_DEVALT0 6 0>;
	};

	/* GPIOB3 / ESPI_ALERT / SERIRQ: DEVALT0.SERIRQ_SL */
	/omit-if-no-ref/ pin_gpiob3_gpio: pin-gpiob3-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT0 7 0>;
	};
	/omit-if-no-ref/ pin_gpiob3_espi_alert: pin-gpiob3-espi-alert {
		nuvoton,alts = <NPCM_SCFG_DEVALT0 7 0>;
	};
	/omit-if-no-ref/ pin_gpiob3_serirq: pin-gpiob3-serirq {
		nuvoton,alts = <NPCM_SCFG_DEVALT0 7 1>;
	};

	/* GPIOB7 / PLTRST: strap selected */
	/omit-if-no-ref/ pin_gpiob7_pltrst: pin-gpiob7-pltrst {
	};

	/* GPIO10 / CTSA: DEVALTB.CTS1_SL */
	/omit-if-no-ref/ pin_gpio10_gpio: pin-gpio10-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 5 0>;
	};
	/omit-if-no-ref/ pin_gpio10_ctsa: pin-gpio10-ctsa {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 5 1>;
	};

	/* GPIO11 / SCL2A / DRSA: DEVALTB.SP1CTL_SL DEVALTE.SMB2A_SL */
	/omit-if-no-ref/ pin_gpio11_gpio: pin-gpio11-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 4 0>, <NPCM_SCFG_DEVALTE 5 0>;
		nuvoton,low-voltage-reg = <NPCM_SCFG_LV_CTL1 7>; /* SCL2A_LV */
	};
	/omit-if-no-ref/ pin_gpio11_scl2a: pin-gpio11-scl2a {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 4 0>, <NPCM_SCFG_DEVALTE 5 1>;
		nuvoton,pull-up-reg = <NPCM_SCFG_DEVPU0 2>; /* SMB2A_PUE */
		nuvoton,low-voltage-reg = <NPCM_SCFG_LV_CTL1 7>; /* SCL2A_LV */
	};
	/omit-if-no-ref/ pin_gpio11_drsa: pin-gpio11-drsa {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 4 1>, <NPCM_SCFG_DEVALTE 5 0>;
	};

	/* GPIO12 / RTSA: DEVALTB.RTS1_SL */
	/omit-if-no-ref/ pin_gpio12_gpio: pin-gpio12-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 0 0>;
	};
	/omit-if-no-ref/ pin_gpio12_rtsa: pin-gpio12-rtsa {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 0 1>;
	};

	/* GPIO13 / SDA2A / DTRA: DEVALTB.SP1CTL_SL DEVALTE.SMB2A_SL */
	/omit-if-no-ref/ pin_gpio13_gpio: pin-gpio13-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 4 0>, <NPCM_SCFG_DEVALTE 5 0>;
		nuvoton,low-voltage-reg = <NPCM_SCFG_LV_CTL0 7>; /* SDA2A_LV */
	};
	/omit-if-no-ref/ pin_gpio13_sda2a: pin-gpio13-sda2a {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 4 0>, <NPCM_SCFG_DEVALTE 5 1>;
		nuvoton,pull-up-reg = <NPCM_SCFG_DEVPU0 2>; /* SMB2A_PUE */
		nuvoton,low-voltage-reg = <NPCM_SCFG_LV_CTL0 7>; /* SDA2A_LV */
	};
	/omit-if-no-ref/ pin_gpio13_dtra: pin-gpio13-dtra {
		nuvoton,alts = <NPCM_SCFG_DEVALTB 4 1>, <NPCM_SCFG_DEVALTE 5 0>;
	};

	/* GPIO14 / SINA / CR_SIN1: DEVALTC.URTI1_SL DEVALTB.SP1I_SL */
	/omit-if-no-ref/ pin_gpio14_gpio: pin-gpio14-gpio {
