/*
 * NPCM4 pin functions.
 *
 * Each node represents one selectable pin function. The nuvoton,alts property
 * lists every SCFG selector and its value, allowing the driver to program a
 * complete selection-table row. Nodes without nuvoton,alts are strap-selected.
 * Pins with GPIO as their only function have no selector and are omitted.
 * Pull-up/down and low-voltage controls are listed only when available.
 */

&pinfunc {
	/* GPIOB0 / SMI: DEVALT5.SMI_SL */
	/omit-if-no-ref/ pin_gpiob0_gpio: pin-gpiob0-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 6 0>;
	};
	/omit-if-no-ref/ pin_gpiob0_smi: pin-gpiob0-smi {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 6 1>;
	};

	/* GPIO00 / EMAC_RXD1 / CTSB / PWM7: DEVALT5.PWM7_SL DEVALT9.CTS2_SL EMC_CTL.RMII_EN */
	/omit-if-no-ref/ pin_gpio00_gpio: pin-gpio00-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 1 0>,
			       <NPCM_SCFG_DEVALT9 4 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio00_emac_rxd1: pin-gpio00-emac-rxd1 {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 1 0>,
			       <NPCM_SCFG_DEVALT9 4 0>,
			       <NPCM_SCFG_EMC_CTL 0 1>;
	};
	/omit-if-no-ref/ pin_gpio00_ctsb: pin-gpio00-ctsb {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 1 0>,
			       <NPCM_SCFG_DEVALT9 4 1>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio00_pwm7: pin-gpio00-pwm7 {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 1 1>,
			       <NPCM_SCFG_DEVALT9 4 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};

	/* GPIO01 / EMAC_RXD0 / DSRB / TA7: DEVALT3.TA7_SL DEVALT9.SP2CTL_SL EMC_CTL.RMII_EN */
	/omit-if-no-ref/ pin_gpio01_gpio: pin-gpio01-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT3 7 0>,
			       <NPCM_SCFG_DEVALT9 3 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio01_emac_rxd0: pin-gpio01-emac-rxd0 {
		nuvoton,alts = <NPCM_SCFG_DEVALT3 7 0>,
			       <NPCM_SCFG_DEVALT9 3 0>,
			       <NPCM_SCFG_EMC_CTL 0 1>;
	};
	/omit-if-no-ref/ pin_gpio01_dsrb: pin-gpio01-dsrb {
		nuvoton,alts = <NPCM_SCFG_DEVALT3 7 0>,
			       <NPCM_SCFG_DEVALT9 3 1>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio01_ta7: pin-gpio01-ta7 {
		nuvoton,alts = <NPCM_SCFG_DEVALT3 7 1>,
			       <NPCM_SCFG_DEVALT9 3 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};

	/* GPIO02 / EMAC_REF_CLK / RTSB / PWM8: DEVALT5.PWM8_SL DEVALT9.RTS2_SL EMC_CTL.RMII_EN */
	/omit-if-no-ref/ pin_gpio02_gpio: pin-gpio02-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 2 0>,
			       <NPCM_SCFG_DEVALT9 0 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio02_emac_ref_clk: pin-gpio02-emac-ref-clk {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 2 0>,
			       <NPCM_SCFG_DEVALT9 0 0>,
			       <NPCM_SCFG_EMC_CTL 0 1>;
	};
	/omit-if-no-ref/ pin_gpio02_rtsb: pin-gpio02-rtsb {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 2 0>,
			       <NPCM_SCFG_DEVALT9 0 1>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio02_pwm8: pin-gpio02-pwm8 {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 2 1>,
			       <NPCM_SCFG_DEVALT9 0 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};

	/* GPIO03 / EMAC_TXD1 / DTRB / TA8: DEVALT4.TA8_SL DEVALT9.SP2CTL_SL EMC_CTL.RMII_EN */
	/omit-if-no-ref/ pin_gpio03_gpio: pin-gpio03-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 0 0>,
			       <NPCM_SCFG_DEVALT9 3 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio03_emac_txd1: pin-gpio03-emac-txd1 {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 0 0>,
			       <NPCM_SCFG_DEVALT9 3 0>,
			       <NPCM_SCFG_EMC_CTL 0 1>;
	};
	/omit-if-no-ref/ pin_gpio03_dtrb: pin-gpio03-dtrb {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 0 0>,
			       <NPCM_SCFG_DEVALT9 3 1>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio03_ta8: pin-gpio03-ta8 {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 0 1>,
			       <NPCM_SCFG_DEVALT9 3 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};

	/*
	 * GPIO04 / EMAC_TXD0 / SINB / CR_SIN1 / PWM1
	 * DEVALT4.PWM1_SL DEVALTB.URTI_SL DEVALT9.SP2I_SL EMC_CTL.RMII_EN
	 */
	/omit-if-no-ref/ pin_gpio04_gpio: pin-gpio04-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 3 0>,
			       <NPCM_SCFG_DEVALTB 1 0>,
			       <NPCM_SCFG_DEVALT9 1 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio04_emac_txd0: pin-gpio04-emac-txd0 {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 3 0>,
			       <NPCM_SCFG_DEVALTB 1 0>,
			       <NPCM_SCFG_DEVALT9 1 0>,
			       <NPCM_SCFG_EMC_CTL 0 1>;
	};
	/omit-if-no-ref/ pin_gpio04_sinb: pin-gpio04-sinb {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 3 0>,
			       <NPCM_SCFG_DEVALTB 1 0>,
			       <NPCM_SCFG_DEVALT9 1 1>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio04_cr_sin1: pin-gpio04-cr-sin1 {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 3 0>,
			       <NPCM_SCFG_DEVALTB 1 1>,
			       <NPCM_SCFG_DEVALT9 1 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio04_pwm1: pin-gpio04-pwm1 {
		nuvoton,alts = <NPCM_SCFG_DEVALT4 3 1>,
			       <NPCM_SCFG_DEVALTB 1 0>,
			       <NPCM_SCFG_DEVALT9 1 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};

	/*
	 * GPIO05 / EMAC_TX_EN / SOUTB / CR_SOUT1 / TA1
	 * DEVALT3.TA1_SL DEVALTA.URTO1_SL DEVALT9.SP2O_SL EMC_CTL.RMII_EN
	 */
	/omit-if-no-ref/ pin_gpio05_gpio: pin-gpio05-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT3 1 0>,
			       <NPCM_SCFG_DEVALTA 6 0>,
			       <NPCM_SCFG_DEVALT9 2 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio05_emac_tx_en: pin-gpio05-emac-tx-en {
		nuvoton,alts = <NPCM_SCFG_DEVALT3 1 0>,
			       <NPCM_SCFG_DEVALTA 6 0>,
			       <NPCM_SCFG_DEVALT9 2 0>,
			       <NPCM_SCFG_EMC_CTL 0 1>;
	};
	/omit-if-no-ref/ pin_gpio05_soutb: pin-gpio05-soutb {
		nuvoton,alts = <NPCM_SCFG_DEVALT3 1 0>,
			       <NPCM_SCFG_DEVALTA 6 0>,
			       <NPCM_SCFG_DEVALT9 2 1>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio05_cr_sout1: pin-gpio05-cr-sout1 {
		nuvoton,alts = <NPCM_SCFG_DEVALT3 1 0>,
			       <NPCM_SCFG_DEVALTA 6 1>,
			       <NPCM_SCFG_DEVALT9 2 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio05_ta1: pin-gpio05-ta1 {
		nuvoton,alts = <NPCM_SCFG_DEVALT3 1 1>,
			       <NPCM_SCFG_DEVALTA 6 0>,
			       <NPCM_SCFG_DEVALT9 2 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};

	/* GPIO06 / EMAC_MDI0 / DCDB / PWM9: DEVALT5.PWM9_SL DEVALT9.SP2CTL_SL EMC_CTL.RMII_EN */
	/omit-if-no-ref/ pin_gpio06_gpio: pin-gpio06-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 3 0>,
			       <NPCM_SCFG_DEVALT9 3 0>,
			       <NPCM_SCFG_EMC_CTL 0 0>;
	};
	/omit-if-no-ref/ pin_gpio06_emac_mdi0: pin-gpio06-emac-mdi0 {
		nuvoton,alts = <NPCM_SCFG_DEVALT5 3 0>,
			       <NPCM_SCFG_DEVALT9 3 0>,
			       <NPCM_SCFG_EMC_CTL 0 1>;
