	};

	/* GPIO17 / CLKOUT / RIA / SDA6B: DEVALT6D.SMB6B_SL DEVALTB.RI1_SL DEVALT7.CLKOUT_SL */
	/omit-if-no-ref/ pin_gpio17_gpio: pin-gpio17-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT6D 7 0>,
