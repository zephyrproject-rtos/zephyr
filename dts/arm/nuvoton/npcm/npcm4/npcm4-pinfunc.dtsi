	/* GPIOC2 / RTSC / SCL7A: DEVALT6D.SMB7A_SL DEVALT62.RTSC_SL */
	/omit-if-no-ref/ pin_gpioc2_gpio: pin-gpioc2-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT6D 0 0>, <NPCM_SCFG_DEVALT62 2 0>;
		nuvoton,low-voltage-reg = <NPCM_SCFG_LV_CTL4 0>; /* SCL7A_LV */
	};
	/omit-if-no-ref/ pin_gpioc2_rtsc: pin-gpioc2-rtsc {
