			       <NPCM_SCFG_DEVALTB 3 0>;
	};

	/* GPIO16 / DCDA / SCL6B: DEVALT6D.SMB6B_SL DEVALTB.SP1CTL_SL */
	/omit-if-no-ref/ pin_gpio16_gpio: pin-gpio16-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALT6D 7 0>, <NPCM_SCFG_DEVALTB 4 0>;
