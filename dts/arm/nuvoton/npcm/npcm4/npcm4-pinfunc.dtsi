	/omit-if-no-ref/ pin_gpio15_gpio: pin-gpio15-gpio {
		nuvoton,alts = <NPCM_SCFG_DEVALTC 7 0>,
			       <NPCM_SCFG_DEVALTA 7 0>,
			       <NPCM_SCFG_DEVALTB 3 0>;
	};
	/omit-if-no-ref/ pin_gpio15_souta: pin-gpio15-souta {
