		din {
			pinmux = <&pin_gpiof2_iox1_din>;
		};

		sclk {
			pinmux = <&pin_gpiof3_iox1_sclk>;
		};
	};

	/omit-if-no-ref/ iox2_ldsh_dout_din_sclk_gpioa0_a1_a3_a4: periph-siox2 {
