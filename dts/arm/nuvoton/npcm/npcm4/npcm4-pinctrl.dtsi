	/omit-if-no-ref/ i2c3a_scl_sda_gpioa7_a2: periph-i2c3a {
		scl {
			pinmux = <&pin_gpioa7_scl3a>;
		};

		sda {
			pinmux = <&pin_gpioa2_sda3a>;
		};
	};

	/omit-if-no-ref/ i2c4a_scl_sda_gpio36_37: periph-i2c4a {
		scl {
			pinmux = <&pin_gpio36_scl4a>;
		};

		sda {
			pinmux = <&pin_gpio37_sda4a>;
		};
	};

	/omit-if-no-ref/ i2c4b_scl_sda_gpiof0_f1: periph-i2c4b {
		scl {
			pinmux = <&pin_gpiof0_scl4b>;
		};

		sda {
			pinmux = <&pin_gpiof1_sda4b>;
		};
	};

	/omit-if-no-ref/ i2c5a_scl_sda_gpio34_35: periph-i2c5a {
