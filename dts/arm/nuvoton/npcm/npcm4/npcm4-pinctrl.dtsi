&pinctrl {
	/* Pin-mux and pad-control groups provided for NPCM4 peripherals. */
	/* Flash Interface Unit (FIU) */
	/omit-if-no-ref/ fiu0_shd_cs_io0_io1_clk_gpio44_45_46_47: periph-fiu0-shd {
		cs {
			nuvoton,device-control = <NPCM_SCFG_DEVCNT 6 0>; /* SHD_SPI_TRIS */
			pinmux = <&pin_gpio44_shd_cs>;
		};

		io0 {
			pinmux = <&pin_gpio45_shd_dio0>;
		};

		io1 {
			pinmux = <&pin_gpio46_shd_dio1>;
		};

		clk {
			pinmux = <&pin_gpio47_shd_sclk>;
		};
	};

	/omit-if-no-ref/ fiu0_shd_quad_io2_io3_clk_gpio55_56: periph-fiu0-shd-quad {
		io2 {
			pinmux = <&pin_gpio55_shd_dio2>;
		};

		io3 {
			pinmux = <&pin_gpio56_shd_dio3>;
		};
	};

	/* PSPI interfaces */
	/omit-if-no-ref/ pspi1_clk_gpio66_67_70_73_76_77: periph-pspi1 {
		clk {
			pinmux = <&pin_gpio66_spip1_clk>;
		};

		cs {
			pinmux = <&pin_gpio73_spip1_cs>;
		};

		io0 {
			pinmux = <&pin_gpio67_spip1_mosi>;
		};

		io1 {
			pinmux = <&pin_gpio70_spip1_dio1>;
		};

		io2 {
			pinmux = <&pin_gpio76_spip1_dio2>;
		};

		io3 {
			pinmux = <&pin_gpio77_spip1_dio3>;
		};
	};

	/* I2C interfaces */
	/omit-if-no-ref/ i2c1a_scl_sda_gpio60_61: periph-i2c1a {
		scl {
			pinmux = <&pin_gpio60_scl1a>;
		};

		sda {
			pinmux = <&pin_gpio61_sda1a>;
		};
	};

	/omit-if-no-ref/ i2c1b_scl_sda_gpio26_25: periph-i2c1b {
		scl {
			pinmux = <&pin_gpio26_scl1b>;
		};

		sda {
			pinmux = <&pin_gpio25_sda1b>;
		};
	};

	/omit-if-no-ref/ i2c2a_scl_sda_gpio11_13: periph-i2c2a {
		scl {
			pinmux = <&pin_gpio11_scl2a>;
		};

		sda {
			pinmux = <&pin_gpio13_sda2a>;
