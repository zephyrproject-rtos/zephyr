		};

		sda {
			pinmux = <&pin_gpioc7_sda8a>;
		};
	};

	/omit-if-no-ref/ i2c9a_scl_sda_gpio32_33: periph-i2c9a {
		scl {
			pinmux = <&pin_gpio32_scl9a>;
		};

		sda {
			pinmux = <&pin_gpio33_sda9a>;
		};
	};

	/omit-if-no-ref/ i2c10a_scl_sda_gpiod2_d3: periph-i2c10a {
		scl {
			pinmux = <&pin_gpiod2_scl10a>;
		};

		sda {
			pinmux = <&pin_gpiod3_sda10a>;
		};
	};

	/omit-if-no-ref/ i2c11a_scl_sda_gpiod4_d5: periph-i2c11a {
		scl {
			pinmux = <&pin_gpiod4_scl11a>;
		};

		sda {
			pinmux = <&pin_gpiod5_sda11a>;
		};
	};

	/omit-if-no-ref/ i2c12a_scl_sda_gpiod6_d7: periph-i2c12a {
		scl {
			pinmux = <&pin_gpiod6_scl12a>;
		};

		sda {
			pinmux = <&pin_gpiod7_sda12a>;
		};
	};

	/* I3C interfaces */
	/omit-if-no-ref/ i3c1_scl_sda_gpio21_22: periph-i3c1 {
		scl {
			pinmux = <&pin_gpio21_i3c1_scl>;
		};

		sda {
