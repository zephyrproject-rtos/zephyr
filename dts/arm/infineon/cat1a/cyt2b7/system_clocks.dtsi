#define DIV_8_BIT    00
#define DIV_16_BIT   01
#define DIV_16_5_BIT 02
#define DIV_24_5_BIT 03

#include <freq.h>

/ {
	clocks: clocks {
		oscillators: oscillators {
			#address-cells = <1>;
			#size-cells = <0>;

			imo: imo@0 {
				compatible = "infineon,clk-osc";
				reg = <0x0>;
				#clock-cells = <0>;
				clock-frequency = <DT_FREQ_M(8)>;
				status = "disabled";
			};

			ext: ext@1 {
				compatible = "infineon,clk-osc";
				reg = <0x1>;
				#clock-cells = <0>;
				status = "disabled";
			};

			eco: eco@2 {
				compatible = "infineon,clk-osc";
				reg = <0x2>;
				#clock-cells = <0>;
				clock-frequency = <DT_FREQ_M(16)>;
				eco-load-capacitance-pf = <18>;
				eco-esr-ohms = <50>;
				eco-drive-level-uw = <100>;
				status = "disabled";
			};

			wco: wco@111 {
				compatible = "infineon,clk-osc";
				reg = <0x111>;
				#clock-cells = <0>;
				clock-frequency = <32768>;
				status = "disabled";
			};

			ilo0: ilo0@110 {
				compatible = "infineon,clk-osc";
				reg = <0x110>;
				#clock-cells = <0>;
				clock-frequency = <32768>;
				status = "disabled";
			};

			ilo1: ilo1@114 {
				compatible = "infineon,clk-osc";
				reg = <0x114>;
				#clock-cells = <0>;
				clock-frequency = <32768>;
				status = "disabled";
			};
		};

		pll {
			#address-cells = <1>;
			#size-cells = <0>;

			pll0: pll200@1 {
				compatible = "infineon,clk-pll";
				reg = <0x1>;
				#clock-cells = <0>;
				clocks = <&eco>;
				p-div = <40>;
				q-div = <2>;
				output-div = <2>;
				status = "disabled";
			};
		};

		rootclocks {
			#address-cells = <1>;
			#size-cells = <0>;

			clk_hf0: clk_hf@0 {
				compatible = "infineon,cat1c-clk-hf";
				reg = <0x0>;
				#clock-cells = <0>;
				clocks = <&pll0>;
				divider = <1>;
				status = "disabled";
			};

			clk_hf1: clk_hf@1 {
				compatible = "infineon,cat1c-clk-hf";
				reg = <0x1>;
				#clock-cells = <0>;
				clocks = <&pll0>;
				divider = <2>;
				status = "disabled";
			};

			clk_hf2: clk_hf@2 {
				compatible = "infineon,cat1c-clk-hf";
				reg = <0x2>;
				#clock-cells = <0>;
				clocks = <&pll0>;
				divider = <4>;
				status = "disabled";
			};
		};

		derived_clocks {
			clk_slow: clk_slow {
				compatible = "fixed-factor-clock";
				clocks = <&clk_hf0>;
				#clock-cells = <0>;
				clock-div = <2>;
				status = "disabled";
			};
		};

		periclocks {
			clk_peri0: clk_peri0 {
				compatible = "infineon,peri-clk";
				clocks = <&clk_hf0>;
				ifx,peri-clk-inst = <IFX_PERI_GRP_INST_SEL(0, 0)>;

				peri0_group0_8bit_0: peri0_group0_8bit_0 {
					compatible = "infineon,peri-div";
					#clock-cells = <0>;
					div-type = <DIV_8_BIT>;
					channel = <0>;
					status = "disabled";
				};

				peri0_group0_8bit_1: peri0_group0_8bit_1 {
					compatible = "infineon,peri-div";
					#clock-cells = <0>;
					div-type = <DIV_8_BIT>;
					channel = <1>;
					status = "disabled";
				};

				peri0_group0_8bit_2: peri0_group0_8bit_2 {
					compatible = "infineon,peri-div";
					#clock-cells = <0>;
					div-type = <DIV_8_BIT>;
					channel = <2>;
					status = "disabled";
				};

				peri0_group0_8bit_3: peri0_group0_8bit_3 {
					compatible = "infineon,peri-div";
					#clock-cells = <0>;
					div-type = <DIV_8_BIT>;
					channel = <3>;
					status = "disabled";
				};

				peri0_group0_8bit_4: peri0_group0_8bit_4 {
					compatible = "infineon,peri-div";
					#clock-cells = <0>;
					div-type = <DIV_8_BIT>;
					channel = <4>;
					status = "disabled";
