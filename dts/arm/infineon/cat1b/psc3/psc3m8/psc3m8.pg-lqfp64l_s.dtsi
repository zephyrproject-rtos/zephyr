				pinmux = <DT_CAT1_PINMUX(2, 2, HSIOM_SEL_ACT_7)>;
			};

			/omit-if-no-ref/ p2_5_scb0_uart_rts: p2_5_scb0_uart_rts {
				pinmux = <DT_CAT1_PINMUX(2, 5, HSIOM_SEL_DS_2)>;
			};

			/omit-if-no-ref/ p4_0_scb4_uart_rts: p4_0_scb4_uart_rts {
				pinmux = <DT_CAT1_PINMUX(4, 0, HSIOM_SEL_ACT_8)>;
			};

			/omit-if-no-ref/ p4_3_scb1_uart_rts: p4_3_scb1_uart_rts {
				pinmux = <DT_CAT1_PINMUX(4, 3, HSIOM_SEL_ACT_7)>;
			};

			/omit-if-no-ref/ p6_3_scb4_uart_rts: p6_3_scb4_uart_rts {
				pinmux = <DT_CAT1_PINMUX(6, 3, HSIOM_SEL_ACT_8)>;
			};

			/omit-if-no-ref/ p7_2_scb5_uart_rts: p7_2_scb5_uart_rts {
				pinmux = <DT_CAT1_PINMUX(7, 2, HSIOM_SEL_ACT_8)>;
			};

			/omit-if-no-ref/ p8_2_scb3_uart_rts: p8_2_scb3_uart_rts {
				pinmux = <DT_CAT1_PINMUX(8, 2, HSIOM_SEL_ACT_7)>;
			};

			/* scb_uart_rx */
			/omit-if-no-ref/ p2_1_scb6_uart_rx: p2_1_scb6_uart_rx {
				pinmux = <DT_CAT1_PINMUX(2, 1, HSIOM_SEL_ACT_7)>;
			};

			/omit-if-no-ref/ p2_3_scb0_uart_rx: p2_3_scb0_uart_rx {
				pinmux = <DT_CAT1_PINMUX(2, 3, HSIOM_SEL_DS_2)>;
			};

			/omit-if-no-ref/ p6_5_scb4_uart_rx: p6_5_scb4_uart_rx {
				pinmux = <DT_CAT1_PINMUX(6, 5, HSIOM_SEL_ACT_8)>;
			};

			/omit-if-no-ref/ p7_0_scb5_uart_rx: p7_0_scb5_uart_rx {
				pinmux = <DT_CAT1_PINMUX(7, 0, HSIOM_SEL_ACT_8)>;
			};

			/omit-if-no-ref/ p8_0_scb3_uart_rx: p8_0_scb3_uart_rx {
				pinmux = <DT_CAT1_PINMUX(8, 0, HSIOM_SEL_ACT_7)>;
			};

			/* scb_uart_tx */
			/omit-if-no-ref/ p2_0_scb6_uart_tx: p2_0_scb6_uart_tx {
				pinmux = <DT_CAT1_PINMUX(2, 0, HSIOM_SEL_ACT_7)>;
			};

			/omit-if-no-ref/ p2_4_scb0_uart_tx: p2_4_scb0_uart_tx {
				pinmux = <DT_CAT1_PINMUX(2, 4, HSIOM_SEL_DS_2)>;
			};

			/omit-if-no-ref/ p6_4_scb4_uart_tx: p6_4_scb4_uart_tx {
				pinmux = <DT_CAT1_PINMUX(6, 4, HSIOM_SEL_ACT_8)>;
			};

			/omit-if-no-ref/ p7_1_scb5_uart_tx: p7_1_scb5_uart_tx {
				pinmux = <DT_CAT1_PINMUX(7, 1, HSIOM_SEL_ACT_8)>;
			};

			/omit-if-no-ref/ p8_1_scb3_uart_tx: p8_1_scb3_uart_tx {
				pinmux = <DT_CAT1_PINMUX(8, 1, HSIOM_SEL_ACT_7)>;
			};

			/* PWM tcpwm_line*/
			/omit-if-no-ref/ p1_2_pwm0_0: p1_2_pwm0_0 {
				pinmux = <DT_CAT1_PINMUX(1, 2, HSIOM_SEL_ACT_10)>;
			};

			/omit-if-no-ref/ p2_4_pwm0_1: p2_4_pwm0_1 {
				pinmux = <DT_CAT1_PINMUX(2, 4, HSIOM_SEL_ACT_10)>;
			};

			/* PWM tcpwm_line_compl*/
			/omit-if-no-ref/ p1_3_pwm0_0: p1_3_pwm0_0_compl {
				pinmux = <DT_CAT1_PINMUX(1, 3, HSIOM_SEL_ACT_10)>;
			};

			/omit-if-no-ref/ p2_5_pwm0_1: p2_5_pwm0_1_compl {
				pinmux = <DT_CAT1_PINMUX(2, 5, HSIOM_SEL_ACT_10)>;
			};
		};
	};
};

&gpio_prt1 {
	ngpios = <6>;
};

&gpio_prt4 {
	ngpios = <4>;
};

&gpio_prt7 {
	ngpios = <3>;
};

&gpio_prt9 {
	ngpios = <2>;
};
