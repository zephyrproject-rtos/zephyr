#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/ifx_cat1-pinctrl.h>
#include "psc3m8_s.dtsi"

/ {
	soc {
		/delete-node/ gpio@52410000; // gpio_prt0
		/delete-node/ gpio@52410180; // gpio_prt3
		/delete-node/ gpio@52410280; // gpio_prt5

		pinctrl: pinctrl@52400000 {
			/* canfd_ttcan_rx */
			/omit-if-no-ref/ p2_3_can0_ttcan_rx: p2_3_can0_ttcan_rx {
				pinmux = <DT_CAT1_PINMUX(2, 3, HSIOM_SEL_ACT_3)>;
			};

			/omit-if-no-ref/ p7_0_can1_ttcan_rx: p7_0_can1_ttcan_rx {
				pinmux = <DT_CAT1_PINMUX(7, 0, HSIOM_SEL_ACT_3)>;
			};

			/* canfd_ttcan_tx */
			/omit-if-no-ref/ p2_4_can0_ttcan_tx: p2_4_can0_ttcan_tx {
				pinmux = <DT_CAT1_PINMUX(2, 4, HSIOM_SEL_ACT_3)>;
			};

			/omit-if-no-ref/ p7_1_can1_ttcan_tx: p7_1_can1_ttcan_tx {
				pinmux = <DT_CAT1_PINMUX(7, 1, HSIOM_SEL_ACT_3)>;
			};

			/* scb_i2c_scl */
			/omit-if-no-ref/ p2_1_scb6_i2c_scl: p2_1_scb6_i2c_scl {
				pinmux = <DT_CAT1_PINMUX(2, 1, HSIOM_SEL_ACT_9)>;
