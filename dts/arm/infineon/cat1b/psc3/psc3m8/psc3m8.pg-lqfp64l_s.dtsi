			/omit-if-no-ref/ p6_5_scb4_i2c_scl: p6_5_scb4_i2c_scl {
				pinmux = <DT_CAT1_PINMUX(6, 5, HSIOM_SEL_ACT_9)>;
			};

			/omit-if-no-ref/ p7_0_scb5_i2c_scl: p7_0_scb5_i2c_scl {
				pinmux = <DT_CAT1_PINMUX(7, 0, HSIOM_SEL_ACT_9)>;
			};

			/omit-if-no-ref/ p8_0_scb3_i2c_scl: p8_0_scb3_i2c_scl {
				pinmux = <DT_CAT1_PINMUX(8, 0, HSIOM_SEL_ACT_9)>;
