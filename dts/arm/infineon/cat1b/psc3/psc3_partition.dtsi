/ {
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		sram0_s: sram0_s@34000000 {
			/* Secure image memory */
			reg = <0x34000000 DT_SIZE_K(16)>;
		};

		sram0_ns: sram0_ns@24004000 {
			/* Non-Secure image memory */
			reg = <0x24004000 DT_SIZE_K(44)>;
		};
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00010000 DT_SIZE_K(90)>;
		};

		slot1_partition: partition@26800 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00026800 DT_SIZE_K(90)>;
		};
	};
};
