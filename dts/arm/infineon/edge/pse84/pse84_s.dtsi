#include <mem.h>
#include <zephyr/dt-bindings/ppc/infineon-edge-ppc.h>

/ {
	sram0: sram0@34000000 {
		compatible = "mmio-sram";
		reg = <0x34000000 0x100000>;
	};

	dtcm {
		#address-cells = <1>;
		#size-cells = <1>;

		dtcm_m33s: dtcm_m33s@58040000 {
			compatible = "zephyr,memory-region", "arm,dtcm";
			reg = <0x58040000 DT_SIZE_K(256)>;
			zephyr,memory-region = "DTCM";
		};
	};

	itcm {
		#address-cells = <1>;
		#size-cells = <1>;

		itcm_m33s: itcm_m33s@58000000 {
			compatible = "zephyr,memory-region", "arm,itcm";
			reg = <0x58000000 DT_SIZE_K(256)>;
			zephyr,memory-region = "ITCM";
		};
	};

	rram {
		#address-cells = <1>;
		#size-cells = <1>;

		rram: rram@32000000 {
			compatible = "soc-nv-flash";
			reg = <0x32000000 DT_SIZE_K(512)>;
		};
	};

	socmem {
		#address-cells = <1>;
		#size-cells = <1>;

		socmem: socmem@36000000 {
			reg = <0x36000000 DT_SIZE_M(5)>;
		};
	};

	soc {
		pinctrl: pinctrl@52800000 {
			compatible = "infineon,pinctrl";
			reg = <0x52800000 0x20000>;
		};

		hsiom: hsiom@52800000 {
			compatible = "infineon,hsiom";
			reg = <0x52800000 0x4000>;
			interrupts = <42 4>, <40 4>;
			status = "disabled";
		};

		gpio_prt0: gpio@52810000 {
			compatible = "infineon,gpio";
			reg = <0x52810000 0x80>;
			interrupts = <20 4>;
			gpio-controller;
			ngpios = <2>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt1: gpio@52810080 {
			compatible = "infineon,gpio";
			reg = <0x52810080 0x80>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			#gpio-cells = <2>;
		};

		gpio_prt2: gpio@52810100 {
			compatible = "infineon,gpio";
			reg = <0x52810100 0x80>;
			interrupts = <21 4>;
			gpio-controller;
			ngpios = <1>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt3: gpio@52810180 {
			compatible = "infineon,gpio";
			reg = <0x52810180 0x80>;
			interrupts = <22 4>;
			gpio-controller;
			ngpios = <2>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt4: gpio@52810200 {
			compatible = "infineon,gpio";
			reg = <0x52810200 0x80>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			#gpio-cells = <2>;
		};

		gpio_prt5: gpio@52810280 {
			compatible = "infineon,gpio";
			reg = <0x52810280 0x80>;
			interrupts = <23 4>;
			gpio-controller;
			ngpios = <1>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt6: gpio@52810300 {
			compatible = "infineon,gpio";
			reg = <0x52810300 0x80>;
			interrupts = <24 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt7: gpio@52810380 {
			compatible = "infineon,gpio";
			reg = <0x52810380 0x80>;
			interrupts = <25 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt8: gpio@52810400 {
			compatible = "infineon,gpio";
			reg = <0x52810400 0x80>;
			interrupts = <26 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt9: gpio@52810480 {
			compatible = "infineon,gpio";
			reg = <0x52810480 0x80>;
			interrupts = <27 4>;
			gpio-controller;
			ngpios = <4>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt10: gpio@52810500 {
			compatible = "infineon,gpio";
			reg = <0x52810500 0x80>;
			interrupts = <28 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt11: gpio@52810580 {
			compatible = "infineon,gpio";
			reg = <0x52810580 0x80>;
			interrupts = <29 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt12: gpio@52810600 {
			compatible = "infineon,gpio";
			reg = <0x52810600 0x80>;
			interrupts = <30 4>;
			gpio-controller;
			ngpios = <6>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt13: gpio@52810680 {
			compatible = "infineon,gpio";
			reg = <0x52810680 0x80>;
			interrupts = <31 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt14: gpio@52810700 {
			compatible = "infineon,gpio";
			reg = <0x52810700 0x80>;
			interrupts = <32 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt15: gpio@52810780 {
			compatible = "infineon,gpio";
			reg = <0x52810780 0x80>;
			interrupts = <33 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt16: gpio@52810800 {
			compatible = "infineon,gpio";
			reg = <0x52810800 0x80>;
			interrupts = <34 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt17: gpio@52810880 {
			compatible = "infineon,gpio";
			reg = <0x52810880 0x80>;
			interrupts = <35 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt18: gpio@52810900 {
			compatible = "infineon,gpio";
			reg = <0x52810900 0x80>;
			interrupts = <36 4>;
			gpio-controller;
			ngpios = <2>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt19: gpio@52810980 {
			compatible = "infineon,gpio";
			reg = <0x52810980 0x80>;
			interrupts = <37 4>;
			gpio-controller;
			ngpios = <2>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt20: gpio@52810a00 {
			compatible = "infineon,gpio";
			reg = <0x52810a00 0x80>;
			interrupts = <38 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		gpio_prt21: gpio@52810a80 {
			compatible = "infineon,gpio";
			reg = <0x52810a80 0x80>;
			interrupts = <39 4>;
			gpio-controller;
			ngpios = <8>;
			status = "disabled";
			wakeup-source;
			#gpio-cells = <2>;
		};

		lpcomp0: comparator@52880000 {
			compatible = "infineon,lp-comp";
			reg = <0x52880000 0x10000>;
			status = "disabled";
			wakeup-source;

			lpcomp0_0: lpcomp0-0 {
				compatible = "infineon,lp-comp-channel";
				channel = <0>;
				status = "disabled";
			};

			lpcomp0_1: lpcomp0-1 {
				compatible = "infineon,lp-comp-channel";
				channel = <1>;
				status = "disabled";
			};
		};

		autanalog: analog@52e00000 {
			compatible = "infineon,autanalog";
			reg = <0x52e00000 0x100000>;
			wakeup-source;
			interrupts = <57 4>, <58 4>;
			interrupt-names = "autanalog", "autanalog_fifo";
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			ctb0: ctb0@0 {
				compatible = "infineon,autanalog-ctb";
				reg = <0x0 0x1000>;
				status = "disabled";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			ctb1: ctb1@10000 {
				compatible = "infineon,autanalog-ctb";
				reg = <0x10000 0x1000>;
				status = "disabled";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			ptcomp0: ptcomp@e40000 {
				compatible = "infineon,autanalog-ptcomp";
				reg = <0xe40000 0xf00>;
				status = "disabled";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			dac0: dac0@60000 {
				compatible = "infineon,autanalog-ctdac";
				reg = <0x60000 0x1000>;
				clk-dst = <0x200>;
				status = "disabled";
				#io-channel-cells = <1>;
				#address-cells = <1>;
				#size-cells = <0>;

				/* FW channel (default) */
				channel@f {
					reg = <15>;
					zephyr,resolution = <12>;
				};
			};

			dac1: dac1@70000 {
				compatible = "infineon,autanalog-ctdac";
				reg = <0x70000 0x1000>;
				clk-dst = <0x201>;
				status = "disabled";
				#io-channel-cells = <1>;
				#address-cells = <1>;
				#size-cells = <0>;

				/* FW channel (default): direct value writes via Zephyr DAC API */
				channel@f {
					reg = <15>;
					zephyr,resolution = <12>;
				};
			};

			adc0: adc0@80000 {
				compatible = "infineon,autanalog-sar-adc";
				/* Offset within AutAnalog subsystem */
				reg = <0x80000 0xf20>;
				status = "disabled";
				#io-channel-cells = <1>;
			};

			prb0: prb@e0300 {
				compatible = "infineon,autanalog-prb";
				reg = <0xe0300 0x100>;
				status = "disabled";
				#address-cells = <1>;
				#size-cells = <0>;
			};
		};

		ipc0: ipc@522a0000 {
			compatible = "infineon,ipc";
			reg = <0x522a0000 0x1200>;
			status = "disabled";
			#ipc-config-cells = <3>;
		};

		ipc1: ipc@541d0000 {
			compatible = "infineon,ipc";
			reg = <0x541d0000 0x1200>;
			status = "disabled";
			#ipc-config-cells = <3>;
		};

		scb0: scb@52990000 {
			compatible = "infineon,scb";
			reg = <0x52990000 0xfd0>;
			interrupts = <43 4>;
			clk-dst = <0x100>;
			status = "disabled";
			wakeup-source;
		};

		scb2: scb@529a0000 {
			compatible = "infineon,scb";
			reg = <0x529a0000 0xfd0>;
			interrupts = <143 4>;
			clk-dst = <0x101>;
			status = "disabled";
		};

		scb3: scb@529b0000 {
			compatible = "infineon,scb";
			reg = <0x529b0000 0xfd0>;
			interrupts = <144 4>;
			clk-dst = <0x102>;
			status = "disabled";
		};

		scb4: scb@529c0000 {
			compatible = "infineon,scb";
			reg = <0x529c0000 0xfd0>;
			interrupts = <145 4>;
			clk-dst = <0x103>;
			status = "disabled";
		};

		scb5: scb@529d0000 {
			compatible = "infineon,scb";
			reg = <0x529d0000 0xfd0>;
			interrupts = <146 4>;
			clk-dst = <0x104>;
			status = "disabled";
		};

		scb6: scb@529e0000 {
			compatible = "infineon,scb";
			reg = <0x529e0000 0xfd0>;
			interrupts = <147 4>;
			clk-dst = <0x105>;
			status = "disabled";
		};

		scb7: scb@529f0000 {
			compatible = "infineon,scb";
			reg = <0x529f0000 0xfd0>;
			interrupts = <148 4>;
			clk-dst = <0x106>;
			status = "disabled";
		};

		scb8: scb@52a00000 {
			compatible = "infineon,scb";
			reg = <0x52a00000 0xfd0>;
			interrupts = <149 4>;
			clk-dst = <0x107>;
			status = "disabled";
		};

		scb9: scb@52a10000 {
			compatible = "infineon,scb";
			reg = <0x52a10000 0xfd0>;
			interrupts = <150 4>;
			clk-dst = <0x108>;
			status = "disabled";
		};

		scb10: scb@52a20000 {
			compatible = "infineon,scb";
			reg = <0x52a20000 0xfd0>;
			interrupts = <151 4>;
			clk-dst = <0x109>;
			status = "disabled";
		};

		scb11: scb@52a30000 {
			compatible = "infineon,scb";
			reg = <0x52a30000 0xfd0>;
			interrupts = <152 4>;
			clk-dst = <0x10a>;
			status = "disabled";
		};

		scb1: scb@52d00000 {
			compatible = "infineon,scb";
			reg = <0x52d00000 0xfd0>;
			interrupts = <142 4>;
			clk-dst = <0x800>;
			status = "disabled";
		};

		i3c0: i3c@52a50000 {
			compatible = "infineon,i3c";
			reg = <0x52a50000 0x438>;
			interrupts = <176 4>;
			status = "disabled";
		};

		watchdog0: watchdog@5240c000 {
			compatible = "infineon,watchdog";
			reg = <0x5240c000 0x180>;
			interrupts = <54 4>;
			status = "disabled";
			wakeup-source;
		};

		mcwdt0: mcwdt@5240d000 {
			compatible = "infineon,lp-timer";
			reg = <0x5240d000 0x40>;
			interrupts = <55 4>;
			status = "disabled";
			wakeup-source;
		};

		mcwdt1: mcwdt@5240d040 {
			compatible = "infineon,lp-timer";
			reg = <0x5240d040 0x40>;
			interrupts = <0 4>;
			status = "disabled";
			wakeup-source;
		};

		rtc0: rtc@52420000 {
			compatible = "infineon,rtc";
			reg = <0x52420000 0x1140>;
			interrupts = <56 4>;
			alarms-count = <2>;
			status = "disabled";
			wakeup-source;
		};

		canfd0: canfd@52840000 {
			compatible = "infineon,canfd-controller";
			reg = <0x52840000 0x1088>, <0x52850000 0x2000>;
			reg-names = "wrapper", "mram";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
			status = "disabled";

			can0: can@52840000 {
				compatible = "infineon,can";
				reg = <0x52840000 0x200>, <0x52850000 0x1000>;
				reg-names = "m_can", "message_ram";
				clk-dst = <0x10b>;
				status = "disabled";
				bosch,mram-cfg = <0x0 15 15 16 0 0 15 15>;
				interrupts = <106 4>, <107 4>;
				interrupt-names = "int0", "int1";
			};

			can1: can@52840200 {
				compatible = "infineon,can";
				reg = <0x52840200 0x200>, <0x52850000 0x2000>;
				reg-names = "m_can", "message_ram";
				clk-dst = <0x10c>;
				status = "disabled";
				bosch,mram-cfg = <0x1000 15 15 16 0 0 15 15>;
				interrupts = <108 4>, <109 4>;
				interrupt-names = "int0", "int1";
			};
		};

		tcpwm0: tcpwm0@52860000 {
			reg = <0x52860000 0x8000>;
			#address-cells = <1>;
			#size-cells = <1>;

			tcpwm0_0: tcpwm0_0@52860000 {
				compatible = "infineon,tcpwm";
				reg = <0x52860000 0x80>;
				interrupts = <110 4>;
				resolution = <32>;
				clk-dst = <0x10d>;
				status = "disabled";

				pwm0_0: pwm0_0 {
					compatible = "infineon,tcpwm-pwm";
					#pwm-cells = <3>;
					status = "disabled";
				};

				counter0_0: counter0_0 {
					compatible = "infineon,tcpwm-counter";
					status = "disabled";
				};
			};

			tcpwm0_1: tcpwm0_1@52860080 {
				compatible = "infineon,tcpwm";
				reg = <0x52860080 0x80>;
				interrupts = <111 4>;
				resolution = <32>;
				clk-dst = <0x10e>;
				status = "disabled";

				pwm0_1: pwm0_1 {
					compatible = "infineon,tcpwm-pwm";
					#pwm-cells = <3>;
					status = "disabled";
				};

				counter0_1: counter0_1 {
					compatible = "infineon,tcpwm-counter";
					status = "disabled";
				};
			};

			tcpwm0_2: tcpwm0_2@52860100 {
				compatible = "infineon,tcpwm";
				reg = <0x52860100 0x80>;
				interrupts = <112 4>;
				resolution = <32>;
				clk-dst = <0x10f>;
				status = "disabled";

				pwm0_2: pwm0_2 {
					compatible = "infineon,tcpwm-pwm";
					#pwm-cells = <3>;
					status = "disabled";
				};

				counter0_2: counter0_2 {
					compatible = "infineon,tcpwm-counter";
					status = "disabled";
				};
			};

			tcpwm0_3: tcpwm0_3@52860180 {
				compatible = "infineon,tcpwm";
				reg = <0x52860180 0x80>;
				interrupts = <113 4>;
				resolution = <32>;
				clk-dst = <0x110>;
				status = "disabled";

				pwm0_3: pwm0_3 {
					compatible = "infineon,tcpwm-pwm";
					#pwm-cells = <3>;
					status = "disabled";
				};

				counter0_3: counter0_3 {
					compatible = "infineon,tcpwm-counter";
					status = "disabled";
				};
			};

			tcpwm0_4: tcpwm0_4@52860200 {
				compatible = "infineon,tcpwm";
				reg = <0x52860200 0x80>;
				interrupts = <114 4>;
				resolution = <32>;
				clk-dst = <0x111>;
				status = "disabled";

				pwm0_4: pwm0_4 {
					compatible = "infineon,tcpwm-pwm";
					#pwm-cells = <3>;
					status = "disabled";
				};

				counter0_4: counter0_4 {
					compatible = "infineon,tcpwm-counter";
					status = "disabled";
				};
			};

			tcpwm0_5: tcpwm0_5@52860280 {
				compatible = "infineon,tcpwm";
				reg = <0x52860280 0x80>;
				interrupts = <115 4>;
				resolution = <32>;
				clk-dst = <0x112>;
				status = "disabled";

				pwm0_5: pwm0_5 {
					compatible = "infineon,tcpwm-pwm";
					#pwm-cells = <3>;
					status = "disabled";
				};

				counter0_5: counter0_5 {
					compatible = "infineon,tcpwm-counter";
					status = "disabled";
				};
			};

			tcpwm0_6: tcpwm0_6@52860300 {
				compatible = "infineon,tcpwm";
				reg = <0x52860300 0x80>;
				interrupts = <116 4>;
				resolution = <32>;
				clk-dst = <0x113>;
				status = "disabled";

				pwm0_6: pwm0_6 {
					compatible = "infineon,tcpwm-pwm";
					#pwm-cells = <3>;
					status = "disabled";
				};

				counter0_6: counter0_6 {
					compatible = "infineon,tcpwm-counter";
					status = "disabled";
				};
			};

			tcpwm0_7: tcpwm0_7@52860380 {
				compatible = "infineon,tcpwm";
				reg = <0x52860380 0x80>;
				interrupts = <117 4>;
				resolution = <32>;
				clk-dst = <0x114>;
				status = "disabled";

				pwm0_7: pwm0_7 {
					compatible = "infineon,tcpwm-pwm";
					#pwm-cells = <3>;
					status = "disabled";
				};

				counter0_7: counter0_7 {
					compatible = "infineon,tcpwm-counter";
					status = "disabled";
				};
			};
		};

		tcpwm1: tcpwm1@52868000 {
			reg = <0x52868000 0x8000>;
			#address-cells = <1>;
			#size-cells = <1>;

			tcpwm1_0: tcpwm1_0@52868000 {
				compatible = "infineon,tcpwm";
				reg = <0x52868000 0x80>;
				interrupts = <118 4>;
				resolution = <16>;
				clk-dst = <0x115>;
				status = "disabled";

				pwm1_0: pwm1_0 {
					compatible = "infineon,tcpwm-pwm";
					#pwm-cells = <3>;
					status = "disabled";
				};

				counter1_0: counter1_0 {
					compatible = "infineon,tcpwm-counter";
					status = "disabled";
				};
			};

			tcpwm1_1: tcpwm1_1@52868080 {
				compatible = "infineon,tcpwm";
