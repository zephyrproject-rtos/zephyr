		dma0: dw@52270000 {
			#dma-cells = <1>;
			compatible = "infineon,dma";
			reg = <0x52270000 0x10000>;
			dma-channels = <16>;
			interrupts = <82 4>, /* CH0 */
				     <83 4>, /* CH1 */
				     <84 4>, /* CH2 */
				     <85 4>, /* CH3 */
				     <86 4>, /* CH4 */
				     <87 4>, /* CH5 */
				     <88 4>, /* CH6 */
				     <89 4>, /* CH7 */
				     <90 4>, /* CH8 */
				     <91 4>, /* CH9 */
				     <92 4>, /* CH10 */
				     <93 4>, /* CH11 */
				     <94 4>, /* CH12 */
				     <95 4>, /* CH13 */
				     <96 4>, /* CH14 */
				     <97 4>; /* CH15 */
			status = "disabled";
		};

		dma1: dw@52280000 {
			#dma-cells = <1>;
			compatible = "infineon,dma";
			reg = <0x52280000 0x10000>;
			dma-channels = <16>;
			interrupts = <181 4>, /* CH0 */
				     <182 4>, /* CH1 */
				     <183 4>, /* CH2 */
				     <184 4>, /* CH3 */
				     <185 4>, /* CH4 */
				     <186 4>, /* CH5 */
				     <187 4>, /* CH6 */
				     <188 4>, /* CH7 */
				     <189 4>, /* CH8 */
				     <190 4>, /* CH9 */
				     <191 4>, /* CH10 */
				     <192 4>, /* CH11 */
				     <193 4>, /* CH12 */
				     <194 4>, /* CH13 */
				     <195 4>, /* CH14 */
