#include <mem.h>
#include <ti/mspm33c/mspm33c.dtsi>

/ {
	clocks: clocks {
		syspll: syspll {
			compatible = "ti,mspm0-pll";
			clocks = <&sysosc>;
			p-div = <2>;
			q-div = <5>;
			clk1-div = <2>;
			clk2x-div = <2>;
			#clock-cells = <0>;
			status = "disabled";
		};
	};

	soc {
		sram0: memory@30000000 {
			reg = <0x30000000 DT_SIZE_K(256)>;
		};
	};
};

&flash0 {
	reg = <0x10000000 DT_SIZE_K(1024)>;
	ranges = <0x0 0x10000000 DT_SIZE_K(1024)>;
};
