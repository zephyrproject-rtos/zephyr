#include <mem.h>
#include <ti/mspm33c/mspm33c.dtsi>

/ {
	soc {
		sram0: memory@30000000 {
			reg = <0x30000000 DT_SIZE_K(256)>;
		};
	};
};

&flash0 {
	reg = <0x10000000 DT_SIZE_K(1024)>;
	ranges = <0x0 0x10000000 DT_SIZE_K(1024)>;
};

&gpioa {
	pinmux = <&gpio_pa0>,
		 <&gpio_pa1>,
		 <&gpio_pa2>,
		 <&gpio_pa3>,
		 <&gpio_pa4>,
		 <&gpio_pa5>,
		 <&gpio_pa6>,
		 <&gpio_pa7>,
		 <&gpio_pa8>,
		 <&gpio_pa9>,
		 <&gpio_pa10>,
		 <&gpio_pa11>,
		 <&gpio_pa12>,
		 <&gpio_pa13>,
		 <&gpio_pa14>,
		 <&gpio_pa15>,
		 <&gpio_pa16>,
		 <&gpio_pa17>,
		 <&gpio_pa18>,
		 <&gpio_pa19>,
		 <&gpio_pa20>,
		 <&gpio_pa21>,
		 <&gpio_pa22>,
		 <&gpio_pa23>,
		 <&gpio_pa24>,
		 <&gpio_pa25>,
		 <&gpio_pa26>,
		 <&gpio_pa27>,
		 <&gpio_pa28>,
		 <&gpio_pa29>,
		 <&gpio_pa30>;
};

