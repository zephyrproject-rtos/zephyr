#include <arm/armv8-m.dtsi>
#include <freq.h>
#include <zephyr/dt-bindings/clock/mspm0_clock.h>
#include <zephyr/dt-bindings/regulator/mspm0_vref.h>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m33";
			reg = <0>;
			clock-frequency = <DT_FREQ_M(32)>;
		};
	};

	ckm: clock-module {
		compatible = "ti,mspm0-ckm";
		#clock-cells = <1>;
		sysctl = <&sysctl>;
		factoryregion = <&factoryregion>;
		fri = <&fri>;
		memcfg = <&memcfg>;
	};

	clocks: clocks {
		hfclk: hfclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			status = "disabled";
		};

		hsclk: hsclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			status = "disabled";
		};

		lfclk: lfclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			clocks = <&lfosc>;
		};

		ulpclk: ulpclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
		};

		mclk: mclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			clocks = <&sysosc>;
		};

		mclk_div_2: mclk_div_2 {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			clk-div = <2>;
		};

		mclk_div_4: mclk_div_4 {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			clk-div = <4>;
		};

		mfpclk: mfpclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			clocks = <&sysosc>;
			status = "disabled";
		};

		canclk: canclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			status = "disabled";
		};
	};

	oscillators: oscillators {
		hfxt: hfxt {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			status = "disabled";
		};

		lfxt: lfxt {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			status = "disabled";
		};

		lfosc: lfosc {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			clock-frequency = <32768>;
		};

		sysosc: sysosc {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			clock-frequency = <DT_FREQ_M(32)>;
		};
	};

	soc {
		sysctl: syscon@400af000 {
			compatible = "syscon";
			reg = <0x400af000 0x2000>;
			status = "okay";
		};

		factoryregion: syscon@80111000 {
			compatible = "syscon";
			reg = <0x80111000 0x80>;
		};

		fri: syscon@40028000 {
			compatible = "syscon";
			reg = <0x40028000 0x2000>;
		};

		memcfg: syscon@4002a000 {
			compatible = "syscon";
			reg = <0x4002a000 0x2000>;
		};

		sram0: memory@30000000 {
			compatible = "mmio-sram";
		};

		flash_controller: flash-controller@40042000 {
			reg = <0x40042000 DT_SIZE_K(8)>;
			interrupts = <2 0>;
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			flash0: flash@10000000 {
				compatible = "soc-nv-flash";
				erase-block-size = <DT_SIZE_K(2)>;
				write-block-size = <16>;
				#address-cells = <1>;
				#size-cells = <1>;
			};
		};

		pinctrl: pin-controller@400cc000 {
			compatible = "ti,mspm0-pinctrl";
			reg = <0x400cc000 0x400>;

			gpio_none: gpio_none {
				pinmux = <0>;
			};
		};

		gpioa: gpio@400f0000 {
			compatible = "ti,mspm0-gpio";
			reg = <0x400f0000 0x2000>;
			interrupts = <6 0>;
			gpio-controller;
			#gpio-cells = <2>;
			status = "disabled";
		};

		gpiob: gpio@400f2000 {
			compatible = "ti,mspm0-gpio";
			reg = <0x400f2000 0x2000>;
			interrupts = <7 0>;
			gpio-controller;
			#gpio-cells = <2>;
			status = "disabled";
		};

		gpioc: gpio@400f4000 {
			compatible = "ti,mspm0-gpio";
			reg = <0x400f4000 0x2000>;
			interrupts = <8 0>;
			gpio-controller;
			#gpio-cells = <2>;
			status = "disabled";
		};

		comp0: comp@400e0000 {
			compatible = "ti,mspm0-comparator";
			reg = <0x400e0000 0x2000>;
			interrupts = <38 0>;
			status = "disabled";
		};

		comp1: comp@400e2000 {
			compatible = "ti,mspm0-comparator";
			reg = <0x400e2000 0x2000>;
			interrupts = <39 0>;
			status = "disabled";
		};

		dma0: dma@40020000 {
			compatible = "ti,mspm0-dma";
			reg = <0x40020000 0x2000>;
			interrupts = <43 0>;
			#dma-cells = <2>;
			status = "disabled";
		};

		dma1: dma@40022000 {
			compatible = "ti,mspm0-dma";
			reg = <0x40022000 0x2000>;
			interrupts = <44 0>;
			#dma-cells = <2>;
			status = "disabled";
		};

		vref0: vref@400e8000 {
			compatible = "ti,mspm0-vref";
			reg = <0x400e8000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_BUSCLK>;
			ti,clk-div = <0x1>;
			off-on-delay-us = <350>;
			regulator-uv = <1400000>;
			ti,sample-cycles = <10>;
			ti,hold-cycles = <40>;
			regulator-allowed-modes = <MSPM0_VREF_MODE_NORMAL>,
						  <MSPM0_VREF_MODE_SHMODE>,
						  <MSPM0_VREF_MODE_V2I>,
						  <MSPM0_VREF_MODE_SHMODE_V2I>;
			status = "disabled";
		};

		timg4_0: timg4_0@400c0000 {
			compatible = "ti,mspm0-timer";
			reg = <0x400c0000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_LFCLK>;
			interrupts = <21 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg4_0: counterg4_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg4_1: timg4_1@400c2000 {
			compatible = "ti,mspm0-timer";
			reg = <0x400c2000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_LFCLK>;
			interrupts = <22 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg4_1: counterg4_1 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg4_2: timg4_2@40180000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40180000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <35 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg4_2: counterg4_2 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg4_3: timg4_3@40182000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40182000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <36 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg4_3: counterg4_3 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg8_0: timg8_0@40184000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40184000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <23 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg8_0: counterg8_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg8_1: timg8_1@40186000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40186000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <37 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg8_1: counterg8_1 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg12_0: timg12_0@40188000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40188000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <24 0>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg12_0: counterg12_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <32>;
				channels = <2>;
				status = "disabled";
			};
		};

		tima0_0: tima0_0@40010000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40010000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK>;
			interrupts = <20 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			countera0_0: countera0_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <4>;
				status = "disabled";
			};

			pwma0_0: pwma0_0 {
				compatible = "ti,mspm0-timer-pwm";
				#pwm-cells = <3>;
				status = "disabled";
			};
		};

		tima0_1: tima0_1@40012000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40012000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK>;
			interrupts = <34 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			countera0_1: countera0_1 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <4>;
				status = "disabled";
			};

			pwma0_1: pwma0_1 {
				compatible = "ti,mspm0-timer-pwm";
				#pwm-cells = <3>;
				status = "disabled";
			};
		};

		canfd0: can@40110000 {
			compatible = "ti,mspm0-canfd";
			reg = <0x40110000 0x8000>,
			      <0x40117000 0x1000>,
			      <0x40110000 0x400>;
			reg-names = "ti_canfd",
				    "m_can",
				    "message_ram";
			interrupts = <19 0>;
			clocks = <&ckm MSPM0_CLOCK_CANCLK>;
			bosch,mram-cfg = <0x0 20 8 3 3 0 3 3>;
			status = "disabled";
		};

		canfd1: can@40118000 {
			compatible = "ti,mspm0-canfd";
			reg = <0x40118000 0x8000>,
			      <0x4011f000 0x1000>,
			      <0x40118000 0x400>;
			reg-names = "ti_canfd",
				    "m_can",
				    "message_ram";
			interrupts = <33 0>;
			clocks = <&ckm MSPM0_CLOCK_CANCLK>;
			bosch,mram-cfg = <0x0 20 8 3 3 0 3 3>;
			status = "disabled";
		};

		wdt0: wdt0@400d0000 {
			compatible = "ti,mspm0-watchdog";
			reg = <0x400d0000 0x2000>;
			interrupts = <3 0>;
			clocks = <&ckm MSPM0_CLOCK_LFCLK>;
			ti,watchdog-reset-action = <1>;
			closed-window = <0>;
			status = "disabled";
		};

		iwdt: iwdt@400d9300 {
			compatible = "ti,mspm0-iwdt";
			reg = <0x400d9300 0x100>;
			clock-frequency = <32768>;
			status = "disabled";
		};

		rtc: rtc@400d8000 {
			compatible = "ti,mspm0-rtc";
			reg = <0x400d8000 0x2000>;
			interrupts = <42 0>;
			alarms-count = <2>;
			ti,rtc-x;
			status = "disabled";
		};

		unicomm2: unicomm2@40680000 {
			compatible = "ti,unicomm";
			reg = <0x40680000 DT_SIZE_K(8)>;
			#address-cells = <1>;
			#size-cells = <1>;
			interrupts = <27 0>;
			unicomm-fixed-mode;
			status = "disabled";

			unicomm2_spi: unicomm2_spi@40660000 {
				compatible = "ti,unicomm-spi";
				reg = <0x40660000 DT_SIZE_K(8)>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <27 0>;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				fifo-depth = <4>;
				status = "disabled";
			};
		};

		unicomm1_0: unicomm1_0@40582000 {
			reg = <0x40582000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <25 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm1_0_uart: unicomm1_0_uart@40502000 {
				reg = <0x40502000 DT_SIZE_K(8)>;
				interrupts = <25 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_4>;
				status = "disabled";
			};

			unicomm1_0_i2c: unicomm1_0_i2c@40523000 {
				reg = <0x40523000 DT_SIZE_K(8)>, <0x40543000 DT_SIZE_K(8)>;
				reg-names = "controller", "target";
				interrupts = <25 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_4>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		unicomm1_1: unicomm1_1@40584000 {
			reg = <0x40584000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <26 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm1_1_uart: unicomm1_1_uart@40504000 {
				reg = <0x40504000 DT_SIZE_K(8)>;
				interrupts = <26 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_4>;
				status = "disabled";
			};

			unicomm1_1_i2c: unicomm1_1_i2c@40525000 {
				reg = <0x40525000 DT_SIZE_K(8)>, <0x40545000 DT_SIZE_K(8)>;
				reg-names = "controller", "target";
				interrupts = <26 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_4>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		unicomm12: unicomm12@40688000 {
			reg = <0x40688000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			unicomm-fixed-mode;
			interrupts = <30 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm12_uart: unicomm12_uart@40608000 {
				reg = <0x40608000 DT_SIZE_K(8)>;
				interrupts = <30 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			};
		};

		unicomm13_0: unicomm13_0@4068a000 {
			reg = <0x4068a000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <31 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm13_0_uart: unicomm13_0_uart@4060a000 {
				reg = <0x4060a000 DT_SIZE_K(8)>;
				interrupts = <31 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				clk-div = <1>;
				status = "disabled";
			};

			unicomm13_0_i2c: unicomm13_0_i2c@4062b000 {
				reg = <0x4062b000 DT_SIZE_K(8)>, <0x4064b000 DT_SIZE_K(8)>;
				reg-names = "controller", "target";
				interrupts = <31 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};

			unicomm13_0_spi: unicomm13_0_spi@4066a000 {
				compatible = "ti,unicomm-spi";
				reg = <0x4066a000 DT_SIZE_K(8)>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <31 0>;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				fifo-depth = <4>;
				status = "disabled";
			};
		};

		unicomm13_1: unicomm13_1@40780000 {
			reg = <0x40780000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <32 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm13_1_uart: unicomm13_1_uart@40700000 {
				reg = <0x40700000 DT_SIZE_K(8)>;
				interrupts = <32 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				clk-div = <1>;
				status = "disabled";
			};

			unicomm13_1_i2c: unicomm13_1_i2c@40721000 {
				reg = <0x40721000 DT_SIZE_K(8)>, <0x40741000 DT_SIZE_K(8)>;
				reg-names = "controller", "target";
				interrupts = <50 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};

			unicomm13_1_spi: unicomm13_1_spi@40760000 {
				compatible = "ti,unicomm-spi";
				reg = <0x40760000 DT_SIZE_K(8)>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <50 0>;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				fifo-depth = <4>;
				status = "disabled";
			};
		};

		unicomm13_2: unicomm13_2@40782000 {
			reg = <0x40782000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <50 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm13_2_uart: unicomm13_2_uart@40702000 {
				reg = <0x40702000 DT_SIZE_K(8)>;
				interrupts = <50 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				clk-div = <1>;
				status = "disabled";
			};

			unicomm13_2_i2c: unicomm13_2_i2c@40723000 {
				reg = <0x40723000 DT_SIZE_K(8)>, <0x40743000 DT_SIZE_K(8)>;
				reg-names = "controller", "target";
				interrupts = <51 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};

			unicomm13_2_spi: unicomm13_2_spi@40762000 {
				compatible = "ti,unicomm-spi";
				reg = <0x40762000 DT_SIZE_K(8)>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <51 0>;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				fifo-depth = <4>;
				status = "disabled";
			};
		};

		unicomm13_3: unicomm13_3@40784000 {
			reg = <0x40784000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <51 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm13_3_uart: unicomm13_3_uart@40704000 {
				reg = <0x40704000 DT_SIZE_K(8)>;
				interrupts = <51 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				clk-div = <1>;
				status = "disabled";
			};
		};

		unicomm14: unicomm14@40786000 {
			reg = <0x40786000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <52 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm14_uart: unicomm14_uart@40707000 {
				reg = <0x40707000 DT_SIZE_K(8)>;
				interrupts = <52 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				clk-div = <1>;
				status = "disabled";
			};

			unicomm13_3_i2c: unicomm13_3_i2c@40725000 {
				reg = <0x40725000 DT_SIZE_K(8)>, <0x40745000 DT_SIZE_K(8)>;
				reg-names = "controller", "target";
				interrupts = <52 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		unicomm15_0: unicomm15_0@40684000 {
			reg = <0x40684000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <28 0>;
			unicomm-fixed-mode;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm15_0_i2c: unicomm15_0_i2c@40625000 {
				reg = <0x40625000 DT_SIZE_K(8)>, <0x40645000 DT_SIZE_K(8)>;
				reg-names = "controller", "target";
				interrupts = <28 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				unicomm-advanced-i2c;
				status = "disabled";
			};
		};

		unicomm15_1: unicomm15_1@40686000 {
			reg = <0x40686000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <29 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm15_1_i2c: unicomm15_1_i2c@40627000 {
				reg = <0x40627000 DT_SIZE_K(8)>, <0x40647000 DT_SIZE_K(8)>;
				reg-names = "controller", "target";
				interrupts = <29 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};

			unicomm13_3_spi: unicomm13_3_spi@40764000 {
				compatible = "ti,unicomm-spi";
				reg = <0x40764000 DT_SIZE_K(8)>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <52 0>;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				fifo-depth = <4>;
				status = "disabled";
			};
		};

		crc: crc@401b2000 {
			compatible = "ti,mspm0-crcp";
			reg = <0x401b2000 0x2000>;
			status = "disabled";
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <2>;
};
