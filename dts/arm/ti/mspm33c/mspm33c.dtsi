#include <arm/armv8-m.dtsi>
#include <freq.h>
#include <zephyr/dt-bindings/clock/mspm0_clock.h>
#include <zephyr/dt-bindings/regulator/mspm0_vref.h>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m33";
			reg = <0>;
			clock-frequency = <DT_FREQ_M(32)>;
		};
	};

	ckm: clock-module {
		compatible = "ti,mspm0-ckm";
		#clock-cells = <1>;
		sysctl = <&sysctl>;
		factoryregion = <&factoryregion>;
		fri = <&fri>;
		memcfg = <&memcfg>;
	};

	clocks: clocks {
		hfclk: hfclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			status = "disabled";
		};

		hsclk: hsclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			status = "disabled";
		};

		lfclk: lfclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			clocks = <&lfosc>;
		};

		ulpclk: ulpclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
		};

		mclk: mclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			clocks = <&sysosc>;
		};

		mclk_div_2: mclk_div_2 {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			clk-div = <2>;
		};

		mclk_div_4: mclk_div_4 {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			clk-div = <4>;
		};

		mfpclk: mfpclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			clocks = <&sysosc>;
			status = "disabled";
		};

		canclk: canclk {
			#clock-cells = <0>;
			compatible = "ti,mspm0-clk";
			status = "disabled";
		};
	};

	oscillators: oscillators {
		hfxt: hfxt {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			status = "disabled";
		};

		lfxt: lfxt {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			status = "disabled";
		};

		lfosc: lfosc {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			clock-frequency = <32768>;
		};

		sysosc: sysosc {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			clock-frequency = <DT_FREQ_M(32)>;
		};
	};

	soc {
		sysctl: syscon@400af000 {
			compatible = "syscon";
			reg = <0x400af000 0x2000>;
			status = "okay";
		};

		factoryregion: syscon@80111000 {
			compatible = "syscon";
			reg = <0x80111000 0x80>;
		};

		fri: syscon@40028000 {
			compatible = "syscon";
			reg = <0x40028000 0x2000>;
		};

		memcfg: syscon@4002a000 {
			compatible = "syscon";
			reg = <0x4002a000 0x2000>;
		};

		sram0: memory@30000000 {
			compatible = "mmio-sram";
		};

		flash_controller: flash-controller@40042000 {
			reg = <0x40042000 DT_SIZE_K(8)>;
			interrupts = <2 0>;
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			flash0: flash@10000000 {
				compatible = "soc-nv-flash";
				erase-block-size = <DT_SIZE_K(2)>;
				write-block-size = <16>;
				#address-cells = <1>;
				#size-cells = <1>;
			};
		};

		pinctrl: pin-controller@400cc000 {
			compatible = "ti,mspm0-pinctrl";
			reg = <0x400cc000 0x400>;
		};

		gpioa: gpio@400f0000 {
			compatible = "ti,mspm0-gpio";
			reg = <0x400f0000 0x2000>;
			interrupts = <6 0>;
			status = "disabled";
			gpio-controller;
			#gpio-cells = <2>;
		};

		gpiob: gpio@400f2000 {
			compatible = "ti,mspm0-gpio";
			reg = <0x400f2000 0x2000>;
			interrupts = <7 0>;
			status = "disabled";
			gpio-controller;
			#gpio-cells = <2>;
		};

		gpioc: gpio@400f4000 {
			compatible = "ti,mspm0-gpio";
			reg = <0x400f4000 0x2000>;
			interrupts = <8 0>;
			status = "disabled";
			gpio-controller;
			#gpio-cells = <2>;
		};

		comp0: comp@400e0000 {
			compatible = "ti,mspm0-comparator";
			reg = <0x400e0000 0x2000>;
			interrupts = <38 0>;
			status = "disabled";
		};

		comp1: comp@400e2000 {
			compatible = "ti,mspm0-comparator";
			reg = <0x400e2000 0x2000>;
			interrupts = <39 0>;
			status = "disabled";
		};

		dma0: dma@40020000 {
			compatible = "ti,mspm0-dma";
			reg = <0x40020000 0x2000>;
			interrupts = <43 0>;
			#dma-cells = <2>;
			status = "disabled";
		};

		dma1: dma@40022000 {
			compatible = "ti,mspm0-dma";
			reg = <0x40022000 0x2000>;
			interrupts = <44 0>;
			#dma-cells = <2>;
			status = "disabled";
		};

		vref0: vref@400e8000 {
			compatible = "ti,mspm0-vref";
			reg = <0x400e8000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_BUSCLK>;
			ti,clk-div = <0x1>;
			off-on-delay-us = <350>;
			regulator-uv = <1400000>;
			ti,sample-cycles = <10>;
			ti,hold-cycles = <40>;
			regulator-allowed-modes = <MSPM0_VREF_MODE_NORMAL>,
						  <MSPM0_VREF_MODE_SHMODE>,
						  <MSPM0_VREF_MODE_V2I>,
						  <MSPM0_VREF_MODE_SHMODE_V2I>;
			status = "disabled";
		};

		timg4_0: timg4_0@400c0000 {
			compatible = "ti,mspm0-timer";
			reg = <0x400c0000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_LFCLK>;
			interrupts = <21 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg4_0: counterg4_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg4_1: timg4_1@400c2000 {
			compatible = "ti,mspm0-timer";
			reg = <0x400c2000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_LFCLK>;
			interrupts = <22 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg4_1: counterg4_1 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg4_2: timg4_2@40180000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40180000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <35 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg4_2: counterg4_2 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg4_3: timg4_3@40182000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40182000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <36 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg4_3: counterg4_3 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg8_0: timg8_0@40184000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40184000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <23 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg8_0: counterg8_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg8_1: timg8_1@40186000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40186000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <37 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg8_1: counterg8_1 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg12_0: timg12_0@40188000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40188000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <24 0>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg12_0: counterg12_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <32>;
				channels = <2>;
				status = "disabled";
			};
		};

		tima0_0: tima0_0@40010000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40010000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK>;
			interrupts = <20 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			countera0_0: countera0_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <4>;
				status = "disabled";
			};
		};

		tima0_1: tima0_1@40012000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40012000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK>;
			interrupts = <34 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			countera0_1: countera0_1 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <4>;
				status = "disabled";
			};
		};

		canfd0: can@40110000 {
			compatible = "ti,mspm0-canfd";
			reg = <0x40110000 0x8000>,
			      <0x40117000 0x1000>,
			      <0x40110000 0x400>;
			reg-names = "ti_canfd",
				    "m_can",
				    "message_ram";
			interrupts = <19 0>;
			clocks = <&ckm MSPM0_CLOCK_CANCLK>;
			bosch,mram-cfg = <0x0 20 8 3 3 0 3 3>;
			status = "disabled";
		};

		canfd1: can@40118000 {
			compatible = "ti,mspm0-canfd";
			reg = <0x40118000 0x8000>,
			      <0x4011f000 0x1000>,
			      <0x40118000 0x400>;
			reg-names = "ti_canfd",
				    "m_can",
				    "message_ram";
			interrupts = <33 0>;
			clocks = <&ckm MSPM0_CLOCK_CANCLK>;
			bosch,mram-cfg = <0x0 20 8 3 3 0 3 3>;
			status = "disabled";
		};

		wdt0: wdt0@400d0000 {
			compatible = "ti,mspm0-watchdog";
			reg = <0x400d0000 0x2000>;
			interrupts = <3 0>;
			clocks = <&ckm MSPM0_CLOCK_LFCLK>;
			ti,watchdog-reset-action = <1>;
			closed-window = <0>;
			status = "disabled";
		};

		iwdt: iwdt@400d9300 {
			compatible = "ti,mspm0-iwdt";
			reg = <0x400d9300 0x100>;
			clock-frequency = <32768>;
			status = "disabled";
		};

		rtc: rtc@400d8000 {
			compatible = "ti,mspm0-rtc";
			reg = <0x400d8000 0x2000>;
			interrupts = <42 0>;
			alarms-count = <2>;
			ti,rtc-x;
			status = "disabled";
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <2>;
};
