#include <arm/armv8-m.dtsi>
#include <freq.h>
#include <zephyr/dt-bindings/clock/mspm0_clock.h>
#include <zephyr/dt-bindings/regulator/mspm0_vref.h>

/ {
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-m33";
			reg = <0>;
			clock-frequency = <DT_FREQ_M(32)>;
		};
	};

	ckm: clock-module {
		compatible = "ti,mspm0-clk";
		#clock-cells = <1>;
	};

	clocks: clocks {
		hfclk: hfclk {
			#clock-cells = <1>;
			compatible = "ti,mspm0-clk";
			status = "disabled";
		};

		hsclk: hsclk {
			#clock-cells = <1>;
			compatible = "ti,mspm0-clk";
			status = "disabled";
		};

		lfclk: lfclk {
			#clock-cells = <1>;
			compatible = "ti,mspm0-clk";
			clocks = <&lfosc>;
		};

		ulpclk: ulpclk {
			#clock-cells = <1>;
			compatible = "ti,mspm0-clk";
		};

		mclk: mclk {
			#clock-cells = <1>;
			compatible = "ti,mspm0-clk";
			clocks = <&sysosc>;
		};

		mfpclk: mfpclk {
			#clock-cells = <1>;
			compatible = "ti,mspm0-clk";
			clocks = <&sysosc>;
			status = "disabled";
		};

		canclk: canclk {
			#clock-cells = <1>;
			compatible = "ti,mspm0-clk";
			status = "disabled";
		};
	};

	oscillators: oscillators {
		hfxt: hfxt {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			status = "disabled";
		};

		lfxt: lfxt {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			status = "disabled";
		};

		lfosc: lfosc {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			clock-frequency = <32768>;
		};

		sysosc: sysosc {
			#clock-cells = <0>;
			compatible = "ti,mspm0-osc";
			clock-frequency = <DT_FREQ_M(32)>;
		};
	};

	soc {
		sysctl: syscon@400af000 {
			compatible = "syscon";
			reg = <0x400af000 0x2000>;
			status = "disabled";
		};

		factoryregion: syscon@80111000 {
			compatible = "syscon";
			reg = <0x80111000 0x80>;
			status = "disabled";
		};

		sram0: memory@30000000 {
			compatible = "mmio-sram";
		};

		pinctrl: pin-controller@400cc000 {
			compatible = "ti,mspm0-pinctrl";
			reg = <0x400cc000 0x2000>;
			status = "disabled";
		};

		flash_controller: flash-controller@40042000 {
			reg = <0x40042000 DT_SIZE_K(8)>;
			interrupts = <2 0>;
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			flash0: flash@10000000 {
				compatible = "soc-nv-flash";
				erase-block-size = <DT_SIZE_K(2)>;
				write-block-size = <16>;
				#address-cells = <1>;
				#size-cells = <1>;
			};
		};

		vref0: vref@400e8000 {
			compatible = "ti,mspm0-vref";
			reg = <0x400e8000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_BUSCLK>;
			ti,clk-div = <0x1>;
			off-on-delay-us = <350>;
			regulator-uv = <1400000>;
			ti,sample-cycles = <10>;
			ti,hold-cycles = <40>;
			regulator-allowed-modes = <MSPM0_VREF_MODE_NORMAL>,
						  <MSPM0_VREF_MODE_SHMODE>,
						  <MSPM0_VREF_MODE_V2I>,
						  <MSPM0_VREF_MODE_SHMODE_V2I>;
			status = "disabled";
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <2>;
};
