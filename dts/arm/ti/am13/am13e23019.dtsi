#include "am13e.dtsi"
#include <zephyr/dt-bindings/clock/mspm0_clock.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	soc {
		sram0_1_2: memory@20000000 {
			compatible = "zephyr,memory-region";
			reg = <0x20000000 DT_SIZE_K(96)>;
			zephyr,memory-region = "SRAM012";
		};

		sram3_cahb: memory@c18000 {
			compatible = "zephyr,memory-region";
			reg = <0xc18000 DT_SIZE_K(32)>;
			zephyr,memory-region = "SRAM3CAHB";
		};

		sram3_sahb: memory@20018000 {
			compatible = "zephyr,memory-region";
			reg = <0x20018000 DT_SIZE_K(32)>;
			zephyr,memory-region = "SRAM3SAHB";
		};

		gpioa: gpio@400f0000 {
			compatible = "ti,mspm0-gpio";
			reg = <0x400f0000 0x2000>;
			interrupts = <4 0>;
			status = "disabled";
			gpio-controller;
			#gpio-cells = <2>;
		};

		gpiob: gpio@400f2000 {
			compatible = "ti,mspm0-gpio";
			reg = <0x400f2000 0x2000>;
			interrupts = <5 0>;
			status = "disabled";
			gpio-controller;
			#gpio-cells = <2>;
		};

		gpioc: gpio@400f4000 {
			compatible = "ti,mspm0-gpio";
			reg = <0x400f4000 0x2000>;
			interrupts = <6 0>;
			status = "disabled";
			gpio-controller;
			#gpio-cells = <2>;
		};

		gpiod: gpio@400f6000 {
			compatible = "ti,mspm0-gpio";
			reg = <0x400f6000 0x2000>;
			interrupts = <7 0>;
			status = "disabled";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <12>;
		};

		flash: flash-controller@40028000 {
			reg = <0x40028000 DT_SIZE_K(8)>;
			ranges;
			interrupts = <2 0>;

			#address-cells = <1>;
			#size-cells = <1>;

			flash0: flash@0 {
				compatible = "soc-nv-flash";
				reg = <0x0 DT_SIZE_K(512)>;
				ranges = <0x0 0x0 DT_SIZE_K(512)>;

				write-block-size = <16>;
				erase-block-size = <DT_SIZE_K(2)>;

				#address-cells = <1>;
				#size-cells = <1>;
			};
		};

		wdt0: wdt0@400d0000 {
			compatible = "ti,mspm0-watchdog";
			reg = <0x400d0000 0x2000>;
			interrupts = <3 0>;
			clocks = <&ckm MSPM0_CLOCK_LFCLK>;
			ti,watchdog-reset-action = <1>;
			closed-window = <0>;
			status = "disabled";
		};

		timg4_0: timg4_0@40180000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40180000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <44 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg4_0: counterg4_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg12_0: timg12_0@40188000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40188000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <45 0>;
			ti,clk-prescaler = <0>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg12_0: counterg12_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <32>;
				channels = <2>;
				status = "disabled";
			};
		};

		mcan0: can0@40110000 {
			compatible = "ti,mspm0-canfd";
			reg = <0x40110000 0x8000>,
			      <0x40117000 0x1000>,
			      <0x40110000 0x400>;
			reg-names = "ti_canfd",
				    "m_can",
				    "message_ram";
			interrupts = <23 0>;
			clocks = <&ckm MSPM0_CLOCK_CANCLK>;
			bosch,mram-cfg = <0x0 20 8 3 3 0 3 3>;
			status = "disabled";
		};

		unicomm0: unicomm0@40630000 {
			reg = <0x40630000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <34 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm0_uart: unicomm0_uart@40600000 {
				reg = <0x40600000 DT_SIZE_K(8)>;
				interrupts = <34 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm0_i2c: unicomm0_i2c@40608000 {
				reg = <0x40608000 DT_SIZE_K(4)>, <0x40610000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <34 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};

			unicomm0_spi: unicomm0_spi@40618000 {
				compatible = "ti,unicomm-spi";
				reg = <0x40618000 DT_SIZE_K(8)>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <34 0>;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};
		};

		unicomm1: unicomm1@40632000 {
			reg = <0x40632000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <35 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm1_uart: unicomm1_uart@40601000 {
				reg = <0x40601000 DT_SIZE_K(8)>;
				interrupts = <35 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm1_i2c: unicomm1_i2c@40609000 {
				reg = <0x40609000 DT_SIZE_K(4)>, <0x40611000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <35 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};

			unicomm1_spi: unicomm1_spi@40619000 {
				compatible = "ti,unicomm-spi";
				reg = <0x40619000 DT_SIZE_K(8)>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <35 0>;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};
		};

		unicomm2: unicomm2@40634000 {
			reg = <0x40634000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <36 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm2_uart: unicomm2_uart@40602000 {
				reg = <0x40602000 DT_SIZE_K(8)>;
				interrupts = <36 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm2_i2c: unicomm2_i2c@4060a000 {
				reg = <0x4060a000 DT_SIZE_K(4)>, <0x40612000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <36 0>;
				compatible = "ti,unicomm-i2c";
				unicomm-advanced-i2c;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		unicomm3: unicomm3@40670000 {
			reg = <0x40670000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <37 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm3_uart: unicomm3_uart@40640000 {
				reg = <0x40640000 DT_SIZE_K(8)>;
				interrupts = <37 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm3_i2c: unicomm3_i2c@40648000 {
				reg = <0x40648000 DT_SIZE_K(4)>, <0x40650000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <37 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};

			unicomm3_spi: unicomm3_spi@40658000 {
				compatible = "ti,unicomm-spi";
				reg = <0x40658000 DT_SIZE_K(8)>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <37 0>;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};
		};

		unicomm4: unicomm4@40672000 {
			reg = <0x40672000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <38 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm4_uart: unicomm4_uart@40641000 {
				reg = <0x40641000 DT_SIZE_K(8)>;
				interrupts = <38 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm4_i2c: unicomm4_i2c@40649000 {
				reg = <0x40649000 DT_SIZE_K(4)>, <0x40651000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <38 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};

			unicomm4_spi: unicomm4_spi@40659000 {
				compatible = "ti,unicomm-spi";
				reg = <0x40659000 DT_SIZE_K(8)>;
				#address-cells = <1>;
				#size-cells = <0>;
				interrupts = <38 0>;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};
		};

		unicomm5: unicomm5@40674000 {
			reg = <0x40674000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <39 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm5_uart: unicomm5_uart@40642000 {
				reg = <0x40642000 DT_SIZE_K(8)>;
				interrupts = <39 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm5_i2c: unicomm5_i2c@4064a000 {
				reg = <0x4064a000 DT_SIZE_K(4)>, <0x40652000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <39 0>;
				compatible = "ti,unicomm-i2c";
				unicomm-advanced-i2c;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		aes: aes@401b0000 {
			compatible = "ti,mspm0-aes-adv";
			reg = <0x401b0000 0x2000>;
			interrupts = <43 0>;
		};

		crc: crc@401b2000 {
			compatible = "ti,mspm0-crcp";
			reg = <0x401b2000 0x2000>;
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <4>;
};

&gpioa {
	pinmux = <&gpio_pa0>, <&gpio_pa1>, <&gpio_pa2>, <&gpio_pa3>,
		 <&gpio_pa4>, <&gpio_pa5>, <&gpio_pa6>, <&gpio_pa7>,
		 <&gpio_pa8>, <&gpio_pa9>, <&gpio_pa10>, <&gpio_pa11>,
		 <&gpio_pa12>, <&gpio_pa13>, <&gpio_pa14>, <&gpio_pa15>,
		 <&gpio_pa16>, <&gpio_pa17>, <&gpio_pa18>, <&gpio_pa19>,
		 <&gpio_pa20>, <&gpio_pa21>, <&gpio_pa22>, <&gpio_pa23>,
		 <&gpio_pa24>, <&gpio_pa25>, <&gpio_pa26>, <&gpio_pa27>,
		 <&gpio_pa28>, <&gpio_pa29>, <&gpio_pa30>, <&gpio_pa31>;
};

&gpiob {
	pinmux = <&gpio_pb0>, <&gpio_pb1>, <&gpio_pb2>, <&gpio_pb3>,
		 <&gpio_pb4>, <&gpio_pb5>, <&gpio_pb6>, <&gpio_pb7>,
		 <&gpio_pb8>, <&gpio_pb9>, <&gpio_pb10>, <&gpio_pb11>,
		 <&gpio_pb12>, <&gpio_pb13>, <&gpio_pb14>, <&gpio_pb15>,
		 <&gpio_pb16>, <&gpio_pb17>, <&gpio_pb18>, <&gpio_pb19>,
		 <&gpio_pb20>, <&gpio_pb21>, <&gpio_pb22>, <&gpio_pb23>,
		 <&gpio_pb24>, <&gpio_pb25>, <&gpio_pb26>, <&gpio_pb27>,
		 <&gpio_pb28>, <&gpio_pb29>, <&gpio_pb30>, <&gpio_pb31>;
};

&gpioc {
	pinmux = <&gpio_pc0>, <&gpio_pc1>, <&gpio_pc2>, <&gpio_pc3>,
		 <&gpio_pc4>, <&gpio_pc5>, <&gpio_pc6>, <&gpio_pc7>,
		 <&gpio_pc8>, <&gpio_pc9>, <&gpio_pc10>, <&gpio_pc11>,
		 <&gpio_pc12>, <&gpio_pc13>, <&gpio_pc14>, <&gpio_pc15>,
		 <&non_bonded>, <&non_bonded>,
		 <&gpio_pc18>, <&gpio_pc19>, <&gpio_pc20>, <&gpio_pc21>,
		 <&gpio_pc22>, <&gpio_pc23>, <&gpio_pc24>, <&gpio_pc25>,
		 <&gpio_pc26>, <&gpio_pc27>, <&gpio_pc28>, <&gpio_pc29>,
		 <&gpio_pc30>, <&gpio_pc31>;
};

&gpiod {
	pinmux = <&gpio_pd0>, <&gpio_pd1>, <&gpio_pd2>, <&gpio_pd3>,
		 <&gpio_pd4>, <&gpio_pd5>, <&gpio_pd6>, <&gpio_pd7>,
		 <&gpio_pd8>, <&gpio_pd9>, <&non_bonded>, <&gpio_pd11>;
};
