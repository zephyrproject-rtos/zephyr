#include "am13e.dtsi"
#include <zephyr/dt-bindings/clock/mspm0_clock.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	soc {
		sram0_1_2: memory@20000000 {
			compatible = "zephyr,memory-region";
			reg = <0x20000000 DT_SIZE_K(96)>;
			zephyr,memory-region = "SRAM012";
		};

		sram3_cahb: memory@c18000 {
			compatible = "zephyr,memory-region";
			reg = <0xc18000 DT_SIZE_K(32)>;
			zephyr,memory-region = "SRAM3CAHB";
		};

		sram3_sahb: memory@20018000 {
			compatible = "zephyr,memory-region";
			reg = <0x20018000 DT_SIZE_K(32)>;
			zephyr,memory-region = "SRAM3SAHB";
		};

		flash: flash-controller@40028000 {
			reg = <0x40028000 DT_SIZE_K(8)>;
			ranges;
			interrupts = <2 0>;

			#address-cells = <1>;
			#size-cells = <1>;

			flash0: flash@0 {
				compatible = "soc-nv-flash";
				reg = <0x0 DT_SIZE_K(512)>;
				ranges = <0x0 0x0 DT_SIZE_K(512)>;

				write-block-size = <16>;
				erase-block-size = <DT_SIZE_K(2)>;

				#address-cells = <1>;
				#size-cells = <1>;
			};
		};

		unicomm0: unicomm0@40630000 {
			reg = <0x40630000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <34 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm0_uart: unicomm0_uart@40600000 {
				reg = <0x40600000 DT_SIZE_K(8)>;
				interrupts = <34 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm0_i2c: unicomm0_i2c@40608000 {
				reg = <0x40608000 DT_SIZE_K(4)>, <0x40610000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <34 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		unicomm1: unicomm1@40632000 {
			reg = <0x40632000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <35 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm1_uart: unicomm1_uart@40601000 {
				reg = <0x40601000 DT_SIZE_K(8)>;
				interrupts = <35 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm1_i2c: unicomm1_i2c@40609000 {
				reg = <0x40609000 DT_SIZE_K(4)>, <0x40611000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <35 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		unicomm2: unicomm2@40634000 {
			reg = <0x40634000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <36 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm2_uart: unicomm2_uart@40602000 {
				reg = <0x40602000 DT_SIZE_K(8)>;
				interrupts = <36 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm2_i2c: unicomm2_i2c@4060a000 {
				reg = <0x4060a000 DT_SIZE_K(4)>, <0x40612000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <36 0>;
				compatible = "ti,unicomm-i2c";
				unicomm-advanced-i2c;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		unicomm3: unicomm3@40670000 {
			reg = <0x40670000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <37 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm3_uart: unicomm3_uart@40640000 {
				reg = <0x40640000 DT_SIZE_K(8)>;
				interrupts = <37 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm3_i2c: unicomm3_i2c@40648000 {
				reg = <0x40648000 DT_SIZE_K(4)>, <0x40650000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <37 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		unicomm4: unicomm4@40672000 {
			reg = <0x40672000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <38 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm4_uart: unicomm4_uart@40641000 {
				reg = <0x40641000 DT_SIZE_K(8)>;
				interrupts = <38 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm4_i2c: unicomm4_i2c@40649000 {
				reg = <0x40649000 DT_SIZE_K(4)>, <0x40651000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <38 0>;
				compatible = "ti,unicomm-i2c";
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};

		unicomm5: unicomm5@40674000 {
			reg = <0x40674000 DT_SIZE_K(8)>;
			compatible = "ti,unicomm";
			interrupts = <39 0>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			unicomm5_uart: unicomm5_uart@40642000 {
				reg = <0x40642000 DT_SIZE_K(8)>;
				interrupts = <39 0>;
				#address-cells = <1>;
				#size-cells = <1>;
				compatible = "ti,mspm0-uart";
				is-unicomm-uart;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				status = "disabled";
			};

			unicomm5_i2c: unicomm5_i2c@4064a000 {
				reg = <0x4064a000 DT_SIZE_K(4)>, <0x40652000 DT_SIZE_K(4)>;
				reg-names = "controller", "target";
				interrupts = <39 0>;
				compatible = "ti,unicomm-i2c";
				unicomm-advanced-i2c;
				clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <4>;
};
