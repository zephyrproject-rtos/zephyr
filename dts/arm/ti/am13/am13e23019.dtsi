#include "am13e.dtsi"
#include <zephyr/dt-bindings/clock/mspm0_clock.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	soc {
		sram0_1_2: memory@20000000 {
			compatible = "zephyr,memory-region";
			reg = <0x20000000 DT_SIZE_K(96)>;
			zephyr,memory-region = "SRAM012";
		};

		sram3_cahb: memory@c18000 {
			compatible = "zephyr,memory-region";
			reg = <0xc18000 DT_SIZE_K(32)>;
			zephyr,memory-region = "SRAM3CAHB";
		};

		sram3_sahb: memory@20018000 {
			compatible = "zephyr,memory-region";
			reg = <0x20018000 DT_SIZE_K(32)>;
			zephyr,memory-region = "SRAM3SAHB";
		};

		flash: flash-controller@40028000 {
			reg = <0x40028000 DT_SIZE_K(8)>;
			ranges;
			interrupts = <2 0>;

			#address-cells = <1>;
			#size-cells = <1>;

			flash0: flash@0 {
				compatible = "soc-nv-flash";
				reg = <0x0 DT_SIZE_K(512)>;
				ranges = <0x0 0x0 DT_SIZE_K(512)>;

				write-block-size = <16>;
				erase-block-size = <DT_SIZE_K(2)>;

				#address-cells = <1>;
				#size-cells = <1>;
			};
		};

		timg4_0: timg4_0@40180000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40180000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <44 0>;
			ti,clk-prescaler = <255>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg4_0: counterg4_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <16>;
				channels = <2>;
				status = "disabled";
			};
		};

		timg12_0: timg12_0@40188000 {
			compatible = "ti,mspm0-timer";
			reg = <0x40188000 0x2000>;
			clocks = <&ckm MSPM0_CLOCK_MCLK_DIV_2>;
			interrupts = <45 0>;
			ti,clk-prescaler = <0>;
			ti,clk-div = <1>;
			status = "disabled";

			counterg12_0: counterg12_0 {
				compatible = "ti,mspm0-timer-counter";
				resolution = <32>;
				channels = <2>;
				status = "disabled";
			};
		};
	};
};

&nvic {
	arm,num-irq-priority-bits = <4>;
};
