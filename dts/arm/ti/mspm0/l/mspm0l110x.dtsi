#include <mem.h>
#include <ti/mspm0/l/mspm0l.dtsi>

/delete-node/ &gpiob;
/delete-node/ &gpioc;

/ {
	die_temp: dietemp {
		compatible = "ti,mspm0-temp";
		io-channels = <&adc0 11>;
		ts-trim-temp = <30>;
		ts-trim-vref = <1400>;
		ts-coefficient = <(-1750)>;
		status = "disabled";
	};

	soc {
		sram0: memory@20000000 {
			reg = <0x20000000 DT_SIZE_K(4)>;
		};

		uart1: uart@40100000 {
			compatible = "ti,mspm0-uart";
			reg = <0x40100000 0x2000>;
			interrupts = <13 0>;
			current-speed = <115200>;
			clocks = <&ckm MSPM0_CLOCK_ULPCLK>;
			clk-div = <1>;
			status = "disabled";
		};
	};
};
