#include <arm/armv8-m.dtsi>

/ {
	  chosen {
		  zephyr,flash-controller = &flash_controller;
		  zephyr,user;
	  };

	  cpus {
		  #address-cells = <1>;
		  #size-cells = <0>;

		  cpu0: cpu@0 {
			  device_type = "cpu";
			  compatible = "arm,cortex-m33";
			  reg = <0>;
			  cpu-power-states = <&idle &standby>;
		  };

		  power-states {
			  idle: idle {
				  compatible = "zephyr,power-state";
				  power-state-name = "suspend-to-idle";
				  min-residency-us = <100>;
			  };

			  standby: standby {
				  compatible = "zephyr,power-state";
				  power-state-name = "standby";
				  min-residency-us = <5000>;
				  exit-latency-us = <2400>;
			  };
		  };
	  };

	  sram0: memory@20000000 {
		  compatible = "mmio-sram";
	  };

	  sysclk: system-clock {
		  compatible = "fixed-clock";
		  clock-frequency = <48000000>;
		  #clock-cells = <0>;
	  };

	  soc {
		  /* IOC = pinctrl */
		  pinctrl: pinctrl@40081000 {
			  compatible = "ti,cc13x4-cc26x4-pinctrl";
			  reg = <0x40081000 0x1000>;
		  };

		  uart0: uart@40001000 {
			  compatible = "ti,cc13x4-cc26x4-uart";
			  reg = <0x40001000 0x1000>;
			  interrupts = <5 0>;
			  clocks = <&sysclk>;
			  status = "disabled";
		  };

		  /* system necessity — flash */
		  flash_controller: flash-controller@58030000 {
			  compatible = "ti,cc13x4-cc26x4-flash-controller";
			  reg = <0x58030000 0x4000>;
			  #address-cells = <1>;
			  #size-cells = <1>;

			  flash0: flash@0 {
				  compatible = "soc-nv-flash";
				  erase-block-size = <DT_SIZE_K(8)>;
				  write-block-size = <1>;
			  };
		  };

		  rtc: rtc@58092000 {
			  compatible = "ti,cc13x4-cc26x4-rtc-timer";
			  reg = <0x58092000 0x1000>;
			  interrupts = <4 0>;
			  status = "okay";
			};
		};
	};

&nvic{
		arm,num-irq-priority-bits = <3>;
	};

&systick{
		status = "disabled";
	};
