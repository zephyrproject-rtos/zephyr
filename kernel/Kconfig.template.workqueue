config $(module)_DEDICATED_WORKQUEUE
	bool "Use a dedicated workqueue for $(module-str)"
	depends on MULTITHREADING
	help
	  Use a dedicated workqueue for $(module-str) instead of the system
	  workqueue.

if $(module)_DEDICATED_WORKQUEUE

config $(module)_DEDICATED_WORKQUEUE_STACK_SIZE
	int "Dedicated workqueue stack size for $(module-str)"
	default 1024
	help
	  Stack size for the dedicated $(module-str) workqueue thread.

config $(module)_DEDICATED_WORKQUEUE_PRIORITY
	int "Dedicated workqueue priority for $(module-str)"
	default SYSTEM_WORKQUEUE_PRIORITY
	help
	  Thread priority for the dedicated $(module-str) workqueue thread.

config $(module)_DEDICATED_WORKQUEUE_NO_YIELD
	bool "Dedicated workqueue no yield for $(module-str)"
	default SYSTEM_WORKQUEUE_NO_YIELD
	help
	  By default, the dedicated $(module-str) workqueue yields between each work item, to
	  prevent other threads from being starved. Selecting this removes this yield.

config $(module)_DEDICATED_WORKQUEUE_WORK_TIMEOUT_MS
	int "Dedicated workqueue work timeout in milliseconds for $(module-str)"
	default SYSTEM_WORKQUEUE_WORK_TIMEOUT_MS
	help
	  Set to 0 to disable work timeout for the dedicated $(module-str) workqueue. Option has no
	  effect if CONFIG_WORKQUEUE_WORK_TIMEOUT is not enabled.

endif # $(module)_DEDICATED_WORKQUEUE
