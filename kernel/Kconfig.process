menu "Process support"

config PROCESS
	bool "Process (thread group) support [EXPERIMENTAL]"
	select EXPERIMENTAL
	help
	  Select 'y' to enable kernel process (thread group) support: every
	  thread belongs to a process, processes form a parent/child tree
	  rooted in the three kernel-reserved processes (swapper, init,
	  kthreadd), and process termination can be observed with k_waitpid().

	  Process support does not require CONFIG_USERSPACE: without it,
	  processes provide identity, lifetime, and wait semantics for
	  supervisor-mode threads; memory isolation between processes
	  additionally requires CONFIG_USERSPACE.

if PROCESS

config PROCESS_STOP
	bool "Process stop and continue (job control)"
	depends on PROCESS && SIGNAL
	help
	  Give the stop signals their POSIX default action: delivery of
	  K_SIG_STOP, K_SIG_TSTP, K_SIG_TTIN, or K_SIG_TTOU suspends every
	  member thread of the receiving process, K_SIG_CONT resumes them,
	  and k_waitpid() reports the transitions to waiters passing
	  K_PROCESS_WUNTRACED or K_PROCESS_WCONTINUED.

config PROCESS_VM
	bool "Per-process virtual address space duplication (experimental)"
	depends on PROCESS && USERSPACE && ARCH_HAS_PROCESS_VM
	# kernel-mode reads of the TLS-cached current thread would alias the
	# parent's physical memory through the shared kernel page tables
	depends on !CURRENT_THREAD_USE_TLS
	select SYS_THREAD
	help
	  Enable address-space duplication for the fork() model: a cloned
	  child receives copies of the calling process's writable memory at
	  the same virtual addresses. Requires architecture support
	  (z_mem_domain_clone_remap()). Experimental.

config MAX_PROCESS_BYTES
	int "Bytes to use to track process permissions to kernel objects"
	default 1
	depends on USERSPACE
	help
	  Every kernel object stores one permission bit per process (a thread
	  holds permissions through the process it belongs to). This is the
	  size of that per-object bitmap in bytes, bounding the number of
	  simultaneously live processes.

config PROCESS_INIT
	bool "Start the init process with an initial thread"
	help
	  Give the reserved init process a running initial thread at boot,
	  independent of the image main(). The thread runs
	  z_process_init_entry(), a weak function the application overrides to
	  act as the system's init process; the default implementation sleeps
	  forever. Without this option, the init process exists but has no
	  thread of its own until one is created in it.

config PROCESS_INIT_STACK_SIZE
	int "init process initial thread stack size"
	depends on PROCESS_INIT
	default 1024
	help
	  Stack size of the init process's initial thread.

config PROCESS_INIT_PRIORITY
	int "init process initial thread priority"
	depends on PROCESS_INIT
	default 0
	help
	  Scheduling priority of the init process's initial thread.

config PROCESS_SIGCHLD_NOTIFIER_STACK_SIZE
	int "SIGCHLD notifier thread stack size"
	depends on SIGNAL
	default 1024
	help
	  Stack size of the thread that emits K_SIG_CHLD to a parent process
	  when one of its children becomes a zombie. Signal generation cannot
	  run in the scheduler's thread-halt path, so it is deferred to this
	  thread.+
config SIGNAL_SET_SIZE_MIN_PROCESS
	int
	depends on SIGNAL
	default 18
	help
	  Child-status notification uses K_SIG_CHLD (17), which must be
	  representable in the kernel signal set: processes require a set of
	  at least 18 signals.

config SIGNAL_QUEUE_SIZE_ADD_PROCESS
	int
	depends on SIGNAL
	default 4
	help
	  Queue headroom for child-status signals: each zombie child may hold
	  one pending K_SIG_CHLD element alongside ordinary signal traffic,
	  so a queue sized only for the latter can drop signals or leave
	  sigtimedwait() callers hung.

endif # PROCESS

endmenu
