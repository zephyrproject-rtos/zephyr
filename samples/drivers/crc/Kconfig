menu "CRC sample application"

choice SAMPLE_CRC_VARIANT
	prompt "CRC variant to run"
	default SAMPLE_CRC_VARIANT_CRC8 if CRC_DRIVER_HAS_CRC8
	default SAMPLE_CRC_VARIANT_CRC16_CCITT if CRC_DRIVER_HAS_CRC16_CCITT || CRC_DRIVER_HAS_CRC16
	default SAMPLE_CRC_VARIANT_CRC32_IEEE if CRC_DRIVER_HAS_CRC32_IEEE
	default SAMPLE_CRC_VARIANT_CRC32_C if CRC_DRIVER_HAS_CRC32_C
	help
	  Choose which CRC algorithm the sample computes.

config SAMPLE_CRC_VARIANT_CRC8
	bool "CRC8"
	depends on CRC_DRIVER_HAS_CRC8

config SAMPLE_CRC_VARIANT_CRC16_CCITT
	bool "CRC16-CCITT"
	depends on CRC_DRIVER_HAS_CRC16_CCITT || CRC_DRIVER_HAS_CRC16

config SAMPLE_CRC_VARIANT_CRC32_IEEE
	bool "CRC32-IEEE"
	depends on CRC_DRIVER_HAS_CRC32_IEEE

config SAMPLE_CRC_VARIANT_CRC32_C
	bool "CRC32-C"
	depends on CRC_DRIVER_HAS_CRC32_C

endchoice

endmenu

source "Kconfig.zephyr"
