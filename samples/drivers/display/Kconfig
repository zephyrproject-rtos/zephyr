mainmenu "Display sample application"

source "Kconfig.zephyr"

config SAMPLE_BUFFER_ADDR_ALIGN
	int "The display buffer address alignment"
	default 8 if 64BIT
	default 8 if DISPLAY_MCUX_ELCDIF
	default 4

config SAMPLE_WIDTH_ALIGN
	int "The update area width alignment"
	default 24 if ST730X
	default 8 if UC81XX
	default 6 if ST7586S
	default 4 if SSD1322 || SSD1363
	default 2 if SSD1327_5 || SSD1320 || SH1122
	default 1

config SAMPLE_HEIGHT_ALIGN
	int "The update area height alignment"
	default 8 if ST75256 || ST7567
	default 2 if ST730X
	default 1

config HEAP_MEM_POOL_ADD_SIZE_SAMPLE
	int "Sample maximum heap allocated buffer size"
	default 196608 if QEMU_RAMFB_DISPLAY
	default 65536
	help
	  Maximum size of the buffer for rendering rectangles
