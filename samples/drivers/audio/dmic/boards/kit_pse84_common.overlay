/ {
	aliases {
		dmic0 = &dmic_dev;
	};
};

dmic_dev: &dmic0 {
	pinctrl-0 = <&p8_5_pdm3_pdm_clk &p8_6_pdm3_pdm_data>;
	pinctrl-names = "default";
	clocks = <&peri1_group1_16_5bit_2>;

	dmas = <&dma0 0>;
	dma-names = "rx";
	status = "okay";
};

&dmic0_ch2 {
	use-alt-io;
	status = "okay";
};

&dmic0_ch3 {
	status = "okay";
};

&dma0 {
	status = "okay";
};

&clk_hf7 {
	source-path = <IFX_CLK_HF_IN_CLKPATH3>;
	status = "okay";
};

&peri1_group1_16_5bit_2 {
	clock-div = <2>;
	div-frac-value = <7>;
	status = "okay";
};

&p8_5_pdm3_pdm_clk {
	drive-strength = "half";
	drive-push-pull;
};

&p8_6_pdm3_pdm_data {
	drive-strength = "half";
	input-enable;
};
