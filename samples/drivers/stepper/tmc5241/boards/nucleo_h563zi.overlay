 * SPDX-License-Identifier: Apache-2.0
 *
 * TMC5241-EVKIT on the Nucleo-H563ZI through the "Sternbruecke Nucleo V0.1"
 * adapter. Same wiring as samples/drivers/stepper/generic/boards/
 * nucleo_h563zi_tmc5241.overlay (see its header for the pin trace and for how
 * the chip-select was found): the Eval connector's SPI1_nCS (pin 30) is
 * Nucleo D8 = PF3, and the SPI clock and data pins are the board defaults.
 *
 * The board-level control pins are driven once at boot with GPIO hogs, so
 * this sample needs no board specific code. Their states are the ones that
 * were used for the bench bring-up of the generic sample:
 *   SLEEPN  (PE6)  high   - low or floating puts the chip to sleep
 *   UART_EN (PE12) low    - SPI mode
 *   IREF_R2 (PE0)  high   - as in the generic sample bring-up
 *   IREF_R3 (PB10) low
 *
 * The ramp values are slow on purpose: with fCLK = 16 MHz,
 * v[Hz] = v * fCLK / 2^24, so vmax = 100000 is about 95k microsteps/s, or
 * 1.9 rev/s at 256 microsteps/step and 200 full steps/rev. IRUN 10 of 31 is
 * about 0.23 A RMS.
 *
 * StallGuard2 (SpreadCycle, so no en-pwm-mode) was tuned on the bench with a
 * QSH2818-32-07-006 motor at 24 V, 0.5 A supply limit and this speed. At
 * stallguard2-threshold = 4 the unloaded SG_RESULT while cruising was about
 * 96-117 and it fell to 0-5 when the shaft was blocked. The window is narrow:
 * each step of the threshold moves the reading by about 47, 2 reads 0 even
 * unloaded (false stalls) and 6 and above leave a blocked shaft at 30-60. It
 * needs retuning for another motor, current, supply or speed. tcoolthrs = 200
 * enables the chip's stall output only above about 84000 (TSTEP <= 200), which
 * keeps the unreliable low-speed readings out. The sample arms the stall stop
 * above CONFIG_STALLGUARD_THRESHOLD_VELOCITY, set in nucleo_h563zi.conf.
 */

/ {
	aliases {
		stepper-driver = &tmc5241_stepper_driver;
		stepper-ctrl = &tmc5241_motion_controller;
	};
};

&gpioe {
	sleep-hog {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-high;
	};

	uart-en-hog {
		gpio-hog;
		gpios = <12 GPIO_ACTIVE_HIGH>;
		output-low;
	};

	iref-r2-hog {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&gpiob {
	iref-r3-hog {
		gpio-hog;
		gpios = <10 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&spi1 {
	cs-gpios = <&gpiof 3 GPIO_ACTIVE_LOW>; /* Eval pin 30 SPI1_nCS = D8 */
	status = "okay";

	tmc5241: tmc5241@0 {
		compatible = "adi,tmc5241";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(1)>;

		/* Sternbruecke Y201 XTAL OSC */
		clock-frequency = <16000000>;
		diag0-gpios = <&gpioe 7 GPIO_ACTIVE_HIGH>;

		tmc5241_stepper_driver: stepper-driver {
			compatible = "adi,tmc5241-stepper-driver";
			en-gpios = <&gpioa 3 GPIO_ACTIVE_LOW>; /* DRV_ENN active-low */
			micro-step-res = <256>;
			stallguard2-threshold = <4>;
		};

		tmc5241_motion_controller: stepper-ctrl {
			compatible = "adi,tmc5241-stepper-ctrl";
			vstart = <100>;
			vstop = <200>;
			a1 = <3000>;
			v1 = <50000>;
			d1 = <3000>;
			vmax = <100000>;
			amax = <3000>;
			dmax = <3000>;
			tzerowait = <100>;
			thigh = <0>;
			tcoolthrs = <200>;
			ihold = <1>;
			irun = <10>;
			iholddelay = <1>;
		};
	};
};
