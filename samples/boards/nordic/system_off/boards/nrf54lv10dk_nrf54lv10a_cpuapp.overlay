/ {
	aliases {
		retainedmemdevice = &retainedmem0;
	};

	cpuapp_sram@2002ec00 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2002ec00 DT_SIZE_K(4)>;
		zephyr,memory-region = "RetainedMem";
		status = "okay";

		retainedmem0: retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
		};
	};
};

&cpuapp_sram_app {
	/* Shrink SRAM to avoid overlap with retained memory region. The SRAM ends at
	 * 187KB = 0x2ec00, where the region starts, and starts at 0x60 after the KMU push
	 * area, so the size is that end offset minus 0x60.
	 */
	reg = <0x60 (DT_SIZE_K(187) - 0x60)>;
};
