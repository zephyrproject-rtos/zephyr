mainmenu "CANopen sample"

config SAMPLE_NODE_ID
	int "CANopen node-ID"
	default 16
	range 1 127

config SAMPLE_BITRATE
	int "CAN bitrate in bit/s"
	default 500000

config SAMPLE_COUNTER_PERIOD_MS
	int "Counter increment period in milliseconds"
	default 100

config SAMPLE_TPDO_EVENT_TIMER_MS
	int "TPDO1 event timer in milliseconds"
	default 1000
	range 0 65535

config SAMPLE_MASTER
	bool "Boot a slave as CANopen master"
	select CANOPEN_MASTER
	help
	  After start-up, configure and start the slave with node-ID SAMPLE_SLAVE_ID, read its
	  device name and monitor its heartbeat.

config SAMPLE_SLAVE_ID
	int "Node-ID of the slave"
	default 32
	range 1 127
	depends on SAMPLE_MASTER

source "Kconfig.zephyr"
