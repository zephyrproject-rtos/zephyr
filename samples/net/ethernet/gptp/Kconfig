mainmenu "gPTP sample application"

if NET_GPTP

config NET_SAMPLE_RUN_DURATION
	int "Run the application this many seconds"
	default 0
	help
	  A value of zero means that the sample application is run forever.

endif


source "Kconfig.zephyr"
