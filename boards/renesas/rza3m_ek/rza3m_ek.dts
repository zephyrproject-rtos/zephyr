/dts-v1/;

#include <freq.h>
#include <arm64/renesas/rz/rza/r9a07g066.dtsi>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/renesas-rz-gpio.h>
#include "rza3m_ek-pinctrl.dtsi"
#include <zephyr/dt-bindings/display/panel.h>

/ {
	model = "Renesas RZ/A3M EK";
	compatible = "renesas,rza3m-ek";

	chosen {
		zephyr,sram = &ddr;
		zephyr,flash = &spi_flash;
		zephyr,console = &scif0;
		zephyr,shell-uart = &scif0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &zephyr_lcdif;
	};

	ddr: memory@40200000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x40200000 (DT_SIZE_M(128) - 0x200000)>;
		zephyr,memory-region = "DDR";
	};

	sram: memory@1e000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x1e000 DT_SIZE_K(72)>;
		zephyr,memory-region = "SRAM";
	};

	aliases {
		led0 = &led1;
		sw0 = &sw1;
		mipi-dsi = &mipi_dsi;
	};

	leds {
		compatible = "gpio-leds";

		led1: led1 {
			gpios = <&gpio10 1 GPIO_ACTIVE_HIGH>;
			label = "led1";
		};

		led2: led2 {
			gpios = <&gpio20 3 GPIO_ACTIVE_HIGH>;
			label = "led2";
		};

		led3: led3 {
			gpios = <&gpio20 4 GPIO_ACTIVE_HIGH>;
			label = "led3";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		sw1: sw1 {
			label = "sw1";
			gpios = <&gpio10 3 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};

		sw2: sw2 {
			label = "sw2";
			gpios = <&gpio11 1 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	renesas_mipi_connector: mipi-connector {
		compatible = "renesas,rz-gpio-mipi-header";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <20 0 &gpio8 2 0>,  /* I2C_SDA */
			   <21 0 &gpio10 2 0>, /* DIMMER */
			   <22 0 &gpio8 3 0>,  /* I2C_SCL */
			   <23 0 &gpio8 1 0>;  /* TP_INT */
	};
};

&spibsc {
	spi_flash: memory@20000000 {
		compatible = "soc-nv-flash";
		reg = <0x20000000 DT_SIZE_M(32)>;
		ranges = <0x0 0x20000000 DT_SIZE_M(32)>;
		#address-cells = <1>;
		#size-cells = <1>;

		partitions {
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			reserved: partition@0 {
				compatible = "zephyr,mapped-partition";
				reg = <0x0 0x20000>;
				read-only;
			};

			header: partition@20000 {
				label = "header";
				compatible = "zephyr,mapped-partition";
				reg = <0x20000 0x200>;
				read-only;
			};

			slot0_partition: partition@20200 {
				label = "image-0";
				compatible = "zephyr,mapped-partition";
				reg = <0x20200 (DT_SIZE_M(32) - 0x20200)>;
				read-only;
			};
		};
	};
};

&scif0 {
	current-speed = <115200>;
	pinctrl-0 = <&scif0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&tint0 {
	status = "okay";
};

&tint1 {
	status = "okay";
};

&tint2 {
	status = "okay";
};

&gpio {
	status = "okay";
};

&gpio8 {
	status = "okay";
};

&gpio10 {
	irqs = <&tint0 1>, <&tint1 3>;
	status = "okay";
};

&gpio11 {
	irqs = <&tint2 1>;
	status = "okay";
};

&gpio20 {
	status = "okay";
};

/* alias used by display shields */
zephyr_lcdif: &lcdif {};

/* alias used by display shields */
zephyr_mipi_dsi: &mipi_dsi {};

renesas_mipi_i2c: &i2c1 {};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	status = "okay";
};
