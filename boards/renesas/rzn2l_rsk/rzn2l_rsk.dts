/dts-v1/;
#include <arm/renesas/rz/rzn/r9a07g084.dtsi>
#include "rzn2l_rsk-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Renesas Starter Kit+ for RZ/N2L";
	compatible = "renesas,rzn2l-rsk";

	chosen {
		zephyr,sram = &atcm;
		zephyr,flash = &mx25u51245g;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		sw0 = &sw1;
		watchdog0 = &wdt0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&gpio18 2 0>;
			label = "led0";
		};

		led1: led1 {
			gpios = <&gpio22 3 0>;
			label = "led1";
		};

		led2: led2 {
			gpios = <&gpio4 1 0>;
			label = "led2";
		};

		led3: led3 {
			gpios = <&gpio17 3 0>;
			label = "led3";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		sw1: sw1 {
			label = "sw1";
			gpios = <&gpio16 3 0>;
			zephyr,code = <INPUT_KEY_0>;
		};

		sw2: sw2 {
			label = "sw2";
			gpios = <&gpio5 4 0>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&sci0 {
	pinctrl-0 = <&sci0_default>;
	pinctrl-names = "default";
	status = "okay";

	uart0: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&gpio18 {
	status = "okay";
};

&gpio22 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

&gpio17 {
	status = "okay";
};

&irq7 {
	trigger-type = "falling";
	pinctrl-0 = <&irq7_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio16 {
	irqs = <&irq7 3>;
	status = "okay";
};

&gpio5 {
	status = "okay";
};

&adc0 {
	status = "okay";
};

&adc1 {
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	status = "okay";
};

&spi2 {
	pinctrl-0 = <&spi2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&xspi0 {
	pinctrl-0 = <&xspi0_default>;
	pinctrl-names = "default";
	status = "okay";

	ext_flash_ctrl: flash-controller@0 {
		compatible = "renesas,rz-qspi-xspi";
		reg = <0>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x60000000 DT_SIZE_M(64)>;

		mx25u51245g: qspi-nor-flash@0 {
			compatible = "soc-nv-flash";
			reg = <0x0 DT_SIZE_M(64)>;
			write-block-size = <1>;
			erase-block-size = <4096>;

			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			partitions {
				ranges;
				#address-cells = <1>;
				#size-cells = <1>;

				loader_param: partition@0 {
					compatible = "zephyr,mapped-partition";
					label = "loader-param";
					reg = <0x00000000 0x4c>;
					read-only;
				};

				loader_program: partition@4c {
					compatible = "zephyr,mapped-partition";
					label = "loader-program";
					reg = <0x0000004c (DT_SIZE_K(56) - 0x4C)>;
					read-only;
				};

				slot0_partition: partition@e000 {
					compatible = "zephyr,mapped-partition";
					label = "image-0";
					reg = <0x0000e000 DT_SIZE_M(4)>;
					read-only;
				};

				storage_partition: partition@40e000 {
					compatible = "zephyr,mapped-partition";
					label = "storage";
					reg = <0x0040e000
					       (DT_SIZE_M(64) - DT_SIZE_M(4) - DT_SIZE_K(56))>;
				};
			};
		};
	};
};
