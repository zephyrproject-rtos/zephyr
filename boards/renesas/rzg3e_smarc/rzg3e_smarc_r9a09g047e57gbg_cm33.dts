/dts-v1/;

#include <freq.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/renesas-rz-gpio.h>
#include <arm/renesas/rz/rzg/r9a09g047.dtsi>
#include "rzg3e_smarc-pinctrl.dtsi"

/ {
	compatible = "renesas,rzg3e-smarc";
	model = "Renesas RZ/G3E SMARC";

	chosen {
		zephyr,sram = &sram;
		zephyr,console = &uart4;
		zephyr,shell-uart = &uart4;
	};

	aliases {
		sw0 = &sw1;
		sw1 = &sw2;
		sw2 = &sw3;
		i2c-0 = &i2c1;
		pwm-test = &pwm3;
		adc = &adc0;
		adc0 = &adc0;
	};

	zephyr,user {
		io-channels = <&adc0 0>, <&adc0 2>;
	};

	buttons {
		compatible = "gpio-keys";

		sw1: sw1 {
			gpios = <&gpio3 1 GPIO_ACTIVE_LOW>;
			label = "SW1";
			zephyr,code = <INPUT_KEY_1>;
		};

		sw2: sw2 {
			gpios = <&gpio8 4 GPIO_ACTIVE_LOW>;
			label = "SW2";
			zephyr,code = <INPUT_KEY_2>;
		};

		sw3: sw3 {
			gpios = <&gpio8 5 GPIO_ACTIVE_LOW>;
			label = "SW3";
			zephyr,code = <INPUT_KEY_3>;
		};
	};

	sram: memory@8003000 {
		compatible = "mmio-sram";
		reg = <0x08003000 DT_SIZE_K(245)>;
	};
};

&sci4 {
	pinctrl-0 = <&sci4_pins>;
	pinctrl-names = "default";
	status = "okay";

	uart4: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

&tint0 {
	status = "okay";
};

&gpio3 {
	irqs = <&tint0 1>;
	status = "okay";
};

&gpio8 {
	status = "okay";
};

&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <12>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,vref-mv = <1800>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <12>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,vref-mv = <1800>;
	};
};

&gtm0 {
	status = "okay";

	counter {
		status = "okay";
	};
};

&gtm1 {
	status = "okay";

	counter {
		status = "okay";
	};
};

&gtm2 {
	status = "okay";

	counter {
		status = "okay";
	};
};

&gtm3 {
	status = "okay";

	counter {
		status = "okay";
	};
};

&gtm4 {
	status = "okay";

	counter {
		status = "okay";
	};
};

&gtm5 {
	status = "okay";

	counter {
		status = "okay";
	};
};

&gtm6 {
	status = "okay";

	counter {
		status = "okay";
	};
};

&gtm7 {
	status = "okay";

	counter {
		status = "okay";
	};
};

&gpt3 {
	status = "okay";

	pwm3: pwm {
		pinctrl-0 = <&gpt3_pins>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&spi0 {
	pinctrl-0 = <&spi0_pins>;
	pinctrl-names = "default";
	status = "okay";
};
