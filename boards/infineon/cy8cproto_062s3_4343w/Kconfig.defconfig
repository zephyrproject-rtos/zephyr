if BOARD_CY8CPROTO_062S3_4343W

# sram0 already starts above the prebuilt Cortex-M0+ image's SRAM, so the
# linker must not reserve it a second time.
config SOC_PSOC6_CM0P_IMAGE_RAM_SIZE
	default 0x0

