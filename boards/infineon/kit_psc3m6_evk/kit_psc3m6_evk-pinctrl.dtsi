/* Debug UART (SCB3) pin drive modes */
&p6_3_scb3_uart_tx {
	drive-push-pull;
};

&p6_2_scb3_uart_rx {
	input-enable;
};

/* User UART (SCB4) pin drive modes */
&p3_3_scb4_uart_tx {
	drive-push-pull;
};

&p3_2_scb4_uart_rx {
	input-enable;
};

/* SPI (SCB2) pin drive modes */
&p7_0_scb2_spi_m_clk {
	drive-strength = "full";
	drive-push-pull;
};

&p7_1_scb2_spi_m_mosi {
	drive-strength = "full";
	drive-push-pull;
};

&p7_2_scb2_spi_m_miso {
	drive-strength = "full";
	input-enable;
};
