# Enable FPU
CONFIG_FPU=y

# General configuration
CONFIG_BUILD_OUTPUT_HEX=y

CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# Enable GPIO driver
CONFIG_GPIO=y

# Enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Enable UART driver
CONFIG_SERIAL=y

# Enable Clock Control driver
CONFIG_CLOCK_CONTROL=y

CONFIG_ARM_TRUSTZONE_M=y

CONFIG_TRUSTED_EXECUTION_NONSECURE=y

CONFIG_CODE_DATA_RELOCATION=y

CONFIG_BUILD_WITH_TFM=y
CONFIG_TFM_PROFILE_TYPE_MEDIUM=y
CONFIG_TFM_LOG_LEVEL_SILENCE=y

CONFIG_USE_DT_CODE_PARTITION=y

# Trusted Firmware-M sets the "prioritize secure exceptions" bit, which halves
# the resolution of non-secure priorities. With only 3 implemented priority
# bits, the supervisor call (level 0) and an interrupt at level 1 end up with
# the same priority, so a nested irq_offload() escalates to a hard fault.
CONFIG_IRQ_OFFLOAD_NESTED=n
