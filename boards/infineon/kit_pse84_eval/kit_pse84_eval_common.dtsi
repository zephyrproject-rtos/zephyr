#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "kit_pse84_eval_common-pinctrl.dtsi"

/ {
	aliases {
		sw0 = &user_bt;
		watchdog0 = &watchdog0;

		/* Sensor Aliases */
		accel0 = &bosch_bmi270;
	};

	leds {
		compatible = "gpio-leds";

		led_red: led_0 {
			label = "LED_0";
			gpios = <&gpio_prt16 7 GPIO_ACTIVE_HIGH>;
		};

		led_green: led_1 {
			label = "LED_1";
			gpios = <&gpio_prt16 6 GPIO_ACTIVE_HIGH>;
		};

		led_blue: led_2 {
			label = "LED_2";
			gpios = <&gpio_prt16 5 GPIO_ACTIVE_HIGH>;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_bt: button_0 {
			label = "SW_1";
			gpios = <&gpio_prt8 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

&watchdog0 {
	status = "okay";
};

zephyr_udc0: &usbhs {
	status = "okay";
};

uart2: &scb2 {
	compatible = "infineon,uart";
	status = "okay";
	current-speed = <115200>;

	clocks = <&peri0_group1_16bit_1>;

	pinctrl-0 = <&p6_7_scb2_uart_tx &p6_5_scb2_uart_rx>;
	pinctrl-names = "default";
};

&peri0_group1_16bit_1 {
	status = "okay";
	clock-div = <1>;
};

i2c0: &scb0 {
	#address-cells = <1>;
	#size-cells = <0>;
	compatible = "infineon,i2c";
	status = "okay";
	clocks = <&peri0_group1_16bit_3>;
	pinctrl-0 = <&p8_0_scb0_i2c_scl &p8_1_scb0_i2c_sda>;
	pinctrl-names = "default";

	bosch_bmi270: bmi270@68 {
		compatible = "bosch,bmi270";
		reg = <0x68>;
		status = "okay";
		irq-gpios = <&gpio_prt7 7 GPIO_ACTIVE_HIGH>, <&gpio_prt6 6 GPIO_ACTIVE_HIGH>;
	};
};

&peri0_group1_16bit_3 {
	status = "okay";
	clock-div = <62>;
};

&gpio_prt0 {
	status = "okay";
};

&gpio_prt2 {
	status = "okay";
};

&gpio_prt6 {
	status = "okay";
};

&gpio_prt7 {
	status = "okay";
};

&gpio_prt8 {
	status = "okay";
};

&gpio_prt10 {
	status = "okay";
};

&gpio_prt11 {
	status = "okay";
};

&gpio_prt13 {
	status = "okay";
};

&gpio_prt14 {
	status = "okay";
};

&gpio_prt16 {
	status = "okay";
};

&gpio_prt17 {
	status = "okay";
};

/*
 * Microchip LAN8710A PHY on MII, its reset is tied to the MCU reset. The
 * MII pins are shared with the HCI UART of the Bluetooth module and need a
 * board rework, enable it with the pse84-eth or pse84-eth-rmii snippet.
 */
&ethernet0 {
	pinctrl-0 = <&p13_1_eth0_mdc &p13_6_eth0_mdio
		     &p11_2_eth0_txd0 &p11_3_eth0_txd1 &p11_6_eth0_txd2 &p10_0_eth0_txd3
		     &p11_4_eth0_tx_ctl &p11_5_eth0_tx_clk
		     &p10_6_eth0_rxd0 &p10_7_eth0_rxd1 &p11_0_eth0_rxd2 &p10_4_eth0_rxd3
		     &p10_5_eth0_rx_ctl &p10_1_eth0_rx_clk>;
	pinctrl-names = "default";
	phy-handle = <&eth_phy>;
	phy-connection-type = "mii";
	zephyr,random-mac-address;
};

&mdio0 {
	eth_phy: ethernet-phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
		status = "disabled";
	};
};
