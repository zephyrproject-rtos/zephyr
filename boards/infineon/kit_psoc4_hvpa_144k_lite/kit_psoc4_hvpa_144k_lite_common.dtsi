#include "kit_psoc4_hvpa_144k_lite-pinctrl.dtsi"

/ {
	aliases {
		watchdog0 = &watchdog0;
	};
};

uart0: &scb0 {
	compatible = "infineon,uart";
	status = "okay";
	current-speed = <115200>;
	clocks = <&peri_clk_div0>;
	pinctrl-0 = <&p0_1_scb0_uart_tx &p0_0_scb0_uart_rx>;
	pinctrl-names = "default";
};

&peri_clk_div0 {
	status = "okay";
};

&gpio_prt0 {
	status = "okay";
};

&gpio_prt1 {
	status = "okay";
};
