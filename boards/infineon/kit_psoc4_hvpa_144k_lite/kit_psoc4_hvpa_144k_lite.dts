/dts-v1/;
#include <arm/infineon/psoc4/mpns/cy8c4147lce_hv423.dtsi>
#include <arm/infineon/psoc4/psoc4_hvpa_144k/system_clocks.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include "kit_psoc4_hvpa_144k_lite_common.dtsi"

/ {
	model = "KIT_PSoC4_HVPA_144K_LITE Development Board";
	compatible = "infineon,kit-psoc4-hvpa-144k-lite", "infineon,psoc4-hvpa-144k";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	aliases {
		led0 = &user_led1;
		sw0 = &user_bt;
	};

	leds {
		compatible = "gpio-leds";
		status = "okay";

		user_led1: led_1 {
			label = "LED_1";
			gpios = <&gpio_prt0 3 GPIO_ACTIVE_LOW>;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_bt: button_0 {
			label = "SW_0";
			gpios = <&gpio_prt0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};
