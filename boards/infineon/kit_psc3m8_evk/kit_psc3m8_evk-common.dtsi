/*
 * Common devicetree content for the kit_psc3m8_evk board variants.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "PSOC™ Control C3M8 Evaluation Kit";
	compatible = "infineon,kit_psc3m8_evk", "infineon,PSC3M8";

	aliases {
		led0 = &user_led0;
		led1 = &user_led1;
		led2 = &user_led2;
		led3 = &user_led3;
		led4 = &user_led4;
		led5 = &user_led5;
		sw0 = &user_bt0;
		sw1 = &user_bt1;
	};

	leds {
		compatible = "gpio-leds";

		user_led0: led_0 {
			label = "LED_0";
			gpios = <&gpio_prt1 5 GPIO_ACTIVE_LOW>;
		};

		user_led1: led_1 {
			label = "LED_1";
			gpios = <&gpio_prt4 1 GPIO_ACTIVE_LOW>;
		};

		user_led2: led_2 {
			label = "LED_2";
			gpios = <&gpio_prt1 7 GPIO_ACTIVE_LOW>;
		};

		user_led3: led_3 {
			label = "LED_3";
			gpios = <&gpio_prt1 4 GPIO_ACTIVE_LOW>;
		};

		user_led4: led_4 {
			label = "LED_4";
			gpios = <&gpio_prt9 1 GPIO_ACTIVE_LOW>;
		};

		user_led5: led_5 {
			label = "LED_5";
			gpios = <&gpio_prt4 0 GPIO_ACTIVE_LOW>;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_bt0: user_btn0 {
			label = "SW_3";
			gpios = <&gpio_prt5 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		user_bt1: user_btn1 {
			label = "SW_4";
			gpios = <&gpio_prt7 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&gpio_prt0 {
	status = "okay";
};

&gpio_prt1 {
	status = "okay";
};

&gpio_prt3 {
	status = "okay";
};

&gpio_prt4 {
	status = "okay";
};

&gpio_prt5 {
	status = "okay";
};

&gpio_prt6 {
	status = "okay";
};

&gpio_prt7 {
	status = "okay";
};

&gpio_prt9 {
	status = "okay";
};

/* Debug UART — console (SCB2: P3.3 TX, P3.4 RX, P3.2 RTS, P3.1 CTS) */
uart2: &scb2 {
	compatible = "infineon,uart";
	status = "okay";
	current-speed = <115200>;
	clocks = <&peri0_group3_8bit_0>;
	pinctrl-0 = <&p3_3_scb2_uart_tx &p3_4_scb2_uart_rx &p3_2_scb2_uart_rts &p3_1_scb2_uart_cts>;
	pinctrl-names = "default";
};

/* Peripheral clock dividers */
&peri0_group3_8bit_0 {
	status = "okay";
	clock-div = <195>;
};

&clk_hf2 {
	source-path = <IFX_CLK_HF_IN_CLKPATH1>;
	status = "okay";
};
