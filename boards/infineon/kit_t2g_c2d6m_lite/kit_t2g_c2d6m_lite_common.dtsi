#include <arm/infineon/cat1c/traveo/cyt4dn/system_clocks.dtsi>
#include <arm/infineon/cat1c/traveo/cyt4dn/cyt4dn.dtsi>
#include <arm/infineon/cat1c/traveo/cyt4dn/cyt4dn-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pinctrl/ifx_cat1-pinctrl.h>
#include <zephyr/dt-bindings/clock/ifx_clock_source_cyt4dnxx.h>

/ {
	leds {
		compatible = "gpio-leds";

		user_led1: user_led1 {
			label = "LED_1";
			gpios = <&gpio_prt7 5 GPIO_ACTIVE_HIGH>;
		};

		user_led2: user_led2 {
			label = "LED_2";
			gpios = <&gpio_prt7 6 GPIO_ACTIVE_HIGH>;
		};

		user_led3: user_led3 {
			label = "LED_3";
			gpios = <&gpio_prt7 7 GPIO_ACTIVE_HIGH>;
		};
	};

	/* Oscillator on the REF_CLK pin of the Ethernet MAC */
	eth0_refclk: eth0-refclk {
		compatible = "fixed-clock";
		clock-frequency = <125000000>;
		#clock-cells = <0>;
	};
};

/*
 * Realtek RTL8211FI gigabit PHY on RGMII, its reset is tied to XRES. The PHY
 * is strapped to address 1; address 0 is its broadcast address.
 */
&eth0 {
	clocks = <&clk_peri>, <&eth0_refclk>, <&clk_hf5>;
	clock-names = "pclk", "ref_clk", "tsu_clk";
	pinctrl-0 = <&p13_0_eth0_mdc &p13_1_eth0_mdio
		     &p13_2_eth0_txd0 &p13_3_eth0_txd1 &p13_6_eth0_txd2 &p13_7_eth0_txd3
		     &p13_4_eth0_tx_clk &p14_0_eth0_tx_ctl &p13_5_eth0_ref_clk
		     &p14_3_eth0_rxd0 &p14_4_eth0_rxd1 &p14_5_eth0_rxd2 &p14_6_eth0_rxd3
		     &p14_2_eth0_rx_clk &p14_7_eth0_rx_ctl>;
	pinctrl-names = "default";
	phy-handle = <&eth0_phy>;
	phy-connection-type = "rgmii-id";
	local-mac-address = [02 00 00 00 00 01];
};

&eth0_mdio {
	eth0_phy: phy@1 {
		compatible = "realtek,rtl8211f";
		reg = <1>;
		status = "disabled";
	};
};

/*
 * Code flash (6336 KB) layout - one execute-in-place partition per core:
 *
 *   Offset     Size      Core   Partition
 *   0x000000   512 KB    M0+    m0p_partition
 *   0x080000   2656 KB   M7_0   m7_0_partition
 *   0x318000   3168 KB   M7_1   m7_1_partition
 *
 * The M0+ boots first and releases each M7 to run from its own partition.
 */
&code_flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		m0p_partition: partition_m0p@0 {
			compatible = "zephyr,mapped-partition";
			label = "m0p_partition";
			reg = <0x0 DT_SIZE_K(512)>;
		};

		m7_0_partition: partition@80000 {
			compatible = "zephyr,mapped-partition";
			label = "m7_0_partition";
			reg = <0x80000 DT_SIZE_K(2656)>;
		};

		m7_1_partition: partition@318000 {
			compatible = "zephyr,mapped-partition";
			label = "m7_1_partition";
			reg = <0x318000 DT_SIZE_K(3168)>;
		};
	};
};

uart7: &scb7 {
	compatible = "infineon,uart";
	current-speed = <115200>;
	clocks = <&peri0_group1_8bit_1>;

	/* UART pins */
	pinctrl-0 = <&p9_0_scb7_uart_rx &p9_1_scb7_uart_tx>;
	pinctrl-names = "default";
};

uart9: &scb9 {
	compatible = "infineon,uart";
	current-speed = <115200>;
	clocks = <&peri0_group1_8bit_0>;

	/* UART pins */
	pinctrl-0 = <&p29_0_scb9_uart_rx &p29_1_scb9_uart_tx>;
	pinctrl-names = "default";
};

&gpio_prt7 {
	status = "okay";
};

