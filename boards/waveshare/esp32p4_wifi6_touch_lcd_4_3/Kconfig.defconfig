if BOARD_ESP32P4_WIFI6_TOUCH_LCD_4_3_ESP32P4_HPCORE

# The 480x800 panel needs 750 KB per RGB565 framebuffer, and the driver
# allocates two of them for tear-free updates, so the stock heap does not
# fit them.
configdefault ESP_SPIRAM_HEAP_SIZE
	default 3145728 if DISPLAY_ESP32_DSI

endif # BOARD_ESP32P4_WIFI6_TOUCH_LCD_4_3_ESP32P4_HPCORE
