if BOARD_RP2350B_PLUS_W

config USB_SELF_POWERED
	default n

config MAIN_STACK_SIZE
	default 4096

if WIFI_AIROC

choice AIROC_PART
	default CYW43439
endchoice

config WHD_DISABLE_SDIO_PULLUP_DURING_SPI_SLEEP
	default y

endif # WIFI_AIROC

endif # BOARD_RP2350B_PLUS_W
