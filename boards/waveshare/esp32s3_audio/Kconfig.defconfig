if BOARD_ESP32S3_AUDIO_ESP32S3_PROCPU

# MCUboot does not use the onboard GPIO expander.
configdefault GPIO_PCA_SERIES
	default n if MCUBOOT

# The expander interrupt is disconnected on the stock board (R15 is unpopulated).
configdefault GPIO_PCA_SERIES_INTERRUPT
	default n

endif # BOARD_ESP32S3_AUDIO_ESP32S3_PROCPU
