if BOARD_ESP32S3_TOUCH_LCD_4_V4_ESP32S3_PROCPU

config KERNEL_MEM_POOL
	default y

config PWM
	default y if DISPLAY

configdefault LV_COLOR_16_SWAP
	default y if LVGL

config MIPI_DBI_SPI_3WIRE
	default y

# SYS_EN is a gpio-hog on the CH32V003 IO-expander; it must run after
# both the I2C bus and the ioexp GPIO driver (GPIO_CH32V003_INIT_PRIO) are up.
config GPIO_HOGS_INIT_PRIORITY
	default 80

endif # BOARD_ESP32S3_TOUCH_LCD_4_V4_ESP32S3_PROCPU
