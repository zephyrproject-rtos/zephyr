/dts-v1/;

#include <espressif/esp32s3/esp32s3.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <espressif/partitions_0x0_amp_16M.dtsi>
#include "esp32s3_touch_lcd_2_8b-pinctrl.dtsi"

/ {
	model = "ESP32-S3-Touch-LCD-2.8B PROCPU";
	compatible = "waveshare,esp32-s3-touch-lcd-2.8b";

	aliases {
		accel0 = &qmi8658;
		i2c-0 = &i2c0;
		pwm-0 = &ledc0;
		pwm-lcd0 = &pwm_lcd0;
		rtc = &rtc0;
		sdhc0 = &sdcard0;
		sw0 = &button0;
		uart-0 = &uart0;
		watchdog0 = &wdt0;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &esp32_bt_hci;
		zephyr,touch = &gt911;
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_lcd0: pwm_lcd0 {
			pwms = <&ledc0 0 PWM_KHZ(20) PWM_POLARITY_NORMAL>;
			label = "LCD backlight";
		};
	};

	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc0 3>;
		output-ohms = <100000>;
		full-ohms = <(200000 + 100000)>;
		skip-calibration; /* ESP32 ADC does not support calibration */
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
	ranges = <0x0 0x0 DT_SIZE_M(16)>;
};

&psram0 {
	size = <DT_SIZE_M(8)>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	/*
	 * P0: LCD reset, P1: touch reset, P2: LCD SPI chip select,
	 * P3: SD card chip select, P4: IMU INT1, P5: IMU INT2, P6: RTC INT,
	 * P7: buzzer. The expander INT output is not connected.
	 */
	exio: gpio@20 {
		compatible = "ti,tca9554";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
	};

	gt911: gt911@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		irq-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&exio 1 GPIO_ACTIVE_LOW>;
	};

	qmi8658: qmi8658@6b {
		compatible = "qst,qmi8658a";
		reg = <0x6b>;
	};

	rtc0: rtc@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
	};
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&ledc0 {
	status = "okay";
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

/* SPI bus shared by the SD card and the LCD panel configuration interface */
&spi2 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	cs-gpios = <&exio 3 GPIO_ACTIVE_LOW>;

	sdcard0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(20)>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&usb_serial {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};
