if BOARD_ESP32S3_TOUCH_LCD_1_47_ESP32S3_PROCPU

config PWM
	default y if DISPLAY

configdefault LV_COLOR_16_SWAP
	default y if LVGL

# MCUboot is single-threaded, which the GPIO keys driver does not support
configdefault INPUT
	default y if !MCUBOOT

if FUEL_GAUGE

# Composite fuel gauge gets battery voltage from ADC-based voltage-divider sensor

config ADC
	default y

config SENSOR
	default y

endif # FUEL_GAUGE

endif # BOARD_ESP32S3_TOUCH_LCD_1_47_ESP32S3_PROCPU
