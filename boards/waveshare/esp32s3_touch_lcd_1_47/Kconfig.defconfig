if BOARD_ESP32S3_TOUCH_LCD_1_47_ESP32S3_PROCPU

config PWM
	default y if DISPLAY

if FUEL_GAUGE

# Composite fuel gauge gets battery voltage from ADC-based voltage-divider sensor

config ADC
	default y

config SENSOR
	default y

endif # FUEL_GAUGE

endif # BOARD_ESP32S3_TOUCH_LCD_1_47_ESP32S3_PROCPU
