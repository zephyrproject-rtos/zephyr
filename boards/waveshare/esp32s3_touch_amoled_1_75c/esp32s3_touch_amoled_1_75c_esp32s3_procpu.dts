/dts-v1/;
#include <espressif/esp32s3/esp32s3.dtsi>
#include "esp32s3_touch_amoled_1_75c-pinctrl.dtsi"
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <espressif/partitions_0x0_amp_32M.dtsi>

/ {
	compatible = "waveshare,esp32-s3-touch-amoled-1.75c";
	model = "ESP32-S3-Touch-AMOLED-1.75C PROCPU";

	aliases {
		i2c-0 = &i2c0;
		sw0 = &button_boot;
		sw1 = &button_pwr;
		uart-0 = &uart0;
		watchdog0 = &wdt0;
		accel0 = &qmi8658a;
		fuel-gauge0 = &fuel_gauge;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &co5300;
		zephyr,bt-hci = &esp32_bt_hci;
	};

	buttons {
		compatible = "gpio-keys";

		button_boot: button_boot {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};

		/* The PWR key reaches GPIO3 through a BSS138, so it reads high while held. */
		button_pwr: button_pwr {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "PWR Button";
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(32)>;
	ranges = <0x0 0x0 DT_SIZE_M(32)>;
};

&psram0 {
	size = <DT_SIZE_M(8)>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&usb_serial {
	status = "okay";
};

&uart0 {
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	status = "okay";

	/* ES8311 mono codec driving the speaker */
	es8311: es8311@18 {
		compatible = "everest,es8311";
		reg = <0x18>;
	};

	/* AXP2101 PMU. Its IRQ line isn't wired to the ESP32-S3. */
	axp2101@34 {
		compatible = "x-powers,axp2101";
		reg = <0x34>;

		charger: charger {
			compatible = "x-powers,axp2101-charger";
			constant-charge-current-max-microamp = <300000>;
			constant-charge-voltage-max-microvolt = <4200000>;
			charge-term-current-microamp = <100000>;
		};

		regulators {
			compatible = "x-powers,axp2101-regulator";

			/* 3.3 V system rail: ESP32-S3, display and sensors */
			dcdc1 {
				regulator-min-microvolt = <3300000>;
				regulator-init-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* 3.3 V analog rail for the ES8311 and ES7210 */
			aldo1 {
				regulator-min-microvolt = <3300000>;
				regulator-init-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
			};
		};

		fuel_gauge: fuel_gauge {
			compatible = "x-powers,axp2101-fuel-gauge";
		};
	};

	qmi8658a: qmi8658a@6b {
		compatible = "qst,qmi8658a";
		reg = <0x6b>;
		int-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		int-pin = <1>;
	};
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
	status = "okay";

	/* 466x466 AMOLED, driven over single-line SPI on QSPI_SIO0 */
	co5300: co5300@0 {
		compatible = "chipone,co5300";
		reg = <0>;
		spi-max-frequency = <40000000>;
		pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
		width = <466>;
		height = <466>;
		reset-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		tear-effect-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&trng0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};
