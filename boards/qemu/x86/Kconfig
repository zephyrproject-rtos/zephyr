# Several boards live in this directory, but the build system only types
# the symbol of the board being built, so the siblings need an explicit
# type.

config BOARD_QEMU_X86
	bool
	select QEMU_TARGET
	select HAS_COVERAGE_SUPPORT

config BOARD_QEMU_X86_LAKEMONT
	bool
	select QEMU_TARGET
	select HAS_COVERAGE_SUPPORT

config BOARD_QEMU_X86_TINY
	bool
	select QEMU_TARGET
	select HAS_COVERAGE_SUPPORT
