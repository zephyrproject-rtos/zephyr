# Platform configuration
CONFIG_ARM_ARCH_TIMER=y

# Cache management
CONFIG_CACHE_MANAGEMENT=y

# Enable UART driver
CONFIG_SERIAL=y

# Enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Enable serial port
CONFIG_UART_INTERRUPT_DRIVEN=y

# Avoid timing skew in tests
CONFIG_QEMU_ICOUNT=y

# The shim boots the kernel into the Normal world
CONFIG_ARMV8_A_NS=y

# Provide enough virtual address space and L2 tables to map the 64 MiB pflash
CONFIG_KERNEL_VM_SIZE=0x5000000
CONFIG_ARM_MMU_NUM_L2_TABLES=128
