# Zephyr runs at Non-secure EL1, started by U-Boot
CONFIG_ARMV8_A_NS=y

# U-Boot loads the image into DRAM
CONFIG_XIP=n

# zephyr.bin is used to build the U-Boot image
CONFIG_BUILD_OUTPUT_BIN=y

# Serial console
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Timer and caches
CONFIG_ARM_ARCH_TIMER=y
CONFIG_CACHE_MANAGEMENT=y
CONFIG_TIMER_READS_ITS_FREQUENCY_AT_RUNTIME=y

# PSCI
CONFIG_PM_CPU_OPS=y
CONFIG_PM_CPU_OPS_PSCI=y

# SMP
CONFIG_SMP=y
CONFIG_MP_MAX_NUM_CPUS=4
CONFIG_TIMEOUT_64BIT=y
