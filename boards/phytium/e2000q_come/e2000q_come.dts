/dts-v1/;
#include <phytium/pe2204.dtsi>

/ {
	compatible = "phytium,e2000q-come", "phytium,pe2204";
	model = "Phytium E2000Q COM Express";

	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,sram = &sram0;
	};
};

&uart1 {
	current-speed = <115200>;
	status = "okay";
};
