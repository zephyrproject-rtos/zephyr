/dts-v1/;

#include <ti/mspm0/l/mspm0l1117.dtsi>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/pinctrl/mspm0-pinctrl.h>
#include <dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "BeagleBoard.org BeagleConnect Zepto";
	compatible = "beagle,beagleconnect_zepto_mspm0l1117";

	aliases {
		led0 = &led0;
		sw0 = &button0;
		watchdog0 = &wdt0;
		counter = &counterg0;
		rtc = &rtc;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,entropy = &trng;
		zephyr,rtc = &rtc;
	};

	zephyr,user {
		io-channels = <&adc0 3>;
	};

	gpio_keys {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpioa 18 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds: leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpioa 13 GPIO_ACTIVE_HIGH>;
		};
	};
};

&flash0 {
	status = "okay";
};

/* TODO: Remove these pinmux from here once upstream merges
 * https://github.com/zephyrproject-rtos/hal_ti/pull/80
 */
&pinctrl {
	status = "okay";

	uart0_tx: uart0_tx {
		pinmux = <MSP_PINMUX(21, MSPM0_PIN_FUNCTION_2)>;
	};

	uart0_rx: uart0_rx {
		pinmux = <MSP_PINMUX(22, MSPM0_PIN_FUNCTION_2)>;
		input-enable;
	};

	analog_pa12: analog_pa12 {
		pinmux = <MSP_PINMUX(34, MSPM0_PIN_FUNCTION_ANALOG)>;
		input-enable;
	};

	analog_pa14: analog_pa14 {
		pinmux = <MSP_PINMUX(36, MSPM0_PIN_FUNCTION_ANALOG)>;
		input-enable;
	};

	analog_pa16: analog_pa16 {
		pinmux = <MSP_PINMUX(38, MSPM0_PIN_FUNCTION_ANALOG)>;
		input-enable;
	};

	analog_pa17: analog_pa17 {
		pinmux = <MSP_PINMUX(39, MSPM0_PIN_FUNCTION_ANALOG)>;
		input-enable;
	};

	analog_pa18: analog_pa18 {
		pinmux = <MSP_PINMUX(40, MSPM0_PIN_FUNCTION_ANALOG)>;
		input-enable;
	};

	analog_pa22: analog_pa22 {
		pinmux = <MSP_PINMUX(47, MSPM0_PIN_FUNCTION_ANALOG)>;
		input-enable;
	};

	analog_pa24: analog_pa24 {
		pinmux = <MSP_PINMUX(54, MSPM0_PIN_FUNCTION_ANALOG)>;
		input-enable;
	};

	analog_pa25: analog_pa25 {
		pinmux = <MSP_PINMUX(55, MSPM0_PIN_FUNCTION_ANALOG)>;
		input-enable;
	};

	analog_pa26: analog_pa26 {
		pinmux = <MSP_PINMUX(59, MSPM0_PIN_FUNCTION_ANALOG)>;
		input-enable;
	};

	analog_pa27: analog_pa27 {
		pinmux = <MSP_PINMUX(60, MSPM0_PIN_FUNCTION_ANALOG)>;
		input-enable;
	};

	tima0_ccp0_pa0: tima0_ccp0_pa0 {
		pinmux = <MSP_PINMUX(1, MSPM0_PIN_FUNCTION_4)>;
	};

	tima0_ccp1_pa01: tima0_ccp1_pa01 {
		pinmux = <MSP_PINMUX(2, MSPM0_PIN_FUNCTION_4)>;
	};

	tima0_ccp1_pa03: tima0_ccp1_pa03 {
		pinmux = <MSP_PINMUX(8, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp2_pa03: tima0_ccp2_pa03 {
		pinmux = <MSP_PINMUX(8, MSPM0_PIN_FUNCTION_8)>;
	};

	tima0_ccp1_cmpl_pa04: tima0_ccp1_cmpl_pa04 {
		pinmux = <MSP_PINMUX(9, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp3_pa04: tima0_ccp3_pa04 {
		pinmux = <MSP_PINMUX(9, MSPM0_PIN_FUNCTION_8)>;
	};

	tima0_ccp2_cmpl_pa06: tima0_ccp2_cmpl_pa06 {
		pinmux = <MSP_PINMUX(11, MSPM0_PIN_FUNCTION_10)>;
	};

	tima0_ccp2_pa07: tima0_ccp2_pa07 {
		pinmux = <MSP_PINMUX(14, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp1_pa07: tima0_ccp1_pa07 {
		pinmux = <MSP_PINMUX(14, MSPM0_PIN_FUNCTION_8)>;
	};

	tima0_ccp0_pa08: tima0_ccp0_pa08 {
		pinmux = <MSP_PINMUX(19, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp0_cmpl_pa09: tima0_ccp0_cmpl_pa09 {
		pinmux = <MSP_PINMUX(20, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp1_pa09: tima0_ccp1_pa09 {
		pinmux = <MSP_PINMUX(20, MSPM0_PIN_FUNCTION_7)>;
	};

	tima0_ccp2_pa10: tima0_ccp2_pa10 {
		pinmux = <MSP_PINMUX(21, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp2_cmpl_pa11: tima0_ccp2_cmpl_pa11 {
		pinmux = <MSP_PINMUX(22, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp3_pa12: tima0_ccp3_pa12 {
		pinmux = <MSP_PINMUX(34, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp3_cmpl_pa13: tima0_ccp3_cmpl_pa13 {
		pinmux = <MSP_PINMUX(35, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp3_pa17: tima0_ccp3_pa17 {
		pinmux = <MSP_PINMUX(39, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp3_cmpl_pa18: tima0_ccp3_cmpl_pa18 {
		pinmux = <MSP_PINMUX(40, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp1_pa18: tima0_ccp1_pa18 {
		pinmux = <MSP_PINMUX(40, MSPM0_PIN_FUNCTION_11)>;
	};

	tima0_ccp2_pa19: tima0_ccp2_pa19 {
		pinmux = <MSP_PINMUX(41, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp2_cmpl_pa20: tima0_ccp2_cmpl_pa20 {
		pinmux = <MSP_PINMUX(42, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp0_pa21: tima0_ccp0_pa21 {
		pinmux = <MSP_PINMUX(46, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp0_cmpl_pa22: tima0_ccp0_cmpl_pa22 {
		pinmux = <MSP_PINMUX(47, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp1_pa22: tima0_ccp1_pa22 {
		pinmux = <MSP_PINMUX(47, MSPM0_PIN_FUNCTION_6)>;
	};

	tima0_ccp3_pa23: tima0_ccp3_pa23 {
		pinmux = <MSP_PINMUX(53, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp3_cmpl_pa24: tima0_ccp3_cmpl_pa24 {
		pinmux = <MSP_PINMUX(54, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_ccp3_pa25: tima0_ccp3_pa25 {
		pinmux = <MSP_PINMUX(55, MSPM0_PIN_FUNCTION_5)>;
	};

	tima0_cpp1_cmpl_pa25: tima0_cpp1_cmpl_pa25 {
		pinmux = <MSP_PINMUX(55, MSPM0_PIN_FUNCTION_6)>;
	};

	tima0_ccp3_cmpl_pa26: tima0_ccp3_cmpl_pa26 {
		pinmux = <MSP_PINMUX(59, MSPM0_PIN_FUNCTION_6)>;
	};
};

&uart0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_tx &uart0_rx>;
};

&gpioa {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&trng {
	status = "okay";
};

&timg0 {
	status = "okay";
};

&counterg0 {
	status = "okay";
};

&rtc {
	status = "okay";
};

/* zephyr,acquisition-time should be overwritten by user based on their needs in overlays */
&adc0 {
	clocks = <&ckm MSPM0_CLOCK_ULPCLK>;
	ti,clk-divider = <1>;
	ti,clk-range = <5>;
	max-result-reg = <12>;
	pinctrl-0 = <&analog_pa24>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	auto-powerdown;

	/* PA27 */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	/* PA26 */
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	/* PA25 */
	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	/* PA24 (AN) */
	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	/* PA18 (BSL) */
	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	/* PA22 (RST) */
	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	/* PA12 */
	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	/* PA14 */
	channel@12 {
		reg = <12>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	/* PA16 */
	channel@13 {
		reg = <13>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	/* PA17 */
	channel@14 {
		reg = <14>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&tima0 {
	status = "okay";
};

&pwma0 {
	pinctrl-0 = <&tima0_ccp1_pa07>;
	pinctrl-names = "default";
	ti,cc-index = <1>;
	ti,pwm-mode = "EDGE_ALIGN_UP";
	ti,period = <1000>;
	status = "okay";
};
