# Zephyr Kernel Configuration
CONFIG_XIP=n

# Serial Driver
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Enable Console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Enable OpenAMP resource table needed for remoteproc booting
CONFIG_OPENAMP_RSC_TABLE=y

# RPMsg UART console (virtual, one per core)
CONFIG_RPMSG_SERVICE=y
CONFIG_RPMSG_SERVICE_MODE_REMOTE=y
CONFIG_UART_RPMSG=y
CONFIG_OPENAMP_RSC_TABLE_NUM_RPMSG_BUFF=8
CONFIG_HEAP_MEM_POOL_SIZE=4096

# rpmsg-uart is poll-only; shell must not use interrupt-driven UART API
CONFIG_SHELL_BACKEND_SERIAL_INTERRUPT_DRIVEN=n

# The RPMsg serial driver (50) registers its endpoint during init, which fails once
# the service has started, so init the service after it
CONFIG_RPMSG_SERVICE_INIT_PRIORITY=55

# TISCI / K3 interrupt router
CONFIG_TISCI=y
