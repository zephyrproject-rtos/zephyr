# Zephyr Kernel Configuration
CONFIG_XIP=n

# Enable OpenAMP resource table needed for remoteproc booting
CONFIG_OPENAMP_RSC_TABLE=y

# RPMsg UART console (virtual, one per core)
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_RPMSG_SERVICE=y
CONFIG_RPMSG_SERVICE_MODE_REMOTE=y
CONFIG_UART_RPMSG=y
CONFIG_OPENAMP_RSC_TABLE_NUM_RPMSG_BUFF=8
CONFIG_HEAP_MEM_POOL_SIZE=4096

# The RPMsg serial driver (50) registers its endpoint during init, which fails once the service has started, so init the service after it
CONFIG_RPMSG_SERVICE_INIT_PRIORITY=55
