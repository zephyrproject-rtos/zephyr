# General Kernel Options
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=96000000

# UART Driver
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Console Driver
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# GPIO Driver
CONFIG_GPIO=y

# Enable MPU
CONFIG_ARM_MPU=y

# Clock configuration
CONFIG_CLOCK_CONTROL=y

# Enable NPCX firmware header
CONFIG_NPCX_HEADER=y
