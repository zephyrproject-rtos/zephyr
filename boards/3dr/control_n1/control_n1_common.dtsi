#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743v(g-i)hx-pinctrl.dtsi>
#include <zephyr/dt-bindings/sensor/iim42653.h>
#include "control_n1_connector.dtsi"

/ {
	model = "3DR Control N1";

	chosen {
		zephyr,console = &uart7;
		zephyr,shell-uart = &uart7;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,dtcm = &dtcm;
		zephyr,itcm = &itcm;
		zephyr,canbus = &fdcan1;
	};

	leds {
		compatible = "gpio-leds";

		white_led: led_0 {
			gpios = <&gpiod 10 GPIO_ACTIVE_HIGH>;
			label = "White LED";
		};
	};

	buzzer: buzzer {
		compatible = "pwm-buzzer";
		pwms = <&pwm17 1 PWM_HZ(2700) PWM_POLARITY_NORMAL>;
	};

	aliases {
		led0 = &white_led;
		accel0 = &imu1;
		accel1 = &imu2;
		buzzer0 = &buzzer;
		die-temp0 = &die_temp;
		volt-sensor0 = &vref;
		sdhc0 = &sdmmc1;
		watchdog0 = &iwdg;
	};
};

&clk_hsi48 {
	status = "okay";
};

&clk_hse {
	hse-bypass;
	clock-frequency = <DT_FREQ_M(24)>;
	status = "okay";
};

&pll {
	div-m = <3>;
	mul-n = <120>;
	div-p = <2>;
	div-q = <5>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

/* 80 MHz FDCAN kernel clock */
&pll2 {
	div-m = <3>;
	mul-n = <60>;
	div-p = <2>;
	div-q = <6>;
	div-r = <10>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(480)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

&pwr {
	power-supply = "ldo";
};

&usart1 {
	clocks = <&rcc STM32_CLOCK(APB2, 4)>,
		 <&rcc STM32_SRC_PLL2_Q USART16_SEL(1)>;
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart2 {
	clocks = <&rcc STM32_CLOCK(APB1, 17)>,
		 <&rcc STM32_SRC_PLL2_Q USART2345678_SEL(1)>;
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6 &usart2_cts_pd3 &usart2_rts_pd4>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart3 {
	clocks = <&rcc STM32_CLOCK(APB1, 18)>,
		 <&rcc STM32_SRC_PLL2_Q USART2345678_SEL(1)>;
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart4 {
	clocks = <&rcc STM32_CLOCK(APB1, 19)>,
		 <&rcc STM32_SRC_PLL2_Q USART2345678_SEL(1)>;
	pinctrl-0 = <&uart4_tx_pd1 &uart4_rx_pd0 &uart4_cts_pb0 &uart4_rts_pa15>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart6 {
	clocks = <&rcc STM32_CLOCK(APB2, 5)>,
		 <&rcc STM32_SRC_PLL2_Q USART16_SEL(1)>;
	pinctrl-0 = <&usart6_tx_pc6 &usart6_rx_pc7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart7 {
	clocks = <&rcc STM32_CLOCK(APB1, 30)>,
		 <&rcc STM32_SRC_PLL2_Q USART2345678_SEL(1)>;
	pinctrl-0 = <&uart7_tx_pe8 &uart7_rx_pe7 &uart7_cts_pe10 &uart7_rts_pe9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart8 {
	clocks = <&rcc STM32_CLOCK(APB1, 31)>,
		 <&rcc STM32_SRC_PLL2_Q USART2345678_SEL(1)>;
	pinctrl-0 = <&uart8_tx_pe1 &uart8_rx_pe0>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pd7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 12 GPIO_ACTIVE_LOW>;
	st,gpio-control;
	status = "okay";

	imu1: iim42653@0 {
		compatible = "invensense,iim42653", "invensense,icm4268x";
		reg = <0>;
		int-gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>;
		spi-max-frequency = <DT_FREQ_M(24)>;
		accel-pwr-mode = <IIM42653_DT_ACCEL_LN>;
		accel-odr = <IIM42653_DT_ACCEL_ODR_1000>;
		accel-fs = <IIM42653_DT_ACCEL_FS_32>;
		gyro-pwr-mode = <IIM42653_DT_GYRO_LN>;
		gyro-odr = <IIM42653_DT_GYRO_ODR_1000>;
		gyro-fs = <IIM42653_DT_GYRO_FS_4000>;
	};
};

&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pc2_c &spi2_mosi_pc1>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 15 GPIO_ACTIVE_LOW>;
	st,gpio-control;
	status = "okay";

	imu2: iim42653@0 {
		compatible = "invensense,iim42653", "invensense,icm4268x";
		reg = <0>;
		int-gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;
		spi-max-frequency = <DT_FREQ_M(24)>;
		accel-pwr-mode = <IIM42653_DT_ACCEL_LN>;
		accel-odr = <IIM42653_DT_ACCEL_ODR_1000>;
		accel-fs = <IIM42653_DT_ACCEL_FS_32>;
		gyro-pwr-mode = <IIM42653_DT_GYRO_LN>;
		gyro-odr = <IIM42653_DT_GYRO_ODR_1000>;
		gyro-fs = <IIM42653_DT_GYRO_FS_4000>;
	};
};

&spi4 {
	pinctrl-0 = <&spi4_sck_pe2 &spi4_miso_pe5 &spi4_mosi_pe6>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 2 GPIO_ACTIVE_LOW>;
	st,gpio-control;
	status = "okay";
};

&spi6 {
	pinctrl-0 = <&spi6_sck_pb3 &spi6_miso_pb4 &spi6_mosi_pb5>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 3 GPIO_ACTIVE_LOW>, <&gpioc 13 GPIO_ACTIVE_LOW>;
	st,gpio-control;
	status = "okay";

	/* M95P08 page EEPROM, which has the SPI NOR command set and SFDP tables */
	m95p08: flash@1 {
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		size = <DT_SIZE_M(8)>;
		jedec-id = [20 00 14];
		sfdp-bfp = [f5 20 c1 ff ff ff 7f 00 00 00 08 6b 08 3b 00 00
			    ee ff ff ff ff ff 00 00 ff ff 00 00 09 db 0c 20
			    10 d8 00 00 04 08 0c 00 90 f3 0e 00 00 00 00 80
			    00 00 00 00 04 bd d5 5c 00 00 00 00 11 10 00 00
			    00 00 00 00 00 00 00 00 00 00 00 00 ff ff ff ff];

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			storage_partition: partition@0 {
				reg = <0x00000000 DT_SIZE_M(1)>;
				label = "storage";
			};
		};
	};
};

&fdcan1 {
	pinctrl-0 = <&fdcan1_rx_pa11 &fdcan1_tx_pa12>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
	status = "okay";

	can-transceiver {
		max-bitrate = <8000000>;
	};
};

&fdcan2 {
	pinctrl-0 = <&fdcan2_rx_pb12 &fdcan2_tx_pb6>;
	pinctrl-names = "default";
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL2_Q FDCAN_SEL(2)>;
	status = "okay";

	can-transceiver {
		max-bitrate = <8000000>;
	};
};

/* Timers run at 240 MHz: a prescaler of 239 gives 1 us PWM resolution. */
&timers1 {
	st,prescaler = <239>;
	status = "okay";

	pwm1: pwm {
		pinctrl-0 = <&tim1_ch1_pa8 &tim1_ch2_pe11 &tim1_ch3_pe13 &tim1_ch4_pe14>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&timers2 {
	st,prescaler = <239>;
	status = "okay";

	pwm2: pwm {
		pinctrl-0 = <&tim2_ch1_pa0 &tim2_ch2_pa1 &tim2_ch3_pa2 &tim2_ch4_pa3>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&timers4 {
	st,prescaler = <239>;
	status = "okay";

	pwm4: pwm {
		pinctrl-0 = <&tim4_ch1_pd12 &tim4_ch2_pd13 &tim4_ch3_pd14 &tim4_ch4_pd15>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&timers17 {
	st,prescaler = <239>;
	status = "okay";

	pwm17: pwm {
		pinctrl-0 = <&tim17_ch1_pb9>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&adc12_common {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
};

&adc1 {
	pinctrl-0 = <&adc1_inp8_pc5 &adc1_inp10_pc0 &adc1_inp18_pa4>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* 5 V supply sense, divided by 2 */
	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 388)>;
		zephyr,resolution = <16>;
	};

	channel@a {
		reg = <10>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 388)>;
		zephyr,resolution = <16>;
	};

	channel@12 {
		reg = <18>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 388)>;
		zephyr,resolution = <16>;
	};
};

&adc3_common {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
};

&adc3 {
	status = "okay";
};

&die_temp {
	status = "okay";
};

&vref {
	status = "okay";
};

&sdmmc1 {
	pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
		     &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
		     &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
	pinctrl-names = "default";
	/* The SDMMC driver needs a 48 MHz kernel clock */
	clocks = <&rcc STM32_CLOCK(AHB3, 16)>,
		 <&rcc STM32_SRC_PLL2_R SDMMC_SEL(1)>;
	/* SDMMC_CK = 48 MHz / (2 * 1): 24 MHz, within the default speed of the card */
	clk-div = <1>;
	bus-width = <4>;
	disk-name = "SD";
	status = "okay";
};

&iwdg {
	status = "okay";
};

&rng {
	status = "okay";
};
