if BOARD_ESP32_CAM_ESP32_PROCPU

config SOC_FAMILY_ESP32_SPIRAM
	default y if !MCUBOOT

choice SOC_FAMILY_ESP32_SPIRAM_TYPE
	default SOC_FAMILY_ESP32_SPIRAM_TYPE_64
endchoice

endif # BOARD_ESP32_CAM_ESP32_PROCPU
