if BOARD_ESP32S31_FUNCTION_COREBOARD_ESP32S31_HPCORE

configdefault ETH_DRIVER
	default y

configdefault NET_IF_MAX_IPV4_COUNT
	default 2 if ETH_DRIVER && WIFI

endif # BOARD_ESP32S31_FUNCTION_COREBOARD_ESP32S31_HPCORE
