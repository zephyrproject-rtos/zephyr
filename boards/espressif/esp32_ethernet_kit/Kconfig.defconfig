if BOARD_ESP32_ETHERNET_KIT_ESP32_PROCPU

config SOC_FAMILY_ESP32_SPIRAM
	default y if !MCUBOOT

choice SOC_FAMILY_ESP32_SPIRAM_TYPE
	default SOC_FAMILY_ESP32_SPIRAM_TYPE_64
endchoice

configdefault ETH_DRIVER
	default y

endif # BOARD_ESP32_ETHERNET_KIT_ESP32_PROCPU
