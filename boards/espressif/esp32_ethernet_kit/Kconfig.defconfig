if BOARD_ESP32_ETHERNET_KIT_ESP32_PROCPU

config SOC_FAMILY_ESPRESSIF_SPIRAM
	default y if !MCUBOOT && !SOC_ESP32_USE_UNSUPPORTED_REVISION

configdefault ETH_DRIVER
	default y

