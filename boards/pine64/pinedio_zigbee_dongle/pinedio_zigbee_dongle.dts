/dts-v1/;

#include <bflb/bl706.dtsi>
#include "pinedio_zigbee_dongle-pinctrl.dtsi"

/ {
	model = "PineDio USB-C Zigbee Dongle";
	compatible = "bflb,bl706";

	chosen {
		zephyr,flash = &gd25q16e;
		zephyr,flash-controller = &sf_bank1;
		zephyr,code-partition = &slot0_partition;
		zephyr,itcm = &itcm;
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,ot-uart = &uart0;
		zephyr,entropy = &sec_eng_trng;
		zephyr,ieee802154 = &ieee802154;
	};

	aliases {
		watchdog0 = &wdt0;
		led0 = &red_led;
		led1 = &green_led;
		led2 = &blue_led;
		pwm-led0 = &red_pwm_led;
		pwm-led1 = &green_pwm_led;
		pwm-led2 = &blue_pwm_led;
	};

	leds {
		compatible = "gpio-leds";

		red_led: led_0 {
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
			label = "Red - LED0";
		};

		green_led: led_1 {
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
			label = "Green - LED1";
		};

		blue_led: led_2 {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			label = "Blue - LED2";
		};
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";
		status = "disabled";

		red_pwm_led: led_pwm_0 {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "Red - LED0 PWM";
		};

		green_pwm_led: led_pwm_1 {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "Green - LED1 PWM";
		};

		blue_pwm_led: led_pwm_2 {
			pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "Blue - LED2 PWM";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button_0: sw0 {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(144)>;
};

&clk_flash {
	divider = <1>;
};

&sf_bank1 {
	reg = <0x23000000 DT_SIZE_M(2)>;
	ranges = <0x0 0x23000000 DT_SIZE_M(2)>;

	gd25q16e: flash@0 {
		compatible = "bflb,sf-flash", "soc-nv-flash";
		reg = <0 DT_SIZE_M(2)>;
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;
		write-block-size = <4>;
		erase-block-size = <DT_SIZE_K(4)>;

		spi-bus-mode = <1>;
		sf-pad = <2>;
		jedec-id = [c8 40 15];

		partitions {
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			boot_header_partition: partition@0 {
				compatible = "zephyr,mapped-partition";
				label = "boot_header";
				reg = <0x00000000 0x2000>;
				read-only;
			};

			slot0_partition: partition@2000 {
				compatible = "zephyr,mapped-partition";
				label = "image-0";
				reg = <0x00002000 (0x180000 - 0x2000)>;
				read-only;
			};

			storage_partition: partition@180000 {
				compatible = "zephyr,mapped-partition";
				label = "storage";
				reg = <0x00180000 0x80000>;
			};
		};
	};
};

&gpio0 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;

	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&pwm0 {
	status = "okay";

	pinctrl-0 = <&pwm0_default>;
	pinctrl-names = "default";
};

&wdt0 {
	status = "okay";
};

&sec_eng_trng {
	status = "okay";
};

&ieee802154 {
	status = "okay";
};
