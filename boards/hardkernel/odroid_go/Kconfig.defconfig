if BOARD_ODROID_GO_ESP32_PROCPU

config SPI
	default y if DISK_DRIVER_SDMMC

config SOC_FAMILY_ESP32_SPIRAM
	default y if !MCUBOOT

choice SOC_FAMILY_ESP32_SPIRAM_TYPE
	default SOC_FAMILY_ESP32_SPIRAM_TYPE_32
endchoice

endif # BOARD_ODROID_GO_ESP32_PROCPU
