/dts-v1/;
#include <ambiq/ambiq_apollo330P.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include "apollo330mP_evb-pinctrl.dtsi"

/ {
	model = "Ambiq Apollo330mP EVB";
	compatible = "ambiq,apollo330mP_evb";

	chosen {
		zephyr,dtcm = &dtcm;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &flash;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &uart0;
		zephyr,uart-mcumgr = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-pipe = &uart0;
		zephyr,entropy = &trng;
		ambiq,xo48m = &xo48m_xtal;
		ambiq,xo32k = &xo32k_xtal;
		ambiq,extrefclk = &extrefclk;
		zephyr,crc = &crc32;
	};

	aliases {
		watchdog0 = &wdt0;
		sdhc0 = &sdio0;
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		sw0 = &button0;
		sw1 = &button1;
		pwm-led0 = &pwm_led0;
		ambiq-psram = &aps25616ba;
		ambiq-external-ram-region = &xip0;
		crc0 = &crc32;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio96_119 1 GPIO_ACTIVE_LOW>;
			label = "LED 0";
		};

		led1: led_1 {
			gpios = <&gpio0_31 23 GPIO_ACTIVE_LOW>;
			label = "LED 1";
		};

		led2: led_2 {
			gpios = <&gpio0_31 22 GPIO_ACTIVE_LOW>;
			label = "LED 2";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0_31 18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BTN0";
			zephyr,code = <INPUT_KEY_0>;
		};

		button1: button_1 {
			gpios = <&gpio32_63 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BTN1";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";
		status = "disabled";

		pwm_led0: pwm_led_0 {
			pwms = <&pwm2 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM_LED";
		};
	};

	sram0: memory@SSRAM_BASE_NAME {
		compatible = "mmio-sram";
		reg = <SSRAM_BASE_ADDR 0x180000>;
	};

	sram_no_cache: memory@20200000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x20200000 0x40000>;
		zephyr,memory-region = "SRAM_NO_CACHE";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;

		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

	};
};

&trng {
	status = "okay";
};

&crc32 {
	status = "okay";
};

&xo48m_xtal {
	clock-frequency = <DT_FREQ_M(48)>;
};

&xo48m_ext {
	clock-frequency = <0>;
};

&xo32k_xtal {
	clock-frequency = <32768>;
};

&xo32k_ext {
	clock-frequency = <0>;
};

&extrefclk {
	clock-frequency = <0>;
};

&itm {
	pinctrl-0 = <&swo_default>;
	pinctrl-names = "default";
};

&adc0 {
	pinctrl-0 = <&adc0_default>;
	pinctrl-names = "default";
	status = "disabled";
};

&timer0 {
	counter0: counter {
		status = "disabled";
	};
};

&timer2 {
	pwm2: pwm {
		pinctrl-0 = <&pwm2_default>;
		pinctrl-names = "default";
		status = "disabled";
	};
};

&rtc0 {
	status = "disabled";
	clock = "XTAL";
};

&uart0 {
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

&iom0 {
	spi0: spi {
		pinctrl-0 = <&spi0_default>;
		pinctrl-1 = <&spi0_sleep>;
		pinctrl-names = "default", "sleep";
		cs-gpios = <&gpio0_31 17 GPIO_ACTIVE_LOW>;
		clock-frequency = <DT_FREQ_M(1)>;
		status = "disabled";
	};

	i2c0: i2c {
		pinctrl-0 = <&i2c0_default>;
		pinctrl-1 = <&i2c0_sleep>;
		pinctrl-names = "default", "sleep";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		status = "disabled";
	};
};

&iom1 {
	spi1: spi {
		pinctrl-0 = <&spi1_default>;
		pinctrl-1 = <&spi1_sleep>;
		pinctrl-names = "default", "sleep";
		cs-gpios = <&gpio0_31 24 GPIO_ACTIVE_LOW>;
		clock-frequency = <DT_FREQ_M(1)>;
		status = "disabled";
	};

	i2c1: i2c {
		pinctrl-0 = <&i2c1_default>;
		pinctrl-1 = <&i2c1_sleep>;
		pinctrl-names = "default", "sleep";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		status = "disabled";
	};
};

&iom2 {
	i2c2: i2c {
		pinctrl-0 = <&i2c2_default>;
		pinctrl-1 = <&i2c2_sleep>;
		pinctrl-names = "default", "sleep";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		status = "disabled";
	};
};

&iom3 {
	spi3: spi {
		pinctrl-0 = <&spi3_default>;
		pinctrl-1 = <&spi3_sleep>;
		pinctrl-names = "default", "sleep";
		cs-gpios = <&gpio96_119 22 GPIO_ACTIVE_LOW>;
		clock-frequency = <DT_FREQ_M(1)>;
		status = "disabled";
	};

	i2c3: i2c {
		pinctrl-0 = <&i2c3_default>;
		pinctrl-1 = <&i2c3_sleep>;
		pinctrl-names = "default", "sleep";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		status = "disabled";
	};
};

&iom4 {
	spi4: spi {
		pinctrl-0 = <&spi4_default>;
		pinctrl-1 = <&spi4_sleep>;
		pinctrl-names = "default", "sleep";
		cs-gpios = <&gpio96_119 10 GPIO_ACTIVE_LOW>;
		clock-frequency = <DT_FREQ_M(1)>;
		status = "disabled";
	};

	i2c4: i2c {
		pinctrl-0 = <&i2c4_default>;
		pinctrl-1 = <&i2c4_sleep>;
		pinctrl-names = "default", "sleep";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		status = "disabled";
	};
};

&stimer0 {
	clk-source = <3>;
};

&wdt0 {
	status = "okay";
};

&mspi0 {
	pinctrl-0 = <&mspi0_default>;
	pinctrl-1 = <&mspi0_sleep>;
	pinctrl-2 = <&mspi0_psram>;
	pinctrl-names = "default", "sleep", "psram";
	status = "okay";
	zephyr,pm-device-runtime-auto;

	ce-gpios = <&gpio64_95 14 GPIO_ACTIVE_LOW>;

	cmdq-buffer-location = "SRAM_NO_CACHE";
	cmdq-buffer-size = <256>;

	ambiq,apmemory;

	dqs-support;

	aps25616ba: aps_z8@0 {
		compatible = "ambiq,mspi-device", "aps-z8";
		size = <DT_SIZE_M(256)>;
		reg = <0>;
		status = "okay";
		mspi-max-frequency = <125000000>;
		mspi-io-mode = "MSPI_IO_MODE_HEX_8_8_16";
		mspi-data-rate = "MSPI_DATA_RATE_S_D_D";
		mspi-hardware-ce-num = <0>;
		mspi-dqs-enable;
		read-command = <0x20>;
		write-command = <0xa0>;
		command-length = "INSTR_1_BYTE";
		address-length = "ADDR_4_BYTE";
		rx-dummy = <5>;
		tx-dummy = <5>;
		memmap-config = <1 0 DT_SIZE_M(32) 0>;
		ce-break-config = <1024 4>;
		ambiq,timing-config-mask = <0x62>;
		ambiq,timing-config = <5 5 1 0 0 3 8>;
		zephyr,pm-device-runtime-auto;
	};
};

zephyr_udc0: &usb {
	vddusb33-gpios = <&gpio96_119 9 GPIO_PULL_UP>;
	status = "okay";
};

&gpio0_31 {
	status = "okay";
};

&gpio32_63 {
	status = "okay";
};

&gpio64_95 {
	status = "okay";
};

&gpio96_119 {
	status = "okay";
};

&flash0 {
	// By default, the flash write block size is 16 bytes, But if the cache is enabled,
	// the write block size needs to be 32 bytes to match the cache line size.
	write-block-size = <32>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(256)>;
		};

		slot0_partition: partition@40000 {
			label = "image-0";
			reg = <0x40000 DT_SIZE_K(512)>;
		};

		slot1_partition: partition@c0000 {
			label = "image-1";
			reg = <0xc0000 DT_SIZE_K(512)>;
		};

		scratch_partition: partition@140000 {
			label = "image-scratch";
			reg = <0x140000 DT_SIZE_K(32)>;
		};

		storage_partition: partition@148000 {
			label = "storage";
			reg = <0x148000 DT_SIZE_K(32)>;
		};
	};
};

&sdio0 {
	pinctrl-0 = <&sdio0_default>;
	pinctrl-names = "default";
	txdelay = <0>;
	rxdelay = <0>;
	status = "okay";

	mmc {
		compatible = "zephyr,mmc-disk";
		disk-name = "SD2";
		status = "okay";
	};
};

&sdio1 {
	pinctrl-0 = <&sdio1_default>;
	pinctrl-names = "default";
	txdelay = <9>;
	rxdelay = <11>;
	status = "okay";
};

&pdm0 {
	pinctrl-0 = <&pdm0_default>;
	pinctrl-names = "default";
	status = "disabled";
};

&i2s0 {
	pinctrl-0 = <&i2s0_default>;
	pinctrl-names = "default";
	status = "disabled";
};
