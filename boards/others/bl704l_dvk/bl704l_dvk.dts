/dts-v1/;

#include <bflb/bl704l.dtsi>
#include "bl704l_dvk-pinctrl.dtsi"

/ {
	model = "BL704L Development Board";
	compatible = "bflb,bl704l";

	chosen {
		zephyr,flash = &gd25wq16e;
		zephyr,flash-controller = &sf_bank1;
		zephyr,code-partition = &slot0_partition;
		zephyr,itcm = &itcm;
		zephyr,sram = &sram0_btle;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,entropy = &sec_eng_trng;
		zephyr,bt-hci = &bt_hci_bflb;
		zephyr,display = &st7305;
	};

	aliases {
		led0 = &led_0;
		led1 = &led_1;
		pwm-led0 = &pwm_led_0;
		pwm-led1 = &pwm_led_1;
		sw0 = &button_0;
		sw1 = &button_1;
		watchdog0 = &wdt0;
		ambient-temp0 = &temp_humidity;
	};

	leds {
		compatible = "gpio-leds";

		led_0: led_0 {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			label = "LED0";
		};

		led_1: led_1 {
			gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
			label = "LED1";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button_0: sw2 {
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};

		button_1: sw3 {
			gpios = <&gpio0 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";
		status = "disabled";

		pwm_led_0: pwm_led_0 {
			pwms = <&pwm1 1 PWM_MSEC(1) 0>;
			label = "LED0 PWM";
		};

		pwm_led_1: pwm_led_1 {
			pwms = <&pwm1 2 PWM_MSEC(1) 0>;
			label = "LED1 PWM";
		};
	};

	mipi_dbi_st7305 {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi0>;
		dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		st7305: st7305@0 {
			compatible = "sitronix,st7305";
			mipi-max-frequency = <30000000>;
			reg = <0>;
			width = <120>;
			height = <250>;
			start-line = <0>;
			start-column = <72>;
			nvm-load = [17 02];
			gate-voltages = [11 04];
			vsh = [41 41 41 41];
			vsl = [32 32 32 32];
			vshn = [4b 4b 4b 4b];
			vsln = [00 00 00 00];
			osc-settings = <0xa6>;
			framerate = <0x5>;
			multiplex-ratio = <0x3f>;
			source-voltage = <0x0>;
			remap-value = <0x48>;
			panel-settings = <0x29>;
			inversion-on;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
		};
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(128)>;
};

&sf_ctrl {
	override-bank1;
};

&clk_flash {
	divider = <1>;
};

&sf_bank1 {
	reg = <0x23000000 DT_SIZE_K(2048)>;
	ranges = <0x0 0x23000000 DT_SIZE_K(2048)>;

	gd25wq16e: flash@0 {
		compatible = "bflb,sf-flash", "soc-nv-flash";
		reg = <0 DT_SIZE_K(2048)>;
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;
		write-block-size = <4>;
		erase-block-size = <DT_SIZE_K(4)>;

		spi-bus-mode = <4>;
		read-dummy-cycles = <4>;
		read-command = <0xeb>;
		continuous-read-command = <0xa5>;
		sf-pad = <1>;
		jedec-id = [c8 65 15];

		partitions {
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			boot_header_partition: partition@0 {
				compatible = "zephyr,mapped-partition";
				label = "boot_header";
				reg = <0x00000000 0x2000>;
				read-only;
			};

			slot0_partition: partition@2000 {
				compatible = "zephyr,mapped-partition";
				label = "image-0";
				reg = <0x00002000 (DT_SIZE_K(1536) - 0x2000)>;
				read-only;
			};

			storage_partition: partition@180000 {
				compatible = "zephyr,mapped-partition";
				label = "storage";
				reg = <0x00180000 DT_SIZE_K(512)>;
			};
		};
	};
};

&gpio0 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;

	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	temp_humidity: htu21d@40 {
		compatible = "meas,htu21d";
		reg = <0x40>;
	};
};

&spi0 {
	status = "okay";

	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;

	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
};

&wdt0 {
	status = "okay";
};

&sec_eng_trng {
	status = "okay";
};

&sec_eng_aes {
	status = "okay";
};

&sec_eng_sha {
	status = "okay";
};

&bt_hci_bflb {
	status = "okay";
};
