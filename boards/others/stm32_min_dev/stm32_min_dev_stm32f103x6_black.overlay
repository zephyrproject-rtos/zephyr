/ {
	model = "STM32 Minimum Development Board (Black)";
	compatible = "stm32_min_dev_black", "st,stm32f103c6";

	leds {
		led: led {
			gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
		};
	};
};
