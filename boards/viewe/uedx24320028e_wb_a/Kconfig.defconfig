if BOARD_UEDX24320028E_WB_A_ESP32S3_PROCPU

config SOC_FAMILY_ESPRESSIF_SPIRAM
	default y if !MCUBOOT

choice SOC_FAMILY_ESPRESSIF_SPIRAM_MODE
	default SOC_FAMILY_ESPRESSIF_SPIRAM_MODE_OCT
endchoice

if DISPLAY

if LVGL

configdefault LV_COLOR_16_SWAP
	default y

endif # LVGL

config REGULATOR
	default y

endif # DISPLAY

endif # BOARD_UEDX24320028E_WB_A_ESP32S3_PROCPU
