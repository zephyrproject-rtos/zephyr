/*
 * On-board peripherals shared by every ensemble_e8_ak board target. Include
 * this after the SoC dtsi, the cluster dtsi and the board pinctrl dtsi: every
 * node referenced below comes from one of those.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/mipi_dsi/mipi_dsi.h>

/ {
	aliases {
		led0 = &led_red;
		led1 = &led_blue;
		led2 = &led_green;
		sw0 = &joy_center;
	};

	chosen {
		zephyr,display = &cdc200;
		zephyr,touch = &gt911;
	};

	leds {
		compatible = "gpio-leds";

		led_red: led_0 {
			gpios = <&gpio12 3 GPIO_ACTIVE_HIGH>;
			label = "LED0_R";
		};

		led_blue: led_1 {
			gpios = <&gpio12 0 GPIO_ACTIVE_HIGH>;
			label = "LED0_B";
		};

		led_green: led_2 {
			gpios = <&gpio7 4 GPIO_ACTIVE_HIGH>;
			label = "LED0_G";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		/*
		 * The DesignWare GPIO driver does not implement both
		 * edge triggering, which the interrupt driven mode of
		 * the GPIO keys driver needs.
		 */
		polling-mode;

		joy_left: joy_left {
			gpios = <&lpgpio 0 GPIO_ACTIVE_LOW>;
			label = "JOY_SW1";
			zephyr,code = <INPUT_KEY_LEFT>;
		};

		joy_up: joy_up {
			gpios = <&lpgpio 1 GPIO_ACTIVE_LOW>;
			label = "JOY_SW2";
			zephyr,code = <INPUT_KEY_UP>;
		};

		joy_down: joy_down {
			gpios = <&lpgpio 2 GPIO_ACTIVE_LOW>;
			label = "JOY_SW3";
			zephyr,code = <INPUT_KEY_DOWN>;
		};

		joy_right: joy_right {
			gpios = <&lpgpio 3 GPIO_ACTIVE_LOW>;
			label = "JOY_SW4";
			zephyr,code = <INPUT_KEY_RIGHT>;
		};

		joy_center: joy_center {
			gpios = <&lpgpio 4 GPIO_ACTIVE_LOW>;
			label = "JOY_SW5";
			zephyr,code = <INPUT_KEY_ENTER>;
		};
	};
};

&gpio6 {
	pinctrl-0 = <&gpio6_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio7 {
	pinctrl-0 = <&gpio7_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio12 {
	pinctrl-0 = <&gpio12_default>;
	pinctrl-names = "default";
	status = "okay";
};

&lpgpio {
	pinctrl-0 = <&lpgpio_default>;
	pinctrl-names = "default";
	status = "okay";
};

&lptimer0 {
	status = "okay";
};

&lptimer1 {
	status = "okay";
};

&lptimer2 {
	status = "okay";
};

&lptimer3 {
	status = "okay";
};

&cdc200 {
	width = <480>;
	height = <800>;
	enable-l1;
	pixel-fmt-l1 = "rgb-888";
	panel-dev = <&mw405>;
	status = "okay";

	display-timings {
		compatible = "zephyr,panel-timing";
		hfront-porch = <5>;
		hback-porch = <5>;
		hsync-len = <4>;
		vfront-porch = <10>;
		vback-porch = <10>;
		vsync-len = <2>;
		clock-frequency = <24364080>;
		hsync-active = <0>;
		vsync-active = <0>;
		de-active = <1>;
		pixelclk-active = <0>;
	};
};

&mipi_dsi {
	dpi-shutdn-active = <1>;
	dpi-colorm-active = <1>;
	vid-pkt-size = <480>;
	ecc-recv-en;
	crc-recv-en;
	frame-ack-en;
	ldo-phy = <&ldo_phy_reg>;
	tx-dphy = <&mipi_tx_dphy_reg>;
	pll-dphy = <&mipi_pll_dphy_reg>;
	// HACK! this is the clock setting for the E7, not E8!
	clocks = <&clockctrl ALIF_DSI_CLK>, <&clockctrl ALIF_CDC200_PIX_SYST_ACLK>,
		 <&clockctrl ALIF_CLK_CFG(CLKCTL_PER_MST, MIPI_CKEN, 0U, 1U, 0U, 0U, 0U, 21)>,
		 <&clockctrl ALIF_MIPI_PLLREF_CLK>,
		 <&clockctrl ALIF_MIPI_BYPASS_CLK>;
	status = "okay";

	mw405: mw405@0 {
		compatible = "focuslcds,mw405";
		reg = <0>;
		reset-gpios = <&lpgpio 5 GPIO_ACTIVE_HIGH>;
		bl-gpios = <&gpio6 1 GPIO_ACTIVE_HIGH>;
		data-lanes = <2>;
		width = <480>;
		height = <800>;
		pixel-format = <MIPI_DSI_PIXFMT_RGB888>;
		hp-mode;
		burst-mode;
		status = "okay";
	};
};

&gpio4 {
	status = "okay";
};

&gpio9 {
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	// Hack- this is for E7
	clocks = <&clockctrl ALIF_CLK_CFG(CLKCTL_PER_SLV, I2C1_CTRL, 0U, 0U,
					  0U, 0U, 0U, ALIF_PARENT_CLK_SYST_PCLK)>;
	status = "okay";

	gt911: gt911@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		irq-gpios = <&gpio9 4 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio4 0 GPIO_ACTIVE_LOW>;
	};
};

&phy_pwr {
	status = "okay";
};
