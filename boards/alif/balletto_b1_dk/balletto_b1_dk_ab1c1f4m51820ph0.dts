/dts-v1/;

#include <alif/balletto/ab1c1f4m51820ph0.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/gpio/mikro-bus.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "balletto_b1_dk-pinctrl.dtsi"

/ {
	compatible = "alif,balletto-b1-dk-ab1c1f4m51820ph0";

	chosen {
		zephyr,flash = &mram;
		zephyr,sram = &dtcm;
		zephyr,console = &uart2;
		zephyr,shell-uart = &uart2;
	};

	aliases {
		led0 = &led_red;
		led1 = &led_blue;
		led2 = &led_green;
		sw0 = &joy_center;
	};

	leds {
		compatible = "gpio-leds";

		led_red: led_0 {
			gpios = <&gpio4 7 GPIO_ACTIVE_HIGH>;
			label = "LED0_R";
		};

		led_blue: led_1 {
			gpios = <&gpio4 3 GPIO_ACTIVE_HIGH>;
			label = "LED0_B";
		};

		led_green: led_2 {
			gpios = <&gpio4 5 GPIO_ACTIVE_HIGH>;
			label = "LED0_G";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		/*
		 * The DesignWare GPIO driver does not implement both
		 * edge triggering, which the interrupt driven mode of
		 * the GPIO keys driver needs.
		 */
		polling-mode;

		joy_down: joy_down {
			gpios = <&gpio5 0 GPIO_ACTIVE_LOW>;
			label = "JOY_SW1";
			zephyr,code = <INPUT_KEY_DOWN>;
		};

		joy_left: joy_left {
			gpios = <&gpio5 4 GPIO_ACTIVE_LOW>;
			label = "JOY_SW2";
			zephyr,code = <INPUT_KEY_LEFT>;
		};

		joy_right: joy_right {
			gpios = <&gpio5 5 GPIO_ACTIVE_LOW>;
			label = "JOY_SW3";
			zephyr,code = <INPUT_KEY_RIGHT>;
		};

		joy_up: joy_up {
			gpios = <&gpio5 6 GPIO_ACTIVE_LOW>;
			label = "JOY_SW4";
			zephyr,code = <INPUT_KEY_UP>;
		};

		joy_center: joy_center {
			gpios = <&gpio5 7 GPIO_ACTIVE_LOW>;
			label = "JOY_SW5";
			zephyr,code = <INPUT_KEY_ENTER>;
		};
	};

	mikrobus_header: mikrobus-connector {
		compatible = "mikro-bus";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <MIKROBUS_AN 0 &gpio0 3 0>,
			   <MIKROBUS_RST 0 &gpio7 6 0>,
			   <MIKROBUS_CS 0 &gpio8 7 0>,
			   <MIKROBUS_SCK 0 &gpio8 6 0>,
			   <MIKROBUS_MISO 0 &gpio8 4 0>,
			   <MIKROBUS_MOSI 0 &gpio8 5 0>,
			   <MIKROBUS_PWM 0 &gpio6 4 0>,
			   <MIKROBUS_INT 0 &gpio7 7 0>,
			   <MIKROBUS_RX 0 &gpio8 2 0>,
			   <MIKROBUS_TX 0 &gpio8 3 0>;
	};
};

&uart2 {
	pinctrl-0 = <&uart2_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio4 {
	pinctrl-0 = <&gpio4_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio5 {
	pinctrl-0 = <&gpio5_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio0 {
	pinctrl-0 = <&gpio0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio7 {
	pinctrl-0 = <&gpio7_default>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio8 {
	pinctrl-0 = <&gpio8_default>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	status = "okay";
};

&lptimer0 {
	status = "okay";
};

&lptimer1 {
	status = "okay";
};

mikrobus_i2c: &i2c1 {};
