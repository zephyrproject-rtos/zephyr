CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y

# Build a UF2 image for the pre-installed Adafruit nRF52 bootloader
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_USE_DT_CODE_PARTITION=y

# Required to enable LSM6DS3TR-C power
CONFIG_REGULATOR=y
