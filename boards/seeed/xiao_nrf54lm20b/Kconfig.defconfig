config HW_STACK_PROTECTION
	default ARCH_HAS_STACK_PROTECTION

if SPI_NOR

config SPI_NOR_FLASH_LAYOUT_PAGE_SIZE
	default 4096 if MCUBOOT || BOOTLOADER_MCUBOOT

endif # SPI_NOR

if BOARD_XIAO_NRF54LM20B_NRF54LM20B_CPUAPP

# Applications are meant to be loaded by the factory MCUboot firmware
# updater, so link them for its slot0 even in plain, non-sysbuild builds.
# The corresponding 0x800 ROM_START_OFFSET comes from the nRF54L SoC
# Kconfig default for BOOTLOADER_MCUBOOT.
config BOOTLOADER_MCUBOOT
	default y if !MCUBOOT

# The nPM1300 charger raises the VBUS current limit from the 100 mA power-on
# default to vbus-limit-microamp during its init. LDO1's soft-start inrush
# exceeds 100 mA, so the nPM13xx regulator init must run after the charger
# (SENSOR_INIT_PRIORITY, default 90) or the PMIC trips overcurrent and the
# board power-cycles in a loop. SENSOR must also be on for the charger to be
# compiled in at all (drivers/sensor/Kconfig gates it behind `if SENSOR`).
if !MCUBOOT

config SENSOR
	bool
	default y

config REGULATOR
	bool
	default y

endif # !MCUBOOT

if REGULATOR_NPM13XX

# Both must stay after the charger (90) and INIT must stay greater than
# COMMON, hence the 91/92 pair.
config REGULATOR_NPM13XX_COMMON_INIT_PRIORITY
	int
	default 91

config REGULATOR_NPM13XX_INIT_PRIORITY
	int
	default 92

endif # REGULATOR_NPM13XX

source "boards/common/usb/Kconfig.cdc_acm_serial.defconfig"

endif # BOARD_XIAO_NRF54LM20B_NRF54LM20B_CPUAPP
