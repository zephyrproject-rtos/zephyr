# Enable UART driver
CONFIG_SERIAL=y

# Enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Enable GPIO
CONFIG_GPIO=y

# Enable MPU
CONFIG_ARM_MPU=y

# Enable Cache
CONFIG_CACHE_MANAGEMENT=y
CONFIG_EXTERNAL_CACHE=y

# REGULATOR is not set here: the board Kconfig.defconfig default (y unless
# building MCUboot itself) provides it, and the CONFIG_REGULATOR_FIXED_*
# assignments that used to sit here were leftovers of the removed power_en
# GPIO regulator node (no zephyr,regulator-fixed node exists on this board).
