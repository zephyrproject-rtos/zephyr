if BOARD_FVP_CORSTONE1000

config BUILD_OUTPUT_BIN
	default y

if ARM64 && ARM_MMU

# Allow extra translation tables for the 2 GiB DRAM map.
# Preserve the Arm64 userspace defaults, which provide larger budgets
# for tests and SMP.
config MAX_XLAT_TABLES
	default 16 if !USERSPACE

endif # ARM64 && ARM_MMU

if BOARD_FVP_CORSTONE1000_A320_SMP

# Plain load-acquires and LSE atomics do not end an FVP execution quantum,
# so a CPU spinning on a release from another CPU can burn its entire
# quantum before the producing CPU runs. Use board-specific atomics with
# explicit YIELD hints as a workaround; see atomic.c for details.
config ATOMIC_OPERATIONS_ARCH
	depends on SMP
	default y

endif # BOARD_FVP_CORSTONE1000_A320_SMP

if BOARD_FVP_CORSTONE1000_CORSTONE1000_EXTSYS

if SERIAL

config UART_INTERRUPT_DRIVEN
	default y

endif # SERIAL

endif # BOARD_FVP_CORSTONE1000_CORSTONE1000_EXTSYS

endif # BOARD_FVP_CORSTONE1000
