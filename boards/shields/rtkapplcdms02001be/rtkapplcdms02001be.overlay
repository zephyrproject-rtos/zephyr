#include <zephyr/dt-bindings/display/panel.h>

/ {
	chosen {
		zephyr,display = &zephyr_lcdif;
	};

	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		input = <&gt911_rtkapplcdms02001be>;
	};
};

&renesas_mipi_i2c {
	status = "okay";

	gt911_rtkapplcdms02001be: touch-controller@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		irq-gpios = <&renesas_mipi_connector 23 GPIO_ACTIVE_HIGH>;
	};
};

&zephyr_mipi_dsi {
	status = "okay";

	ili9881c: panel-controller@0 {
		compatible = "ilitek,ili9881c";
		reg = <0x0>;
		height = <1280>;
		width = <720>;
		data-lanes = <4>;
		pixel-format = <MIPI_DSI_PIXFMT_RGB888>;
		init-seq = [
			    /* Change to Page 3 CMD */
			    ff 03 98 81 03
			    /* GIP_1 */
			    01 01 00
			    02 01 00
			    03 01 72
			    04 01 00
			    05 01 00
			    06 01 09
			    07 01 00
			    08 01 00
			    09 01 01
			    0a 01 00
			    0b 01 00
			    0c 01 01
			    0d 01 00
			    0e 01 00
			    0f 01 00
			    10 01 00
			    11 01 00
			    12 01 00
			    13 01 00
			    14 01 00
			    15 01 00
			    16 01 00
			    17 01 00
			    18 01 00
			    19 01 00
			    1a 01 00
			    1b 01 00
			    1c 01 00
			    1d 01 00
			    1e 01 40
			    1f 01 80
			    20 01 05
			    21 01 02
			    22 01 00
			    23 01 00
			    24 01 00
			    25 01 00
			    26 01 00
			    27 01 00
			    28 01 33
			    29 01 02
			    2a 01 00
			    2b 01 00
			    2c 01 00
			    2d 01 00
			    2e 01 00
			    2f 01 00
			    30 01 00
			    31 01 00
			    32 01 00
			    32 01 00
			    33 01 00
			    34 01 04
			    35 01 00
			    36 01 00
			    37 01 00
			    38 01 3c
			    39 01 00
			    3a 01 40
			    3b 01 40
			    3c 01 00
			    3d 01 00
			    3e 01 00
			    3f 01 00
			    40 01 00
			    41 01 00
			    42 01 00
			    43 01 00
			    44 01 00
			    /* GIP_2 */
			    50 01 01
			    51 01 23
			    52 01 45
			    53 01 67
			    54 01 89
			    55 01 ab
			    56 01 01
			    57 01 23
			    58 01 45
			    59 01 67
			    5a 01 89
			    5b 01 ab
			    5c 01 cd
			    5d 01 ef
			    /* GIP_3 */
			    5e 01 11
			    5f 01 01
			    60 01 00
			    61 01 15
			    62 01 14
			    63 01 0e
			    64 01 0f
			    65 01 0c
			    66 01 0d
			    67 01 06
			    68 01 02
			    69 01 07
			    6a 01 02
			    6b 01 02
			    6c 01 02
			    6d 01 02
			    6e 01 02
			    6f 01 02
			    70 01 02
			    71 01 02
			    72 01 02
			    73 01 02
			    74 01 02
			    75 01 01
			    76 01 00
			    77 01 14
			    78 01 15
			    79 01 0e
			    7a 01 0f
			    7b 01 0c
			    7c 01 0d
			    7d 01 06
			    7e 01 02
			    7f 01 07
			    80 01 02
			    81 01 02
			    83 01 02
			    84 01 02
			    85 01 02
			    86 01 02
			    87 01 02
			    88 01 02
			    89 01 02
			    8a 01 02
			    /* Change to Page 4 CMD */
			    ff 03 98 81 04
			    /* 6Ch: VCORE setting */
			    6c 01 15  /* 1.5 V*/
			    /* 6Eh Power Control 2 */
			    6e 01 2a  /* VGH 15V */
			    /* 6Fh: Power Control 3 */
			    6f 01 33
			    3a 01 94
			    /* 8Dh: Power Control 4 */
			    8d 01 15  /* VGL 10.23V */
			    87 01 ba
			    26 01 76
			    b2 01 d1
			    b5 01 06
			    /* Change to Page 1 CMD */
			    ff 03 98 81 01
			    /* 22h: Panel Operation Mode */
			    22 01 0a  /* BGR_PANEL | SS_PANEL */
			    /* 31h: Display Inversion Control */
			    31 01 00  /* Column inversion */
			    /* 53h/55h: VCOM Control 1 */
			    53 01 a5  /* VCOM forward scan 1.992V */
			    55 01 a2  /* VCOM backward scan 1.956V */
			    /* 50h/51h: Power Control 1 */
			    50 01 b7  /* VREG1OUT 4.896V */
			    51 01 b7  /* VREG2IUT -4.896V */
			    /* 60h..63h: Source Timing SDT/CRT/EQT/PCT, TOP_CLK = 62.5ns */
			    60 01 22
			    61 01 00
			    62 01 19
			    63 01 10
			    /* A0h..B3h: Positive Gamma Correction */
			    a0 01 08  /* VP0 */
			    a1 01 17  /* VP4 */
			    a2 01 1e  /* VP8 */
			    a3 01 0e  /* VP12 */
			    a4 01 13  /* VP16 */
			    a5 01 24  /* VP24 */
			    a6 01 1b  /* VP36 */
			    a7 01 1b  /* VP52 */
			    a8 01 53  /* VP80 */
			    a9 01 1b  /* VP111 */
			    aa 01 28  /* VP144 */
			    ab 01 45  /* VP175 */
			    ac 01 1a  /* VP203 */
			    ad 01 1a  /* VP219 */
			    ae 01 50  /* VP231 */
			    af 01 21  /* VP239 */
			    b0 01 2c  /* VP243 */
			    b1 01 3b  /* VP247 */
			    b2 01 63  /* VP251 */
			    b3 01 39  /* VP255 */
			    /* C0h..D3h: Negative Gamma Correction */
			    c0 01 08  /* VN0 */
			    c1 01 0c  /* VN4 */
			    c2 01 17  /* VN8 */
			    c3 01 0f  /* VN12 */
			    c4 01 0b  /* VN16 */
			    c5 01 1c  /* VN24 */
			    c6 01 10  /* VN36 */
			    c7 01 16  /* VN52 */
			    c8 01 5b  /* VN80 */
			    c9 01 1a  /* VN111 */
			    ca 01 26  /* VN144 */
			    cb 01 55  /* VN175 */
			    cc 01 1d  /* VN203 */
			    cd 01 1e  /* VN219 */
			    ce 01 52  /* VN231 */
			    cf 01 26  /* VN239 */
			    d0 01 29  /* VN243 */
			    d1 01 45  /* VN247 */
			    d2 01 63  /* VN251 */
			    d3 01 39  /* VN255 */
			    /* Change to Page 0 CMD */
			    ff 03 98 81 00];
		status = "okay";
	};
};

&zephyr_lcdif {
	width = <720>;
	height = <1280>;
	input-pixel-format = <PANEL_PIXEL_FORMAT_RGB_888>;
	pixel-format = <PANEL_PIXEL_FORMAT_RGB_888>;

	backlight-gpios = <&renesas_mipi_connector 21 GPIO_ACTIVE_HIGH>;
	status = "okay";

	display-timings {
		compatible = "zephyr,panel-timing";
		hsync-len = <33>;
		hback-porch = <100>;
		vsync-len = <2>;
		vback-porch = <30>;
		hsync-active = <1>;
		vsync-active = <1>;
		de-active = <1>;
		pixelclk-active = <0>;
		syncclk-active = <1>;
		hfront-porch = <133>;
		vfront-porch = <22>;
	};
};
