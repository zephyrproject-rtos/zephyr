#include <zephyr/dt-bindings/gpio/microchip-sodimm-connector.h>

&mchp_sodimm_i2c {
	lan8840_eds2_dc_eeprom: eeprom@54 {
		compatible = "atmel,at24";
		reg = <0x54>;
		address-width = <8>;
		pagesize = <16>;
		size = <128>;
		timeout = <5>;
		status = "okay";
	};
};

&mchp_sodimm_gmac {
	status = "okay";
	pinctrl-0 = <&mchp_sodimm_pinctrl_rgmii_default>;
	pinctrl-names = "default";
	phy-connection-type = "rgmii";
	phy-handle = <&lan8840_eds2_dc_gmac_phy>;

	zephyr,random-mac-address;
};

&mchp_sodimm_gmac_mdio {
	status = "okay";

	lan8840_eds2_dc_gmac_phy: ethernet-phy@1 {
		compatible = "microchip,lan8840";
		int-gpios = <&mchp_sodimm_header MCHP_SODIMM_49 GPIO_ACTIVE_LOW>;
		microchip,rgmii-delay = "id";
		reg = <1>;
		status = "okay";
	};
};
