if SHIELD_RAKWIRELESS_RAK12015

configdefault INPUT
	default y

# The module runs from 3V3_S. The rail has to be up before the input
# driver samples AIN1.
configdefault POWER_DOMAIN
	default y

configdefault POWER_DOMAIN_GPIO_INIT_PRIORITY
	default 45

endif # SHIELD_RAKWIRELESS_RAK12015
