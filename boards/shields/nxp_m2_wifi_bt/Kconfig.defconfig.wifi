	default 36 if SHIELD_NXP_M2_1XK_WIFI_BT || SHIELD_NXP_M2_2EL_WIFI_BT
	default 16 if SHIELD_NXP_ADAPTER_M2_2LL_WIFI_BT

configdefault NET_BUF_RX_COUNT
