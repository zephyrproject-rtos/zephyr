	default 40 if SHIELD_NXP_M2_1XK_WIFI_BT || SHIELD_NXP_M2_2EL_WIFI_BT
	default 20 if SHIELD_NXP_ADAPTER_M2_2LL_WIFI_BT

configdefault NET_TC_TX_COUNT
