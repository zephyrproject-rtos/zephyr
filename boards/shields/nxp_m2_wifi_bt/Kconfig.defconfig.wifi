if NETWORKING

if NET_L2_WIFI_MGMT

configdefault WIFI_MGMT_AP_MAX_NUM_STA
	default 8 if NXP_WIFI_SOFTAP_SUPPORT

configdefault WIFI_SHELL_MAX_AP_STA
	default 8

endif # NET_L2_WIFI_MGMT

endif # NETWORKING

if SHIELD_NXP_ADAPTER_M2_2LL_WIFI_BT

configdefault NXP_WIFI_SLIM
	default y

endif # SHIELD_NXP_ADAPTER_M2_2LL_WIFI_BT

if NXP_WIFI_PRESET

source "drivers/wifi/nxp/Kconfig.preset"

if NETWORKING

configdefault NET_PKT_RX_COUNT
	default 36 if SHIELD_NXP_M2_2LL_WIFI_BT
	default 72 if SHIELD_NXP_M2_1XK_WIFI_BT || SHIELD_NXP_M2_2EL_WIFI_BT
	default 16 if SHIELD_NXP_ADAPTER_M2_2LL_WIFI_BT

configdefault NET_PKT_TX_COUNT
	default 36 if SHIELD_NXP_M2_2LL_WIFI_BT
	default 36 if SHIELD_NXP_M2_1XK_WIFI_BT || SHIELD_NXP_M2_2EL_WIFI_BT
	default 16 if SHIELD_NXP_ADAPTER_M2_2LL_WIFI_BT

configdefault NET_BUF_RX_COUNT
	default 40 if SHIELD_NXP_M2_2LL_WIFI_BT
	default 80 if SHIELD_NXP_M2_1XK_WIFI_BT || SHIELD_NXP_M2_2EL_WIFI_BT
	default 20 if SHIELD_NXP_ADAPTER_M2_2LL_WIFI_BT

configdefault NET_BUF_TX_COUNT
	default 40 if SHIELD_NXP_M2_2LL_WIFI_BT
	default 40 if SHIELD_NXP_M2_1XK_WIFI_BT || SHIELD_NXP_M2_2EL_WIFI_BT
	default 20 if SHIELD_NXP_ADAPTER_M2_2LL_WIFI_BT

if NET_TCP

configdefault NET_TCP_MAX_SEND_WINDOW_SIZE
	default 46720 if SHIELD_NXP_M2_2LL_WIFI_BT
	default 46720 if SHIELD_NXP_M2_1XK_WIFI_BT || SHIELD_NXP_M2_2EL_WIFI_BT
	default 20440 if SHIELD_NXP_ADAPTER_M2_2LL_WIFI_BT

configdefault NET_TCP_MAX_RECV_WINDOW_SIZE
	default 46720 if SHIELD_NXP_M2_2LL_WIFI_BT
	default 46720 if SHIELD_NXP_M2_1XK_WIFI_BT || SHIELD_NXP_M2_2EL_WIFI_BT
	default 20440 if SHIELD_NXP_ADAPTER_M2_2LL_WIFI_BT

endif # NET_TCP

endif # NETWORKING

if SOC_MIMX9131 && SHIELD_NXP_M2_2LL_WIFI_BT

configdefault NXP_WIFI_TX_TASK_STACK_SIZE
	default 8192

configdefault NXP_WIFI_CORE_TASK_STACK_SIZE
	default 4096

configdefault NXP_WIFI_SCAN_TASK_STACK_SIZE
	default 8192

configdefault NXP_WIFI_MON_TASK_STACK_SIZE
	default 8192

configdefault NXP_WIFI_POWERSAVE_TASK_STACK_SIZE
	default 4096

configdefault NXP_WIFI_DRIVER_TASK_STACK_SIZE
	default 8192

configdefault NXP_WIFI_WLCMGR_TASK_STACK_SIZE
	default 8192

endif # SOC_MIMX9131 && SHIELD_NXP_M2_2LL_WIFI_BT

endif # NXP_WIFI_PRESET
