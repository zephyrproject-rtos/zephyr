#include <zephyr/dt-bindings/sensor/lps22hh.h>
#include <zephyr/dt-bindings/sensor/stts22h.h>

/ {
	aliases {
		magn0 = &iis2mdc_x_stm32mp_msp01;
		accel0 = &ism330dhcx_6b_x_stm32mp_msp01;
		accel1 = &iis2dlpc_x_stm32mp_msp01;
	};
};

&raspberrypi_i2c1 {
	ism330dhcx_6b_x_stm32mp_msp01: ism330dhcx@6b {
		compatible = "st,ism330dhcx";
		reg = <0x6b>;
		drdy-gpios = <&raspberrypi_header 4 GPIO_ACTIVE_HIGH>;
		int-pin = <2>;
	};

	iis2mdc_x_stm32mp_msp01: iis2mdc@1e {
		compatible = "st,iis2mdc";
		reg = <0x1e>;
		drdy-gpios = <&raspberrypi_header 2 GPIO_ACTIVE_HIGH>;
	};

	iis2dlpc_x_stm32mp_msp01: iis2dlpc@19 {
		compatible = "st,iis2dlpc";
		reg = <0x19>;
		drdy-gpios = <&raspberrypi_header 16 GPIO_ACTIVE_HIGH>;
		drdy-int = <1>;
	};

	stts22h_x_stm32mp_msp01: stts22h@38 {
		compatible = "st,stts22h";
		reg = <0x38>;
		int-gpios = <&raspberrypi_header 19 GPIO_ACTIVE_HIGH>;
		sampling-rate = <STTS22H_1Hz>;
	};

	lps22hh_x_stm32mp_msp01: lps22hh@5d {
		compatible = "st,lps22hh";
		reg = <0x5d>;
		drdy-gpios = <&raspberrypi_header 5 GPIO_ACTIVE_HIGH>;
		odr = <LPS22HH_DT_ODR_10HZ>;
	};

	vl53l5cx_x_stm32mp_msp01: vl53l5cx@29 {
		compatible = "st,vl53l5cx";
		reg = <0x29>;
	};
};
