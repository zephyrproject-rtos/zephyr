/*
 * QT7 Xplained Pro Extension Board overlay
 *
 */

/ {
	qt7_leds {
		compatible = "gpio-leds";

		qt7_led_b0: button0_led {
			gpios = <&ext1_header 3 GPIO_ACTIVE_LOW>;
			label = "LED6 Button 1";
		};

		qt7_led_b1: button1_led {
			gpios = <&ext1_header 8 GPIO_ACTIVE_LOW>;
			label = "LED7 Button 2";
		};

		qt7_scroller_led0: slider_led0 {
			gpios = <&ext1_header 15 GPIO_ACTIVE_LOW>;
			label = "LED0 Slider";
		};

		qt7_scroller_led1: slider_led1 {
			gpios = <&ext1_header 14 GPIO_ACTIVE_LOW>;
			label = "LED1 Slider";
		};

		qt7_scroller_led2: slider_led2 {
			gpios = <&ext1_header 13 GPIO_ACTIVE_LOW>;
			label = "LED2 Slider";
		};

		qt7_scroller_led3: slider_led3 {
			gpios = <&ext1_header 12 GPIO_ACTIVE_LOW>;
			label = "LED3 Slider";
		};

		qt7_scroller_led4: slider_led4 {
			gpios = <&ext1_header 9 GPIO_ACTIVE_LOW>;
			label = "LED4 Slider";
		};

		qt7_scroller_led5: slider_led5 {
			gpios = <&ext1_header 2 GPIO_ACTIVE_LOW>;
			label = "LED5 Slider";
		};
	};
};

&ptc {
	def-num-channels = <5>;
	def-num-sensors = <5>;

	pinctrl-0 = <&ptc_qt7_default>;
	pinctrl-names = "default";

	/* node parameters */
	node_0_params: touch_node0 {
		x-mask = <QT7_PIN3_EXT1>,
			 <QT7_PIN10_EXT1>,
			 <QT7_PIN7_EXT1>,
			 <QT7_PIN8_EXT1>,
			 <QT7_PIN9_EXT1>;
		x-names = "DRIVEN_SHIELD",
			  "BUTTON_1",
			  "SLIDER_0",
			  "SLIDER_1",
			  "SLIDER_2";
		y-mask = <QT7_PIN4_EXT1>;
		y-names = "BUTTON_0";
		zephyr,code = <INPUT_KEY_0>;
		csd = <0>;
		prescaler = "PRSC_DIV_SEL_16";
		digital-gain = "GAIN_1";
		analog-gain = "GAIN_1";
		filter-level = "FILTER_LEVEL_16";
	};

	key_0_params: touch_key0 {
		threshold = <50>;
		hysteresis = "HYST_25";
		aks-group = "NO_AKS_GROUP";
	};

	/* node parameters */
	node_1_params: touch_node1 {
		x-mask = <QT7_PIN3_EXT1>,
			 <QT7_PIN4_EXT1>,
			 <QT7_PIN7_EXT1>,
			 <QT7_PIN8_EXT1>,
			 <QT7_PIN9_EXT1>;
		x-names = "DRIVEN_SHIELD",
			  "BUTTON_0",
			  "SLIDER_0",
			  "SLIDER_1",
			  "SLIDER_2";
		y-mask = <QT7_PIN10_EXT1>;
		y-names = "BUTTON_1";
		zephyr,code = <INPUT_KEY_1>;
		csd = <0>;
		prescaler = "PRSC_DIV_SEL_16";
		digital-gain = "GAIN_1";
		analog-gain = "GAIN_1";
		filter-level = "FILTER_LEVEL_16";
	};

	key_1_params: touch_key1 {
		threshold = <50>;
		hysteresis = "HYST_25";
		aks-group = "NO_AKS_GROUP";
	};

	/* scroller - node parameters */
	node_2_params: touch_node2 {
		x-mask = <QT7_PIN3_EXT1>,
			 <QT7_PIN4_EXT1>,
			 <QT7_PIN10_EXT1>,
			 <QT7_PIN7_EXT1>,
			 <QT7_PIN8_EXT1>;
		x-names = "DRIVEN_SHIELD",
			  "BUTTON_0",
			  "BUTTON_1",
			  "SLIDER_1",
			  "SLIDER_2";
		y-mask = <QT7_PIN9_EXT1>;
		y-names = "SLIDER_0";
		zephyr,code = <INPUT_KEY_2>;
		csd = <0>;
		prescaler = "PRSC_DIV_SEL_16";
		digital-gain = "GAIN_1";
		analog-gain = "GAIN_1";
		filter-level = "FILTER_LEVEL_16";
	};

	key_2_params: touch_key2 {
		threshold = <50>;
		hysteresis = "HYST_25";
		aks-group = "NO_AKS_GROUP";
	};

	node_3_params: touch_node3 {
		x-mask = <QT7_PIN3_EXT1>,
			 <QT7_PIN4_EXT1>,
			 <QT7_PIN10_EXT1>,
			 <QT7_PIN7_EXT1>,
			 <QT7_PIN9_EXT1>;
		x-names = "DRIVEN_SHIELD",
			  "BUTTON_0",
			  "BUTTON_1",
			  "SLIDER_0",
			  "SLIDER_2";
		y-mask = <QT7_PIN8_EXT1>;
		y-names = "SLIDER_0";
		zephyr,code = <INPUT_KEY_3>;
		csd = <0>;
		prescaler = "PRSC_DIV_SEL_16";
		digital-gain = "GAIN_1";
		analog-gain = "GAIN_1";
		filter-level = "FILTER_LEVEL_16";
	};

	key_3_params: touch_key3 {
		threshold = <50>;
		hysteresis = "HYST_25";
		aks-group = "NO_AKS_GROUP";
	};

	node_4_params: touch_node4 {
		x-mask = <QT7_PIN3_EXT1>,
			 <QT7_PIN4_EXT1>,
			 <QT7_PIN10_EXT1>,
			 <QT7_PIN8_EXT1>,
			 <QT7_PIN9_EXT1>;
		x-names = "DRIVEN_SHIELD",
			  "BUTTON_0",
			  "BUTTON_1",
			  "SLIDER_0",
			  "SLIDER_1";
		y-mask = <28>;
		y-names = "SLIDER_0";
		zephyr,code = <INPUT_KEY_4>;
		csd = <0>;
		prescaler = "PRSC_DIV_SEL_16";
		digital-gain = "GAIN_1";
		analog-gain = "GAIN_1";
		filter-level = "FILTER_LEVEL_16";
	};

	key_4_params: touch_key4 {
		threshold = <50>;
		hysteresis = "HYST_25";
		aks-group = "NO_AKS_GROUP";
	};

	def-num-scrollers = <1>;

	/* Slider / wheel Parameters */
	scroller-0-params {
		compatible = "microchip,ptc-scroller";
		scroller-type = "SCROLLER_TYPE_SLIDER";
		zephyr,code = <INPUT_ABS_WHEEL>;
		start-key = <2>;
		number-of-keys = <3>;
		position-hysteresis = <8>;
		contact-min-threshold = <50>;

		/* resol_deadband */
		scroller-resolution = "SCR_RESOL_8_BIT";
		scr-db-percent = "SCR_DB_10_PERCENT";
	};
};
