sensry_i2c: &i2c22 {};

sensry_spi: &spi21 {};

sensry_pdm: &pdm21 {};

/ {
	sensry-leds {
		compatible = "gpio-leds";

		led_sensry_sensor_addon: shield-led {
			gpios = <&expander_sensry_sensor_addon 0 GPIO_ACTIVE_HIGH>;
			label = "Shield LED";
		};
	};
};

&sensry_i2c {
	expander_sensry_sensor_addon: gpio@21 {
		compatible = "nxp,pca9554";
		reg = <0x21>;
		no-auto-reset;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
	};

	light_sensry_sensor_addon: opt3002@44 {
		compatible = "ti,opt3001";
		reg = <0x44>;
	};

	rtc_sensry_sensor_addon: rtc@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
	};

	environmental_sensry_sensor_addon: bme680@76 {
		compatible = "bosch,bme680";
		reg = <0x76>;
	};
};

&sensry_spi {
	imu_sensry_sensor_addon: imu@0 {
		compatible = "bosch,bmi270";
		reg = <0>;
		spi-max-frequency = <8000000>;
		spi-cpol;
		spi-cpha;
	};

	magnetometer_sensry_sensor_addon: lis2mdl@1 {
		compatible = "st,lis2mdl";
		reg = <1>;
		spi-max-frequency = <8000000>;
	};
};

microphone_sensry_sensor_addon: &sensry_pdm {
	status = "okay";
};
