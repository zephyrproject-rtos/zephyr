#include "seeed_xiao_display_gadgets.dtsi"

/ {
	chosen {
		zephyr,display = &st7789v_seeed_xiao_display_1_47;
		zephyr,touch = &axs5106l_seeed_xiao_display_1_47;
	};

	aliases {
		sw0 = &usr1_seeed_xiao_display_1_47;
		sw1 = &usr2_seeed_xiao_display_1_47;
	};

	buttons_seeed_xiao_display_1_47: buttons {
		compatible = "gpio-keys";

		usr1_seeed_xiao_display_1_47: button-usr1 {
			gpios = <&xiao_plus_d 19 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "USR1";
			zephyr,code = <INPUT_KEY_0>;
		};

		usr2_seeed_xiao_display_1_47: button-usr2 {
			gpios = <&xiao_plus_d 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "USR2";
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&mipi_dbi_seeed_xiao_display {
	/*
	 * The JD9853A controller of this panel is driven through its
	 * ST7789V compatible command set.
	 */
	st7789v_seeed_xiao_display_1_47: st7789v@0 {
		compatible = "sitronix,st7789v";
		reg = <0>;
		mipi-max-frequency = <DT_FREQ_M(40)>;
		mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
		width = <172>;
		height = <320>;
		x-offset = <34>;
		y-offset = <0>;
		mdac = <0x48>;
		inversion-off;
		pixel-format = <PANEL_PIXEL_FORMAT_RGB_565X>;
		porch-param = [0c 0c 00 33 33];
		gctrl = <0x35>;
		vcom = <0x28>;
		lcm = <0x0c>;
		vrhs = <0x10>;
		vdvs = <0x20>;
		pwctrl1-param = [a4 a1];
		pvgam-param = [d0 00 02 07 0a 28 32 44 42 06 0e 12 14 17];
		nvgam-param = [d0 00 02 07 0a 28 31 54 47 0e 1c 17 1b 1e];
		ram-param = [00 f0];
	};
};

&xiao_i2c {
	/*
	 * The touch controller shares the reset line of the display, which has
	 * no pull-up resistor and is only driven by the display driver.
	 */
	axs5106l_seeed_xiao_display_1_47: axs5106l@63 {
		compatible = "chipsourcetek,axs5106l";
		reg = <0x63>;
		irq-gpios = <&xiao_d 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		screen-width = <172>;
		screen-height = <320>;
		inverted-x;
	};
};

&xiao_spi {
	cs-gpios = <&xiao_d 2 GPIO_ACTIVE_LOW>, <&xiao_d 6 GPIO_ACTIVE_LOW>;

	sdhc_seeed_xiao_display_1_47: sdhc@1 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <1>;
		spi-max-frequency = <DT_FREQ_M(24)>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
		};
	};
};
