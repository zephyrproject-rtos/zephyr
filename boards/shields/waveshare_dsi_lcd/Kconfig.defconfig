if SHIELD_WAVESHARE_7INCH_DSI_LCD_C

if DISPLAY

if LVGL

config LV_Z_DOUBLE_VDB
	default y

choice LV_Z_RENDERING_MODE
	default LV_Z_FULL_REFRESH
endchoice

choice LV_COLOR_FORMAT_DEFAULT
	default LV_COLOR_FORMAT_XRGB8888
endchoice

endif # LVGL

endif # DISPLAY

endif # SHIELD_7INCH_DSI_LCD_C
