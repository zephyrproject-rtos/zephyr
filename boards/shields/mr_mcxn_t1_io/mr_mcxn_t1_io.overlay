#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	aliases {
		pwm-0 = &flexpwm0_pwm0;
		pwm-1 = &flexpwm1_pwm0;
	};
};

/*
 * Flex IO breakout: a passive expansion board with no fixed silicon. It
 * routes an expansion I2C bus, two flow-controlled UARTs, two FlexPWM
 * blocks and an ADC to the stacking header. The board leaves these buses
 * disabled with their pin routing in place; enable each parent and the
 * exposed function here. Consumers on the expansion connectors are defined
 * by the application.
 */
&flexcomm3 {
	status = "okay";
};

&mr_mcxn_t1_flexio_i2c {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&flexcomm0 {
	status = "okay";
};

&mr_mcxn_t1_flexio_uart0 {
	status = "okay";
	current-speed = <115200>;
};

&flexcomm2 {
	status = "okay";
};

&mr_mcxn_t1_flexio_uart2 {
	status = "okay";
	current-speed = <115200>;
};

&flexpwm0 {
	status = "okay";
};

&mr_mcxn_t1_flexio_pwm0 {
	status = "okay";
};

&flexpwm1 {
	status = "okay";
};

&mr_mcxn_t1_flexio_pwm1 {
	status = "okay";
};

&mr_mcxn_t1_flexio_adc {
	status = "okay";
};
