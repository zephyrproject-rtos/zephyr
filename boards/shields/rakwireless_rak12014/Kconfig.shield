config SHIELD_RAKWIRELESS_RAK12014_SENSOR_C
	def_bool $(shields_list_contains,rakwireless_rak12014_sensor_c)

config SHIELD_RAKWIRELESS_RAK12014_SENSOR_D
	def_bool $(shields_list_contains,rakwireless_rak12014_sensor_d)

config SHIELD_RAKWIRELESS_RAK12014_SENSOR_E
	def_bool $(shields_list_contains,rakwireless_rak12014_sensor_e)

config SHIELD_RAKWIRELESS_RAK12014_SENSOR_F
	def_bool $(shields_list_contains,rakwireless_rak12014_sensor_f)

config SHIELD_RAKWIRELESS_RAK12014
	def_bool SHIELD_RAKWIRELESS_RAK12014_SENSOR_C || \
		SHIELD_RAKWIRELESS_RAK12014_SENSOR_D || \
		SHIELD_RAKWIRELESS_RAK12014_SENSOR_E || \
		SHIELD_RAKWIRELESS_RAK12014_SENSOR_F
