/dts-v1/;
#include <wch/ch58/ch582m.dtsi>

/ {
	compatible = "wch,ch582m-dev-board";
	model = "wch,ch582m-dev-board";

	chosen {
		zephyr,console = &uart0;
		zephyr,flash = &flash0;
		zephyr,serial = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram0;
	};
};

/*
 * UART0 defaults to RXD/TXD on PB4/PB7 out of reset (R32_PIN_CONFIG
 * RB_PIN_UART0 == 0), so no pin remapping is required to use the console.
 */
&uart0 {
	current-speed = <115200>;
	status = "okay";
};
