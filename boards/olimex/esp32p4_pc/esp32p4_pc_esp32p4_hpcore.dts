/dts-v1/;

#include <espressif/esp32p4/esp32p4_n16r32.dtsi>
#include "esp32p4_pc_esp32p4_hpcore-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <espressif/partitions_0x2000_default_16M.dtsi>

/ {
	model = "OLIMEX ESP32-P4-PC HP Core";
	compatible = "espressif,esp32p4";

	chosen {
		zephyr,sram = &sramhp;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &dsi_display;
	};

	aliases {
		led0 = &user_led;
		sw0 = &boot_button;
		watchdog0 = &wdt0;
		sdhc0 = &sdhc0;
	};

	gpio_keys {
		compatible = "gpio-keys";

		boot_button: button {
			label = "Boot Button";
			gpios = <&gpio1 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		user_led: led0 {
			label = "User LED";
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
 * This board carries pre-v3 (v1.3) ESP32-P4 silicon, whose valid CPU
 * frequencies are 90/180/360 MHz. Using a frequency outside that set
 * builds but fails at boot with "invalid CPU frequency".
 */
&cpu0 {
	clock-frequency = <DT_FREQ_M(360)>;
};

&cpu1 {
	clock-frequency = <DT_FREQ_M(360)>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&trng0 {
	status = "okay";
};

&coretemp {
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	/* On-board MIPI DSI to HDMI bridge */
	hdmi_bridge: lt8912b@48 {
		compatible = "lontium,lt8912b";
		reg = <0x48>;
		mipi-dsi = <&mipi_dsi>;
		data-lanes = <2>;
		width = <1280>;
		height = <720>;

		display-timings {
			compatible = "zephyr,panel-timing";
			/* Reduced-blanking 1280x720; together with the 60 MHz
			 * DPI clock (an exact divider of the 240 MHz source)
			 * this gives a clean ~56 Hz mode. PC monitors need
			 * >= ~50 Hz vertical; a TV also accepts 1920x1080
			 * at 30 Hz (80 MHz DPI clock, hfront-porch 401,
			 * vback-porch 8).
			 */
			hsync-len = <32>;
			hback-porch = <80>;
			hfront-porch = <48>;
			vsync-len = <5>;
			vback-porch = <13>;
			vfront-porch = <3>;
			hsync-active = <1>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
		};
	};
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
};

&usb_serial {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&dma {
	status = "okay";
};

&dma_axi {
	status = "okay";
};

&ldo {
	status = "okay";

	ldo1@1 {
		regulator-init-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	ldo2@2 {
		regulator-init-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	/* VDD_MIPI D-PHY supply */
	ldo3@3 {
		regulator-init-microvolt = <2500000>;
		regulator-boot-on;
		regulator-always-on;
	};

	ldo4@4 {
		regulator-init-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};
};

&sdhc {
	sdhc0: sdhc@0 {
		status = "okay";
		bus-width = <4>;
		max-bus-freq = <40000000>;
		clk-pin = <43>;
		cmd-pin = <44>;
		d0-pin = <39>;
		d1-pin = <40>;
		d2-pin = <41>;
		d3-pin = <42>;
		pwr-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

&mdio {
	pinctrl-0 = <&mdio_default>;
	pinctrl-names = "default";
	status = "okay";

	phy: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
		reset-gpios = <&gpio1 19 GPIO_ACTIVE_LOW>;
		reset-assert-duration-us = <10000>;
		reset-deassertion-timeout-ms = <100>;
	};
};

&eth {
	status = "okay";
	phy-handle = <&phy>;
	pinctrl-0 = <&rmii_default>;
	pinctrl-names = "default";
};

zephyr_udc0: &usb_otg {
	status = "okay";
};

&mipi_dsi {
	status = "okay";
	phy-clock = <1000000000>;
	dpi-clock-frequency = <60000000>;
};

&dsi_display {
	status = "okay";
	/* The bridge consumes 24-bit pixels in B,G,R memory order */
	pixel-format = <PANEL_PIXEL_FORMAT_BGR_888>;
	width = <1280>;
	height = <720>;
};
