/dts-v1/;

#include <espressif/esp32/esp32.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <espressif/partitions_0x1000_amp.dtsi>
#include "ulanzi_tc001-pinctrl.dtsi"

/ {
	model = "Ulanzi TC001 PROCPU";
	compatible = "ulanzi,tc001";

	aliases {
		uart-0 = &uart0;
		i2c-0 = &i2c0;
		sw0 = &button_left;
		sw1 = &button_middle;
		sw2 = &button_right;
		watchdog0 = &wdt0;
		led-strip = &led_strip;
		rtc = &rtc0;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &esp32_bt_hci;
		zephyr,display = &led_matrix;
	};

	buttons {
		compatible = "gpio-keys";

		button_left: button_left {
			label = "Left";
			gpios = <&gpio0 26 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_LEFT>;
		};

		button_middle: button_middle {
			label = "Middle";
			gpios = <&gpio0 27 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};

		button_right: button_right {
			label = "Right";
			gpios = <&gpio0 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_RIGHT>;
		};
	};

	buzzer0: buzzer0 {
		compatible = "pwm-buzzer";
		pwms = <&ledc0 0 PWM_HZ(2700) PWM_POLARITY_NORMAL>;
	};

	led_matrix: led-matrix {
		compatible = "led-strip-matrix";
		led-strips = <&led_strip>;
		width = <32>;
		height = <8>;
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(4)>;
	ranges = <0x0 0x0 DT_SIZE_M(4)>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&gpio0 {
	gpio-reserved-ranges = <6 6>, <20 1>, <24 1>, <28 4>;
	status = "okay";

	buzzer_idle {
		gpio-hog;
		gpios = <15 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpio1 {
	gpio-reserved-ranges = <5 2>;
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	sda-gpios = <&gpio0 21 GPIO_OPEN_DRAIN>;
	scl-gpios = <&gpio0 22 GPIO_OPEN_DRAIN>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	rtc0: rtc@68 {
		compatible = "maxim,ds1307";
		reg = <0x68>;
	};

	sht3xd: sht3xd@44 {
		compatible = "sensirion,sht3xd";
		reg = <0x44>;
	};
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	dma-enabled;
	line-idle-low;
	pinctrl-0 = <&spim2_ws2812_led>;
	pinctrl-names = "default";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <3200000>;
		bits-per-symbol = <4>;
		spi-one-frame = <0xe>;
		spi-zero-frame = <0x8>;

		chain-length = <256>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
	};
};

&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	battery_channel: channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	ldr_channel: channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&ledc0 {
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

&timer0 {
	status = "disabled";
};

&timer1 {
	status = "disabled";
};

&timer2 {
	status = "disabled";
};

&timer3 {
	status = "disabled";
};

&trng0 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};
