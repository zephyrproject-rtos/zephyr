if BOARD_UBX_EVK_IRIS_W1

configdefault ETH_DRIVER
	default y if DT_HAS_NXP_ENET_MAC_ENABLED

# IRIS-W1 module single-antenna RF calibration data (from hal_nxp)
configdefault NXP_WIFI_CALDATA_UBX_IRIS_W1
	default y if WIFI_NXP

endif # BOARD_UBX_EVK_IRIS_W1
