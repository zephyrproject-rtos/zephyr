/dts-v1/;

#include <adi/max32/max32690-m4.dtsi>
#include <adi/max32/max32690-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/adi-max32-gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Analog Devices EVAL-ADIN1140D1Z";
	compatible = "adi,eval-adin1140d1z";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	leds {
		compatible = "gpio-leds";

		user_led: user_led {
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
			label = "USR LED";
		};

		uc_led0: uc_led0 {
			gpios = <&gpio2 9 GPIO_ACTIVE_LOW>;
			label = "LED0";
		};

		uc_led1: uc_led1 {
			gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
			label = "LED1";
		};

		uc_led2: uc_led2 {
			gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
			label = "LED2";
		};

		uc_led3: uc_led3 {
			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
			label = "LED3";
		};
	};

	buttons {
		compatible = "gpio-keys";

		usr_btn: usr_btn {
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
			label = "S2";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		led0 = &user_led;
		led1 = &uc_led0;
		led2 = &uc_led1;
		sw0 = &usr_btn;
		ambient-temp0 = &adt7420;
	};
};

&clk_ipo {
	status = "okay";
};

&clk_ibro {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

&uart0 {
	clock-source = <ADI_MAX32_PRPH_CLK_SRC_IBRO>;
	pinctrl-0 = <&uart0a_tx_p2_12 &uart0a_rx_p2_11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	status = "okay";
};

&trng {
	status = "okay";
};

&dma0 {
	status = "okay";
};

&spi0b_miso_p2_27 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi0b_mosi_p2_28 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi0b_sck_p2_29 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi0b_ss1_p2_26 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0b_miso_p2_27 &spi0b_mosi_p2_28 &spi0b_sck_p2_29>;
	cs-gpios = <&gpio2 26 (GPIO_ACTIVE_LOW | MAX32_GPIO_VSEL_VDDIOH)>;
	pinctrl-names = "default";

	dmas = <&dma0 1 MAX32_DMA_SLOT_SPI0_TX>, <&dma0 2 MAX32_DMA_SLOT_SPI0_RX>;
	dma-names = "tx", "rx";

	adin1140: adin1140@0 {
		compatible = "adi,adin1140";
		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(25)>;
		int-gpios = <&gpio3 1 (GPIO_ACTIVE_LOW | MAX32_GPIO_VSEL_VDDIOH | GPIO_PULL_UP)>;
		wake-gpios = <&gpio3 0 (GPIO_ACTIVE_HIGH | MAX32_GPIO_VSEL_VDDIOH)>;
		status = "okay";
		local-mac-address = [00 e0 22 fe da d0];
		phy-handle = <&adin1140_phy>;

		mdio {
			compatible = "adi,adin1140-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			adin1140_phy: ethernet-phy@0 {
				reg = <0x0>;
				compatible = "adi,adin1140-phy";
				plca-enable;
				plca-node-id = <0>;
				plca-node-count = <5>;
				plca-burst-count = <0>;
				plca-burst-timer = <0x60>;
				plca-to-timer = <0x20>;
			};
		};
	};
};

&spi3a_miso_p0_20 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi3a_mosi_p0_21 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi3a_sck_p0_16 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi3a_ss0_p0_19 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi3 {
	pinctrl-0 = <&spi3a_miso_p0_20 &spi3a_mosi_p0_21 &spi3a_sck_p0_16
		     &spi3a_ss0_p0_19>;
	pinctrl-names = "default";
	status = "okay";

	adin1110: adin1110@0 {
		compatible = "adi,adin1110";
		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(10)>;
		int-gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | MAX32_GPIO_VSEL_VDDIOH)>;
		reset-gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | MAX32_GPIO_VSEL_VDDIOH)>;
		status = "okay";

		port1 {
			local-mac-address = [00 e0 22 fe da c9];
		};

		mdio {
			compatible = "adi,adin2111-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-phy@1 {
				reg = <0x1>;
				compatible = "adi,adin2111-phy";
			};
		};
	};
};

&spi4a_miso_p1_2 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi4a_mosi_p1_1 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi4a_sck_p1_3 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi4a_ss0_p1_0 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

pmod_spi: &spi4 {
	pinctrl-0 = <&spi4a_miso_p1_2 &spi4a_mosi_p1_1 &spi4a_sck_p1_3
		     &spi4a_ss0_p1_0>;
	pinctrl-names = "default";
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1a_scl_p0_12 &i2c1a_sda_p0_11>;
	pinctrl-names = "default";

	adt7420: adt7420@48 {
		compatible = "adi,adt7420";
		reg = <0x48>;
	};
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0a_scl_p2_8 &i2c0a_sda_p2_7>;
	pinctrl-names = "default";

	eeprom: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		status = "okay";
		size = <DT_SIZE_K(64)>;
		pagesize = <32>;
		address-width = <8>;
		timeout = <5>;
	};
};
