/dts-v1/;

#include <adi/max32/max32650.dtsi>
#include <adi/max32/max32650-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/adi-max32-gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	compatible = "adi,ad_swiot1l_sl";
	model = "Analog Devices AD-SWIOT1L-SL";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram4;
		zephyr,flash = &flash0;
	};

	leds {
		compatible = "gpio-leds";

		led1: led_1 {
			gpios = <&gpio2 15 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};

		led2: led_2 {
			gpios = <&gpio2 14 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};
	};

	/* These aliases are provided for compatibility with samples */
	aliases {
		led0 = &led1;
		led1 = &led2;
	};
};

&uart0 {
	pinctrl-0 = <&uart0_tx_p2_12 &uart0_rx_p2_11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	status = "okay";
};

&clk_ipo {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";

	/*
	 * ADIN1110 configuration straps, latched when the driver releases
	 * reset-gpios. With SPI_CFG1 high the ADIN1110 comes up in Generic SPI
	 * mode with CRC, which is what the driver expects by default. SPI_CFG0
	 * is P2.3, shared with the SPI2 MISO line.
	 */
	adin1110-spi-cfg1-hog {
		gpio-hog;
		gpios = <0 (GPIO_ACTIVE_HIGH | MAX32_GPIO_VSEL_VDDIOH)>;
		output-high;
	};

	adin1110-mssel-hog {
		gpio-hog;
		gpios = <9 (GPIO_ACTIVE_HIGH | MAX32_GPIO_VSEL_VDDIOH)>;
		output-high;
	};

	adin1110-tx2p4-hog {
		gpio-hog;
		gpios = <10 (GPIO_ACTIVE_HIGH | MAX32_GPIO_VSEL_VDDIOH)>;
		output-low;
	};

	adin1110-swpd-hog {
		gpio-hog;
		gpios = <25 (GPIO_ACTIVE_HIGH | MAX32_GPIO_VSEL_VDDIOH)>;
		output-high;
	};
};

&gpio3 {
	status = "okay";
};

/* SPI2 and the ADIN1110 control pins are supplied from VDDIOH */
&spi2_sck_p2_2 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi2_miso_p2_3 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi2_mosi_p2_4 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi2_ss0_p2_5 {
	power-source = <MAX32_VSEL_VDDIOH>;
};

&spi2 {
	pinctrl-0 = <&spi2_miso_p2_3 &spi2_mosi_p2_4 &spi2_sck_p2_2 &spi2_ss0_p2_5>;
	pinctrl-names = "default";
	status = "okay";

	adin1110: adin1110@0 {
		compatible = "adi,adin1110";
		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(15)>;
		int-gpios = <&gpio2 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP | MAX32_GPIO_VSEL_VDDIOH)>;
		reset-gpios = <&gpio2 1 (GPIO_ACTIVE_LOW | MAX32_GPIO_VSEL_VDDIOH)>;
		status = "okay";

		port1 {
			local-mac-address = [00 18 80 03 25 60];
		};

		mdio {
			compatible = "adi,adin2111-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-phy@1 {
				reg = <0x1>;
				compatible = "adi,adin2111-phy";
			};
		};
	};
};
