/dts-v1/;
#include <espressif/esp32s3/esp32s3_mini_n8.dtsi>
#include <espressif/partitions_0x0_amp_8M.dtsi>
#include "glyph_s3-pinctrl.dtsi"

/ {
	model = "PCB Cupid Glyph-S3 APPCPU";
	compatible = "pcbcupid,glyph-s3";

	chosen {
		zephyr,sram = &sram1;
		zephyr,ipc_shm = &shm0;
		zephyr,ipc = &ipm0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_appcpu_partition;
	};
};

&trng0 {
	status = "okay";
};

&ipm0 {
	status = "okay";
};
