config BOARD_GLYPH_S3
	select SOC_ESP32S3_MINI_N8
	select SOC_ESP32S3_PROCPU if BOARD_GLYPH_S3_ESP32S3_PROCPU
	select SOC_ESP32S3_APPCPU if BOARD_GLYPH_S3_ESP32S3_APPCPU
