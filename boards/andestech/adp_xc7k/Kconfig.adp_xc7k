config BOARD_ADP_XC7K
	select SOC_AE350_22 if BOARD_ADP_XC7K_AE350_22_CLIC
	select SOC_AE350_23 if BOARD_ADP_XC7K_AE350_23 || BOARD_ADP_XC7K_AE350_23_CLIC
