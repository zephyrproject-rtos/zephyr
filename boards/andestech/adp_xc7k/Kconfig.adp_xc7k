config BOARD_ADP_XC7K
	select SOC_AE350_N22 if BOARD_ADP_XC7K_AE350_N22 || BOARD_ADP_XC7K_AE350_N22_CLIC
	select SOC_AE350_D23 if BOARD_ADP_XC7K_AE350_D23 || BOARD_ADP_XC7K_AE350_D23_CLIC
	select SOC_AE350_A25 if BOARD_ADP_XC7K_AE350_A25
	select SOC_AE350_AX45 if BOARD_ADP_XC7K_AE350_AX45
