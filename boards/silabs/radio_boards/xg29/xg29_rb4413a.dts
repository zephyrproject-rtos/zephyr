/dts-v1/;
#include <silabs/xg29/efr32mg29b230f1024cm40.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "xg29_common.dtsi"
#include "xg29_rb4413a-pinctrl.dtsi"

/ {
	model = "Silicon Labs xG29-RB4413A";
	compatible = "silabs,xg29_rb4413a", "silabs,efr32mg29";

	chosen {
		zephyr,display = &ls013b7dh03;
	};

	aliases {
		dht0 = &si7021;
		/*
		 * Map buttons to the opposite aliases so samples can use LED0
		 * and SW0 simultaneously; each LED shares a pin with a button.
		 */
		sw0 = &button1;
		sw1 = &button0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
			label = "LED 0";
		};

		led1: led_1 {
			gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;
			label = "LED 1";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
			label = "User Push Button 0";
			zephyr,code = <INPUT_KEY_0>;
		};

		button1: button_1 {
			gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;
			label = "User Push Button 1";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	display_enable: sensor_enable: gpio_switch_0 {
		compatible = "regulator-fixed";
		enable-gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
		regulator-name = "sensor_enable";
	};
};

&hfxo {
	ctune = <129>;
	precision = <50>;
};

&lfxo {
	ctune = <42>;
	precision = <50>;
};

&dma0 {
	status = "okay";
};

&i2c0 {
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	dmas = <&dma0 DMA_REQSEL_I2C0RXDATAV>, <&dma0 DMA_REQSEL_I2C0TXBL>;
	dma-names = "rx", "tx";
	status = "okay";

	si7021: si7021@40 {
		compatible = "silabs,si7006";
		reg = <0x40>;
		vin-supply = <&sensor_enable>;
	};
};

&eusart1 {
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>, <&gpioc 6 GPIO_ACTIVE_HIGH>;

	mx25r80: mx25r8035f@0 {
		zephyr,pm-device-runtime-auto;
	};

	ls013b7dh03: ls0xx@1 {
		compatible = "sharp,ls0xx";
		reg = <1>;
		disp-en-gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
		extcomin-frequency = <60>;
		extcomin-gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
		height = <128>;
		spi-max-frequency = <DT_FREQ_M(2)>;
		width = <128>;
	};
};

&gpiob {
	vcom-enable {
		gpio-hog;
		gpios = <4 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&radio {
	pa-2p4ghz = "highest";
	pa-voltage-mv = <1800>;
};
