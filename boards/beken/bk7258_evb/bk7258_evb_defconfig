#
# Board defconfig for the BK7258 EVB.
#
# The architecture, the CPU model and the core clock are properties of the SoC
# and come in through its select chain, so they are not repeated here.

CONFIG_MAIN_STACK_SIZE=2048
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=2048
CONFIG_ISR_STACK_SIZE=2048

CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_PRINTK=y

CONFIG_HEAP_MEM_POOL_SIZE=4096
