#include <nxp/imxrt/imxrt7xx/pinctrl/MIMXRT798SGFOB-pinctrl.h>

&pinctrl {
	/* CPU0 debug console (MCU-Link), FLEXCOMM0 LPUART - same pins as MIMXRT700-EVK */
	pinmux_flexcomm0_lpuart: pinmux_flexcomm0_lpuart {
		group0 {
			pinmux = <LP_FLEXCOMM0_P0_PIO0_31>;
			input-enable;
			slew-rate = "normal";
			drive-strength = "normal";
		};

		group1 {
			pinmux = <LP_FLEXCOMM0_P1_PIO1_0>;
			slew-rate = "normal";
			drive-strength = "normal";
		};
	};

	/* CPU1 debug console, FLEXCOMM19 LPUART - same pins as MIMXRT700-EVK */
	pinmux_flexcomm19_lpuart: pinmux_flexcomm19_lpuart {
		group0 {
			pinmux = <LP_FLEXCOMM19_P0_PIO8_14>;
			input-enable;
			slew-rate = "normal";
			drive-strength = "normal";
		};

		group1 {
			pinmux = <LP_FLEXCOMM19_P1_PIO8_15>;
			slew-rate = "normal";
			drive-strength = "normal";
		};
	};

	/* USDHC0 to the SD card slot (J47) through the U72 level translator */
	pinmux_usdhc0: pinmux_usdhc0 {
		group0 {
			pinmux = <SDHC0_CMD_PIO7_1>,
				 <USDHC0_USDHC_DATA0_PIO7_6>,
				 <USDHC0_USDHC_DATA1_PIO7_7>,
				 <USDHC0_USDHC_DATA2_PIO7_8>,
				 <USDHC0_USDHC_DATA3_PIO7_9>,
				 <SDHC0_CARD_DET_N_PIO7_11>;
			bias-pull-up;
			input-enable;
			slew-rate = "normal";
			drive-strength = "normal";
			nxp,drive-current = <3>;
		};

		group1 {
			pinmux = <SDHC0_CLK_PIO7_0>;
			bias-pull-up;
			input-enable;
			slew-rate = "normal";
			drive-strength = "normal";
			nxp,drive-current = <3>;
		};

		/* SD power switch enable (U52) on PIO7_10 as GPIO */
		group2 {
			pinmux = <GPIO7_GPIO10_PIO7_10>;
			bias-pull-down;
			slew-rate = "normal";
			drive-strength = "normal";
		};
	};
};
