/dts-v1/;

#include <nxp/imxrt/imxrt7xx/nxp_rt798s_cm33_cpu0.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "frdm_imxrt700-pinctrl.dtsi"

/ {
	model = "NXP FRDM-IMXRT700 board";
	compatible = "nxp,mimxrt798s";

	aliases {
		led0 = &green_led;
		led1 = &blue_led;
		sw0 = &user_button_1;
	};

	chosen {
		zephyr,flash-controller = &ext_flash_ctrl;
		zephyr,flash = &w25q25pw;
		zephyr,code-partition = &slot0_partition;
		zephyr,sram = &sram0;
		zephyr,console = &flexcomm0_lpuart0;
		zephyr,shell-uart = &flexcomm0_lpuart0;
	};

	leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
			label = "User LED_GREEN";
		};

		blue_led: led_1 {
			gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
			label = "User LED_BLUE";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button_1: button_0 {
			label = "User SW5";
			gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

/*
 * RT700-FRDM board cm33_cpu0 uses OS timer as the kernel timer
 * In case we need to switch to SYSTICK timer, then
 * replace &os_timer with &systick
 */
&os_timer_cpu0 {
	status = "okay";
	wakeup-source;
};

&flexcomm0 {
	status = "okay";
};

&flexcomm0_lpuart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_flexcomm0_lpuart>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&green_led {
	status = "okay";
};

&blue_led {
	status = "okay";
};

&xspi0 {
	status = "okay";
	pinctrl-0 = <&pinmux_xspi0>;
	pinctrl-names = "default";
	byte-order = <3>;
	ahb-buffer-write-flush;
	ahb-prefetch;

	ext_flash_ctrl: flash-controller@0 {
		compatible = "nxp,xspi-nor";
		/* W25Q25PW is a 32MB, 256Mbit flash part. */
		size = <DT_SIZE_M(32)>;
		reg = <0>;
		/* No DQS pin: sample with the strobe looped back through the DQS pad */
		sample-clk-source = <2>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x38000000 DT_SIZE_M(32)>;

		w25q25pw: flash@0 {
			compatible = "winbond,w25q25pw", "soc-nv-flash";
			reg = <0x0 DT_SIZE_M(32)>;
			erase-block-size = <DT_SIZE_K(4)>;
			write-block-size = <4>;

			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			partitions {
				#address-cells = <1>;
				#size-cells = <1>;
				ranges;

				/*
				 * Partition sizes must be aligned
				 * to the flash memory sector size of 4KB.
				 */
				boot_partition: partition@0 {
					compatible = "zephyr,mapped-partition";
					label = "mcuboot";
					reg = <0x00000000 DT_SIZE_K(128)>;
				};

				slot0_partition: partition@20000 {
					compatible = "zephyr,mapped-partition";
					label = "image-0";
					reg = <0x00020000 DT_SIZE_M(7)>;
				};

				slot1_partition: partition@720000 {
					compatible = "zephyr,mapped-partition";
					label = "image-1";
					reg = <0x00720000 DT_SIZE_M(7)>;
				};

				storage_partition: partition@e20000 {
					compatible = "zephyr,mapped-partition";
					label = "storage";
					reg = <0x00e20000 (DT_SIZE_M(2) - DT_SIZE_K(128))>;
				};
			};
		};
	};
};
