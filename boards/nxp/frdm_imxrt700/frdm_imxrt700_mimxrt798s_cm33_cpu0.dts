/dts-v1/;

#include <nxp/imxrt/imxrt7xx/nxp_rt798s_cm33_cpu0.dtsi>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "frdm_imxrt700-pinctrl.dtsi"

/ {
	model = "NXP FRDM-IMXRT700 board";
	compatible = "nxp,mimxrt798s";

	aliases {
		led0 = &green_led;
		led1 = &blue_led;
		sw0 = &user_button_1;
		i2s-codec-tx = &sai0;
		i2s-tx = &sai0;
	};

	chosen {
		zephyr,flash = &w25q25pw;
		zephyr,sram = &sram0;
		zephyr,console = &flexcomm0_lpuart0;
		zephyr,shell-uart = &flexcomm0_lpuart0;
	};

	leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
			label = "User LED_GREEN";
		};

		blue_led: led_1 {
			gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
			label = "User LED_BLUE";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button_1: button_0 {
			label = "User SW5";
			gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

/*
 * RT700-FRDM board cm33_cpu0 uses OS timer as the kernel timer
 * In case we need to switch to SYSTICK timer, then
 * replace &os_timer with &systick
 */
&os_timer_cpu0 {
	status = "okay";
	wakeup-source;
};

&edma0 {
	status = "okay";
};

&edma1 {
	status = "okay";
};

&flexcomm0 {
	status = "okay";
};

&flexcomm0_lpuart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_flexcomm0_lpuart>;
	pinctrl-names = "default";
};

&flexcomm3 {
	status = "okay";
};

&flexcomm3_lpi2c3 {
	status = "okay";
	pinctrl-0 = <&pinmux_flexcomm3_lpi2c>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	#address-cells = <1>;
	#size-cells = <0>;

	audio_codec: wm8962@1a {
		compatible = "wolfson,wm8962";
		reg = <0x1a>;
		clock-source = "MCLK";
		clocks = <&clkctl0 MCUX_SAI0_CLK>;
		clock-names = "mclk";
	};
};

&flexcomm8 {
	status = "okay";
};

arduino_i2c: &flexcomm8_lpi2c8 {
	status = "okay";
	pinctrl-0 = <&pinmux_flexcomm8_lpi2c>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

p3t1755dp_ard_i2c_interface: &flexcomm8_lpi2c8 {};

arduino_spi: &lpspi16 {
	status = "okay";
	/* DMA channels 0 and 1, muxed to LPSPI16 RX and TX */
	dmas = <&edma0 0 75>, <&edma0 1 76>;
	dma-names = "rx", "tx";
	pinctrl-0 = <&pinmux_lpspi16>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&green_led {
	status = "okay";
};

&blue_led {
	status = "okay";
};

/*
 * XSPI0 hosts the XIP boot flash: FRDM-IMXRT700 populates a Winbond
 * W25Q25PW quad SPI NOR (32MB / 256Mbit), unlike the MIMXRT700-EVK
 * octal MX25UM51345G. The boot ROM configures the pins and the
 * controller for XIP from the boot configuration block
 * (flash_config/flash_config.c), so no pinctrl is attached here and
 * code executes in place from the memory-mapped window at 0x38000000.
 * The node must stay enabled: the boot header machinery (BOOT_XSPI_NOR
 * and the flash config block placement) depends on an enabled nxp,xspi
 * node, and board_early_init_hook() keys the XSPI0 power domain
 * keep-alive on it.
 */
&xspi0 {
	status = "okay";

	/*
	 * The flash chip is described because it is on the board and
	 * zephyr,flash needs it to place the XIP image, but the flash
	 * controller stays disabled: the nxp,xspi-nor driver only knows the
	 * octal MX25UM51345G (see the device table in
	 * drivers/flash/flash_mcux_xspi.c) and would fail probing this quad
	 * part. For the same reason there is no zephyr,flash-controller
	 * chosen entry; add both once the driver supports the W25Q25PW.
	 */
	ext_flash_ctrl: flash-controller@0 {
		compatible = "nxp,xspi-nor";
		device-name = "w25q25pw";
		/* W25Q25PW is a 32MB, 256Mbit flash part. */
		size = <DT_SIZE_M(32)>;
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x38000000 DT_SIZE_M(32)>;
		status = "disabled";

		w25q25pw: flash@0 {
			compatible = "soc-nv-flash";
			reg = <0x0 DT_SIZE_M(32)>;
			erase-block-size = <DT_SIZE_K(4)>;
			write-block-size = <4>;

			/*
			 * Required by zephyr,mapped-partition so that an
			 * application overlay can add partitions to this
			 * node; the baseline board itself is unpartitioned.
			 */
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
		};
	};
};

&sai0 {
	status = "okay";
	pinctrl-0 = <&pinmux_sai0>;
	pinctrl-names = "default";
	nxp,rx-sync-mode;
};

&micfil {
	status = "okay";
	pinctrl-0 = <&pinmux_micfil>;
	pinctrl-names = "default";
};
