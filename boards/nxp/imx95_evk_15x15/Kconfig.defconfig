if SOC_MIMX9596_A55

# Keep GIC, mailbox, and SCMI at the same priority. Devicetree dependencies
# determine the order of mailbox and SCMI initialization.
configdefault INTC_INIT_PRIORITY
	default 31

configdefault MBOX_INIT_PRIORITY
	default 31

configdefault ARM_SCMI_SHMEM_INIT_PRIORITY
	default 31

configdefault ARM_SCMI_TRANSPORT_INIT_PRIORITY
	default 31

configdefault CLOCK_CONTROL_INIT_PRIORITY
	default 31

if NETWORKING

configdefault GIC_V3_ITS
	default y

configdefault ETH_DRIVER
	default y

# Enlarge default networking stack
configdefault NET_TX_STACK_SIZE
	default 2048

configdefault NET_RX_STACK_SIZE
	default 2048

configdefault NET_TCP_WORKQ_STACK_SIZE
	default 2048

configdefault NET_MGMT_EVENT_STACK_SIZE
	default 2048

configdefault NET_SOCKETS_SERVICE_STACK_SIZE
	default 2048

endif # NETWORKING

endif # SOC_MIMX9596_A55
