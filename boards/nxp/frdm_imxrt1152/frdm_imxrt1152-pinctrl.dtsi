#include <nxp/imxrt/imxrt11xx/pinctrl/mimxrt1152xhm8b-pinctrl.dtsi>

&pinctrl {
	pinmux_lpuart1: pinmux_lpuart1 {
		group0 {
			pinmux = <&iomuxc_gpio_ad_25_lpuart1_rx>,
				 <&iomuxc_gpio_ad_24_lpuart1_tx>;
			drive-strength = "high";
			slew-rate = "fast";
		};
	};

	pinmux_lpuart1_sleep: pinmux_lpuart1_sleep {
		group0 {
			pinmux = <&iomuxc_gpio_ad_25_gpio_mux3_io24>;
			drive-strength = "high";
			bias-pull-up;
			slew-rate = "fast";
		};

		group1 {
			pinmux = <&iomuxc_gpio_ad_24_lpuart1_tx>;
			drive-strength = "high";
			slew-rate = "fast";
		};
	};

	pinmux_enet1g: pinmux_enet1g {
		group0 {
			pinmux = <&iomuxc_gpio_disp_b1_11_enet_1g_tx_clk_io>,
				 <&iomuxc_gpio_sd_b2_01_enet_1g_rx_clk>;
			bias-disable;
			drive-strength = "high";
			slew-rate = "fast";
			input-enable;
		};

		group1 {
			pinmux = <&iomuxc_gpio_disp_b1_09_enet_1g_tdata00>,
				 <&iomuxc_gpio_disp_b1_08_enet_1g_tdata01>,
				 <&iomuxc_gpio_disp_b1_07_enet_1g_tdata02>,
				 <&iomuxc_gpio_disp_b1_06_enet_1g_tdata03>,
				 <&iomuxc_gpio_disp_b1_10_enet_1g_tx_en>;
			drive-strength = "high";
			bias-disable;
			slew-rate = "fast";
		};

		group2 {
			pinmux = <&iomuxc_gpio_sd_b2_02_enet_1g_rdata00>,
				 <&iomuxc_gpio_sd_b2_03_enet_1g_rdata01>,
				 <&iomuxc_gpio_sd_b2_04_enet_1g_rdata02>,
				 <&iomuxc_gpio_emc_b2_07_enet_1g_rdata03>,
				 <&iomuxc_gpio_sd_b2_00_enet_1g_rx_en>;
			drive-strength = "high";
			bias-disable;
			slew-rate = "fast";
			input-enable;
		};
	};

	pinmux_enet1g_mdio: pinmux_enet1g_mdio {
		group0 {
			pinmux = <&iomuxc_gpio_emc_b1_40_enet_1g_mdc>,
				 <&iomuxc_gpio_emc_b1_41_enet_1g_mdio>;
			drive-strength = "high";
			bias-disable;
			slew-rate = "fast";
		};
	};

	pinmux_flexspi1: pinmux_flexspi1 {
		group0 {
			pinmux = <&iomuxc_gpio_sd_b2_05_flexspi1_a_dqs>,
				 <&iomuxc_gpio_sd_b2_06_flexspi1_a_ss0_b>,
				 <&iomuxc_gpio_sd_b2_07_flexspi1_a_sclk>,
				 <&iomuxc_gpio_sd_b2_08_flexspi1_a_data00>,
				 <&iomuxc_gpio_sd_b2_09_flexspi1_a_data01>,
				 <&iomuxc_gpio_sd_b2_10_flexspi1_a_data02>,
				 <&iomuxc_gpio_sd_b2_11_flexspi1_a_data03>;
			bias-pull-down;
			input-enable;
		};
	};
};
