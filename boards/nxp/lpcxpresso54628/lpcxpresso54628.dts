/dts-v1/;

#include <nxp/lpc/nxp_lpc546xx.dtsi>
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "lpcxpresso54628-pinctrl.dtsi"

/ {
	compatible = "nxp,lpc546xx", "nxp,lpc";
	model = "NXP LPCXpresso54628 board";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &flexcomm0;
		zephyr,shell-uart = &flexcomm0;
	};

	aliases {
		led0 = &led1;
		led1 = &led2;
		led2 = &led3;
		usart-0 = &flexcomm0;
		sw0 = &user_button;
		accel0 = &mma8652fc;
		watchdog0 = &wwdt0;
		rtc = &rtc;
	};

	/*
	 * SW5 is the only usable push button. The ISP buttons SW2/SW3/SW4 are
	 * wired to P0_6/P0_5/P0_4, which this board uses as EMC_D4/EMC_D3/EMC_D2
	 * for the SDRAM, so they cannot be read as GPIO while the EMC is active
	 * and are intentionally not exposed here.
	 */
	gpio_keys {
		compatible = "gpio-keys";

		user_button: button_0 {
			label = "User button SW5";
			gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led1: led_1 {
			gpios = <&gpio3 14 GPIO_ACTIVE_LOW>;
			label = "User LED1";
		};

		led2: led_2 {
			gpios = <&gpio3 3 GPIO_ACTIVE_LOW>;
			label = "User LED2";
		};

		led3: led_3 {
			gpios = <&gpio2 2 GPIO_ACTIVE_LOW>;
			label = "User LED3";
		};
	};

	/*
	 * Arduino Uno R3 footprint on the inner rows of J9, J10, J12 and J13.
	 * Several pins are shared with on-board functions: A4 is the
	 * accelerometer interrupt, A5 the user button SW5, D5 user LED1, and
	 * the I2C pins are the shared FlexComm2 bus.
	 */
	arduino_header: arduino-connector {
		compatible = "arduino-header-r3";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <ARDUINO_HEADER_R3_A0 0 &gpio0 16 0>,
			   <ARDUINO_HEADER_R3_A1 0 &gpio0 31 0>,
			   <ARDUINO_HEADER_R3_A2 0 &gpio1 0 0>,
			   <ARDUINO_HEADER_R3_A3 0 &gpio2 0 0>,
			   <ARDUINO_HEADER_R3_A4 0 &gpio3 4 0>,
			   <ARDUINO_HEADER_R3_A5 0 &gpio1 1 0>,
			   <ARDUINO_HEADER_R3_D0 0 &gpio3 26 0>,
			   <ARDUINO_HEADER_R3_D1 0 &gpio3 27 0>,
			   <ARDUINO_HEADER_R3_D2 0 &gpio3 2 0>,
			   <ARDUINO_HEADER_R3_D3 0 &gpio4 5 0>,
			   <ARDUINO_HEADER_R3_D4 0 &gpio3 10 0>,
			   <ARDUINO_HEADER_R3_D5 0 &gpio3 14 0>,
			   <ARDUINO_HEADER_R3_D6 0 &gpio3 1 0>,
			   <ARDUINO_HEADER_R3_D7 0 &gpio1 22 0>,
			   <ARDUINO_HEADER_R3_D8 0 &gpio4 7 0>,
			   <ARDUINO_HEADER_R3_D9 0 &gpio2 1 0>,
			   <ARDUINO_HEADER_R3_D10 0 &gpio3 30 0>,
			   <ARDUINO_HEADER_R3_D11 0 &gpio3 21 0>,
			   <ARDUINO_HEADER_R3_D12 0 &gpio3 22 0>,
			   <ARDUINO_HEADER_R3_D13 0 &gpio3 20 0>,
			   <ARDUINO_HEADER_R3_D14 0 &gpio3 23 0>,
			   <ARDUINO_HEADER_R3_D15 0 &gpio3 24 0>;
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(220)>;
};

/*
 * Default for this board is to use the full 160 KB of contiguous main SRAM
 * (SRAM0-3) as a single region; an application can provide its own devicetree
 * to allocate the SRAM banks differently.
 */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(160)>;
};

&flexcomm0 {
	compatible = "nxp,lpc-usart";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_flexcomm0_usart>;
	pinctrl-names = "default";
	status = "okay";
};

&usbfs {
	pinctrl-0 = <&pinmux_usbfs>;
	pinctrl-names = "default";
};

zephyr_udc0: &usbhs {
	status = "okay";
};

/* Full-size SD card slot (J7), 4-bit SDIO. */
&sdif {
	pinctrl-0 = <&pinmux_sdif>;
	pinctrl-names = "default";
	status = "okay";

	mmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

arduino_i2c: &flexcomm2 {
	compatible = "nxp,lpc-i2c";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&pinmux_flexcomm2_i2c>;
	pinctrl-names = "default";
	status = "okay";

	/*
	 * NXP MMA8652FC 3-axis accelerometer. INT1 is wired to P3_4 and INT2 is
	 * unconnected. The pin interrupt engine can only select pins on ports 0
	 * and 1, so INT1 cannot raise a GPIO interrupt and the driver's trigger
	 * support is unavailable on this board.
	 */
	mma8652fc: mma8652fc@1d {
		compatible = "nxp,fxos8700", "nxp,mma8652fc";
		reg = <0x1d>;
		int1-gpios = <&gpio3 4 GPIO_ACTIVE_LOW>;
	};
};

/* Arduino D0 (RX) and D1 (TX). */
arduino_serial: &flexcomm4 {
	compatible = "nxp,lpc-usart";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_flexcomm4_usart>;
	pinctrl-names = "default";
};

/* Arduino D13 (SCK), D11 (MOSI), D12 (MISO) and D10 (SSEL0). */
arduino_spi: &flexcomm9 {
	compatible = "nxp,lpc-spi";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&pinmux_flexcomm9_spi>;
	pinctrl-names = "default";
	status = "okay";
};

&ctimer0 {
	status = "okay";
};

&ctimer1 {
	status = "okay";
};

&ctimer2 {
	status = "okay";
};

&ctimer3 {
	status = "okay";
};

&ctimer4 {
	status = "okay";
};

&wwdt0 {
	status = "okay";
};

&mrt0 {
	status = "okay";
};

&mrt0_channel0 {
	status = "okay";
};

&rtc {
	status = "okay";
};

&crc {
	status = "okay";
};
