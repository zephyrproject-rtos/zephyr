/dts-v1/;

#include <nxp/lpc/nxp_lpc546xx.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "lpcxpresso54628-pinctrl.dtsi"

/ {
	model = "NXP LPCXpresso54628 board";
	compatible = "nxp,lpc546xx", "nxp,lpc";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &flexcomm0;
		zephyr,shell-uart = &flexcomm0;
	};

	aliases {
		led0 = &led1;
		led1 = &led2;
		led2 = &led3;
		usart-0 = &flexcomm0;
		sw0 = &user_button;
	};

	/*
	 * SW5 is the only usable push button. The ISP buttons SW2/SW3/SW4 are
	 * wired to P0_6/P0_5/P0_4, which this board uses as EMC_D4/EMC_D3/EMC_D2
	 * for the SDRAM, so they cannot be read as GPIO while the EMC is active
	 * and are intentionally not exposed here.
	 */
	gpio_keys {
		compatible = "gpio-keys";

		user_button: button_0 {
			label = "User button SW5";
			gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led1: led_1 {
			gpios = <&gpio3 14 GPIO_ACTIVE_LOW>;
			label = "User LED1";
		};

		led2: led_2 {
			gpios = <&gpio3 3 GPIO_ACTIVE_LOW>;
			label = "User LED2";
		};

		led3: led_3 {
			gpios = <&gpio2 2 GPIO_ACTIVE_LOW>;
			label = "User LED3";
		};
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(220)>;
};

/*
 * Default for this board is to use the full 160 KB of contiguous main SRAM
 * (SRAM0-2) as a single region; an application can provide its own devicetree
 * to allocate the SRAM banks differently.
 */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(160)>;
};

&flexcomm0 {
	status = "okay";
	compatible = "nxp,lpc-usart";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_flexcomm0_usart>;
	pinctrl-names = "default";
};
