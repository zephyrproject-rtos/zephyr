/dts-v1/;

#include <nxp/lpc/lpc54xxx/nxp_lpc546xx.dtsi>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "lpcxpresso54628-pinctrl.dtsi"

/ {
	compatible = "nxp,lpc546xx", "nxp,lpc";
	model = "NXP LPCXpresso54628 board";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &flexcomm0;
		zephyr,shell-uart = &flexcomm0;
	};

	aliases {
		led0 = &led1;
		led1 = &led2;
		led2 = &led3;
		usart-0 = &flexcomm0;
		sw0 = &user_button;
		accel0 = &mma8652fc;
		watchdog0 = &wwdt0;
		rtc = &rtc;
	};

	/*
	 * SW5 is the only usable push button. The ISP buttons SW2/SW3/SW4 are
	 * wired to P0_6/P0_5/P0_4, which this board uses as EMC_D4/EMC_D3/EMC_D2
	 * for the SDRAM, so they cannot be read as GPIO while the EMC is active
	 * and are intentionally not exposed here.
	 */
	gpio_keys {
		compatible = "gpio-keys";

		user_button: button_0 {
			label = "User button SW5";
			gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led1: led_1 {
			gpios = <&gpio3 14 GPIO_ACTIVE_LOW>;
			label = "User LED1";
		};

		led2: led_2 {
			gpios = <&gpio3 3 GPIO_ACTIVE_LOW>;
			label = "User LED2";
		};

		led3: led_3 {
			gpios = <&gpio2 2 GPIO_ACTIVE_LOW>;
			label = "User LED3";
		};
	};

	/*
	 * GPIO pins of the parallel-LCD FPC connector, shared across NXP EVKs
	 * and used by the parallel-display shields.
	 */
	nxp_parallel_lcd_connector: parallel-connector {
		compatible = "nxp,parallel-lcd-connector";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <0 0 &gpio3 31 0>;	/* Pin 1: LCD backlight enable */
	};

	/* GPIO pins of the I2C touch-controller FPC connector. */
	nxp_i2c_touch_fpc: i2c-touch-connector {
		compatible = "nxp,i2c-tsc-fpc";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <1 0 &gpio2 27 0>,	/* Pin 2: touch reset  */
			   <2 0 &gpio4 0 0>;	/* Pin 3: touch interrupt */
	};

	/*
	 * 16 MB external SDRAM (Micron MT48LC8M16A2) on the EMC dynamic
	 * chip-select 0, declared as a memory-region so large buffers that do
	 * not fit in internal SRAM can be linked here. It has no MPU attributes
	 * of its own, so the default memory map's execute-never device region
	 * applies: data only, privileged access (unaligned access verified on
	 * this board).
	 */
	sdram0: memory@a0000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0xa0000000 DT_SIZE_M(16)>;
		zephyr,memory-region = "SDRAM";
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(220)>;
};

/*
 * Default for this board is to use the full 160 KB of contiguous main SRAM
 * (SRAM0-3) as a single region; an application can provide its own devicetree
 * to allocate the SRAM banks differently.
 */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(160)>;
};

&flexcomm0 {
	compatible = "nxp,lpc-usart";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_flexcomm0_usart>;
	pinctrl-names = "default";
	status = "okay";
};

&usbfs {
	pinctrl-0 = <&pinmux_usbfs>;
	pinctrl-names = "default";
};

zephyr_udc0: &usbhs {
	status = "okay";
};

/* Full-size SD card slot (J7), 4-bit SDIO. */
&sdif {
	pinctrl-0 = <&pinmux_sdif>;
	pinctrl-names = "default";
	status = "okay";

	mmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

nxp_touch_i2c: &flexcomm2 {
	compatible = "nxp,lpc-i2c";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&pinmux_flexcomm2_i2c>;
	pinctrl-names = "default";
	status = "okay";

	/*
	 * NXP MMA8652FC 3-axis accelerometer. INT1 is wired to P3_4 and INT2 is
	 * unconnected. The pin interrupt engine can only select pins on ports 0
	 * and 1, so INT1 cannot raise a GPIO interrupt and the driver's trigger
	 * support is unavailable on this board.
	 */
	mma8652fc: mma8652fc@1d {
		compatible = "nxp,fxos8700", "nxp,mma8652fc";
		reg = <0x1d>;
		int1-gpios = <&gpio3 4 GPIO_ACTIVE_LOW>;
	};
};

&ctimer0 {
	status = "okay";
};

&ctimer1 {
	status = "okay";
};

&ctimer2 {
	status = "okay";
};

&ctimer3 {
	status = "okay";
};

&ctimer4 {
	status = "okay";
};

&wwdt0 {
	status = "okay";
};

&mrt0 {
	status = "okay";
};

&mrt0_channel0 {
	status = "okay";
};

&rtc {
	status = "okay";
};

&crc {
	status = "okay";
};

/* 10/100 RMII Ethernet to the on-board LAN8720A PHY and RJ45 jack (J4). */
&enet {
	pinctrl-0 = <&pinmux_enet>;
	pinctrl-names = "default";
	phy-connection-type = "rmii";
	phy-handle = <&phy>;
	status = "okay";
};

&enet_mdio {
	status = "okay";

	phy: ethernet-phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
		reset-gpios = <&gpio2 26 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <100000>;
	};
};

&enet_ptp_clock {
	status = "okay";
};

&emc {
	pinctrl-0 = <&pinmux_emc>;
	pinctrl-names = "default";
	/* 220 MHz / 3 = 73.3 MHz, below the 100 MHz EMC clock limit. */
	nxp,emc-clock-div = <2>;
	/*
	 * Read-capture delay. A 16 MB memory test passes with every value at
	 * 73.3 MHz and with 23-31 at 110 MHz; 26 is inside both windows.
	 */
	nxp,emc-feedback-clock-delay = <26>;
	status = "okay";

	sdram@0 {
		compatible = "nxp,lpc-emc-sdram";
		reg = <0>;			/* EMC dynamic chip-select 0 (DYCS0) */
		refresh-period-ns = <15625>;
		t-rp-ns = <18>;
		t-ras-ns = <42>;
		t-srex-ns = <67>;
		t-apr-ns = <18>;
		t-wr-ns = <6>;
		t-rc-ns = <60>;
		t-rfc-ns = <60>;
		t-xsr-ns = <67>;
		t-rrd-ns = <12>;
		nxp,address-mapping = <0x09>;	/* 16-bit, 4 banks, 12 rows, 9 cols */
		nxp,sdram-mode-register = <0x33>;
		nxp,ras-latency = <2>;
		nxp,mode-register-delay = <2>;
	};
};

/*
 * Expose the LCDC under the label the parallel-display shields expect. The
 * panel timings, resolution and pixel format come from the shield; the board
 * supplies the pin routing, the framebuffer memory and the backlight PWM.
 */
zephyr_lcdif: &lcdc {
	pinctrl-0 = <&pinmux_lcd>;
	pinctrl-names = "default";
	memory-region = <&sdram0>;
	/*
	 * Backlight brightness via SCTimer PWM on P3_31 (1 kHz). The LCDC driver
	 * uses this for display_set_brightness() and blanking; it takes
	 * precedence over the shield's GPIO backlight-enable on the same pin.
	 */
	pwms = <&sc_timer 5 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
};

/* SCTimer0 output 5 drives the LCD backlight PWM (P3_31). */
&sc_timer {
	pinctrl-0 = <&pinmux_sctimer0_lcd>;
	pinctrl-names = "default";
	status = "okay";
};
