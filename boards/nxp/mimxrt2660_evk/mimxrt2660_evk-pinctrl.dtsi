/*
 * Board pinctrl for the MIMXRT2660-EVK.
 *
 * input-enable is required on any pad the peripheral reads back (IBENA bit).
 * drive-strength is only available on PIO5/PIO6/PIO7 pads; groups on
 * PIO0..PIO4 omit it.
 */

#include <nxp/imxrt/imxrt266x/pinctrl/mimxrt2663cvvaa-pinctrl.dtsi>

&pinctrl {
	/* Debug console: LPUART0 on PIO3_30 (TXD) / PIO3_31 (RXD). */
	pinmux_lpuart0: pinmux_lpuart0 {
		group0 {
			pinmux = <&main__iomuxc_pio3_30_hsp_lpuart0_txd>,
				 <&main__iomuxc_pio3_31_hsp_lpuart0_rxd>;
			slew-rate = "high";
			input-enable;
		};
	};

	/* Alternate UART: LPUART2 on PIO2_8 (TXD) / PIO2_9 (RXD). */
	pinmux_lpuart2: pinmux_lpuart2 {
		group0 {
			pinmux = <&main__iomuxc_pio2_8_hsp_lpuart2_txd>,
				 <&main__iomuxc_pio2_9_hsp_lpuart2_rxd>;
			slew-rate = "high";
			input-enable;
		};
	};
};
