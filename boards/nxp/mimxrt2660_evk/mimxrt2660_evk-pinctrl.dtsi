/*
 * Board pinctrl for the MIMXRT2660-EVK.
 *
 * The <&main__iomuxc_*> / <&wake__iomuxc_*> nodes are generated per-part into
 * hal_nxp, under dts/nxp/imxrt/imxrt266x/pinctrl/; each carries the combined
 * IOMUXC PIO register (mux == config) and the daisy register for that pad.
 *
 * Any pad the peripheral has to read back needs input-enable (the IBENA bit):
 * without it the pad receiver stays off and the peripheral sees a stuck level.
 *
 * drive-strength exists only on the PIO5/PIO6/PIO7 pads, so groups on PIO0..PIO4
 * leave it out rather than carry a no-op.
 */

#include <nxp/imxrt/imxrt266x/pinctrl/mimxrt2663cvvaa-pinctrl.dtsi>

&pinctrl {
	/* Debug console: LPUART0 on PIO3_30 (TXD) / PIO3_31 (RXD). */
	pinmux_lpuart0: pinmux_lpuart0 {
		group0 {
			pinmux = <&main__iomuxc_pio3_30_hsp_lpuart0_txd>,
				 <&main__iomuxc_pio3_31_hsp_lpuart0_rxd>;
			slew-rate = "high";
			input-enable;
		};
	};

	/* LPI2C0 on PIO2_12 (SDA) / PIO2_13 (SCL): PCAL6524 + PCA9555 expanders. */
	pinmux_lpi2c0: pinmux_lpi2c0 {
		group0 {
			pinmux = <&main__iomuxc_pio2_12_hsp_lpi2c0_sda>,
				 <&main__iomuxc_pio2_13_hsp_lpi2c0_scl>;
			input-enable;
			drive-open-drain;
		};
	};

	/* DCIF DPI (24-bit data + DE/PIXEL_CLK/HSYNC/VSYNC). */
	pinmux_dcif: pinmux_dcif {
		group0 {
			pinmux = <&main__iomuxc_pio3_0_media_dcif_data00>,
				 <&main__iomuxc_pio3_1_media_dcif_data01>,
				 <&main__iomuxc_pio3_2_media_dcif_data02>,
				 <&main__iomuxc_pio3_3_media_dcif_data03>,
				 <&main__iomuxc_pio3_4_media_dcif_data04>,
				 <&main__iomuxc_pio3_5_media_dcif_data05>,
				 <&main__iomuxc_pio3_6_media_dcif_data06>,
				 <&main__iomuxc_pio3_7_media_dcif_data07>,
				 <&main__iomuxc_pio3_8_media_dcif_data08>,
				 <&main__iomuxc_pio3_9_media_dcif_data09>,
				 <&main__iomuxc_pio3_10_media_dcif_data10>,
				 <&main__iomuxc_pio3_11_media_dcif_data11>,
				 <&main__iomuxc_pio3_12_media_dcif_data12>,
				 <&main__iomuxc_pio3_13_media_dcif_data13>,
				 <&main__iomuxc_pio3_14_media_dcif_data14>,
				 <&main__iomuxc_pio3_15_media_dcif_data15>,
				 <&main__iomuxc_pio3_16_media_dcif_data16>,
				 <&main__iomuxc_pio3_17_media_dcif_data17>,
				 <&main__iomuxc_pio3_18_media_dcif_data18>,
				 <&main__iomuxc_pio3_19_media_dcif_data19>,
				 <&main__iomuxc_pio3_20_media_dcif_data20>,
				 <&main__iomuxc_pio3_21_media_dcif_data21>,
				 <&main__iomuxc_pio3_22_media_dcif_data22>,
				 <&main__iomuxc_pio3_23_media_dcif_data23>,
				 <&main__iomuxc_pio3_24_media_dcif_de>,
				 <&main__iomuxc_pio3_25_media_dcif_pixel_clk>,
				 <&main__iomuxc_pio3_26_media_dcif_hsync>,
				 <&main__iomuxc_pio3_27_media_dcif_vsync>;
			slew-rate = "high";
		};
	};
};
