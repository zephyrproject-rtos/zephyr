# The 512-byte board default is insufficient for ztest's final UART
# summary and post-test processing, which run in the main thread.
# Keep sufficient headroom on this 32 KiB SRAM device.
configdefault MAIN_STACK_SIZE
	default 1024

configdefault ISR_STACK_SIZE
	default 768

configdefault SYS_CLOCK_HW_CYCLES_PER_SEC
	default $(dt_node_int_prop_int,/cpus/cpu@0,clock-frequency)
