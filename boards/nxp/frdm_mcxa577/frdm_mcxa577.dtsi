/*/dts-v1/;*/

#include "frdm_mcxa577-pinctrl.dtsi"
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/wuc/wuc_nxp_wuu.h>

/ {
	aliases {
		led0 = &red_led;
		led1 = &green_led;
		led2 = &blue_led;
		sw0 = &user_button_2;
		sw1 = &user_button_3;
		wakeup-button = &user_button_2;
		watchdog0 = &wwdt0;
		flash-controller = &fmu;
		die-temp0 = &temp0;
		rtc = &rtc;
		ambient-temp0 = &p3t1755;
	};

	leds {
		compatible = "gpio-leds";

		red_led: led_0 {
			gpios = <&gpio2 14 GPIO_ACTIVE_LOW>;
			label = "Red LED";
		};

		green_led: led_1 {
			gpios = <&gpio2 22 GPIO_ACTIVE_LOW>;
			label = "Green LED";
		};

		blue_led: led_2 {
			gpios = <&gpio2 23 GPIO_ACTIVE_LOW>;
			label = "Blue LED";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button_2: button_2 {
			label = "User SW2";
			gpios = <&gpio3 17 GPIO_ACTIVE_LOW>;
			/* P3_17 reaches the core as WUU external pin 26. */
			wakeup-ctrls = <&wuu NXP_WUU_PIN_26_FALLING_INT>;
			zephyr,code = <INPUT_KEY_0>;
		};

		user_button_3: button_3 {
			label = "User SW3";
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	/*
	 * This node describes the GPIO pins of the LCD-PAR-S035 panel 8080 interface.
	 */
	nxp_lcd_8080_connector: lcd-8080-connector {
		compatible = "nxp,lcd-8080";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <9 0 &gpio2 8 0>,	/* Pin 9, LCD touch INT */
			   <10 0 &gpio2 4 0>,	/* Pin 10, LCD backlight control */
			   <11 0 &gpio2 30 0>;	/* Pin 11, LCD and touch reset */
	};

	arduino_header: arduino-connector {
		compatible = "arduino-header-r3";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <ARDUINO_HEADER_R3_A0 0 &gpio1 14 0>,
			   <ARDUINO_HEADER_R3_A1 0 &gpio0 6 0>,
			   <ARDUINO_HEADER_R3_A2 0 &gpio1 15 0>,
			   <ARDUINO_HEADER_R3_A3 0 &gpio2 16 0>,
			   <ARDUINO_HEADER_R3_A4 0 &gpio0 19 0>,
			   <ARDUINO_HEADER_R3_A5 0 &gpio5 2 0>,
			   <ARDUINO_HEADER_R3_D0 0 &gpio2 11 0>,
			   <ARDUINO_HEADER_R3_D1 0 &gpio2 10 0>,
			   <ARDUINO_HEADER_R3_D2 0 &gpio1 14 0>,
			   <ARDUINO_HEADER_R3_D3 0 &gpio2 14 0>,
			   <ARDUINO_HEADER_R3_D4 0 &gpio1 15 0>,
			   <ARDUINO_HEADER_R3_D5 0 &gpio2 22 0>,
			   <ARDUINO_HEADER_R3_D6 0 &gpio2 23 0>,
			   <ARDUINO_HEADER_R3_D7 0 &gpio5 9 0>,
			   <ARDUINO_HEADER_R3_D8 0 &gpio2 29 0>,
			   <ARDUINO_HEADER_R3_D9 0 &gpio0 27 0>,
			   <ARDUINO_HEADER_R3_D10 0 &gpio2 17 0>,
			   <ARDUINO_HEADER_R3_D11 0 &gpio2 13 0>,
			   <ARDUINO_HEADER_R3_D12 0 &gpio2 15 0>,
			   <ARDUINO_HEADER_R3_D13 0 &gpio2 12 0>;
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(200)>;
};

&porta {
	status = "okay";
};

&portb {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&waketimer0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

&gpio5 {
	status = "okay";
};

&lpuart1 {
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_lpuart1>;
	pinctrl-names = "default";
	status = "okay";
};

&lpuart2 {
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_lpuart2>;
	pinctrl-names = "default";
	status = "okay";
};

&lpadc0 {
	pinctrl-0 = <&pinmux_lpadc0>;
	pinctrl-names = "default";
	status = "okay";
};

&lpspi2 {
	pinctrl-0 = <&pinmux_lpspi2>;
	pinctrl-names = "default";
	status = "okay";
};

&lpi2c0 {
	pinctrl-0 = <&pinmux_lpi2c0>;
	pinctrl-names = "default";
	status = "okay";
};

&lpi2c3 {
	pinctrl-0 = <&pinmux_lpi2c3>;
	pinctrl-names = "default";
	status = "okay";
};

&ctimer0 {
	status = "okay";
};

&lptmr0 {
	status = "okay";
};

&edma0 {
	status = "okay";
};

&wwdt0 {
	status = "okay";
};

&fmu {
	status = "okay";
};

&flash {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			reg = <0x00000000 DT_SIZE_K(128)>;
			label = "mcuboot";
			read-only;
		};

		slot0_partition: partition@20000 {
			reg = <0x00020000 DT_SIZE_K(896)>;
			label = "image-0";
		};

		slot1_partition: partition@100000 {
			reg = <0x00100000 DT_SIZE_K(896)>;
			label = "image-1";
		};

		storage_partition: partition@1e0000 {
			reg = <0x001e0000 DT_SIZE_K(128)>;
			label = "storage";
		};
	};
};

&flexspi {
	pinctrl-0 = <&pinmux_flexspi>;
	pinctrl-names = "default";
	ahb-prefetch;
	ahb-bufferable;
	ahb-cacheable;
	ahb-read-addr-opt;
	combination-mode;
	rx-clock-source = <1>;
	status = "okay";

	/* WINBOND W25Q64JV flash memory */
	ext_flash_ctrl: flash-controller@0 {
		compatible = "nxp,imx-flexspi-nor";
		reg = <0>;
		ranges = <0x0 0x90000000 DT_SIZE_M(8)>;
		size = <DT_SIZE_M(64)>;
		spi-max-frequency = <DT_FREQ_M(133)>;
		jedec-id = [ef 40 17];
		cs-interval-unit = <1>;
		cs-interval = <2>;
		cs-hold-time = <3>;
		cs-setup-time = <3>;
		data-valid-time = <2>;
		column-space = <0>;

		#address-cells = <1>;
		#size-cells = <1>;
		status = "okay";

		w25q64: flash@0 {
			compatible = "soc-nv-flash";
			reg = <0x0 DT_SIZE_M(8)>;
			ranges;
			erase-block-size = <DT_SIZE_K(4)>;
			write-block-size = <1>;
			#address-cells = <1>;
			#size-cells = <1>;

			partitions {
				#address-cells = <1>;
				#size-cells = <1>;

				ext_boot_partition: partition@0 {
					compatible = "zephyr,mapped-partition";
					reg = <0x00000000 DT_SIZE_K(80)>;
					label = "ext-mcuboot";
				};

				ext_slot0_partition: partition@14000 {
					compatible = "zephyr,mapped-partition";
					reg = <0x00014000 DT_SIZE_M(3)>;
					label = "ext-image-0";
				};

				ext_slot1_partition: partition@314000 {
					compatible = "zephyr,mapped-partition";
					reg = <0x00314000 DT_SIZE_M(3)>;
					label = "ext-image-1";
				};

				ext_storage_partition: partition@614000 {
					compatible = "zephyr,mapped-partition";
					reg = <0x00614000 DT_SIZE_K(1968)>;
					label = "ext-storage";
				};
			};
		};
	};
};

&enet {
	pinctrl-0 = <&pinmux_enet_qos>;
	pinctrl-names = "default";
	phy-connection-type = "rmii";
	phy-handle = <&phy>;
	zephyr,random-mac-address;
	status = "okay";
};

&enet_mdio {
	status = "okay";

	phy: ethernet-phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
		status = "okay";
	};
};

&eim0 {
	status = "okay";
};

&eim0_channel0 {
	status = "okay";
};

&erm0 {
	status = "okay";
};

&crc {
	status = "okay";
};

&inputmux0 {
	status = "okay";
};

&freqme0 {
	status = "okay";
};

&flexcan0 {
	pinctrl-0 = <&pinmux_flexcan0>;
	pinctrl-names = "default";
	status = "okay";
};

&rtc {
	clock-src = <1>;
	status = "okay";
};

&i3c0 {
	pinctrl-0 = <&pinmux_i3c0>;
	pinctrl-names = "default";

	i2c-scl-hz = <DT_FREQ_K(400)>;
	i3c-scl-hz = <DT_FREQ_M(4)>;
	i3c-od-scl-hz = <DT_FREQ_K(1500)>;
	status = "okay";

	p3t1755: p3t1755@4800000236152a0090 {
		compatible = "nxp,p3t1755";
		reg = <0x48 0x0236 0x152a0090>;
		status = "okay";
	};
};

&flexio0 {
	status = "okay";
};

&tsi0 {
	pinctrl-0 = <&pinmux_tsi>;
	pinctrl-names = "default";
	/* On-board electrode E2 is wired to TSI0_CH0 (P5_3). */
	channel-mask = <0x1>;
	input-codes = <INPUT_KEY_A>;
	touch-threshold = <100>;
	release-threshold = <50>;
	scan-period-ms = <50>;
	status = "okay";
};

&smartdma {
	status = "okay";
};

nxp_8080_touch_panel_i2c: &lpi2c3 {};

zephyr_mipi_dbi_parallel: &flexio0_lcd {
	dmas = <&smartdma>;
	dma-names = "smartdma";
	/* Route the FlexIO IRQ to the SmartDMA trigger input through
	 * INPUTMUX0. Connection value is the inputmux_connection_t
	 * enum from fsl_inputmux_connections.h:
	 *   kINPUTMUX_Flexio0irqToSmartdmatrig = 0xa000034
	 */
	mux-states = <&inputmux0 0 0xa000034>;
	shifters-count = <4>;
	timers-count = <1>;
	enwr-pin = <27>;
	rd-pin = <26>;
	data-pin-start = <0>;
	reset-gpios = <&gpio2 30 GPIO_ACTIVE_HIGH>;
	cs-gpios = <&gpio2 24 GPIO_ACTIVE_HIGH>;
	rs-gpios = <&gpio2 31 GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&pinmux_flexio_lcd>;
	pinctrl-names = "default";
};
