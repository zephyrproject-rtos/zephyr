/dts-v1/;

#include <nxp/mcx/mcxl/nxp_mcxl255_cm33.dtsi>
#include "frdm_mcxl255-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash;
		zephyr,flash-controller = &fmu;
		zephyr,console = &lpuart0;
		zephyr,shell-uart = &lpuart0;
		zephyr,crc = &crc;
		zephyr,code-partition = &slot0_partition;
		/*
		 * CM0+ runs from AON SRAM; CM33 copies the image here at boot
		 * and releases the core via AON CGU RST_SUB_BLK.CM0P_RST_REL.
		 */
		zephyr,code-cpu1-partition = &aon_sram;
	};

	aliases {
		led0 = &red_led;
		led1 = &green_led;
		led2 = &blue_led;
		sw0 = &user_button_2;
		sw1 = &user_button_3;
		rtc = &rtc;
		watchdog0 = &wwdt0;
		spi-0 = &lpspi0;
		spi-1 = &lpspi1;
		i2c-0 = &lpi2c0;
		i2c-1 = &lpi2c1;
	};

	leds {
		compatible = "gpio-leds";

		red_led: led_0 {
			gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};

		green_led: led_1 {
			gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};

		blue_led: led_2 {
			gpios = <&gpio2 12 GPIO_ACTIVE_HIGH>;
			label = "Blue LED";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button_2: button_0 {
			label = "User SW2";
			gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};

		user_button_3: button_1 {
			label = "User SW3";
			gpios = <&gpio3 2 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(96)>;
};

&edma0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&lpuart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_lpuart0>;
	pinctrl-names = "default";
};

&lpuart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_lpuart1>;
	pinctrl-names = "default";
};

&aon_lpuart0 {
	status = "disabled";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_aon_lpuart0>;
	pinctrl-names = "default";
};

&lpspi0 {
	status = "okay";
	pinctrl-0 = <&pinmux_lpspi0>;
	pinctrl-names = "default";
};

&lpspi1 {
	status = "okay";
	pinctrl-0 = <&pinmux_lpspi1>;
	pinctrl-names = "default";
};

&inputmux0 {
	status = "okay";
};

&freqme0 {
	status = "okay";
};

&rtc {
	status = "okay";
};

&crc {
	status = "okay";
};

&systick {
	status = "okay";
};

&wwdt0 {
	status = "okay";
};

&lpi2c0 {
	status = "okay";
	pinctrl-0 = <&pinmux_lpi2c0>;
	pinctrl-names = "default";
};

&lpi2c1 {
	status = "okay";
	pinctrl-0 = <&pinmux_lpi2c1>;
	pinctrl-names = "default";
};

&aon_lpi2c0 {
	status = "okay";
	pinctrl-0 = <&pinmux_aon_lpi2c0>;
	pinctrl-names = "default";
};

&mbox_a {
	status = "okay";
};

/*
 * Split CM33 flash (512 KB) into two partitions:
 *   slot0 (0x10000000, 480 KB) - CM33 cpu0 application image
 *   slot1 (0x10078000,  32 KB) - CM0+ cpu1 image storage (LMA slot)
 *
 * The CM33 copies slot1 to AON SRAM at boot via second_core_init()
 * and releases the CM0+ via AON CGU RST_SUB_BLK.CM0P_RST_REL.
 * BUILD_OUTPUT_ADJUST_LMA for the cpu1 build = 0x10078000.
 */
&flash {
	ranges = <0x0 0x10000000 DT_SIZE_K(512)>;
	#address-cells = <1>;
	#size-cells = <1>;

	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		slot0_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00000000 DT_SIZE_K(480)>;
		};

		slot1_partition: partition@78000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00078000 DT_SIZE_K(32)>;
		};
	};
};
