# FRDM_RW612 board

# Copyright 2024-25 NXP
# SPDX-License-Identifier: Apache-2.0

if BOARD_FRDM_RW612

configdefault ETH_DRIVER
	default y if DT_HAS_NXP_ENET_MAC_ENABLED

# The external flash is bound to a power domain, so restore its
# FlexSPI configuration when that domain is turned back on.
configdefault FLASH_MCUX_FLEXSPI_NOR_PM_RESTORE
	default y if PM_DEVICE

if LVGL

# Enable DMA for LCDIC
config MIPI_DBI_NXP_LCDIC_DMA
	default y if MIPI_DBI

# Increase descriptor count. LVGL will allocate a 30KB buffer,
# and the SPI driver sets up RX and TX side. Since LPC DMA has
# 1KB limit per descriptor, we need 60
config DMA_MCUX_LPC_NUMBER_OF_DESCRIPTORS
	default 60

config LV_Z_FLUSH_THREAD
	default y

endif # LVGL

endif # BOARD_FRDM_RW612
