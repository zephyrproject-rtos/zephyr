#include "frdm_mcxw70-pinctrl.dtsi"
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "NXP FRDM-MCXW70 board";

	aliases {
		led0 = &blue_led;
		blue-pwm-led = &blue_pwm_led;
		green-pwm-led = &green_pwm_led;
		red-pwm-led = &red_pwm_led;
		sw0 = &user_button_0;
	};

	chosen {
		zephyr,flash = &flw;
		zephyr,flash-controller = &fmu_0;
		zephyr,code-partition = &code_partition;
		zephyr,sram = &stcm0;
		zephyr,console = &lpuart1;
		zephyr,shell-uart = &lpuart1;
		zephyr,uart-pipe = &lpuart1;
		zephyr,bt-c2h-uart = &lpuart1;
		zephyr,crc = &crc;
	};

	user_led {
		compatible = "gpio-leds";

		red_led: red_led {
			gpios = <&gpio_d 2 GPIO_ACTIVE_HIGH>;
		};

		green_led: green_led {
			gpios = <&gpio_d 3 GPIO_ACTIVE_HIGH>;
		};

		blue_led: blue_led {
			gpios = <&gpio_c 7 GPIO_ACTIVE_HIGH>;
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		red_pwm_led: pwm_led_2 {
			pwms = <&tpm_2 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};

		green_pwm_led: pwm_led_1 {
			pwms = <&tpm_2 1 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};

		blue_pwm_led: pwm_led_0 {
			pwms = <&tpm_0 2 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button_0: button_0 {
			label = "User SW4";
			gpios = <&gpio_a 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
			status = "okay";
		};
	};
};

gpioa: &gpio_a {
	status = "okay";
};

gpiob: &gpio_b {
	status = "okay";
};

gpioc: &gpio_c {
	status = "okay";
};

gpiod: &gpio_d {
	status = "okay";
};

porta: &port_a {};

portb: &port_b {};

portc: &port_c {};

portd: &port_d {};

lpuart0: &lpuart_0 {
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_lpuart0>;
	pinctrl-names = "default";
	status = "okay";
};

lpuart1: &lpuart_1 {
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_lpuart1>;
	pinctrl-names = "default";
	status = "okay";
};

fmu: &fmu_0 {
	status = "okay";
};

tpm0: &tpm_0 {
	pinctrl-0 = <&pinmux_tpm0>;
	pinctrl-names = "default";
	status = "okay";
};

tpm2: &tpm_2 {
	pinctrl-0 = <&pinmux_tpm2>;
	pinctrl-names = "default";
	status = "okay";
};

lptmr0: &lptmr_0 {
	status = "okay";
};

lptmr1: &lptmr_1 {
	status = "okay";
};

tstmr0: &tstmr_0 {
	status = "okay";
};

&ieee802154 {
	counter = <&lptmr1>;
};

&crc {
	status = "okay";
};

lpspi1: &lpspi_1 {
	pinctrl-0 = <&pinmux_lpspi1>;
	pinctrl-names = "default";
	status = "okay";

	/* The LPSPI1_SIN line is held low by the
	 * combined action of U30 and U12C. To prevent
	 * this condition when accessing the NOR flash,
	 * first disable U30 by either shorting JP6 or
	 * removing the jumper on JP23. This releases
	 * the LPSPI1_SIN signal and allows normal flash
	 * operation.
	 */
	mx25r6435fm2il0: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		jedec-id = [c2 28 17];
		/* only wp-gpio on default board configuration,
		 * there is a reset gpio line but the line is
		 * DNP by default on the board (R83 on schematic)
		 */
		wp-gpios = <&gpiob 5 GPIO_ACTIVE_LOW>;
		size = <DT_SIZE_M(64)>;
		has-dpd;
		dpd-wakeup-sequence = <30000 20 35000>;
		t-enter-dpd = <10000>;
		/* 8 MHz for low power mode */
		spi-max-frequency = <DT_FREQ_M(8)>;
		spi-cs-setup-delay-ns = <5>;
		spi-cs-hold-delay-ns = <5>;
		spi-interframe-delay-ns = <125>;
		/* this is the default (reset) mode for this flash */
		mxicy,mx25r-power-mode = "low-power";
	};
};
