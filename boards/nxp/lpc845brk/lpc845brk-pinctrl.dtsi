#include <zephyr/dt-bindings/pinctrl/lpc84x-pinctrl.h>

&swm {
	status = "okay";

	/*
	 * GPIO pins do not require Switch Matrix (SWM) movable function multiplexing,
	 * as GPIO is the default pin assignment. Hence, the pinmux group is intentionally
	 * empty to satisfy pinctrl_apply_state().
	 */

	gpio0_default: gpio0_default {
		group0 {
			pinmux = <>;
		};
	};

	gpio0_sleep: gpio0_sleep {
		group0 {
			pinmux = <>;
		};
	};

	gpio1_default: gpio1_default {
		group0 {
			pinmux = <>;
		};
	};

	gpio1_sleep: gpio1_sleep {
		group0 {
			pinmux = <>;
		};
	};

	uart0_default: uart0_default {
		group0 {
			pinmux = <LPC84X_PINMUX_M(LPC84X_SWM_USART0_TXD, P0_25)>,
				 <LPC84X_PINMUX_M(LPC84X_SWM_USART0_RXD, P0_24)>;
		};
	};
};
