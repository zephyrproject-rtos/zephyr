if SPI

configdefault GPIO_INIT_PRIORITY
	default 10

configdefault SPI_INIT_PRIORITY
	default 10

if WDT_NXP_FS26

configdefault WDT_NXP_FS26_INIT_PRIORITY
	default 10

endif # WDT_NXP_FS26

endif # SPI

configdefault NET_L2_ETHERNET
	default y if !NET_LOOPBACK && !NET_TEST
