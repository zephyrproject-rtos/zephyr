/dts-v1/;

#include <ti/mspm0/g/mspm0g3507.dtsi>
#include <ti/mspm0/g/mspm0g1x0x_g3x0x-pinctrl.dtsi>
#include <zephyr/dt-bindings/clock/mspm0_clock.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "TI LP_MSPM0G3507/MSPM0G3507";
	compatible = "ti,mspm0g3507";

	aliases {
		led0 = &led0;
		pwm-led0 = &pwm_led0;
		watchdog0 = &wdt0;
		watchdog1 = &wdt1;
		sw0 = &btn0;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,code-partition = &slot0_partition;
		zephyr,canbus = &canfd0;
		zephyr,entropy = &trng;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpiob 22 GPIO_ACTIVE_HIGH>;
			label = "Blue LED";
		};
	};

	pwm_leds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led0 {
			pwms = <&pwma0 0 PWM_MSEC(100) PWM_POLARITY_NORMAL>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		/* S3 onboard switch */
		btn0: btn_0 {
			gpios = <&gpiob 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "S3 User Switch";
			zephyr,code = <INPUT_KEY_0>;
		};

		/* S2 onboard switch */
		btn1: btn_1 {
			gpios = <&gpioa 18 GPIO_ACTIVE_HIGH>;
			label = "S2 User Switch";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	zephyr,user {
		dac = <&dac0>;
		dac-channel-id = <0>;
		dac-resolution = <12>;
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(80)>;
};

&ulpclk {
	clk-div = <2>;
};

&mclk {
	clock-frequency = <DT_FREQ_M(80)>;
	clocks = <&hsclk>;
};

&hsclk {
	clocks = <&syspll>;
	status = "okay";
};

&mfpclk {
	status = "okay";
};

&canclk {
	clocks = <&syspll>;
	status = "okay";
};

&flash0 {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x8000>;
		};

		slot0_partition: partition@8000 {
			label = "image-0";
			reg = <0x00008000 0xc000>;
		};

		slot1_partition: partition@14000 {
			label = "image-1";
			reg = <0x00014000 0xc000>;
		};
	};
};

&pinctrl {
	status = "okay";
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&uart0 {
	status = "okay";

	current-speed = <115200>;
	pinctrl-0 = <&uart0_tx_pa10 &uart0_rx_pa11>;
	pinctrl-names = "default";
};

/*
 * Slow TIMA0 to 39,062 Hz so LED PWM periods (20 ms - 1.68 s)
 * fit in the 16-bit counter: 80 MHz / (div=8 * (prescaler+1)=256)
 */
&tima0 {
	ti,clk-div = <8>;
	ti,clk-prescaler = <255>;
};

&pwma0 {
	status = "okay";

	pinctrl-0 = <&tima0_ccp0_pa0>;
	pinctrl-names = "default";
	ti,cc-index = <0>;
	ti,pwm-mode = "EDGE_ALIGN";
	ti,period = <3906>; /* ~100 ms at 39,062 Hz */
};

&canfd0 {
	status = "okay";
	pinctrl-0 = <&canfd0_cantx_pa12 &canfd0_canrx_pa13>;
	pinctrl-names = "default";
};

&dac0 {
	status = "okay";
	fifo-enable;
	sample-rate-hz = <1000>;
};

&vref0 {
	status = "okay";
	pinctrl-0 = <&analog_pa23>;
	pinctrl-names = "default";
};

&trng {
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pa17 &i2c1_sda_pa16>;
	pinctrl-names = "default";
	status = "disabled";
};

&adc0 {
	dmas = <&dma 6 23>;
};
