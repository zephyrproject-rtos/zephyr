CONFIG_SHARED_MULTI_HEAP=y

CONFIG_GPIO=y
CONFIG_GPIO_GET_CONFIG=y
CONFIG_GPIO_GET_DIRECTION=y
CONFIG_GPIO_HOGS=y
CONFIG_GPIO_SHELL=y
CONFIG_GPIO_SHELL_INFO_CMD=y
CONFIG_GPIO_SHELL_TOGGLE_CMD=y
CONFIG_GPIO_SHELL_BLINK_CMD=y

CONFIG_SERIAL=y

CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SHELL=y
CONFIG_SHELL_STACK_SIZE=4096
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_SHELL_BACKEND_SERIAL_INTERRUPT_DRIVEN=y
CONFIG_SHELL_BACKEND_SERIAL_API_INTERRUPT_DRIVEN=y

CONFIG_FLASH=y
CONFIG_SOC_FLASH_CC35XX=y
CONFIG_FLASH_SHELL=y

# Required for BLE operation. Explicitly disable this config option here, as
# some BLE samples enable it by default.
CONFIG_BT_HCI_ACL_FLOW_CONTROL=n
