#define BTN_GPIO_FLAGS (GPIO_ACTIVE_LOW | GPIO_PULL_UP)

/ {
	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,bt-hci = &ti_bt_hci;
		zephyr,bt-c2h-uart = &uart0;
		zephyr,code-partition = &slot0_partition;
		zephyr,uart-mcumgr = &uart0;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		sw0 = &btn0;
		sw1 = &btn1;
		rtc = &rtc;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};

		led1: led_1 {
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};
	};

	keys {
		compatible = "gpio-keys";

		btn0: btn_0 {
			gpios = <&gpio0 20 BTN_GPIO_FLAGS>;
			label = "Button 1";
			zephyr,code = <INPUT_KEY_0>;
		};

		btn1: btn_1 {
			gpios = <&gpio0 0 BTN_GPIO_FLAGS>;
			label = "Button 2";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	lfxosc: lf_xosc {
		compatible = "ti,cc27xx-lf-xosc";
	};

	ti_bt_hci: ti_bt_hci {
		compatible = "ti,bt-hci";
		status = "okay";
	};
};

/delete-node/ &slot0_partition;

&flash0 {
	partitions {
		/* 40 KiB (0xa000) for MCUboot */
		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x0000a000>;
		};

		/* 446464 Bytes (0x6d000) per slot for application */
		slot0_partition: partition@a000 {
			label = "image-0";
			reg = <0x0000a000 0x0006d000>;
		};

		slot1_partition: partition@77000 {
			label = "image-1";
			reg = <0x00077000 0x0006d000>;
		};
	};
};

&cpu0 {
	clock-frequency = <96000000>;
};

&gpio0 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_rx_default &uart0_tx_default>;
	pinctrl-names = "default";
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_rx_default &uart1_tx_default>;
	pinctrl-names = "default";
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_scl_default
		     &i2c0_sda_default>;
	clock-frequency = <100000>;
	pinctrl-names = "default";
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_sck_default
		     &spi0_mosi_default
		     &spi0_miso_default
		     &spi0_cs_default>;
	pinctrl-1 = <&spi0_sck_sleep
		     &spi0_mosi_sleep
		     &spi0_miso_sleep
		     &spi0_cs_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;

	mx25r80: mx25r8035f@0 {
		status = "okay";
		compatible = "jedec,spi-nor";
		reg = <0>;
		zephyr,pm-device-runtime-auto;
		spi-max-frequency = <12000000>;
		size = <0x800000>;
		jedec-id = [c2 28 14];
		has-dpd;
		dpd-wakeup-sequence = <30000 20 35000>;
		t-enter-dpd = <10000>;
		sfdp-bfp = [e5 20 f1 ff ff ff 7f 00 44 eb 08 6b 08 3b 04 bb
			    ee ff ff ff ff ff 00 ff ff ff 00 ff 0c 20 0f 52
			    10 d8 00 ff 23 72 f5 00 82 ed 04 b7 44 83 38 44
			    30 b0 30 b0 f7 c4 d5 5c 00 be 29 ff f0 d0 ff ff];
	};
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_sck_default
		     &spi1_mosi_default
		     &spi1_miso_default
		     &spi1_cs_default>;
	pinctrl-1 = <&spi1_sck_sleep
		     &spi1_mosi_sleep
		     &spi1_miso_sleep
		     &spi1_cs_sleep>;
	pinctrl-names = "default", "sleep";
};

&dma {
	status = "okay";
};

&aes {
	status = "okay";
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_ch3
		     &adc0_ch4
		     &adc0_ch5
		     &adc0_ch6
		     &adc0_ch7
		     &adc0_ch8>;
	pinctrl-names = "default";
};

&wdt0 {
	status = "okay";
};

&rtc {
	status = "okay";
};

&rng {
	status = "okay";
};
