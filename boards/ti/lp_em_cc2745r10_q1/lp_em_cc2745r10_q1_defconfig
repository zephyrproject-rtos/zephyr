# Ensure hex-file is not filled between lower and upper flash.
# If not, it will grow to 3.5 GB.
CONFIG_BUILD_NO_GAP_FILL=y
CONFIG_BUILD_OUTPUT_HEX=y

CONFIG_GPIO=y
CONFIG_PINCTRL=y
CONFIG_SERIAL=y

CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

CONFIG_DYNAMIC_THREAD_POOL_SIZE=2
CONFIG_DYNAMIC_THREAD_STACK_SIZE=1500

# Entropy source for random number generation is disabled by default.
# Applications can enable it in their prj.conf file.
CONFIG_ENTROPY_GENERATOR=n
CONFIG_MBEDTLS=y
CONFIG_CTR_DRBG_CSPRNG_GENERATOR=y
