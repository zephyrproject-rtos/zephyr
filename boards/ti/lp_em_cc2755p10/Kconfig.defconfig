rsource "../lpf3_common/Kconfig.defconfig"

if BOARD_LP_EM_CC2755P10

if BT
config BT_LL_HEAP_SIZE
	hex
	default 0x4E00
endif # BT

if PM
# Power Management requires increased idle task stack size because of
# stack usage introduced by "pm_state_set"
config IDLE_STACK_SIZE
	default 320
endif # PM

# The SPI driver only supports DMA mode
if SPI
config SPI_CC23X0_CC27XX_DMA_DRIVEN
	default y
endif # SPI

endif # BOARD_LP_EM_CC2755P10
