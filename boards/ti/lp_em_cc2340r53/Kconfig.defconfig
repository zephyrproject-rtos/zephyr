if BOARD_LP_EM_CC2340R53

if PM

# Power management requires an increased idle task stack size because of
# the stack usage introduced by "pm_state_set".
config IDLE_STACK_SIZE
	default 320

endif # PM

if SPI

config SPI_CC23X0_DMA_DRIVEN
	default y

endif # SPI

endif # BOARD_LP_EM_CC2340R53
