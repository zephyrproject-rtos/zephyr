config TI_MCUMGR_BT_OTA_DFU
	bool "MCUMgr OTA DFU over Bluetooth"
	select NET_BUF
	select ZCBOR
	select ZEPHYR_ZCBOR_MODULE
	select CRC
	select MCUMGR
	select MCUMGR_TRANSPORT_BT
	select MCUMGR_TRANSPORT_BT_REASSEMBLY
	select IMG_MANAGER
	select MCUMGR_GRP_IMG
	select FLASH
	select FLASH_MAP
	select STREAM_FLASH
	imply MCUMGR_GRP_OS
	imply MCUMGR_GRP_OS_MCUMGR_PARAMS
	imply MCUMGR_GRP_OS_BOOTLOADER_INFO
	depends on BT
	depends on BT_SMP
	depends on BT_PERIPHERAL
	depends on BOOTLOADER_MCUBOOT
	default n

config BT_LL_HEAP_SIZE
	hex "TI BLE LL Heap Size"
	depends on BT
	default 0x4000
