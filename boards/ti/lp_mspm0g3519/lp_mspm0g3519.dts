/dts-v1/;

#include <arm/ti/mspm0/g/mspm0g3519.dtsi>
#include <ti/mspm0/g/mspm0gx51x-pinctrl.dtsi>
#include <zephyr/dt-bindings/clock/mspm0_clock.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "TI LP_MSPM0G3519";
	compatible = "ti,mspm0g3519";

	aliases {
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		sw0 = &btn0;
		sw1 = &btn1;
		watchdog0 = &wdt0;
		watchdog1 = &wdt1;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,canbus = &canfd0;
		zephyr,entropy = &trng;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpiob 22 GPIO_ACTIVE_HIGH>;
			label = "Blue LED";
		};

		led1: led_1 {
			gpios = <&gpiob 26 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};

		led2: led_2 {
			gpios = <&gpiob 27 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};
	};

	keys {
		compatible = "gpio-keys";

		btn0: btn_0 {
			gpios = <&gpioa 18 GPIO_ACTIVE_HIGH>;
			label = "Switch 1";
			zephyr,code = <INPUT_KEY_0>;
		};

		btn1: btn_1 {
			gpios = <&gpiob 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Switch 2";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	zephyr,user {
		dac = <&dac0>;
		dac-channel-id = <0>;
		dac-resolution = <12>;
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(80)>;
};

&ulpclk {
	clk-div = <2>;
};

&mclk {
	clock-frequency = <DT_FREQ_M(80)>;
	clocks = <&hsclk>;
};

&hsclk {
	clocks = <&syspll>;
	status = "okay";
};

&mfpclk {
	status = "okay";
};

&canclk {
	clocks = <&syspll>;
	status = "okay";
};

&hfxt {
	clock-frequency = <DT_FREQ_M(48)>;
	ti,xtal-startup-delay-us = <500>;
};

&lfxt {
	clock-frequency = <32768>;
	ti,xtal-startup-delay-us = <1000000>;
};

&pinctrl {
	status = "okay";
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&uart0 {
	status = "okay";

	current-speed = <115200>;
	pinctrl-0 = <&uart0_tx_pa10 &uart0_rx_pa11>;
	pinctrl-names = "default";
};

&canfd0 {
	status = "okay";
	pinctrl-0 = <&canfd0_cantx_pa12 &canfd0_canrx_pa13>;
	pinctrl-names = "default";
};

&dac0 {
	status = "okay";
	fifo-enable;
	sample-rate-hz = <1000>;
};

&vref0 {
	status = "okay";
	pinctrl-0 = <&analog_pa23>;
	pinctrl-names = "default";
};

&trng {
	status = "okay";
};

&tima0 {
	ti,clk-div = <8>;
	ti,clk-prescaler = <255>;
};

&pwma0 {
	status = "okay";

	pinctrl-0 = <&tima0_ccp0_pa0>;
	pinctrl-names = "default";
	ti,cc-index = <0>;
	ti,pwm-mode = "EDGE_ALIGN";
	ti,period = <3906>; /* ~100 ms at 39,062 Hz */
};
