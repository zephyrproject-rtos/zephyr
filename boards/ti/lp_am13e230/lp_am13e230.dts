/dts-v1/;

#include <ti/am13/am13e23019.dtsi>
#include <ti/am13/am13e23019-pinctrl.dtsi>
#include <zephyr/dt-bindings/mux/ti_am13e230_xbar_in.h>
#include <zephyr/dt-bindings/mux/ti_am13e230_xbar_out.h>

/ {
	model = "TI AM13E230X Launchpad";
	compatible = "ti,am13e23019";

	chosen {
		zephyr,sram = &sram0_1_2;
		zephyr,flash = &flash0;
		zephyr,console = &unicomm4_uart;
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(200)>;
};

&mclk {
	clocks = <&hsclk>;
};

&hsclk {
	clocks = <&syspll>;
	status = "okay";
};

&syspll {
	status = "okay";
};

&hfxt {
	clock-frequency = <DT_FREQ_M(48)>;
	ti,xtal-startup-delay-us = <500>;
};

&unicomm4 {
	status = "okay";
};

&unicomm4_uart {
	status = "okay";
	current-speed = <115200>;

	pinctrl-0 = <&uc4_tx_sda_pico_pa0 &uc4_rx_scl_sclk_pa1>;
	pinctrl-names = "default";
};

&gpio_pb4 {
	input-enable;
	bias-pull-down;
};

&outputxbar8_pb3 {
	bias-pull-down;
};

&xbar1 {
	status = "okay";
};

&xbar2 {
	status = "okay";
};

&ecap0 {
	status = "okay";
	interrupts = <29 0>;

	pinctrl-0 = <&outputxbar8_pb3>;
	pinctrl-names = "default";

	/* ECAP0 -> OUTPUTXBAR8 (idx 7) -> G1SEL bit 4 -> PB3 */
	mux-states = <&xbar2 AM13E230_XBAR_OUT_CTRL(7, 1, 4) 1>;
	mux-state-names = "output";
};

&ecap1 {
	status = "okay";
	interrupts = <30 0>;

	pinctrl-0 = <&gpio_pb4>;
	pinctrl-names = "default";

	/* PB4 (GPIO36) -> INPUTXBAR1 -> ECAP1 ECCTL0.INPUTSEL (raw=1) */
	mux-states = <&xbar1 0 AM13E230_XBAR_IN_STATE(36, 1)>;
	mux-state-names = "input";
};
