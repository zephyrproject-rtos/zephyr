/dts-v1/;

#include <ti/am13/am13e23019.dtsi>
#include <ti/am13/am13e23019-pinctrl.dtsi>

/ {
	model = "TI AM13E230X Launchpad";
	compatible = "ti,am13e23019";

	aliases {
		watchdog0 = &wdt0;
	};

	chosen {
		zephyr,sram = &sram0_1_2;
		zephyr,flash = &flash0;
		zephyr,console = &unicomm4_uart;
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(200)>;
};

&mclk {
	clocks = <&hsclk>;
};

&hsclk {
	clocks = <&syspll>;
	status = "okay";
};

&syspll {
	status = "okay";
};

&hfxt {
	clock-frequency = <DT_FREQ_M(48)>;
	ti,xtal-startup-delay-us = <500>;
};

&unicomm4 {
	status = "okay";
};

&unicomm4_uart {
	status = "okay";
	current-speed = <115200>;

	pinctrl-0 = <&uc4_tx_sda_pico_pa0 &uc4_rx_scl_sclk_pa1>;
	pinctrl-names = "default";
};

&wdt0 {
	status = "okay";
};
