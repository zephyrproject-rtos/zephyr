/dts-v1/;

#include <ti/mspm33c/mspm33c321a.dtsi>
#include <ti/mspm33/c/mspm33c321a-pinctrl.dtsi>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pinctrl/mspm0-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "TI LP_MSPM33C321A/MSPM33C321A";
	compatible = "ti,lp-mspm33c321a";

	aliases {
		watchdog0 = &wdt0;
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		sw0 = &btn0;
		sw1 = &btn1;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &flash_controller;
		zephyr,canbus = &canfd0;
		zephyr,console = &unicomm12_uart;
		zephyr,shell-uart = &unicomm12_uart;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpioc 26 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};

		led1: led_1 {
			gpios = <&gpioc 27 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};

		led2: led_2 {
			gpios = <&gpioa 2 GPIO_ACTIVE_HIGH>;
			label = "Blue LED";
		};
	};

	buttons {
		compatible = "gpio-keys";

		btn0: btn_0 {
			gpios = <&gpioa 18 GPIO_ACTIVE_HIGH>;
			label = "S1";
			zephyr,code = <INPUT_KEY_0>;
		};

		btn1: btn_1 {
			gpios = <&gpioc 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "S2";
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&flash0 {
	status = "okay";
};

&sram0 {
	status = "okay";
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(160)>;
};

&mclk {
	clocks = <&hsclk>;
};

&hsclk {
	clocks = <&syspll>;
	status = "okay";
};

&syspll {
	status = "okay";
};

&hfxt {
	clock-frequency = <DT_FREQ_M(48)>;
	ti,xtal-startup-delay-us = <500>;
};

&lfxt {
	clock-frequency = <32768>;
	ti,xtal-startup-delay-us = <640000>;
};

&vref0 {
	status = "okay";
	pinctrl-0 = <&analog_pa23>;
	pinctrl-names = "default";
};

&timg8_0 {
	status = "okay";

	counterg8_0: counterg8_0 {
		status = "okay";
	};
};

&tima0_0 {
	ti,clk-div = <8>;
};

&pwma0_0 {
	status = "okay";
	pinctrl-0 = <&tima0_0_ccp0_pa8>;
	pinctrl-names = "default";
	ti,cc-index = <0>;
	ti,pwm-mode = "EDGE_ALIGN";
	ti,period = <7812>; /* ~100 ms at 78,125 Hz */
};

&canclk {
	clocks = <&syspll 0>;
	status = "okay";
};

&canfd0 {
	status = "okay";
	pinctrl-0 = <&canfd0_cantx_pa12 &canfd0_canrx_pa13>;
	pinctrl-names = "default";
};

&wdt0 {
	status = "okay";
};

&unicomm12 {
	status = "okay";
};

&unicomm12_uart {
	status = "okay";
	current-speed = <115200>;

	pinctrl-0 = <&uc12_tx_pa10 &uc12_rx_pa11>;
	pinctrl-names = "default";
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};
