/dts-v1/;
#include <ti/cc1354p10.dtsi>
#include "lp_em_cc1354p10_1-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "TI LP-EM-CC1354P10_1";
	compatible = "ti,lp-em-cc1354p10-1";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,code-partition = &slot0_partition;
		zephyr,flash-controller = &flash_controller;
	};
};

&flash0 {
	partitions {
		compatible = "zephyr,mapped-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x0000a000>;
		};

		slot0_partition: partition@a000 {
			label = "image-0";
			reg = <0x0000a000 0x00076000>;
		};

		slot1_partition: partition@80000 {
			label = "image-1";
			reg = <0x00080000 0x00076000>;
		};

		storage_partition: partition@f6000 {
			label = "storage";
			reg = <0x000f6000 0x0000a000>;
		};
	};
};

&cpu0 {
	clock-frequency = <48000000>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_rx_default &uart0_tx_default>;
	pinctrl-names = "default";
};

&systick {
	status = "okay";
};

&rtc {
	status = "okay";
};
