/dts-v1/;

#include <ti/am62l3_a53.dtsi>
#include "am62l_evm_am62l3_a53-pinctrl.dtsi"
#include <zephyr/dt-bindings/mipi_dsi/mipi_dsi.h>

/ {
	model = "TI AM62L EVALUATION MODULE (EVM)";
	compatible = "ti,am62l_evm";

	chosen {
		zephyr,console = &main_uart0;
		zephyr,shell-uart = &main_uart0;
		zephyr,sram = &ddr0;
		zephyr,flash-controller = &main_ospi0;
		zephyr,flash = &flash0_memory;
		zephyr,display = &dss;
		zephyr,touch = &gt911;
	};

	aliases {
		adc0 = &main_adc0;
		led0 = &ld9;
		watchdog0 = &main_rti0;
		rtc = &counter_rtc0;
		sdhc0 = &main_sdhci0;
		sdhc1 = &main_sdhci1;
		sdhc2 = &main_sdhci2;
	};

	leds: leds {
		compatible = "gpio-leds";

		ld9: led_0 {
			gpios = <&main_gpio0_3 27 GPIO_ACTIVE_HIGH>;
		};
	};

	cpus {
		cpu@0 {
			status = "okay";
		};

		cpu@1 {
			status = "okay";
		};
	};

	ddr0: memory@82000000 {
		reg = <0x82000000 (DT_SIZE_G(2) - DT_SIZE_M(32))>;
	};
};

&main_uart0 {
	current-speed = <115200>;
	pinctrl-0 = <&uart0_rx_default>,
		    <&uart0_tx_default>;
	pinctrl-names = "default";
	status = "okay";
};

&main_adc0 {
	ti,fifo = <0>;
	pinctrl-0 = <&adc0_ext_trigger0>,
		    <&adc0_ext_trigger1>;
	pinctrl-names = "default";
	status = "okay";

	channel@0 {
		reg = <0>;
		ti,open-delay = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
		zephyr,vref-mv = <1800>;
	};

	channel@1 {
		reg = <1>;
		ti,open-delay = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
		zephyr,vref-mv = <1800>;
	};

	channel@2 {
		reg = <2>;
		ti,open-delay = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
		zephyr,vref-mv = <1800>;
	};

	channel@3 {
		reg = <3>;
		ti,open-delay = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
		zephyr,vref-mv = <1800>;
	};
};

&main_gpio0_3 {
	pinctrl-0 = <&main_gpio0_3_led>;
	pinctrl-names = "default";
	status = "okay";
};

&main_i2c0 {
	pinctrl-0 = <&main_i2c0_scl &main_i2c0_sda>;
	pinctrl-names = "default";
	status = "okay";

	eeprom0: eeprom@51 {
		compatible = "atmel,at24";
		reg = <0x51>;
		address-width = <16>;
		pagesize = <128>;
		size = <65536>;
		timeout = <5>;
	};

	display_mcu: display_mcu@45 {
		compatible = "raspberrypi,touchscreen-panel-regulator-v2";
		reg = <0x45>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "disabled";
	};

	gt911: gt911@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		alt-addr = <0x14>;
		reset-gpios = <&display_mcu 1 GPIO_ACTIVE_LOW>;
		screen-width = <720>;
		screen-height = <1280>;
		status = "disabled";
	};
};

&main_i2c1 {
	pinctrl-0 = <&main_i2c1_scl &main_i2c1_sda>;
	pinctrl-names = "default";
	status = "okay";

	gpio_expander: tca6424a@22 {
		compatible = "ti,tca6424a";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <24>;
	};

	sii9022a: sii9022a@3b {
		compatible = "sil,sii9022a";
		reg = <0x3b>;
		/* HDMI RGB output; pixel clock latched on falling edge */
		output-format = <0>;
		clk-falling;
		display-controller = <&dss>;
		status = "disabled";
	};
};

&main_rti0 {
	status = "okay";
};

&wkup_rtc0 {
	status = "okay";
};

&counter_rtc0 {
	status = "okay";
};

/* eMMC */
&main_sdhci0 {
	pinctrl-0 = <&mmc0_cmd
		     &mmc0_clk
		     &mmc0_dat0
		     &mmc0_dat1
		     &mmc0_dat2
		     &mmc0_dat3
		     &mmc0_dat4
		     &mmc0_dat5
		     &mmc0_dat6
		     &mmc0_dat7>;
	pinctrl-names = "default";
	status = "okay";

	mmc {
		compatible = "zephyr,mmc-disk";
		bus-width = <8>;
		disk-name = "emmc";
	};
};

/* SD */
&main_sdhci1 {
	pinctrl-0 = <&mmc1_cmd
		     &mmc1_clk
		     &mmc1_dat0
		     &mmc1_dat1
		     &mmc1_dat2
		     &mmc1_dat3
		     &mmc1_sdcd>;
	pinctrl-names = "default";
	status = "okay";

	sd {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "sd";
	};
};

/* SDIO */
&main_sdhci2 {
	pinctrl-0 = <&mmc2_cmd
		     &mmc2_clk
		     &mmc2_clklb
		     &mmc2_dat0
		     &mmc2_dat1
		     &mmc2_dat2
		     &mmc2_dat3>;
	pinctrl-names = "default";
	ti,fails-without-test-cd;
	status = "disabled";
};

&main_epwm0 {
	pinctrl-0 = <&main_epwm0_a &main_epwm0_b>;
	pinctrl-names = "default";
	status = "okay";
};

&main_ecap0 {
	pinctrl-0 = <&main_ecap0_in>;
	pinctrl-names = "default";
	status = "okay";
};

&main_ospi0 {
	pinctrl-0 = <&main_ospi0_clk
		     &main_ospi0_d0
		     &main_ospi0_d1
		     &main_ospi0_d2
		     &main_ospi0_d3
		     &main_ospi0_d4
		     &main_ospi0_d5
		     &main_ospi0_d6
		     &main_ospi0_d7
		     &main_ospi0_dqs
		     &main_ospi0_lbclko
		     &main_ospi0_csn0>;
	pinctrl-names = "default";
	status = "okay";

	flash0: flash@0 {
		compatible = "infineon,s28hx512t", "jedec,nor";
		status = "okay";
		reg = <0>;
		jedec-id = [34 5b 1a];
		size = <DT_SIZE_M(512)>; /* 512 Mbits(64 MB) - input in Bits */
		erase-block-size = <DT_SIZE_K(256)>;
		mspi-max-frequency = <DT_FREQ_M(25)>;
		mspi-io-mode = "MSPI_IO_MODE_OCTAL";
		mspi-endian = "MSPI_LITTLE_ENDIAN";
		mspi-data-rate = "MSPI_DATA_RATE_DUAL";
		address-length = "ADDR_4_BYTE";
		command-length = "INSTR_2_BYTE";
		mspi-hardware-ce-num = <0>;
		mspi-cpp-mode = "MSPI_CPP_MODE_0";
		mspi-ce-polarity = "MSPI_CE_ACTIVE_LOW";
		initial-soft-reset;
		t-reset-recovery = <90000>; /* 90us */
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x60000000 DT_SIZE_M(64)>; /* 64 MB - input in Bytes */

		flash0_memory: flash@0 {
			compatible = "soc-nv-flash";
			reg = <0x0 DT_SIZE_M(64)>; /* 64 MB - input in Bytes */
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
		};
	};
};

&main_eqep0 {
	pinctrl-0 = <&eqep0_a &eqep0_b &eqep0_i &eqep0_s>;
	pinctrl-names = "default";
	status = "okay";
};

&wkup_vtm0 {
	ti,max-reset-mc = <120000>;
	ti,max-recovery-mc = <105000>;
	status = "okay";

	sensor0: sensor@0 {
		reg = <0>;
		ti,voltage-domain = <0>;
	};
};

zephyr_udc0: &main_usb0 {
	status = "okay";
	ti,syscon-phy-pll-refclk = <&usb0_phy_ctrl>;
	ti,vbus-divider;
};

&pktdma {
	status = "okay";
};

&cpsw3g {
	status = "okay";
};

&cpsw_port1 {
	phy-handle = <&cpsw_phy1>;
};

&cpsw_port2 {
	phy-handle = <&cpsw_phy2>;
};

&cpsw_mdio {
	status = "okay";

	cpsw_phy1: ethernet-phy@0 {
		compatible = "ti,dp83867";
		reg = <0>;
		ti,interface-type = "rgmii-id";
		ti,rx-internal-delay = <7>; /* 2 ns delay */
		ti,tx-internal-delay = <0>; /* Delay added by MAC */
	};

	cpsw_phy2: ethernet-phy@1 {
		compatible = "ti,dp83867";
		reg = <1>;
		ti,interface-type = "rgmii-id";
		ti,rx-internal-delay = <7>; /* 2 ns delay */
		ti,tx-internal-delay = <0>; /* Delay added by MAC */
	};
};

&dss {
	data-width = <24>;
	height = <1280>;
	width = <720>;

	display-timings {
		compatible = "zephyr,panel-timing";
		clock-frequency = <83330000>;
		hfront-porch = <239>;
		hback-porch = <50>;
		hsync-len = <33>;
		vfront-porch = <20>;
		vback-porch = <30>;
		vsync-len = <2>;
		hsync-active = <0>;
		vsync-active = <0>;
		de-active = <1>;
		pixelclk-active = <0>;
	};

	status = "okay";
};

&dsi0 {
	status = "okay";
	data-lanes = <2>;

	rpi_td2: panel@0 {
		compatible = "ilitek,ili9881c";
		reg = <0>;
		data-lanes = <2>;
		pixel-format = <MIPI_DSI_PIXFMT_RGB888>;
		reset-gpios = <&display_mcu 0 GPIO_ACTIVE_HIGH>;
		width = <720>;
		height = <1280>;
		status = "disabled";
	};
};

&main_spi0 {
	pinctrl-0 = <&main_spi0_clk &main_spi0_cs0 &main_spi0_d0 &main_spi0_d1>;
	pinctrl-names = "default";
	status = "okay";
};
