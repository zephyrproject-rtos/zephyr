# UART console via Ameba LogUART driver
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# 100 Hz is too coarse for the timer precision tests. 10 kHz exceeds their
# 100 us latency allowance due to user-mode call overhead.
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
