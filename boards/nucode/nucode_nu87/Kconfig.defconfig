if BOARD_NUCODE_NU87

config HW_STACK_PROTECTION
	default ARCH_HAS_STACK_PROTECTION

if !USE_DT_CODE_PARTITION

DT_CHOSEN_Z_CODE_PARTITION := zephyr,code-partition

# The ROM bootloader remaps the application to the flash window base. Keep the
# link offset at zero and derive the linker limit from the storage partition.
# The final package also includes the NP image and headers and needs its own
# size check.
config FLASH_LOAD_SIZE
	default $(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_CODE_PARTITION))

endif # !USE_DT_CODE_PARTITION

endif # BOARD_NUCODE_NU87
