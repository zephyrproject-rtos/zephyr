CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Enable LogUart
CONFIG_SERIAL=y

CONFIG_GPIO=y

# The ROM bootloader maps slot0_partition to the base of the flash window, so
# the application links at offset 0 rather than at the partition offset. Cap the
# linker region at the partition size. The final package also includes the
# NP image and headers, which must fit within the same partition.
CONFIG_FLASH_LOAD_SIZE=0x1ec000
