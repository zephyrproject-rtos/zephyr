/dts-v1/;

#include <broadcom/bcm2710.dtsi>
#include <broadcom/bcm2711-pinctrl.dtsi>

/ {
	model = "Raspberry Pi Zero 2 W";
	compatible = "raspberrypi,model-zero-2-w", "brcm,bcm2710";

	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,sram = &dram0;
		zephyr,entropy = &rng;
	};

	/*
	 * DRAM window the image is linked into; the base must match the
	 * kernel_address= line in config.txt.
	 */
	dram0: memory@200000 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x200000 DT_SIZE_M(256)>;
	};

	aliases {
		sdhc0 = &sdhost;
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_gpio14>;
	current-speed = <115200>;
	status = "okay";
};

/* Legacy SDHost controller -> external microSD card slot. The slot
 * is a board-level fact (PCB pad, GPIO 48..53 ALT0 routing is fixed),
 * so the enablement and sdmmc-disk child live in the board DTS.
 */
&sdhost {
	pinctrl-names = "default";
	pinctrl-0 = <&sdhost_gpio48>;
	status = "okay";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
	};
};
