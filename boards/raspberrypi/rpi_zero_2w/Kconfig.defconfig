if BOARD_RPI_ZERO_2W

config PM_DEVICE
	default y if PM

if PM_DEVICE

config POWER_DOMAIN
	default y

config PM_DEVICE_POWER_DOMAIN
	default y

endif # PM_DEVICE

# The USB core is unpowered until the VideoCore firmware turns on its
# power domain.
config POWER_DOMAIN
	default y if UDC_DWC2

endif # BOARD_RPI_ZERO_2W
