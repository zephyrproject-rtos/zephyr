# The default 8 MMU translation tables are insufficient once the image
# map and the SoC device regions are accounted for, and userspace builds
# need more for the memory domain tables.
CONFIG_MAX_XLAT_TABLES=28

# Serial / console
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# ARM generic timer frequency is read at runtime.
CONFIG_TIMER_READS_ITS_FREQUENCY_AT_RUNTIME=y
