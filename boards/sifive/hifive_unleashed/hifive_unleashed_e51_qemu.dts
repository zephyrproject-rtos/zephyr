 *
 * HiFive Unleashed as emulated by the sifive_u machine of QEMU.
 */

#include "hifive_unleashed_e51.dts"

/* QEMU has no QSPI1 */
&spi1 {
	status = "disabled";
};

/* The GEM of QEMU does not timestamp frames and its 1588 timer does not run */
&eth0_ptp {
	status = "disabled";
};
