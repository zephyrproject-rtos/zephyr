#include <freq.h>

#include <zephyr/dt-bindings/clock/rpi_pico_clock_common.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

#include "w6300_evb_pico2-pinctrl.dtsi"

/ {
	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	pico_header: connector {
		compatible = "raspberrypi,pico-header";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <0 0 &gpio0 0 0>,	/* GP0 */
			   <1 0 &gpio0 1 0>,	/* GP1 */
			   <2 0 &gpio0 2 0>,	/* GP2 */
			   <3 0 &gpio0 3 0>,	/* GP3 */
			   <4 0 &gpio0 4 0>,	/* GP4 */
			   <5 0 &gpio0 5 0>,	/* GP5 */
			   <6 0 &gpio0 6 0>,	/* GP6 */
			   <7 0 &gpio0 7 0>,	/* GP7 */
			   <8 0 &gpio0 8 0>,	/* GP8 */
			   <9 0 &gpio0 9 0>,	/* GP9 */
			   <10 0 &gpio0 10 0>,	/* GP10 */
			   <11 0 &gpio0 11 0>,	/* GP11 */
			   <12 0 &gpio0 12 0>,	/* GP12 */
			   <13 0 &gpio0 13 0>,	/* GP13 */
			   <14 0 &gpio0 14 0>,	/* GP14 */
			   /* GP15-22 reserved for W6300 SPI/QSPI */
			   <26 0 &gpio0 26 0>,	/* GP26 */
			   <27 0 &gpio0 27 0>,	/* GP27 */
			   <28 0 &gpio0 28 0>; /* GP28 */
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
			label = "LED";
		};
	};

	pwm_leds {
		compatible = "pwm-leds";
		status = "disabled";

		pwm_led0: pwm_led_0 {
			pwms = <&pwm 9 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM_LED";
		};
	};

	/*
	 * Single data line fallback for the W6300.  The W6300 signals are not
	 * routed to the RP2350 SPI0 pinmux, so this bus has to be bit-banged
	 * and only reaches 500 kHz.  The board therefore drives the W6300 over
	 * the PIO based MSPI controller (&mspi0) by default.  To fall back to
	 * single data line SPI, enable &spi_w6300 and &ethernet_spi and disable
	 * &mspi0 and &ethernet.
	 */
	spi_w6300: spi-bitbang {
		compatible = "zephyr,spi-bitbang";
		status = "disabled";
		#address-cells = <1>;
		#size-cells = <0>;
		clk-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
		sdo-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		sdi-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;

		ethernet_spi: w6300@0 {
			compatible = "wiznet,w6300";
			reg = <0x0>;
			spi-max-frequency = <500000>;
			int-gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
			zephyr,random-mac-address;
			status = "disabled";
		};
	};

	aliases {
		led0 = &led0;
		pwm-led0 = &pwm_led0;
		watchdog0 = &wdt0;
	};
};

&flash0 {
	reg = <0x10000000 DT_SIZE_M(2)>;
	ranges = <0x0 0x10000000 DT_SIZE_M(2)>;
	#address-cells = <1>;
	#size-cells = <1>;
};

&uart0 {
	current-speed = <115200>;
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
};

&spi0 {
	clock-frequency = <DT_FREQ_M(8)>;
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
};

/*
 * PIO QSPI bus for W6300
 *  CS  : GPIO16   CLK : GPIO17
 *  IO0 : GPIO18   IO1 : GPIO19
 *  IO2 : GPIO20   IO3 : GPIO21
 *  INT : GPIO15   RST : GPIO22
 */
&pio0 {
	status = "okay";

	mspi0: mspi0 {
		compatible = "raspberrypi,pico-mspi-pio";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-0 = <&pio0_qspi_default>;
		pinctrl-names = "default";
		clocks = <&clocks RPI_PICO_CLKID_CLK_SYS>;
		clk-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
		io0-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
		io1-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		io2-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
		io3-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		ce-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
		dmas = <&dma 0 0 0>, <&dma 1 0 0>;
		dma-names = "tx", "rx";

		ethernet: w6300@0 {
			compatible = "wiznet,w6300";
			reg = <0>;
			mspi-max-frequency = <33000000>;
			mspi-io-mode = "MSPI_IO_MODE_QUAD_1_4_4";
			mspi-cpp-mode = "MSPI_CPP_MODE_0";
			mspi-ce-polarity = "MSPI_CE_ACTIVE_LOW";
			int-gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
			zephyr,random-mac-address;
			status = "okay";
		};
	};
};

&dma {
	status = "okay";
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&adc {
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
	status = "okay";
};

&pwm {
	pinctrl-0 = <&pwm_ch4b_default>;
	pinctrl-names = "default";
	divider-int-0 = <255>;
};

&timer0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&vreg {
	status = "okay";
};

zephyr_udc0: &usbd {
	status = "okay";
};

pico_spi: &spi0 {};

pico_spi0: &spi0 {};

pico_i2c: &i2c0 {};

pico_i2c0: &i2c0 {};

pico_i2c1: &i2c1 {};

pico_serial: &uart0 {};

pico_serial0: &uart0 {};
