/dts-v1/;

#include <intel/intel_socfpga_agilex5.dtsi>

/ {
	model = "Intel SoC FPGA Agilex5";
	compatible = "intel,socfpga-agilex5";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &mem0;
	};

	aliases {
		led0 = &led0;
		sdhc0 = &sdmmc;
	};

	leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		};
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&sdmmc {
	status = "okay";
	no-1-8-v;
	cdns,phy-cfg-sd-ds = <0x00780000 0x81a40040 0x00a000fe 0x28000001 0x00800004>;
	cdns,phy-cfg-sd-hs = <0x00780001 0x81a40040 0x00000000 0x10000001 0x00800004>;
	cdns,ctrl-cfg-sd-hs = <0x0001800c 0x00030000 0x00000101 0x000a0001>;
	cdns,phy-cfg-emmc-sdr = <0x00780004 0x80a40040 0x04000004 0x38000001 0x00800004>;
	cdns,ctrl-cfg-emmc-sdr = <0xf1c1800c 0x00020000 0x00000101 0x00090005>;
	cdns,phy-cfg-emmc-hs200 = <0x00780004 0x81a40040 0x004d4d00 0x11000001 0x00000004>;
	cdns,ctrl-cfg-emmc-hs200 = <0xf1c18000 0x00090000 0x00000101 0x000a0001>;

	mmc {
		/*SD Disk Access */
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};

&xgmac0 {
	full-duplex-mode-en;
	num-dma-ch = <1>;
	num-tx-queues = <1>;
	num-rx-queues = <1>;
	num-tc = <1>;
	dma-ch-rdrl = <128>;
	dma-ch-tdrl = <128>;
	max-speed = <1000>;
	max-frame-size = <9018>;
	jumbo-pkt-en;
	zephyr,random-mac-address;
	phy-handle = <&phy0>;
};

&mdio0 {
	csr-clock-indx = <4>;

	phy0: phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
	};
};
