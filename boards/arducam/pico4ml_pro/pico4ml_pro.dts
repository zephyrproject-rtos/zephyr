/dts-v1/;

#include <raspberrypi/rpi_pico/rp2040.dtsi>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include "pico4ml_pro-pinctrl.dtsi"

/ {
	model = "Arducam Pico4ML-Pro";
	compatible = "arducam,pico4ml-pro";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &ssi;
		zephyr,code-partition = &code_partition;
		zephyr,display = &st7789v;
		zephyr,touch = &xpt2046;
	};

	aliases {
		watchdog0 = &wdt0;
		sdhc0 = &sdhc0;
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi0>;
		dc-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		/* 320x240 landscape; panel settings as in the vendor st7789.c */
		st7789v: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			mipi-max-frequency = <20000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			width = <320>;
			height = <240>;
			x-offset = <0>;
			y-offset = <0>;
			mdac = <0xa0>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565X>;
			porch-param = [0c 0c 00 33 33];
			gctrl = <0x35>;
			vcom = <0x28>;
			lcm = <0x3c>;
			vrhs = <0x0b>;
			vdvs = <0x20>;
			pwctrl1-param = [a4 a1];
			pvgam-param = [d0 01 08 0f 11 2a 36 55 44 3a 0b 06 11 20];
			nvgam-param = [d0 02 07 0a 0b 18 34 43 4a 2b 1b 1c 22 1f];
		};
	};
};

&flash0 {
	reg = <0x10000000 DT_SIZE_M(2)>;
	ranges = <0x0 0x10000000 DT_SIZE_M(2)>;

	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		/* Reserved memory for the second stage bootloader */
		second_stage_bootloader: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "second_stage_bootloader";
			reg = <0x00000000 0x100>;
			read-only;
		};

		/*
		 * Usable flash. Starts at 0x100, after the bootloader. The partition
		 * size is 2MB minus the 0x100 bytes taken by the bootloader.
		 */
		code_partition: partition@100 {
			compatible = "zephyr,mapped-partition";
			label = "code-partition";
			reg = <0x100 (DT_SIZE_M(2) - 0x100)>;
			read-only;
		};
	};
};

&gpio0 {
	status = "okay";
};

/* Wired to the AT command port of the on-board ESP32 */
&uart0 {
	current-speed = <115200>;
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";

	/* No reset or power GPIO reaches the ESP32: the driver resets it with AT+RST */
	esp32_wifi: esp32_wifi {
		compatible = "espressif,esp-at";
		status = "okay";
	};
};

/* HM01B0 camera (0x24) and ICM-42622 IMU (0x68) */
&i2c0 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

/* ST7789 display, XPT2046 touch controller, microSD card */
&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>,
		   <&gpio0 9 GPIO_ACTIVE_LOW>,
		   <&gpio0 7 GPIO_ACTIVE_LOW>;

	/*
	 * Raw X follows the display's vertical axis and raw Y its horizontal
	 * axis, reversed. Calibration from the vendor LCD_Touch.c defaults.
	 */
	xpt2046: xpt2046@1 {
		compatible = "xptek,xpt2046";
		reg = <1>;
		spi-max-frequency = <2000000>;
		int-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
		min-x = <172>;
		max-x = <3614>;
		min-y = <260>;
		max-y = <3733>;
		screen-width = <240>;
		screen-height = <320>;
		inverted-y;
		swapped-x-y;
		display = <&st7789v>;
		reads = <4>;
	};

	sdhc0: sdhc@2 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <2>;
		spi-max-frequency = <20000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
		};
	};
};

/* Arducam Mega camera connectors */
&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>,
		   <&gpio0 28 GPIO_ACTIVE_LOW>,
		   <&gpio0 17 GPIO_ACTIVE_LOW>,
		   <&gpio0 25 GPIO_ACTIVE_LOW>;
};

&timer {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

zephyr_udc0: &usbd {
	status = "okay";
};

&die_temp {
	status = "okay";
};

&vreg {
	status = "okay";
};

&xosc {
	startup-delay-multiplier = <64>;
};

#include <../boards/common/usb/cdc_acm_serial.dtsi>
