/dts-v1/;

#include <st/h5/stm32h5e5Xj.dtsi>
#include <st/h5/stm32h5e5zjtx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "arduino_r3_connector.dtsi"
#include "st_morpho_connector.dtsi"

/ {
	model = "STMicroelectronics STM32H5E5ZJ Nucleo-144 board";
	compatible = "st,stm32h5e5zj-nucleo";

	chosen {
		zephyr,console = &usart3;
		zephyr,shell-uart = &usart3;
		zephyr,canbus = &fdcan1;
		zephyr,sram = &sram1;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &flash;
	};

	leds {
		compatible = "gpio-leds";

		green_led: led-1 {
			gpios = <&gpioa 3 GPIO_ACTIVE_HIGH>;
			label = "User LD1";
		};

		red_led: led-2 {
			gpios = <&gpiof 0 GPIO_ACTIVE_LOW>;
			label = "User LD2";
		};

		blue_led: led-3 {
			gpios = <&gpioe 5 GPIO_ACTIVE_LOW>;
			label = "User LD3";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button {
			label = "User";
			gpios = <&gpioc 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_green_led: led-1 {
			pwms = <&pwm2 4 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	aliases {
		led0 = &green_led;
		led1 = &red_led;
		led2 = &blue_led;
		pwm-led0 = &pwm_green_led;
		sw0 = &user_button;
		watchdog0 = &iwdg;
		volt-sensor0 = &vref;
		volt-sensor1 = &vbat;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(48)>;
	status = "okay";
};

&clk_lse {
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&pll {
	div-m = <12>;
	mul-n = <125>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(250)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c4 {
	pinctrl-0 = <&i2c4_scl_pf5 &i2c4_sda_pg6>;
	pinctrl-names = "default";
	scl-gpios = <&gpiof 5 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpiog 6 GPIO_ACTIVE_HIGH>;
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

&uart7 {
	pinctrl-0 = <&uart7_tx_pb4 &uart7_rx_pa8>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&timers2 {
	st,prescaler = <10000>;
	status = "okay";

	pwm2: pwm {
		pinctrl-0 = <&tim2_ch4_pc4>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&adc12_common {
	st,adc-prescaler = <6>;
	st,adc-clock-source = "ASYNC";
	status = "okay";
};

&adc1 {
	pinctrl-0 = <&adc1_inp2_pf11 &adc1_inp6_pf12
		     &adc1_inp7_pa7 &adc1_inp9_pb0 &adc1_inp3_pa6>;
	pinctrl-names = "default";
	status = "okay";
};

&adc3_common {
	st,adc-prescaler = <6>;
	st,adc-clock-source = "ASYNC";
	status = "okay";
};

&adc3 {
	status = "okay";
};

&gpdma1 {
	status = "okay";
};

&gpdma2 {
	status = "okay";
};

&rng {
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB3, 21)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};

&iwdg {
	status = "okay";
};

&vref {
	status = "okay";
};

&vbat {
	status = "okay";
};

&vddcore {
	status = "okay";
};

zephyr_udc0: &usbotg_hs {
	status = "okay";
};

&otghs_phy {
	clocks = <&rcc STM32_CLOCK(AHB2, 13)>,
		 <&rcc (STM32_SRC_HSE | STM32_CLOCK_DIV(2)) OTGHS_SEL(2)>,
		 <&rcc STM32_SRC_HSE OTGPHYREFCK_SEL(10)>;
	status = "okay";
};

&spi4 {
	pinctrl-0 = <&spi4_sck_pe12 &spi4_miso_pe13 &spi4_mosi_pe14>;
	pinctrl-names = "default";
	status = "okay";
};

&fdcan1 {
	pinctrl-0 = <&fdcan1_tx_pd5 &fdcan1_rx_pe0>;
	pinctrl-names = "default";
	status = "okay";
};
