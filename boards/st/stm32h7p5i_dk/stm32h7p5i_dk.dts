/dts-v1/;
#include <st/h7p/stm32h7p5Xi.dtsi>
#include <st/h7p/stm32h7p(4-5)i(g-i)kx-pinctrl.dtsi>
#include "arduino_r3_connector.dtsi"

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/stm32_pwm.h>

/ {
	compatible = "st,stm32h7p5i-dk";
	model = "STMicroelectronics STM32H7P5I-DISCOVERY KIT board";

	aliases {
		led0 = &green_led;
		led1 = &red_led;
		led2 = &blue_led;
		pwm-led0 = &red_pwm_led;
		pwm-led1 = &blue_pwm_led;
		sw0 = &user_button;
	};

	chosen {
		zephyr,console = &usart2;
		zephyr,display = &gjx_2864tswbg09;
		zephyr,shell-uart = &usart2;
	};

	gpio-keys {
		compatible = "gpio-keys";

		user_button: button_0 {
			label = "User";
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&gpioh 6 GPIO_ACTIVE_HIGH>;
			label = "User LD1";
		};

		red_led: led_1 {
			gpios = <&gpiog 1 GPIO_ACTIVE_LOW>;
			label = "User LD2";
		};

		blue_led: led_2 {
			gpios = <&gpioh 5 GPIO_ACTIVE_LOW>;
			label = "User LD3";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		/* LD1 is not exposed here: no PWM-capable pin is wired to it */

		red_pwm_led: led_1_pwm {
			pwms = <&pwm20 2 PWM_MSEC(20)
				(PWM_POLARITY_NORMAL | STM32_PWM_COMPLEMENTARY)>;
		};

		blue_pwm_led: led_2_pwm {
			pwms = <&pwm17 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};
};

&clk_lse {
	driving-capability = <0>;
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(24)>;
	hse-bypass;
	status = "okay";
};

&pll {
	/*
	 * f(hse_ck)    =  24 MHz
	 * f(vco1_ck)   = 520 MHz: (24 / 6) * 130
	 * f(pll1_p_ck) = 520 MHz: (520 / 1)
	 * f(pll1_q_ck) =  65 MHz: (520 / 8)
	 * pll1_s_ck is not used
	 */
	clocks = <&clk_hse>;
	div-m = <6>;
	mul-n = <130>;
	div-p = <1>;
	div-q = <8>;
	status = "okay";
};

&rcc {
	/*
	 * Select pll1_p_ck as system clock (sys_ck).
	 * BMPRE is set to 2 to satisfy Fbus <= Fbusmax = 260 MHz.
	 * PPRE1/PPRE4 are set to 2 to satisfy Fbus <= Fbusmax/2.
	 */
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(520)>;
	cpre = <1>;
	bmpre = <2>;
	ppre1 = <2>;
	ppre2 = <1>;
	ppre4 = <2>;
};

&pwr {
	st,power-supply = "internal-regulator";
};

&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			reg = <0x00000000 DT_SIZE_K(128)>;
			label = "mcuboot";
		};

		storage_partition: partition@20000 {
			compatible = "zephyr,mapped-partition";
			reg = <0x00020000 DT_SIZE_K(128)>;
			label = "storage";
		};

		application_partition: partition@40000 {
			compatible = "zephyr,mapped-partition";
			reg = <0x00040000 (DT_SIZE_M(2) - DT_SIZE_K(256))>;
			label = "application";
		};
	};
};

/* ST-Link VCP UART */
&usart2 {
	pinctrl-0 = <&usart2_rx_pa3 &usart2_tx_pa2>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart4 {
	/* Arduino D0 (RX) / D1 (TX) */
	pinctrl-0 = <&uart4_rx_ph14 &uart4_tx_ph13>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&spi5 {
	/* Arduino D10 (NSS) / D11 (MOSI) / D12 (MISO) / D13 (SCK) */
	pinctrl-0 = <&spi5_nss_ph9 &spi5_mosi_ph8 &spi5_miso_ph7 &spi5_sck_ph6>;
	pinctrl-names = "default";
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pg9 &spi1_mosi_pg5>;
	pinctrl-names = "default";
	cs-gpios = <&gpiog 4 GPIO_ACTIVE_LOW>;
	status = "okay";

	/*
	 * The on-board display (GJX-2864TSWBG09) uses an ST7315 driver IC
	 * which behaves identically to an SSD1306, so use that as compatible.
	 */
	gjx_2864tswbg09: display@0 {
		compatible = "solomon,ssd1306";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(10)>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;

		data-cmd-gpios = <&gpiog 6 0>;
		reset-gpios = <&gpioe 1 GPIO_ACTIVE_LOW>;
	};
};

/* User LEDs PWM */
&timers17 {
	st,prescaler = <10000>;
	status = "okay";

	pwm17: pwm {
		pinctrl-0 = <&tim17_ch1_ph5>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&timers20 {
	st,prescaler = <10000>;
	status = "okay";

	pwm20: pwm {
		pinctrl-0 = <&tim20_ch2n_pg1>;
		pinctrl-names = "default";
		status = "okay";
	};
};
