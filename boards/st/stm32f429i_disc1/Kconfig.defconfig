# STM32F4DISCOVERY board configuration

# Copyright (c) 2016 Linaro Limited.
# SPDX-License-Identifier: Apache-2.0

if BOARD_STM32F429I_DISC1

config MEMC
	default y if STM32_LTDC

if LVGL

# Let LVGL fully handle the buffers
configdefault STM32_LTDC_FB_NUM
	default 0

configdefault LV_Z_VDB_ZEPHYR_REGION
	default y
configdefault LV_Z_VDB_ZEPHYR_REGION_NAME
	default "SDRAM2"
configdefault LV_Z_DOUBLE_VDB
	default y

choice LV_Z_RENDERING_MODE
	default LV_Z_DIRECT_RENDERING
endchoice

endif # LVGL

endif # BOARD_STM32F429I_DISC1
