if BOARD_STM32H573I_DK

configdefault ETH_DRIVER
	default y

configdefault SDMMC_STM32_CLOCK_CHECK
	default n

# Required by the WM8904 MCLK fixed-clock node (revision D1)
configdefault CLOCK_CONTROL_FIXED_RATE_CLOCK
	default y if AUDIO_CODEC_WM8904

if DISPLAY

# Required to enable LCD backlight
config REGULATOR
	default y

configdefault I2C_STM32_V2_TIMING
	default y if INPUT

endif # DISPLAY

endif # BOARD_STM32H573I_DK
