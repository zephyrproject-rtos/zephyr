if BOARD_STM32H5F5J_DK

configdefault ETH_DRIVER
	default y if NETWORKING

configdefault SDMMC_STM32_CLOCK_CHECK
	default n if DISK_DRIVER_SDMMC

if DISPLAY

# Default display framebuffer is located in PSRAM
configdefault MEMC
	default y

configdefault I2C_STM32_V2_TIMING
	default y if INPUT

endif # DISPLAY

if LVGL

# Let LVGL fully handle the buffers
configdefault STM32_LTDC_FB_NUM
	default 0

configdefault LV_Z_VDB_ZEPHYR_REGION
	default y

configdefault LV_Z_VDB_ZEPHYR_REGION_NAME
	default "PSRAM"

configdefault LV_Z_DOUBLE_VDB
	default y

choice LV_Z_RENDERING_MODE
	default LV_Z_DIRECT_RENDERING
endchoice

endif # LVGL

endif # BOARD_STM32H5F5J_DK
