/dts-v1/;
#include <st/f1/stm32f107Xc.dtsi>
#include <st/f1/stm32f107v(b-c)tx-pinctrl.dtsi>

/ {
	model = "STMicroelectronics STM32-MICRIUM evaluation board";
	compatible = "st,stm32-micrium";

	chosen {
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,canbus = &can1;
	};

	leds {
		compatible = "gpio-leds";

		green_led_1: led_1 {
			gpios = <&gpiod 13 GPIO_ACTIVE_HIGH>;
			label = "LD1";
		};

		orange_led_2: led_2 {
			gpios = <&gpiod 14 GPIO_ACTIVE_HIGH>;
			label = "LD2";
		};

		red_led_3: led_3 {
			gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
			label = "LD3";
		};
	};

	aliases {
		led0 = &green_led_1;
		led1 = &orange_led_2;
		led2 = &red_led_3;
		ambient-temp0 = &stlm75;
		rtc = &rtc;
		sdhc0 = &sdhc0;
		watchdog0 = &iwdg;
	};
};

&clk_lse {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(25)>;
	status = "okay";
};

&pll2 {
	/* 25 MHz / 5 * 8 = 40 MHz */
	mul = <8>;
	prediv = <5>;
	status = "okay";
};

&pll {
	/* 40 MHz / 5 * 9 = 72 MHz */
	mul = <9>;
	prediv = <5>;
	clocks = <&pll2>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(72)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&usart2 {
	pinctrl-0 = <&usart2_tx_remap1_pd5 &usart2_rx_remap1_pd6
		     &usart2_rts_remap1_pd4 &usart2_cts_remap1_pd3>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	stlm75: stlm75@48 {
		compatible = "lm75";
		reg = <0x48>;
		int-gpios = <&gpiob 5 GPIO_ACTIVE_LOW>;
	};
};

&spi1 {
	pinctrl-0 = <&spi1_sck_master_pa5 &spi1_miso_master_pa6 &spi1_mosi_master_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
	status = "okay";

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(25)>;
		cd-gpios = <&gpioe 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		status = "okay";

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

&can1 {
	pinctrl-0 = <&can1_rx_remap2_pd0 &can1_tx_remap2_pd1>;
	pinctrl-names = "default";
	status = "okay";

	can-transceiver {
		max-bitrate = <1000000>;
	};
};

&mac {
	pinctrl-0 = <&eth_crs_pa0
		     &eth_rx_clk_pa1
		     &eth_col_pa3
		     &eth_txd3_pb8
		     &eth_rx_er_pb10
		     &eth_tx_en_pb11
		     &eth_txd0_pb12
		     &eth_txd1_pb13
		     &eth_txd2_pc2
		     &eth_tx_clk_pc3
		     &eth_rx_dv_remap1_pd8
		     &eth_rxd0_remap1_pd9
		     &eth_rxd1_remap1_pd10
		     &eth_rxd2_remap1_pd11
		     &eth_rxd3_remap1_pd12>;
	pinctrl-names = "default";
	phy-connection-type = "mii";
	phy-handle = <&eth_phy>;
	status = "okay";
};

&mdio {
	pinctrl-0 = <&eth_mdio_pa2 &eth_mdc_pc1>;
	pinctrl-names = "default";
	status = "okay";

	eth_phy: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <0x01>;
	};
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12
		     &usb_otg_fs_id_pa10 &usb_otg_fs_vbus_pa9>;
	pinctrl-names = "default";
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB1, 28)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};

&iwdg {
	status = "okay";
};
