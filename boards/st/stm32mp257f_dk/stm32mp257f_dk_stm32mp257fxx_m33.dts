/dts-v1/;
#include <st/mp2/stm32mp257_m33.dtsi>
#include <st/mp2/stm32mp257fakx-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/raspberrypi-csi-connector.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/video/video-interfaces.h>

/ {
	model = "STMicroelectronics STM32MP257F-DK board";
	compatible = "st,stm32mp257f-dk", "st,stm32mp25";

	chosen {
		zephyr,console = &uart5;
		zephyr,flash = &ddr_code;
		zephyr,shell-uart = &uart5;
		zephyr,sram = &ddr_sys;
	};

	leds {
		compatible = "gpio-leds";

		orange_led_9: led_9 {
			gpios = <&gpioh 6 GPIO_ACTIVE_HIGH>;
			label = "LD9";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		button_user2: button4 {
			gpios = <&gpioc 11 GPIO_ACTIVE_LOW>;
			label = "User 2";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		led0 = &orange_led_9;
		sw0 = &button_user2;
	};

	/* CN8 camera connector: CAM.RST on PB1, CAM_EN on PB11 */
	csi_connector: connector_csi {
		compatible = "raspberrypi,csi-connector";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <CSI_IO0 0 &gpiob 1 0>,
			   <CSI_IO1 0 &gpiob 11 0>;
	};
};

&gpiob {
	csi_gpio0_hog: csi-gpio0-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};

	csi_gpio1_hog: csi-gpio1-hog {
		gpio-hog;
		gpios = <11 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};
};

&clk_hsi {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(40)>;
	status = "okay";
};

&rcc {
	clock-frequency = <DT_FREQ_M(400)>;
};

&mailbox {
	status = "okay";
};

&uart5 {
	pinctrl-0 = <&uart5_tx_pg9 &uart5_rx_pg10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart6 {
	pinctrl-0 = <&usart6_tx_pf13 &usart6_rx_pf14>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c8 {
	/* Pin conflict with i3c4. Enable only with i3c4 disabled */
	pinctrl-0 = <&i2c8_scl_pz4 &i2c8_sda_pz3>;
	pinctrl-names = "default";
	scl-gpios = <&gpioz 4 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpioz 3 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&i3c4 {
	/* Pin conflict with i2c8. Enable only with i2c8 disabled */
	pinctrl-0 = <&i3c4_scl_pz4 &i3c4_sda_pz3>;
	pinctrl-names = "default";
	status = "disabled";
};

csi_i2c: &i2c2 {
	/* Shared with the LVDS touch panel: disable i2c2 on the Cortex-A35 side */
	pinctrl-0 = <&i2c2_scl_pf2 &i2c2_sda_pf0>;
	pinctrl-names = "default";
	scl-gpios = <&gpiof 2 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpiof 0 GPIO_ACTIVE_HIGH>;
};

csi_interface: &dcmipp {
	port {
		csi_ep_in: endpoint {};
	};
};

csi_capture_port: &pipe_main {};
