/dts-v1/;
#include <microchip/pic32c/pic32cm_jh/pic32cm_jh01/pic32cm5164jh01100.dtsi>
#include "pic32cm_jh01_cpro-pinctrl.dtsi"
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/mchp_pic32cm_jh_adc.h>
#include <zephyr/dt-bindings/input/mchp_pic32cm_jh_ptc.h>

/ {
	model = "PIC32CM JH01 Curiosity Pro";
	compatible = "pic32cmjh01,cpro", "microchip,pic32cm5164jh01100", "microchip,pic32cm";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &nvmctrl;
		zephyr,console = &sercom4;
		zephyr,shell-uart = &sercom4;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		led0 = &led0;
		sw0 = &button0;
		pwm-led0 = &pwm_led0;
		rtc = &rtc;
	};

	ext1_header: xplained-pro-connector1 {
		compatible = "microchip,xpro-header";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;

		/* dts-format off */
					       /*                                                Shared */
		gpio-map = <0  0 &porta 11 0>, /* EXT1-3  [ADC(+)]        PA11  ADC0/AIN[11]            */
			   <1  0 &portb  8 0>, /* EXT1-4  [ADC(-)]        PB08  ADC0/AIN[2]             */
			   <2  0 &portb 17 0>, /* EXT1-5  [GPIO0]         PB17  GPIO                    */
			   <3  0 &portb 16 0>, /* EXT1-6  [GPIO1]         PB16  GPIO                    */
			   <4  0 &portb 12 0>, /* EXT1-7  [PWM(+)]        PB12  TCC0/WO[6]              */
			   <5  0 &portb 13 0>, /* EXT1-8  [PWM(-)]        PB13  TCC0/WO[7]              */
			   <6  0 &porta 21 0>, /* EXT1-9  [IRQ/GPIO]      PA21  EIC/EXTINT[5] / GPIO    */
			   <7  0 &portb  7 0>, /* EXT1-10 [SPI_SS_B/GPIO] PB07  GPIO                    */
			   <8  0 &porta 22 0>, /* EXT1-11 [TWI_SDA]       PA22  SERCOM3/PAD[0] I2C SDA  */
			   <9  0 &porta 23 0>, /* EXT1-12 [TWI_SCL]       PA23  SERCOM3/PAD[1] I2C SCL  */
			   <10 0 &porta 13 0>, /* EXT1-13 [USART_RX]      PA13  SERCOM2/PAD[1] UART RX  */
			   <11 0 &porta 12 0>, /* EXT1-14 [USART_TX]      PA12  SERCOM2/PAD[0] UART TX  */
			   <12 0 &portc 28 0>, /* EXT1-15 [SPI_SS_A]      PC28  SERCOM1/PAD[1] SPI SS   */
			   <13 0 &porta 18 0>, /* EXT1-16 [SPI_MOSI]      PA18  SERCOM1/PAD[2] SPI MOSI */
			   <14 0 &portc 27 0>, /* EXT1-17 [SPI_MISO]      PC27  SERCOM1/PAD[0] SPI MISO */
			   <15 0 &porta 19 0>; /* EXT1-18 [SPI_SCK]       PA19  SERCOM1/PAD[3] SPI SCK  */
					       /* GND                                                   */
					       /* +3.3V                                                 */
		/* dts-format on */
	};

	ext2_header: xplained-pro-connector2 {
		compatible = "microchip,xpro-header";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;

		/* dts-format off */
					       /*                                                 Shared */
		gpio-map = <0  0 &porta  5 0>, /* EXT2-3  [ADC(+)]         PA05  ADC0/AIN[5]             */
			   <1  0 &porta  4 0>, /* EXT2-4  [ADC(-)]         PA04  ADC0/AIN[4]             */
			   <2  0 &porta 20 0>, /* EXT2-5  [GPIO0]          PA20  GPIO                    */
			   <3  0 &portc 11 0>, /* EXT2-6  [GPIO1]          PC11  GPIO                    */
			   <4  0 &portb 30 0>, /* EXT2-7  [PWM(+)]         PB30  TCC1/WO[2]              */
			   <5  0 &portb 31 0>, /* EXT2-8  [PWM(-)]         PB31  TCC1/WO[3]              */
			   <6  0 &portc 24 0>, /* EXT2-9  [IRQ/GPIO]       PC24  EIC/EXTINT[0] / GPIO    */
			   <7  0 &portc 25 0>, /* EXT2-10 [SPI_SS_B/GPIO]  PC25  GPIO                    */
			   <8  0 &porta 16 0>, /* EXT2-11 [TWI_SDA]        PA16  SERCOM1/PAD[0] I2C SDA  */
			   <9  0 &porta 17 0>, /* EXT2-12 [TWI_SCL]        PA17  SERCOM1/PAD[1] I2C SCL  */
			   <10 0 &portb 21 0>, /* EXT2-13 [USART_RX]       PB21  SERCOM3/PAD[1] UART RX  */
			   <11 0 &portb 20 0>, /* EXT2-14 [USART_TX]       PB20  SERCOM3/PAD[0] UART TX  */
			   <12 0 &portb  3 0>, /* EXT2-15 [SPI_SS_A]       PB03  SERCOM5/PAD[1] SPI SS   */
			   <13 0 &portb  0 0>, /* EXT2-16 [SPI_MOSI]       PB00  SERCOM5/PAD[2] SPI MOSI */
			   <14 0 &portb  2 0>, /* EXT2-17 [SPI_MISO]       PB02  SERCOM5/PAD[0] SPI MISO */
			   <15 0 &portb  1 0>; /* EXT2-18 [SPI_SCK]        PB01  SERCOM5/PAD[3] SPI SCK  */
					       /* GND                                                    */
					       /* +3.3V                                                  */
		/* dts-format on */
	};

	ext3_header: xplained-pro-connector3 {
		compatible = "microchip,xpro-header";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;

		/* dts-format off */
					       /*                                                 Shared */
		gpio-map = <0  0 &portb  6 0>, /* EXT3-3  [ADC(+)]         PB06  ADC1/AIN[8]             */
			   <1  0 &portb  9 0>, /* EXT3-4  [ADC(-)]         PB09  ADC1/AIN[5]             */
			   <2  0 &portc 18 0>, /* EXT3-5  [GPIO0]          PC18  GPIO                    */
			   <3  0 &portc 19 0>, /* EXT3-6  [GPIO1]          PC19  GPIO                    */
			   <4  0 &portb 22 0>, /* EXT3-7  [PWM(+)]         PB22  TC3/WO[0]               */
			   <5  0 &portb 23 0>, /* EXT3-8  [PWM(-)]         PB23  TC3/WO[1]               */
			   <6  0 &porta 28 0>, /* EXT3-9  [IRQ/GPIO]       PA28  EIC/EXTINT[8] / GPIO    */
			   <7  0 &porta 27 0>, /* EXT3-10 [SPI_SS_B/GPIO]  PA27  GPIO                    */
			   <8  0 &porta 16 0>, /* EXT3-11 [TWI_SDA]        PA16  SERCOM1/PAD[0] I2C SDA  */
			   <9  0 &porta 17 0>, /* EXT3-12 [TWI_SCL]        PA17  SERCOM1/PAD[1] I2C SCL  */
			   <10 0 &portc 17 0>, /* EXT3-13 [USART_RX]       PC17  SERCOM6/PAD[1] UART RX  */
			   <11 0 &portc 16 0>, /* EXT3-14 [USART_TX]       PC16  SERCOM6/PAD[0] UART TX  */
			   <12 0 &portc 13 0>, /* EXT3-15 [SPI_SS_A]       PC13  SERCOM7/PAD[1] SPI SS   */
			   <13 0 &portc 14 0>, /* EXT3-16 [SPI_MOSI]       PC14  SERCOM7/PAD[2] SPI MOSI */
			   <14 0 &portc 12 0>, /* EXT3-17 [SPI_MISO]       PC12  SERCOM7/PAD[0] SPI MISO */
			   <15 0 &portc 15 0>; /* EXT3-18 [SPI_SCK]        PC15  SERCOM7/PAD[3] SPI SCK  */
					       /* GND                          */
					       /* +3.3V                        */
		/* dts-format on */
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&portc 5 GPIO_ACTIVE_LOW>;
			label = "Yellow LED";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led_0 {
			pwms = <&tcc2 1 PWM_MSEC(20) 0>;
			status = "okay";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&portb 19 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW0";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

&flash0 {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* Initial 64kB for boot partition*/
		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(64)>;
		};

		/* 224kB for slot0 partition */
		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00010000 DT_SIZE_K(224)>;
		};

		/* 224kB for slot1 partition */
		slot1_partition: partition@48000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00048000 DT_SIZE_K(224)>;
		};

		/* Entire 8kB of Data flash is for storage partition */
		storage_partition: partition@400000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x00400000 DT_SIZE_K(8)>;
		};
	};
};

&cpu0 {
	clock-frequency = <48000000>;
};

&clock {
	compatible = "microchip,pic32cm-jh-clock";

	/* If cpu sourced from osc48m, use 3 for CPU frequency above 24Mhz */
	flash-wait-states = <2>;

	xosc: xosc {
		compatible = "microchip,pic32cm-jh-xosc";
		xosc-frequency = <32000000>;
		xosc-en = <1>;
		xosc-xtal-en = <1>;
		xosc-run-in-standby-en = <1>;
	};

	fdpll: fdpll {
		compatible = "microchip,pic32cm-jh-fdpll";
		fdpll-xosc-clock-divider = <15>;
		fdpll-divider-ratio-frac = <0>;
		fdpll-divider-ratio-int = <95>;
		fdpll-output-prescalar = "div2";
		fdpll-src = "xosc";
		fdpll-run-in-standby-en = <1>;
		fdpll-en = <1>;
	};

	xosc32k: xosc32k {
		compatible = "microchip,pic32cm-jh-xosc32k";
		xosc32k-32khz-en = <1>;
		xosc32k-xtal-en = <1>;
		xosc32k-startup-time = "122-us";
		xosc32k-run-in-standby-en = <1>;
		xosc32k-en = <1>;
	};

	osc32k: osc32k {
		compatible = "microchip,pic32cm-jh-osc32k";
		osc32k-32khz-en = <1>;
		osc32k-startup-time = "183-us";
		osc32k-run-in-standby-en = <1>;
		osc32k-en = <0>;
	};

	gclkgen: gclkgen {
		compatible = "microchip,pic32cm-jh-gclkgen";

		gclkgen0 {
			subsystem = <CLOCK_MCHP_GCLKGEN_ID_GEN0>;
			gclkgen-div-factor = <1>;
			gclkgen-run-in-standby-en = <1>;
			gclkgen-src = "fdpll";
			gclkgen-en = <1>;
		};

		gclkgen1 {
			subsystem = <CLOCK_MCHP_GCLKGEN_ID_GEN1>;
			gclkgen-div-factor = <1>;
			gclkgen-run-in-standby-en = <1>;
			gclkgen-src = "xosc";
			gclkgen-en = <1>;
		};
	};

	gclkperiph: gclkperiph {
		compatible = "microchip,pic32cm-jh-gclkperiph";
		#clock-cells = <1>;

		sercom4 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM4_CORE>;
			gclkperiph-src = "gclk0";
			gclkperiph-en = <1>;
		};

		adc0 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_ADC0>;
			gclkperiph-src = "gclk1";
			gclkperiph-en = <0>;
		};

		adc1 {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_ADC1>;
			gclkperiph-src = "gclk1";
			gclkperiph-en = <0>;
		};

		dac {
			subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_DAC>;
			gclkperiph-src = "gclk1";
			gclkperiph-en = <0>;
		};
	};
};

&sercom4 {
	compatible = "microchip,sercom-g1-uart";
	#address-cells = <1>;
	#size-cells = <0>;
	current-speed = <115200>;
	data-bits = <8>;
	parity = "none";
	stop-bits = "1";
	rxpo = <3>;
	txpo = <1>;
	pinctrl-0 = <&sercom4_uart_default>;
	pinctrl-names = "default";
	dmas = <&dmac 0x0 0xa>, <&dmac 0x1 0xb>;
	dma-names = "rx", "tx";
	status = "okay";
};

&dmac {
	status = "okay";
};

i2c0: &sercom3 {
	compatible = "microchip,sercom-g1-i2c";
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&sercom3_i2c_default>;
	pinctrl-names = "default";
	dmas = <&dmac 0x2 0x8>, <&dmac 0x3 0x9>;
	dma-names = "rx", "tx";
	status = "okay";
};

&adc0 {
	/* ADC clock = xosc => GCLK1 / prescaler (32 MHz / 2 = 16 MHz) */
	prescaler = <2>;
	pinctrl-0 = <&adc0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&dmac {
	status = "okay";
};

&tcc2 {
	compatible = "microchip,tcc-g1-pwm";
	#pwm-cells = <3>;
	pinctrl-0 = <&tcc2_pwm_default>;
	pinctrl-names = "default";
	max-bit-width = <24>;
	prescaler = <256>;
	status = "okay";
};

&tc5 {
	compatible = "microchip,tc-g1-pwm";
	#pwm-cells = <3>;
	pinctrl-0 = <&tc5_pwm_default>;
	pinctrl-names = "default";
	prescaler = <64>;
	status = "okay";
};

&tc0 {
	compatible = "microchip,tc-g1-counter";
	max-bit-width = <32>;
	prescaler = <8>;
	status = "okay";
};

&dac {
	pinctrl-0 = <&dac_default>;
	pinctrl-names = "default";
	status = "okay";
};

&tcc1 {
	compatible = "microchip,tcc-g1-counter";
	max-bit-width = <24>;
	prescaler = <4>;
	status = "okay";
};

&rtc {
	prescaler = <1024>;
	status = "okay";
};

&sercom5 {
	compatible = "microchip,sercom-g1-spi";
	dipo = <0>;
	dopo = <1>;
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&sercom5_spi_default>;
	pinctrl-names = "default";
	cs-gpios = <&portb 3 GPIO_ACTIVE_LOW>;
	dmas = <&dmac 0x4 0xc>, <&dmac 0x5 0xd>;
	dma-names = "rx", "tx";
};

&ptc {
	interrupts = <30 3>;
	run-in-standby-en = <0>;
	def-touch-measurement-period-ms = <20>;
	def-sensor-type = <0x81>;
	def-sel-freq-init = "FREQ_SEL_0";
	def-touch-det-int = <4>;
	def-anti-tch-det-int = <5>;
	def-anti-tch-recal-thrshld = "RECAL_100";
	def-tch-drift-rate = <20>;
	def-anti-tch-drift-rate = <5>;
	def-drift-hold-time = <20>;
	def-reburst-mode = "REBURST_UNRESOLVED";
	def-max-on-duration = <0>;

	pinctrl-0 = <&ptc_btn1_default>;
	pinctrl-names = "default";

	/* frequency hop parameters */
	num-freq-steps = <3>;
	def-median-filter-frequencies = "FREQ_SEL_0", "FREQ_SEL_1", "FREQ_SEL_2";
	def-freq-autotune-enable = <1>;
	freq-autotune-max-variance = <10>;
	freq-autotune-count-in = <6>;

	/* Data Streamer port */
	data-streamer-port = <&sercom4>;

	def-num-channels = <1>;

	/* node parameters */
	node_0_params: touch_node0 {
		x-mask = <3>;
		x-names = "DRIVEN_SHIELD";
		y-mask = <10>;
		y-names = "BUTTON_0";
		zephyr,code = <INPUT_KEY_0>;
		csd = <0>;
		rselect = "RSEL_VAL_0";
		prescaler = "PRSC_DIV_SEL_16";
		digital-gain = "GAIN_1";
		analog-gain = "GAIN_1";
		filter-level = "FILTER_LEVEL_16";
	};

	/* button module parameters */
	def-num-sensors = <1>;

	key_0_params: touch_key0 {
		threshold = <25>;
		hysteresis = "HYST_25";
		aks-group = "NO_AKS_GROUP";
	};

	status = "okay";
};
