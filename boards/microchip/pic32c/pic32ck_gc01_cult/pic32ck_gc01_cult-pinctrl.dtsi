#include <dt-bindings/pic32c/pic32ck_sg_gc/pic32ck_gc01/pic32ck2051gc01144-pinctrl.h>

&pinctrl {
	sercom1_uart_default: sercom1_uart_default {
		group1 {
			pinmux = <PD13C_SERCOM1_PAD0>, /* TX */
				 <PD14C_SERCOM1_PAD1>; /* RX */
		};
	};

	sercom2_spi_default: sercom2_spi_default {
		group1 {
			pinmux = <PC15C_SERCOM2_PAD0>,
				 <PC18C_SERCOM2_PAD3>,
				 <PC17C_SERCOM2_PAD2>,
				 <PC16C_SERCOM2_PAD1>;
		};
	};

	sercom3_uart_default: sercom3_uart_default {
		group1 {
			pinmux = <PB21C_SERCOM3_PAD0>, /* TX */
				 <PB22C_SERCOM3_PAD1>; /* RX */
		};
	};

	sercom5_uart_default: sercom5_uart_default {
		group1 {
			pinmux = <PA24C_SERCOM5_PAD0>, /* TX */
				 <PA25C_SERCOM5_PAD1>; /* RX */
		};
	};

	sercom2_spi_ext1: sercom2_spi_ext1 {
		group1 {
			pinmux = <PC15C_SERCOM2_PAD0>,
				 <PC16C_SERCOM2_PAD1>,
				 <PC17C_SERCOM2_PAD2>;
		};

		group2 {
			pinmux = <PD15_GPIO>;
		};
	};

	sercom2_spi_ext2: sercom2_spi_ext2 {
		group1 {
			pinmux = <PC15C_SERCOM2_PAD0>,
				 <PC16C_SERCOM2_PAD1>,
				 <PC17C_SERCOM2_PAD2>;
		};

		group2 {
			pinmux = <PC23_GPIO>;
		};
	};

	sercom2_spi_arduino: sercom2_spi_arduino {
		group1 {
			pinmux = <PC15C_SERCOM2_PAD0>,
				 <PC16C_SERCOM2_PAD1>,
				 <PC17C_SERCOM2_PAD2>;
		};

		group2 {
			pinmux = <PB12_GPIO>;
		};
	};

	sercom2_spi_mikrobus: sercom2_spi_mikrobus {
		group1 {
			pinmux = <PC15C_SERCOM2_PAD0>,
				 <PC16C_SERCOM2_PAD1>,
				 <PC17C_SERCOM2_PAD2>;
		};

		group2 {
			pinmux = <PD15_GPIO>;
		};
	};

	sercom_audio_spi: sercom_audio_spi {
		group1 {
			pinmux = <PD16J_SPI_IXS_SDI>,
				 <PD17J_SPI_IXS_SDO>,
				 <PD14J_SPI_IXS_SCK>,
				 <PD13J_SPI_IXS_FSYNC>;
		};
	};
};
