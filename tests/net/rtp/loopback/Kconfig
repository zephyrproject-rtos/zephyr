config RTP_LOOPBACK_TEST_SRTP_GCM
	bool "Use AES-GCM for the SRTP loopback permutations"
	help
	  Protect the loopback session with AES-128-GCM instead of
	  AES-128-CM with HMAC-SHA1-80.

config RTP_LOOPBACK_TEST_SRTP_GCM_256
	bool "Use AES-256-GCM for the SRTP loopback permutations"
	help
	  Protect the loopback session with AES-256-GCM instead of
	  AES-128-CM with HMAC-SHA1-80. Takes precedence over
	  RTP_LOOPBACK_TEST_SRTP_GCM.

source "Kconfig.zephyr"
