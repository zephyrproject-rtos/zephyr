mainmenu "Thread-local storage tests"

config TEST_TLS_ALIGNMENT
	int "Alignment of initialized thread-local data"
	default 1
	range 1 64
	help
	  Increase the alignment to verify that runtime TLS initialization
	  preserves the ELF layout and compiler-generated variable offsets.

config TEST_TLS_BSS_ALIGNMENT
	int "Alignment of zero-initialized thread-local data"
	default 1
	range 1 64
	help
	  Increase the alignment independently of initialized data to verify
	  padding before and within the zero-initialized TLS area.

source "Kconfig.zephyr"
