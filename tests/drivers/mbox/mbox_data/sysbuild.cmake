# Build the remote image only when a remote board is selected. A single-CPU
# configuration (CONFIG_TEST_SINGLE_CPU) loops messages back on one core and
# needs no remote, so boards that force sysbuild (for example the Infineon PSE84
# boards) can still build this test with no remote board defined.
if(NOT "${SB_CONFIG_REMOTE_BOARD}" STREQUAL "")
  set(REMOTE_APP remote)

  ExternalZephyrProject_Add(
      APPLICATION ${REMOTE_APP}
      SOURCE_DIR  ${APP_DIR}/${REMOTE_APP}
      BOARD       ${SB_CONFIG_REMOTE_BOARD}
  )

  if(SB_CONFIG_BOARD_MIMXRT1160_EVK_MIMXRT1166_CM7 OR
     SB_CONFIG_BOARD_MIMXRT1170_EVK_MIMXRT1176_CM7 OR
     SB_CONFIG_BOARD_LPCXPRESSO55S69_LPC55S69_CPU0 OR
     SB_CONFIG_BOARD_MIMXRT1180_EVK_MIMXRT1189_CM33 OR
     SB_CONFIG_BOARD_FRDM_IMXRT1186_MIMXRT1186_CM33)
    # For these NXP boards the main core application is dependent on
    # 'zephyr_image_info.h' generated by remote application.

    # Let's build the remote application first
    add_dependencies(${DEFAULT_IMAGE} ${REMOTE_APP})
  endif()
endif()
