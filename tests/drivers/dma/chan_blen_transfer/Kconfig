mainmenu "DMA Loop Transfer Test"

source "Kconfig.zephyr"

config DMA_TRANSFER_CHANNEL_NR_0
	int "first DMA channel to use"
	default 0

config DMA_TRANSFER_CHANNEL_NR_1
	int "second DMA channel to use"
	default 1

config DMA_LOOP_TRANSFER_RELOCATE_SECTION
	string "the section to place the memory buffers."
	depends on CODE_DATA_RELOCATION
	default "RAM"

config DMA_LOOP_TRANSFER_NUMBER_OF_DMAS
	int "Number of DMAs to test"
	default 1

config DMA_TRANSFER_BURST16
	bool "Enable loop transfers of 16-beat bursts"
	default y

config DMA_TRANSFER_LONG_BLOCK_SIZE
	int "Size in bytes of an additional long single-block transfer"
	default 0
	help
	  When non-zero, also copy one block of this many bytes with
	  one-byte bursts. Set it above what one descriptor of the
	  controller can carry to exercise a driver that splits a block.

config DMA_TRANSFER_LONG_BLOCK_RELOAD
	bool "Reload the channel after the long block"
	depends on DMA_TRANSFER_LONG_BLOCK_SIZE > 0
	help
	  For a driver that splits a long block on dma_config() but sends a
	  reload out as one descriptor: check that a reload of the long size
	  is refused with -EINVAL, and that a short reload then copies its
	  data and nothing else.

config DMA_TRANSFER_OVERSIZE_BLOCK_SIZE
	int "Size in bytes of a single block the driver must reject"
	default 0
	help
	  When non-zero, check that dma_config() rejects one block of this
	  many bytes with -EINVAL, returns with interrupts unlocked, and
	  leaves the channel usable for the next transfer.

config DMA_TRANSFER_IDLE_SLOT
	int "Request line of a peripheral that never requests"
	default -1
	help
	  When not negative, a peripheral-to-memory transfer on this request
	  line stays pending, which lets the test read dma_get_status() of a
	  started transfer: pending_length must be the whole block for 8-byte
	  bursts of 1-byte data.

config DMA_TRANSFER_FAULT_ADDRESS
	hex "Address a write to which ends in a bus error"
	default 0x0
	depends on DMA_TRANSFER_IDLE_SLOT >= 0
	help
	  When non-zero, start a memory-to-memory transfer to this address
	  while another channel waits on DMA_TRANSFER_IDLE_SLOT. The faulting
	  transfer must end with a negative status in its callback and the
	  waiting one must stay busy.

config DMA_TRANSFER_SOURCE_CHAINING_MAX_BLOCK_SIZE
	int "Largest block_size accepted with source_chaining_en"
	default 0
	help
	  When non-zero, dma_config() with source_chaining_en set and 1-byte
	  data and bursts must accept a block of this many bytes and reject
	  one byte more with -EINVAL.
