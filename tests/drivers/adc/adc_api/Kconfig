# ADC API test configuration options

# Copyright (c) 2024 STMicroelectronics
# SPDX-License-Identifier: Apache-2.0

mainmenu "ADC API Test"

source "Kconfig.zephyr"

config TEST_ADC_BASIC
	bool "Exercise the ADC API on the board's channels"
	default y

config ADC_API_SAMPLE_INTERVAL_US
	int "Interval between repeatead samples in us"
	default 0

config ADC_32_BITS_DATA
	bool "ADC data is 32-bits long"

config TEST_ADC_CALIBRATE_REQUIRED
	bool "Require calibrate field in ADC test"
	default y if DT_HAS_RENESAS_RA_ADC16_ENABLED

config TEST_ADC_ERROR_CASES
	bool "Check the error codes of the ADC API"

config TEST_ADC_ACCURACY_REF
	bool "Compare a channel against the board's reference voltage"
	depends on DT_HAS_TEST_ADC_REFERENCE_VOLTAGE_ENABLED

config TEST_ADC_ACCURACY_DAC
	bool "Compare a channel against a DAC output of the board"
	depends on DT_HAS_TEST_ADC_DAC_LOOPBACK_ENABLED
	select DAC

config TEST_ADC_ACCURACY_PASSES
	int "Number of readings in the accuracy tests"
	default 5

config TEST_DAC_BUFFER_NOT_SUPPORTED
	bool "DAC on board/SoC does not support output buffer mode"
	help
	  The accuracy test then sets up the DAC channel without its output buffer.
