#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	relay0: relay-0 {
		compatible = "zephyr,gpio-relay";
		gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	relay1: relay-1 {
		compatible = "zephyr,gpio-relay";
		gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};
