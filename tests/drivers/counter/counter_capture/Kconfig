mainmenu "Counter capture test configuration"

source "Kconfig.zephyr"

config NUM_OF_CONTINUOUS_CAPTURES
	int "Number of continuous capture iterations"
	default 5
	range 1 255
	help
	  Number of capture iterations run by each continuous capture test case.

# The trigger source the board provides, from its devicetree
ZEPHYR_USER := zephyr,user

config COUNTER_CAPTURE_TRIGGER_PWM
	bool
	default $(dt_node_has_prop,/$(ZEPHYR_USER),pwms)
	select PWM
	help
	  A PWM output of the zephyr,user node drives the capture input.

config COUNTER_CAPTURE_TRIGGER_GPIO
	bool
	default $(dt_node_has_prop,/$(ZEPHYR_USER),capture-tester-gpios)
	select GPIO
	help
	  A GPIO of the zephyr,user node drives the capture input.

config COUNTER_CAPTURE_MCUX_QTMR_XBAR_LOOPBACK
	bool
	default y if SOC_MIMXRT1064 && !COUNTER_CAPTURE_TRIGGER_PWM && \
		!COUNTER_CAPTURE_TRIGGER_GPIO
	help
	  The RT1064-specific trigger-source backend of the test. It configures
	  XBARA1 and IOMUXC_GPR so QTMR3 timer 0 output drives QTMR1 timer 0
	  input internally, avoiding an external loopback wire while exercising
	  the MCUX QTMR capture path.
