&timer0 {
	status = "okay";

	gptimer_counter: counter {
		status = "okay";
	};
};

&rtc_timer {
	wakeup-source;
	status = "okay";
};

/ {
	aliases {
		counter-pm-gptimer = &gptimer_counter;
		counter-pm-lptimer = &rtc_timer;
	};
};
