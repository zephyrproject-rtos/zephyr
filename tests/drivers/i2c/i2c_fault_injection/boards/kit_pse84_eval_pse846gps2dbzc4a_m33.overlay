/*
 * KIT_PSE84_EVAL for the I2C fault injection suite.  The controller under test
 * is SCB0 (i2c0) on P8[0] SCL and P8[1] SDA, at J3.10 and J3.9 (kit user
 * guide 002-39007 Rev. *B, Table 2).  No wiring is needed.
 */

/ {
	aliases {
		i2c-dut = &i2c0;
	};
};
