/*
 * I2C loopback wiring for LP-MSPM0L2228:
 *
 *   i2c0 (controller): PA1  = SCL (BoosterPack #9),  PA0  = SDA (BoosterPack #10)
 *   i2c1 (target):     PA29 = SCL (BoosterPack #35), PA30 = SDA (BoosterPack #36)
 *
 * Wire BoosterPack #9  <-> #35 (SCL) and BoosterPack #10 <-> #36 (SDA).
 * Internal pull-ups are enabled on all four pins.
 */

&i2c0_scl_pa1 {
	input-enable;
	drive-open-drain;
	bias-pull-up;
};

&i2c0_sda_pa0 {
	input-enable;
	drive-open-drain;
	bias-pull-up;
};

&i2c1_scl_pa29 {
	input-enable;
	drive-open-drain;
	bias-pull-up;
};

&i2c1_sda_pa30 {
	input-enable;
	drive-open-drain;
	bias-pull-up;
};

&i2c0 {
	pinctrl-0 = <&i2c0_scl_pa1 &i2c0_sda_pa0>;
	pinctrl-names = "default";
	status = "okay";

	eeprom0: eeprom@54 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x54>;
		address-width = <8>;
		size = <256>;
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pa29 &i2c1_sda_pa30>;
	pinctrl-names = "default";
	status = "okay";

	eeprom1: eeprom@56 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x56>;
		address-width = <8>;
		size = <256>;
	};
};
