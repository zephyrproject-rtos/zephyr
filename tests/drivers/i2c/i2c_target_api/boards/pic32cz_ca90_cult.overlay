/* Connect PC0 to PC8 (SDA), and PC1 to PC9 (SCL) */

&pinctrl {
	sercom0_i2c_default: sercom0_i2c_default {
		group1 {
			pinmux = <PC0D_SERCOM0_PAD0>,
				 <PC1D_SERCOM0_PAD1>;
		};
	};

	sercom2_i2c_default: sercom2_i2c_default {
		group1 {
			pinmux = <PC8D_SERCOM2_PAD0>,
				 <PC9D_SERCOM2_PAD1>;
		};
	};
};

&gclkperiph {
	sercom0 {
		subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM0_CORE>;
		gclkperiph-src = "gclk1";
		gclkperiph-en = <1>;
	};

	sercom2 {
		subsystem = <CLOCK_MCHP_GCLKPERIPH_ID_SERCOM2_CORE>;
		gclkperiph-src = "gclk1";
		gclkperiph-en = <1>;
	};
};

&sercom0 {
	compatible = "microchip,sercom-g1-i2c";
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&sercom0_i2c_default>;
	pinctrl-names = "default";
	status = "okay";

	eeprom0: eeprom@54 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x54>;
		size = <256>;
	};
};

&sercom2 {
	compatible = "microchip,sercom-g1-i2c";

	/* sercom2 is configured for SPI, drop SPI-related properties to allow I2C use */
	/delete-property/ dipo;
	/delete-property/ dopo;
	/delete-property/ cs-gpios;
	/delete-property/ dmas;
	/delete-property/ dma-names;
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&sercom2_i2c_default>;
	pinctrl-names = "default";
	status = "okay";

	eeprom1: eeprom@58 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x58>;
		size = <256>;
	};
};
