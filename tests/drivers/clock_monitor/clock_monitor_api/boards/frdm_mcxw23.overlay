#include <zephyr/dt-bindings/clock/mcux_lpc_syscon_clock.h>
#include <zephyr/dt-bindings/clock-monitor/nxp-anactrl.h>

/ {
	test-required-clocks {
		compatible = "test-required-clocks";
		clocks = <&syscon MCUX_FRO_1M_CLK>;
	};

	clock-monitor-test {
		compatible = "test-clock-monitor";

		/*
		 * anactrl: ANACTRL freq-measure, MEASURE mode only.
		 * Default: reference = main clock (~32 MHz), target = 1 MHz FRO.
		 * switch-reference: reference -> 1 MHz FRO with the target left
		 *                   alone, so the result must stay ~1 MHz.
		 * switch-target:    target -> 32 kHz OSC32K, expected ~32768 Hz.
		 */
		anactrl_fm {
			monitor = <&anactrl>;
			measure-expected-hz = <1000000>;
			measure-tolerance-ppm = <50000>;
			switch-reference = <NXP_ANACTRL_MCXW2XX_REF_FRO_1M>;
			switch-target = <NXP_ANACTRL_MCXW2XX_TAR_OSC32K>;
			switch-target-expected-hz = <32768>;
		};
	};
};

&anactrl {
	status = "okay";
};

&inputmux {
	status = "okay";
};
