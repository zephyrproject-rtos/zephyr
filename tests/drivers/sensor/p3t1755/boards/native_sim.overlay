&i2c0 {
	status = "okay";

	p3t1755_continuous: p3t1755@48 {
		compatible = "nxp,p3t1755";
		reg = <0x48>;
	};

	p3t1755_oneshot: p3t1755@49 {
		compatible = "nxp,p3t1755";
		reg = <0x49>;
		oneshot-mode;
	};
};

/ {
	aliases {
		p3t1755 = &p3t1755_continuous;
		p3t1755-oneshot = &p3t1755_oneshot;
	};
};
