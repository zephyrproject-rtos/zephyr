#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/*
 * qemu_cortex_m3 has no I2C or SPI controller, and its GPIO controllers are
 * modelled hardware rather than the emulator these tests drive, so this
 * overlay supplies all three. It exists so the suite can run on hosts where
 * native_sim is unavailable.
 */
/ {
	bmi260_i2c_bus: i2c@10000000 {
		compatible = "zephyr,i2c-emul-controller";
		reg = <0x10000000 4>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		bmi260_i2c: bmi260@68 {
			compatible = "bosch,bmi260";
			reg = <0x68>;
			irq-gpios = <&bmi260_gpio 0 GPIO_ACTIVE_HIGH>;
		};

		/*
		 * Stands in for a part that answers with the wrong chip
		 * identifier. Initialization is deferred so a test can set the
		 * identifier before the driver reads it.
		 */
		bmi260_wrong: bmi260@69 {
			compatible = "bosch,bmi260";
			reg = <0x69>;
			zephyr,deferred-init;
		};

		/*
		 * Stands in for a part whose feature engine never reports
		 * that it started. Initialization is deferred so a test can
		 * arrange that before the driver polls for it.
		 */
		bmi260_stuck: bmi260@6a {
			compatible = "bosch,bmi260";
			reg = <0x6a>;
			zephyr,deferred-init;
		};
	};

	bmi260_spi_bus: spi@10000100 {
		compatible = "zephyr,spi-emul-controller";
		reg = <0x10000100 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		bmi260_spi: bmi260@0 {
			compatible = "bosch,bmi260";
			reg = <0>;
			spi-max-frequency = <10000000>;
			irq-gpios = <&bmi260_gpio 1 GPIO_ACTIVE_HIGH>;
		};
	};

	bmi260_gpio: gpio_emul {
		compatible = "zephyr,gpio-emul";
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
	};
};
