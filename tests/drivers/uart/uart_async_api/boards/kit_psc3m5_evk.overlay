&dma0 {
	status = "okay";
};

dut: &scb4 {
	compatible = "infineon,uart";
	status = "okay";
	current-speed = <115200>;

	clocks = <&peri0_group4_16bit_0>;

	pinctrl-0 = <&p4_3_scb4_uart_tx &p4_2_scb4_uart_rx>;
	pinctrl-names = "default";

	dmas = <&dma0 0>, <&dma0 1>;
	dma-names = "tx", "rx";
};

&p4_3_scb4_uart_tx {
	drive-push-pull;
};

&p4_2_scb4_uart_rx {
	input-enable;
};

&peri0_group4_16bit_0 {
	status = "okay";
	clock-div = <103>;
};
