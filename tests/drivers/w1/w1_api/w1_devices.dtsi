&w1_0 {
	peripheral_1: dummy-peripheral-1 {
		compatible = "vnd,w1-device";
		family-code = <0x28>;
		overdrive-speed;
		status = "okay";
	};

	peripheral_2: dummy-peripheral-2 {
		compatible = "vnd,w1-device";
		family-code = <0x29>;
		status = "okay";
	};
};
