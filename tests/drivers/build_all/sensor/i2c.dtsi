/*
 * Devices with an emulator must have a unique, non-zero address, as the
 * I2C and SPI emulators route transfers by address. Use address 0 for
 * all other devices.
 */

test_i2c_adt7420: adt7420@48 {
	compatible = "adi,adt7420";
	reg = <0x48>;
	int-gpios = <&test_gpio 0 0>;
};

test_i2c_adxl345: adxl345@0 {
	compatible = "adi,adxl345";
	reg = <0x0>;
	int1-gpios = <&test_gpio 0 0>;
	fifo-watermark = <1>;
};

