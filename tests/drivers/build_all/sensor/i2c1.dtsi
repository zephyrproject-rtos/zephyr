test_i2c_pac194x: pac194x@50 {
	compatible = "microchip,pac194x";
	reg = <0x50>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	microchip,refresh-mode = <PAC_REFRESH_AUTO_NOWAIT>;

	channel@1 {
		reg = <0x1>;
		friendly-name = "CPU";
		microchip,shunt-resistor-micro-ohms = <4000>;
		microchip,vbus-mode = <PAC_UNIPOLAR_FSR>;
		microchip,vsense-mode = <PAC_UNIPOLAR_FSR>;
		microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
	};

	channel@2 {
		reg = <0x2>;
		friendly-name = "MEM";
		microchip,shunt-resistor-micro-ohms = <4000>;
		microchip,vbus-mode = <PAC_BIPOLAR_FSR>;
		microchip,vsense-mode = <PAC_BIPOLAR_HALF_FSR>;
		microchip,accumulation-mode = <PAC_ACCUM_VPOWER>;
	};

	channel@3 {
		reg = <0x3>;
		friendly-name = "GPU";
		microchip,shunt-resistor-micro-ohms = <4000>;
		microchip,vbus-mode = <PAC_UNIPOLAR_FSR>;
		microchip,vsense-mode = <PAC_UNIPOLAR_FSR>;
		microchip,accumulation-mode = <PAC_ACCUM_VBUS>;
	};

	channel@4 {
		reg = <0x4>;
		friendly-name = "NET";
		microchip,shunt-resistor-micro-ohms = <4000>;
		microchip,vbus-mode = <PAC_UNIPOLAR_FSR>;
		microchip,vsense-mode = <PAC_UNIPOLAR_FSR>;
		microchip,accumulation-mode = <PAC_ACCUM_VBUS>;
	};
};

test_i2c_fdc1004: fdc1004@51 {
	compatible = "ti,fdc1004";
	reg = <0x51>;
	measure-rate = <100>;
	ti,capdac = <0 0 0 0>;
};

test_i2c_htu31d: htu31d@52 {
	compatible = "meas,htu31d";
	reg = <0x52>;
};

test_i2c_ms5637: ms5637@53 {
	compatible = "meas,ms5637";
	reg = <0x53>;
};

test_i2c_max30102: max30102@54 {
	compatible = "maxim,max30102";
	reg = <0x54>;
	acq-mode = "multi-led";
};

test_i2c_tmp451: tmp451@55 {
	compatible = "ti,tmp451";
	reg = <0x55>;
	alert-gpios = <&test_gpio 0 0>;
};

test_i2c_icm40627: icm40627@56 {
	compatible = "invensense,icm40627";
	reg = <0x56>;
	int-gpios = <&test_gpio 0 0>;
	accel-hz = <100>;
	gyro-hz = <100>;
	accel-fs = <16>;
	gyro-fs = <2000>;
};
