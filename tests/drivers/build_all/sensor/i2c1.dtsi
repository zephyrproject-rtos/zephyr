	compatible = "onnn,nct75";
	reg = <0x0c>;
	status = "okay";
};

test_i2c_tmp114: tmp114@d {
	compatible = "ti,tmp114";
	reg = <0x0d>;
	odr = <TMP114_DT_ODR_250_MS>;
