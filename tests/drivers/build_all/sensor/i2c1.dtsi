test_i2c_tmp1075: tmp1075@18 {
	compatible = "ti,tmp1075";
	reg = <0x18>;
	alert-gpios = <&test_gpio 0 0>;
	conversion-rate = <220000>;
	lower-threshold = <27>;
	upper-threshold = <28>;
	consecutive-fault-measurements = <4>;
	interrupt-mode;
};

test_i2c_bmp390: bmp390@19 {
	compatible = "bosch,bmp390";
