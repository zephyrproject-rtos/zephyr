/* Build all nine standalone comparators and every analog route mux encoding. */
&peri0_group0_16bit_0 {
	clock-div = <2>;
	status = "okay";
};

&csg0 {
	clocks = <&peri0_group0_16bit_0>;
	status = "okay";
};

&comp0 {
	positive-input = "ain-pa";
	negative-input = "ain-na";
	infineon,aroute-input = "ain-a";
	status = "okay";
};

&comp1 {
	positive-input = "ain-pb";
	negative-input = "ain-nb";
	infineon,aroute-input = "ain-b";
	status = "okay";
};

&comp2 {
	positive-input = "ain-pa";
	negative-input = "ain-na";
	infineon,aroute-input = "ain-c";
	status = "okay";
};

&comp3 {
	positive-input = "ain-pb";
	negative-input = "ain-nb";
	infineon,aroute-input = "ain-d";
	status = "okay";
};

&comp4 {
	positive-input = "ain-pa";
	negative-input = "ain-na";
	status = "okay";
};

&comp5 {
	positive-input = "ain-pb";
	negative-input = "ain-nb";
	infineon,aroute-input = "ain-b";
	status = "okay";
};

&comp6 {
	positive-input = "ain-pa";
	negative-input = "ain-na";
	infineon,aroute-input = "ain-c";
	status = "okay";
};

&comp7 {
	positive-input = "ain-pb";
	negative-input = "ain-nb";
	infineon,aroute-input = "ain-d";
	status = "okay";
};

&comp8 {
	positive-input = "ain-pa";
	negative-input = "ain-na";
	infineon,aroute-input = "ain-a";
	status = "okay";
};
