#include <zephyr/dt-bindings/video/video-interfaces.h>

/ {
	test {
		#address-cells = <1>;
		#size-cells = <1>;

		test_i2c: i2c@11112222 {
			compatible = "vnd,i2c";
			reg = <0x11112222 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			status = "okay";

			test_i2c_max96724: max96724@27 {
				compatible = "adi,max96724";
				reg = <0x27>;
				#address-cells = <1>;
				#size-cells = <0>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;

						t_gmsl_in: endpoint {
							remote-endpoint-label = "t_gmsl_out";
						};
					};

					port@4 {
						reg = <4>;

						endpoint {
							remote-endpoint-label = "";
							bus-type = <VIDEO_BUS_TYPE_CSI2_DPHY>;
							data-lanes = <1 2>;
							link-frequencies = <700000000>;
						};
					};
				};

				test_i2c_max96724_gate: i2c-gate@0 {
					compatible = "adi,max96724-i2c-gate";
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
				};
			};
		};
	};
};

/* The MAX96717 sits behind the deserializer gate, as on real hardware. */
&test_i2c_max96724_gate {
	test_i2c_max96717: max96717@40 {
		compatible = "adi,max96717";
		reg = <0x40>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;

				t_gmsl_out: endpoint {
					remote-endpoint-label = "t_gmsl_in";
				};
			};
		};

		test_i2c_max96717_gate: i2c-gate {
			compatible = "adi,max96717-i2c-gate";
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};
