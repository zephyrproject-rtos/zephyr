/ {
	test {
		#address-cells = <1>;
		#size-cells = <1>;

		test_gpio: gpio@deadbeef {
			compatible = "vnd,gpio";
			reg = <0xdeadbeef 0x1000>;
			gpio-controller;
			#gpio-cells = <0x2>;
			status = "okay";
		};

		test_ethernet: ethernet {
			compatible = "vnd,ethernet";

			test_mdio0: mdio {
				compatible = "zephyr,mdio-gpio";
				mdc-gpios = <&test_gpio 0 0>;
				mdio-gpios = <&test_gpio 0 0>;

				#address-cells = <1>;
				#size-cells = <0>;

				ethernet-phy@0 {
					compatible = "realtek,rtl8211f";
					reg = <0x0>;
					status = "okay";
				};

				ethernet-phy@1 {
					compatible = "nxp,tja1103";
					reg = <0x1>;
					int-gpios = <&test_gpio 0 0>;
					master-slave = "slave";
					status = "okay";
				};

				ethernet-phy@2 {
					compatible = "microchip,ksz8081";
					reg = <0x2>;
					reset-gpios = <&test_gpio 0 0>;
					int-gpios = <&test_gpio 0 0>;
					microchip,interface-type = "rmii";
					status = "okay";
				};

				ethernet-phy@5 {
					compatible = "adi,adin1100-phy";
					reg = <0x5>;
					status = "okay";
				};

				ethernet-phy@6 {
					compatible = "adi,adin2111-phy";
					reg = <0x6>;
					status = "okay";
				};

				ethernet-phy@7 {
					compatible = "davicom,dm8806-phy";
					reg = <0x7>;
					reg-switch = <8>;
					reset-gpios = <&test_gpio 0 0>;
					int-gpios = <&test_gpio 0 0>;
					davicom,interface-type = "rmii";
					status = "okay";
				};

				ethernet-phy@8 {
					compatible = "ti,dp83867";
					reg = <0x8>;
					reset-gpios = <&test_gpio 0 0>;
					int-gpios = <&test_gpio 0 0>;
					ti,interface-type = "rgmii";
					status = "okay";
				};

				ethernet-phy@9 {
					compatible = "microchip,ksz9131";
					reg = <0x9>;
					int-gpios = <&test_gpio 0 0>;
					status = "okay";
				};

				ethernet-phy@a {
					compatible = "ethernet-phy";
					reg = <0xa>;
					reset-gpios = <&test_gpio 0 0>;
					reset-assert-duration-us = <100>;
					reset-deassertion-timeout-ms = <10>;
					status = "okay";
				};
			};
		};

		test_mdio1: mdio {
			compatible = "zephyr,mdio-gpio";
			mdc-gpios = <&test_gpio 0 0>;
			mdio-gpios = <&test_gpio 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
		};
	};
};
