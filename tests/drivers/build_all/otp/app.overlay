 *
 * Application overlay for testing driver builds
 *
 * Names in this file should be chosen in a way that won't conflict
 * with real-world devicetree nodes, to allow these tests to run on
 * (and be extended to test) real hardware.
 */

/ {
	test {
		#address-cells = <1>;
		#size-cells = <1>;

		test_axi_sysid: axi-sysid@deadbeef {
			compatible = "adi,axi-sysid";
			reg = <0xdeadbeef 0x1000>;
			status = "okay";
		};

		test_gpio: gpio@11112222 {
			compatible = "vnd,gpio";
			gpio-controller;
			reg = <0x11112222 0x1000>;
			#gpio-cells = <0x2>;
			status = "okay";
		};

		test_gpio_straps: gpio-straps {
			compatible = "zephyr,gpio-straps";
			gpios = <&test_gpio 0 0>, <&test_gpio 1 0>, <&test_gpio 2 0>;
			status = "okay";
		};
	};
};
