/ {
	test {
		#address-cells = <1>;
		#size-cells = <1>;

		test_spi: spi@33334444 {
			compatible = "vnd,spi";
			reg = <0x33334444 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <2000000>;

			cs-gpios = <&test_gpio 0 0>;
			status = "okay";

			test_spi_ads114s08: ads114s08@0 {
				compatible = "ti,ads114s08";
				reg = <0x00>;
				spi-max-frequency = <10000000>;
				#address-cells = <1>;
				#size-cells = <0>;
				#io-channel-cells = <1>;
				reset-gpios = <&test_gpio 0 0>;
				drdy-gpios = <&test_gpio 0 0>;
				start-sync-gpios = <&test_gpio 0 0>;
				status = "okay";

				test_spi_ads114s08_gpio: ads1x4s0x_gpio {
					compatible = "ti,ads1x4s0x-gpio";
					gpio-controller;
					ngpios = <4>;
					#gpio-cells = <2>;
				};
			};

			test_spi_ads124s08: ads124s08@0 {
				compatible = "ti,ads124s08";
				reg = <0x00>;
				spi-max-frequency = <10000000>;
				#address-cells = <1>;
				#size-cells = <0>;
				#io-channel-cells = <1>;
				reset-gpios = <&test_gpio 0 0>;
				drdy-gpios = <&test_gpio 0 0>;
				start-sync-gpios = <&test_gpio 0 0>;
				status = "okay";

				test_spi_ads124s08_gpio: ads1x4s0x_gpio {
					compatible = "ti,ads1x4s0x-gpio";
					gpio-controller;
					ngpios = <4>;
					#gpio-cells = <2>;
				};
			};

			test_spi_ads114s06: ads114s06@0 {
				compatible = "ti,ads114s06";
				reg = <0x00>;
				spi-max-frequency = <10000000>;
				#address-cells = <1>;
				#size-cells = <0>;
				#io-channel-cells = <1>;
				reset-gpios = <&test_gpio 0 0>;
				drdy-gpios = <&test_gpio 0 0>;
				start-sync-gpios = <&test_gpio 0 0>;
				status = "okay";

				test_spi_ads114s06_gpio: ads1x4s0x_gpio {
					compatible = "ti,ads1x4s0x-gpio";
					gpio-controller;
					ngpios = <4>;
					#gpio-cells = <2>;
				};
			};

			test_spi_ads124s06: ads124s06@0 {
				compatible = "ti,ads124s06";
				reg = <0x00>;
				spi-max-frequency = <10000000>;
				#address-cells = <1>;
				#size-cells = <0>;
				#io-channel-cells = <1>;
				reset-gpios = <&test_gpio 0 0>;
				drdy-gpios = <&test_gpio 0 0>;
				start-sync-gpios = <&test_gpio 0 0>;
				status = "okay";

				test_spi_ads124s06_gpio: ads1x4s0x_gpio {
					compatible = "ti,ads1x4s0x-gpio";
					gpio-controller;
					ngpios = <4>;
					#gpio-cells = <2>;
				};
			};
		};

		test_gpio: gpio@deadbeef {
			compatible = "vnd,gpio";
			reg = <0xdeadbeef 0x1000>;
			gpio-controller;
			#gpio-cells = <0x2>;
			status = "okay";
		};
	};
};
