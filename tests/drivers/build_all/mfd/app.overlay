 *
 * Application overlay for testing driver builds
 *
 * Names in this file should be chosen in a way that won't conflict
 * with real-world devicetree nodes, to allow these tests to run on
 * (and be extended to test) real hardware.
 */

/ {
	test {
		#address-cells = <1>;
		#size-cells = <1>;

		test_spi: spi@33334444 {
			compatible = "vnd,spi";
			reg = <0x33334444 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <2000000>;

			/* one entry for every spi devices */
			cs-gpios = <&test_gpio 0 0>;
			status = "okay";

			test_spi_maxq10xx@0 {
				compatible = "adi,maxq10xx";
				reg = <0x0>;
				spi-max-frequency = <0>;
				status = "okay";

				test_spi_maxq10xx_trng: trng {
					compatible = "adi,maxq10xx-trng";
					status = "okay";
				};
			};
		};

		test_i2c: i2c@33335555 {
			compatible = "vnd,i2c";
			reg = <0x33335555 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			test_i2c_npm10xx: pmic@0 {
				compatible = "nordic,npm10xx";
				reg = <0x0>;
			};

			test_i2c_tla2528: tla2528@1 {
				compatible = "ti,tla2528";
				reg = <0x1>;
				#io-channel-cells = <1>;
			};

			sc18is606: sc18is606@28 {
				compatible = "nxp,sc18is606";
				reg = <0x28>;
				status = "okay";

				spi_ext: sc18is606_spi {
					compatible = "nxp,sc18is606-spi";
					#address-cells = <1>;
					#size-cells = <0>;
					frequency = <1875>;
					status = "okay";
				};

				gpio_ext: sc18is606_gpio {
					compatible = "nxp,sc18is606-gpio";
					gpio-controller;
					#gpio-cells = <2>;
					ngpios = <3>;
					status = "okay";
				};
			};

			test_rv3028: rv3028@52 {
				compatible = "microcrystal,rv3028";
				reg = <0x52>;
				int-gpios = <&test_gpio 0 0>;
				backup-switch-mode = "disabled";
				status = "okay";
			};

			test_i2c_m5pm1: pmic@6e {
				compatible = "m5stack,m5pm1";
				reg = <0x6e>;
			};
		};

		test_uart: uart@55556666 {
			compatible = "vnd,serial";
			reg = <0x55556666 0x1000>;
			status = "okay";

			test_sc18im704: sc18im704 {
				compatible = "nxp,sc18im704";
				status = "okay";

				test_i2c_ext: sc18im704_i2c {
					compatible = "nxp,sc18im704-i2c";
					#address-cells = <1>;
					#size-cells = <0>;
					status = "okay";
				};

				test_gpio_ext: sc18im704_gpio {
					compatible = "nxp,sc18im704-gpio";
					gpio-controller;
					#gpio-cells = <2>;
					ngpios = <8>;
					status = "okay";
				};
			};
		};

		test_gpio: gpio@deadbeef {
			compatible = "vnd,gpio";
			reg = <0xdeadbeef 0x1000>;
			gpio-controller;
			#gpio-cells = <0x2>;
			status = "okay";
		};
	};
};
