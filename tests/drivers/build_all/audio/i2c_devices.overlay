/ {
	test {
		#address-cells = <1>;
		#size-cells = <1>;

		test_gpio: gpio@deadbeef {
			compatible = "vnd,gpio";
			gpio-controller;
			reg = <0xdeadbeef 0x1000>;
			#gpio-cells = <0x2>;
			status = "okay";
		};

		test_i2c: i2c@11112222 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "vnd,i2c";
			reg = <0x11112222 0x1000>;
			status = "okay";
			clock-frequency = <100000>;

			test_i2c_tas6422dac: tas6422dac@0 {
				compatible = "ti,tas6422dac";
				status = "okay";
				reg = <0x0>;
			};

			test_i2c_tlv320dac: tlv320dac@1 {
				compatible = "ti,tlv320dac";
				status = "okay";
				reg = <0x1>;
				reset-gpios = <&test_gpio 0 0>;
			};

			test_i2c_pcm1681: pcm1681@2 {
				compatible = "ti,pcm1681";
				status = "okay";
				reg = <0x2>;
			};

			test_i2c_max98091: max98091@3 {
				compatible = "maxim,max98091";
				status = "okay";
				reg = <0x3>;
				mclk-frequency = <13000000>;
			};

			test_i2c_tas2563: tas2563@4 {
				compatible = "ti,tas2563";
				reg = <0x4>;
				status = "okay";
			};

			test_i2c_aw88298: aw88298@5 {
				compatible = "awinic,aw88298";
				status = "okay";
				reg = <0x5>;
			};

			test_i2c_cs43l22: cs43l22@6 {
				compatible = "cirrus,cs43l22";
				status = "okay";
				reg = <0x6>;
				reset-gpios = <&test_gpio 1 0>;
			};

			test_i2c_wm8904: wm8904@7 {
				compatible = "wolfson,wm8904";
				status = "okay";
				reg = <0x7>;
			};

			test_i2c_es8311: es8311@8 {
				compatible = "everest,es8311";
				status = "okay";
				reg = <0x8>;
			};
		};
	};
};
