/ {
	test {
		#address-cells = <1>;
		#size-cells = <1>;

		test_gpio: gpio@deadbeef {
			compatible = "vnd,gpio";
			reg = <0xdeadbeef 0x1000>;
			gpio-controller;
			#gpio-cells = <0x2>;
			status = "okay";
		};

		test_i2c: i2c@11112222 {
			compatible = "vnd,i2c";
			reg = <0x11112222 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <100000>;
			status = "okay";

			test_i2c_tas6422dac: tas6422dac@0 {
				compatible = "ti,tas6422dac";
				reg = <0x0>;
				status = "okay";
			};

			test_i2c_tlv320dac: tlv320dac@1 {
				compatible = "ti,tlv320dac";
				reg = <0x1>;
				reset-gpios = <&test_gpio 0 0>;
				status = "okay";
			};

			test_i2c_pcm1681: pcm1681@2 {
				compatible = "ti,pcm1681";
				reg = <0x2>;
				status = "okay";
			};

			test_i2c_max98091: max98091@3 {
				compatible = "maxim,max98091";
				reg = <0x3>;
				mclk-frequency = <13000000>;
				status = "okay";
			};

			test_i2c_tas2563: tas2563@4 {
				compatible = "ti,tas2563";
				reg = <0x4>;
				status = "okay";
			};
		};
	};
};
