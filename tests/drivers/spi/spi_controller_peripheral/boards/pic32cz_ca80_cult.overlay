/* Connect the SERCOM8 MOSI (PD24) to SERCOM2 MOSI (PC8) */
/* Connect the SERCOM8 MISO (PD27) to SERCOM2 MISO (PC11) */
/* Connect the SERCOM8 SCK  (PD25) to SERCOM2 SCK  (PC9)  */
/* Connect the SERCOM8 CS   (PD26) to SERCOM2 CS   (PC10) */

&portd {
	status = "okay";
};

&sercom8 {
	compatible = "microchip,sercom-g1-spi";
	dipo = <3>;
	dopo = <0>;
	interrupts = <111 2>, <112 2>, <113 2>, <114 2>, <115 2>, <116 2>, <117 2>;
	#address-cells = <1>;
	#size-cells = <0>;
	cs-gpios = <&portd 26 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&sercom8_spi_cs_gpio>;
	pinctrl-names = "default";
	status = "okay";

	dut_spi_dt: test-spi-dev@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
	};
};

dut_spis: &sercom2 {
	dipo = <0>;
	dopo = <2>;
	pinctrl-0 = <&sercom2_spi_slave>;
	pinctrl-names = "default";
	status = "okay";
};

&pinctrl {
	sercom8_spi_cs_gpio: sercom8_spi_cs_gpio {
		group1 {
			pinmux = <PD24D_SERCOM8_PAD0>, /* MOSI */
				 <PD27D_SERCOM8_PAD3>, /* MISO */
				 <PD25D_SERCOM8_PAD1>; /* SCK  */
		};
	};

	sercom2_spi_slave: sercom2_spi_slave {
		group1 {
			pinmux = <PC8D_SERCOM2_PAD0>,   /* MOSI */
				 <PC11D_SERCOM2_PAD3>,   /* MISO */
				 <PC9D_SERCOM2_PAD1>,   /* SCK */
				 <PC10D_SERCOM2_PAD2>;   /* SS */
		};
	};
};
