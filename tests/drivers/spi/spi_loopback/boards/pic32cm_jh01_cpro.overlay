&sercom5 {
	status = "disabled";
};

&sercom1 {
	compatible = "microchip,sercom-g1-spi";
	/* Internally connect MOSI to MISO for loop-back operation */
	dipo = <3>;
	dopo = <2>;
	#address-cells = <1>;
	#size-cells = <0>;
	cs-gpios = <&portc 28 GPIO_ACTIVE_LOW>;
	dmas = <&dmac 0 0x04>, <&dmac 1 0x05>;
	dma-names = "rx", "tx";
	pinctrl-0 = <&sercom1_spi_default>;
	pinctrl-names = "default";
	status = "okay";

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <16000000>;
	};
};

&pinctrl {
	sercom1_spi_default: sercom1_spi_default {
		group1 {
			pinmux = <PA18C_SERCOM1_PAD2>,
				 <PC27D_SERCOM1_PAD0>,
				 <PA19C_SERCOM1_PAD3>;
		};
	};
};
