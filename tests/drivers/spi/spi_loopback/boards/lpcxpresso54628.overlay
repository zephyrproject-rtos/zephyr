/* Requires a wire from Arduino D11 (MOSI) to D12 (MISO). */
&arduino_spi {
	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <6000000>;
	};
};
