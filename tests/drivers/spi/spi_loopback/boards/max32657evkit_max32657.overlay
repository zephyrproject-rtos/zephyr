&dma1 {
	status = "okay";
};

#define SPI_LOOPBACK_SLOW_HZ 128000
#define SPI_LOOPBACK_FAST_HZ 500000
#define SPI_LOOPBACK_REG 1

spi_loopback: &spi0 {
	dmas = <&dma1 1 MAX32_DMA_SLOT_SPI_TX>, <&dma1 2 MAX32_DMA_SLOT_SPI_RX>;
	dma-names = "tx", "rx";
};

#include "../spi-loopback.dtsi"
