/* Connect ARDUINO D11 (MOSI, PB9) to ARDUINO D12 (MISO, PB8). */
&spi1 {
	dmas = <&dmamux1 0 5 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH)>,
	       <&dmamux1 1 4 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
	dma-names = "tx", "rx";

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <8000000>;
	};
};

&dma1 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};
