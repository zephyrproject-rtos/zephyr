&sercom2 {
	status = "disabled";
};

&sercom5 {
	compatible = "microchip,sercom-g1-spi";
	/* Internally connect MOSI to MISO for loop-back operation */
	dipo = <3>;
	dopo = <2>;
	/* Assign a CS pin */
	cs-gpios = <&porta 19 GPIO_ACTIVE_LOW>;
	/* Configure DMA */
	dmas = <&dmac 0 26>, <&dmac 1 27>;
	dma-names = "rx", "tx";

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <24000000>;
	};

	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&sercom5_spi_default>;
	pinctrl-names = "default";
	status = "okay";
};

&pinctrl {
	sercom5_spi_default: sercom5_spi_default {
		group1 {
			pinmux = <PA16D_SERCOM5_PAD0>,
				 <PA15D_SERCOM5_PAD3>,
				 <PA17D_SERCOM5_PAD1>;
		};
	};
};
