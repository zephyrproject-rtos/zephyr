#include <zephyr/dt-bindings/gpio/gpio.h>

&sercom2 {
	status = "disabled";
};

&portd {
	status = "okay";
};

&sercom8 {
	compatible = "microchip,sercom-g1-spi";
	/* Internally connect MOSI to MISO for loop-back operation */
	dipo = <3>;
	dopo = <2>;
	/* Assign a CS pin */
	cs-gpios = <&portd 26 GPIO_ACTIVE_LOW>;
	/* Configure DMA */
	dmas = <&dmac 0 21>, <&dmac 1 22>;
	dma-names = "rx", "tx";

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <24000000>;
	};

	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&sercom8_spi_default>;
	pinctrl-names = "default";
	status = "okay";
};

&pinctrl {
	sercom8_spi_default: sercom8_spi_default {
		group1 {
			pinmux = <PD24D_SERCOM8_PAD0>,
				 <PD27D_SERCOM8_PAD3>,
				 <PD25D_SERCOM8_PAD1>;
		};
	};
};
