/* To test this sample, connect
 * LPSPI3 MOSI(J47-8) --> LPSPI3 MISO(J47-10)
 */

#define SPI_LOOPBACK_FAST_HZ 1000000

spi_loopback: &lpspi3 {
	status = "okay";
	pinctrl-0 = <&lpspi3_default>;
	pinctrl-names = "default";
};

#include "../spi-loopback.dtsi"
