#define SPI_LOOPBACK_SLOW_HZ 1000000
#define SPI_LOOPBACK_FAST_HZ 2500000

&pinctrl {
	sci2_spi_default: sci2_spi_default {
		group1 {
			/* MISO MOSI SCK */
			psels = <RA_PSEL(RA_PSEL_SCI_2, 10, 2)>,
				<RA_PSEL(RA_PSEL_SCI_2, 10, 3)>,
				<RA_PSEL(RA_PSEL_SCI_2, 10, 4)>;
			drive-strength = "high";
		};
	};
};

&sci2 {
	pinctrl-0 = <&sci2_spi_default>;
	pinctrl-names = "default";

	spi_loopback: spi {
		status = "okay";
	};

	uart {
		status = "disabled";
	};

	i2c {
		status = "disabled";
	};
};

#include "../spi-loopback.dtsi"
