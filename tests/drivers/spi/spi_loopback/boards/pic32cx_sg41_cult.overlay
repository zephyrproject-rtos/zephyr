&sercom0 {
	status = "disabled";
};

&sercom6 {
	compatible = "microchip,sercom-g1-spi";
	/* Internally connect MOSI to MISO for loop-back operation */
	dipo = <3>;
	dopo = <2>;
	/* Assign a CS pin */
	cs-gpios = <&portc 6 GPIO_ACTIVE_LOW>;
	/* Configure DMA */
	dmas = <&dmac 0 0x10>, <&dmac 1 0x11>;
	dma-names = "rx", "tx";

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <24000000>;
	};

	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&sercom6_spi_default>;
	pinctrl-names = "default";
	status = "okay";
};

&pinctrl {
	sercom6_spi_default: sercom6_spi_default {
		group1 {
			pinmux = <PC13D_SERCOM6_PAD0>,
				 <PC12D_SERCOM6_PAD1>,
				 <PC7C_SERCOM6_PAD3>;
		};
	};
};
