spi_loopback: &lpspi1 {
	transfer-delay = <100>;
	sck-pcs-delay = <200>;
	pcs-sck-delay = <200>;

	slow@0 {
		spi-cs-setup-delay-ns = <1000>;
		spi-cs-hold-delay-ns = <1000>;
		spi-interframe-delay-ns = <1000>;
	};

	fast@0 {
		spi-cs-setup-delay-ns = <100>;
		spi-cs-hold-delay-ns = <100>;
	};
};

#include "../spi-loopback.dtsi"
