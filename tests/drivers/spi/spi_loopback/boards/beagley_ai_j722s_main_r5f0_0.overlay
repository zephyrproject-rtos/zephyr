 *
 * Wire HAT SPI0 MOSI (pin 19) to MISO (pin 21) for an external loopback, or
 * use CONFIG_SPI_LOOPBACK_MODE_LOOP for controller internal loopback.
 */

#include <freq.h>

&mcu_spi0 {
	pinctrl-0 = <&hat_24_spi &hat_23_spi &hat_19_spi &hat_21_spi>;
	pinctrl-names = "default";
	status = "okay";

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_K(500)>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(12)>;
	};
};
