&dma1 {
	status = "okay";
};

&spi0 {
	zephyr,pm-device-runtime-auto;
	dmas = <&dma1 1 MAX32_DMA_SLOT_SPI_TX>, <&dma1 2 MAX32_DMA_SLOT_SPI_RX>;
	dma-names = "tx", "rx";

	slow@1 {
		compatible = "test-spi-loopback-slow";
		reg = <1>;
		spi-max-frequency = <128000>;
	};

	fast@1 {
		compatible = "test-spi-loopback-fast";
		reg = <1>;
		spi-max-frequency = <500000>;
	};
};

/*
 * SRAM banks marked with the following property are retained in backup mode
 *
 * SRAM banks are listed in max32657_common.dtsi
 */
&sram0 {
	adi,ram-bank-retained;
};
