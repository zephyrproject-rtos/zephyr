spi: &scb0 {
	compatible = "infineon,spi";
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	clocks = <&peri_clk_div2>;
	pinctrl-0 = <&p0_0_scb0_spi_clk &p0_1_scb0_spi_mosi &p0_2_scb0_spi_miso>;
	pinctrl-names = "default";
	cs-gpios = <&gpio_prt0 3 GPIO_ACTIVE_LOW>;

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&peri_clk_div2 {
	status = "okay";
};

&p0_0_scb0_spi_clk {
	drive-push-pull;
};

&p0_1_scb0_spi_mosi {
	drive-push-pull;
};

&p0_2_scb0_spi_miso {
	input-enable;
};
