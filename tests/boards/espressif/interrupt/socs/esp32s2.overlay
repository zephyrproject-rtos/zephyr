&timer0 {
	interrupts = <TG0_T0_LEVEL_INTR_SOURCE 1 0>;
	status = "okay";

	counter {
		status = "okay";
	};
};

&timer1 {
	interrupts = <TG0_T1_LEVEL_INTR_SOURCE 2 0>;
	status = "okay";

	counter {
		status = "okay";
	};
};

&timer2 {
	interrupts = <TG1_T0_LEVEL_INTR_SOURCE 3 0>;
	status = "okay";

	counter {
		status = "okay";
	};
};
