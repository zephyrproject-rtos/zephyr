choice
	prompt "Critical boot test registered by this suite"
	default SAFETY_TEST_TESTS_BOOT_PASS
	help
	  Which critical boot test the suite registers. safety_test_boot_passed()
	  has three answers and they need three different sets of registered
	  tests, which is a compile-time property.

config SAFETY_TEST_TESTS_BOOT_PASS
	bool "one that passes"

config SAFETY_TEST_TESTS_BOOT_FAIL
	bool "one that fails"

config SAFETY_TEST_TESTS_BOOT_NONE
	bool "none at all"

endchoice

source "Kconfig.zephyr"
