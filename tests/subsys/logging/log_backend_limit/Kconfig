config TEST_NUM_BACKENDS
	int "Number of test backends"
	default 32 if !LOG_RUNTIME_FILTERING
	default 8 if LOG_FRONTEND
	default 9
	help
	  Must equal the maximum number of backends. With runtime filtering this
	  is LOG_FILTERS_MAX_BACKENDS: 32-bit filter word of 3-bit slots, minus
	  the aggregated slot, minus the frontend slot if present. Without it,
	  the limit is the 32-bit backend activation mask.

source "Kconfig.zephyr"
