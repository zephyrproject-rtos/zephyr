mainmenu "LLEXT tests"

config MP_MAX_NUM_CPUS
	default 1 if LLEXT_READONLY_1CPU

source "Kconfig.zephyr"

config LLEXT_INC_IN_TEXT
	bool "Put extension .inc array in .text instead of .data"
	help
	  Put the llext extension .inc arrays from the LLEXT subsys tests
	  in .text instead of .data by default. This is useful for when the
	  memory region the linker places .data in by default is not suitable
	  for execution.

config LLEXT_READONLY_1CPU
	bool
	default y if !LLEXT_STORAGE_WRITABLE && \
		     (SOC_SERIES_INTEL_ADSP_ACE20 || \
		      SOC_SERIES_INTEL_ADSP_ACE30 || \
		      SOC_SERIES_INTEL_ADSP_ACE40)
	select LLEXT_CUSTOM_HEAP_PLACEMENT
	help
	  Automatically enabled on Intel ADSP ACE when the ELF storage is not
	  writable, i.e. for the readonly and readonly_mpu tests. In that case
	  the extension code is copied to the LLEXT heap and executed from
	  there. Windowed call return addresses only keep the low 30 bits, so
	  the heap must be placed in the cached region, in the same 1GB region
	  as .text. That region is not coherent across cores, so these tests
	  are restricted to a single CPU.
