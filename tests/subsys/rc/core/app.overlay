/ {
	rc_loopback0: rc-loopback-0 {
		compatible = "zephyr,rc-loopback";
		rx-timeout-us = <20000>;
		status = "okay";
	};

	rc_loopback1: rc-loopback-1 {
		compatible = "zephyr,rc-loopback";
		protocols = <0x1f2 0x1fe>;
		status = "okay";
	};

	rc_loopback2: rc-loopback-2 {
		compatible = "zephyr,rc-loopback";
		hw-rx-timeout;
		protocols = <0x1fe>;
		rx-timeout-us = <5000>;
		status = "okay";
	};

	rc_loopback3: rc-loopback-3 {
		compatible = "zephyr,rc-loopback";
		hw-rx-timeout;
		status = "okay";
	};

	rc_loopback4: rc-loopback-4 {
		compatible = "zephyr,rc-loopback";
		hw-rx-timeout;
		status = "okay";
	};

	rc_loopback5: rc-loopback-5 {
		compatible = "zephyr,rc-loopback";
		protocols = <0x1fa>;
		rx-timeout-us = <5000>;
		status = "okay";
	};

	rc_loopback6: rc-loopback-6 {
		compatible = "zephyr,rc-loopback";
		protocols = <0x1fb 0x1ff>;
		rx-timeout-us = <10000>;
		status = "okay";
	};

	rc_loopback7: rc-loopback-7 {
		compatible = "zephyr,rc-loopback";
		protocols = <0x1fa>;
		rx-timeout-us = <5000>;
		status = "okay";
	};

	rc_loopback8: rc-loopback-8 {
		compatible = "zephyr,rc-loopback";
		protocols = <0x1fa>;
		rx-timeout-us = <5000>;
		status = "okay";
	};

	rc_loopback9: rc-loopback-9 {
		compatible = "zephyr,rc-loopback";
		protocols = <0x1fe>;
		rx-timeout-us = <5000>;
		status = "okay";
	};

	rc_loopback10: rc-loopback-10 {
		compatible = "zephyr,rc-loopback";
		protocols = <0x1fe>;
		rx-timeout-us = <5000>;
		tx-echo;
		status = "okay";
	};

	rc_loopback11: rc-loopback-11 {
		compatible = "zephyr,rc-loopback";
		rx-only;
		status = "okay";
	};

	rc_loopback12: rc-loopback-12 {
		compatible = "zephyr,rc-loopback";
		protocols = <0x1fe>;
		status = "okay";
	};

	rc_loopback13: rc-loopback-13 {
		compatible = "zephyr,rc-loopback";
		protocols = <0x1fd>;
		rx-timeout-us = <5000>;
		tx-echo;
		status = "okay";
	};

	rc_loopback14: rc-loopback-14 {
		compatible = "zephyr,rc-loopback";
		protocols = <0x1fe>;
		fixed-carrier;
		status = "okay";
	};
};
