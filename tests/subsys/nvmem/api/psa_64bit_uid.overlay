/*
 * Exercise the widening of cell addresses into 64-bit PSA storage UIDs.
 * The ZMS store backing the test limits UIDs to 30 bits even with
 * CONFIG_SECURE_STORAGE_64_BIT_UID, so stay below 2^30.
 */
&test_nvmem0 {
	uid-base = <0x0 0x20000000>;
};
