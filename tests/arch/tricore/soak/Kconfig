config TRICORE_SOAK_SECONDS
	int "TriCore soak duration in seconds"
	default 20
	help
	  How long the concurrent soak workload runs before the invariants
	  (no CSA leak, no fault, no sleep stall) are checked.

source "Kconfig.zephyr"
