	depends on SOC_SERIES_ESP32P4
	select DEPRECATED
	help
	  Deprecated. Use ESP32_MAC_ADDRESSES_TWO instead.

config ESP32S2_UNIVERSAL_MAC_ADDRESSES_ONE
	bool "One [DEPRECATED]"
	depends on SOC_SERIES_ESP32S2
	select DEPRECATED
	help
	  Deprecated. Use ESP32_MAC_ADDRESSES_ONE instead.

config ESP32S2_UNIVERSAL_MAC_ADDRESSES_TWO
