config ZEPHYR_HAL_ESPRESSIF_MODULE
	bool

config ZEPHYR_HAL_ESPRESSIF_MODULE_BLOBS
	bool

config HAS_ESPRESSIF_HAL
	bool
	depends on SOC_FAMILY_ESPRESSIF_ESP32

if SOC_FAMILY_ESPRESSIF_ESP32

module = ESP_HAL
module-str = esp_hal
source "subsys/logging/Kconfig.template.log_config"

config ESP_HAL_EARLY_LOG_LEVEL
	int "Early boot log level for ESP HAL"
	default 3
	range 0 4
	help
	  Controls log output from ESP_EARLY_LOGx and ESP_DRAM_LOGx macros
	  that run before Zephyr's logging subsystem is initialized.
	  These use esp_rom_printf and are independent of CONFIG_LOG.
	  0 = Off, 1 = Error, 2 = Warning, 3 = Info, 4 = Debug

config ESP32_TIMER_TASK_STACK_SIZE
	int "Stack size of the high resolution ESP Timer"
	default 1536
	help
	  Set the stack size for the internal high resolution ESP Timer
	  used in Wi-Fi and BLE peripherals. Registered timer callbacks
	  run in this task's context, including Wi-Fi, BLE, mesh, PHY and
	  coexistence callbacks that dispatch here.

config ESP32_TIMER_TASK_PRIO
	int "Task priority of the high resolution ESP Timer"
	default 3
	help
	  Set the task priority for the internal high resolution ESP Timer
	  used in Wi-Fi and BLE peripherals.

config ESP32_MAC_BB_PD
	bool "Power down MAC and baseband of Wi-Fi and Bluetooth when PHY is disabled"
	depends on SOC_SERIES_ESP32C2 || SOC_SERIES_ESP32C3 || SOC_SERIES_ESP32C5 || \
		SOC_SERIES_ESP32C6 || SOC_SERIES_ESP32C61 || SOC_SERIES_ESP32S3
	depends on TICKLESS_KERNEL && PM
	help
	  If enabled, the MAC and baseband of Wi-Fi and Bluetooth will be powered
	  down when PHY is disabled. Enabling this setting reduces power consumption
	  by a small amount but increases RAM use by approximately 4 KB (Wi-Fi only),
	  2 KB (Bluetooth only) or 5.3 KB (Wi-Fi + Bluetooth).

config MAC_BB_PD
	bool "Power down MAC and baseband when PHY is disabled [DEPRECATED]"
	depends on SOC_SERIES_ESP32C2 || SOC_SERIES_ESP32C3 || SOC_SERIES_ESP32C5 || \
		SOC_SERIES_ESP32C6 || SOC_SERIES_ESP32C61 || SOC_SERIES_ESP32S3
	depends on TICKLESS_KERNEL && PM
	select DEPRECATED
	imply ESP32_MAC_BB_PD
	help
	  Deprecated. Use ESP32_MAC_BB_PD instead.

if (BT_ESP32 || WIFI_ESP32 || IEEE802154_ESP32)

config ESP32_PHY_MAX_TX_POWER
	int "Max Wi-Fi/BLE/IEEE802154 TX power (dBm)"
	range 10 20
	default 20
	help
	  Set maximum transmit power for the ESP32 radio. Actual transmit power for high
	  data rates may be lower than this setting.

config ESP32_SW_COEXIST_ENABLE
	bool "Software controls Wi-Fi/Bluetooth coexistence"
	default y if (BT_ESP32 && WIFI_ESP32) || \
		(WIFI_ESP32 && IEEE802154_ESP32) || \
		(IEEE802154_ESP32 && BT_ESP32)
	help
	  If enabled, Wi-Fi & Bluetooth coexistence is controlled by software rather than hardware.
	  Recommended for heavy traffic scenarios. Both coexistence configuration options are
	  automatically managed, no user intervention is required.
	  If only Bluetooth is used, it is recommended to disable this option to reduce binary file
	  size.

endif

choice ESP32_MAC_ADDRESSES
	prompt "Number of universally administered (by IEEE) MAC addresses"
	default ESP32_MAC_ADDRESSES_ONE if ESP32S2_UNIVERSAL_MAC_ADDRESSES_ONE
	default ESP32_MAC_ADDRESSES_TWO if ESP32_UNIVERSAL_MAC_ADDRESSES_TWO || \
		ESP32C2_UNIVERSAL_MAC_ADDRESSES_TWO || ESP32C3_UNIVERSAL_MAC_ADDRESSES_TWO || \
		ESP32C5_UNIVERSAL_MAC_ADDRESSES_TWO || ESP32C6_UNIVERSAL_MAC_ADDRESSES_TWO || \
		ESP32C61_UNIVERSAL_MAC_ADDRESSES_TWO || ESP32H2_UNIVERSAL_MAC_ADDRESSES_TWO || \
		ESP32P4_UNIVERSAL_MAC_ADDRESSES_TWO || ESP32S2_UNIVERSAL_MAC_ADDRESSES_TWO || \
		ESP32S3_UNIVERSAL_MAC_ADDRESSES_TWO
	default ESP32_MAC_ADDRESSES_FOUR if ESP32_UNIVERSAL_MAC_ADDRESSES_FOUR || \
		ESP32C2_UNIVERSAL_MAC_ADDRESSES_FOUR || ESP32C3_UNIVERSAL_MAC_ADDRESSES_FOUR || \
		ESP32C5_UNIVERSAL_MAC_ADDRESSES_FOUR || ESP32C6_UNIVERSAL_MAC_ADDRESSES_FOUR || \
		ESP32C61_UNIVERSAL_MAC_ADDRESSES_FOUR || ESP32S3_UNIVERSAL_MAC_ADDRESSES_FOUR
	default ESP32_MAC_ADDRESSES_TWO if SOC_SERIES_ESP32S2 || SOC_SERIES_ESP32H2 || \
		SOC_SERIES_ESP32P4
	default ESP32_MAC_ADDRESSES_FOUR
	help
	  Configure the number of universally administered (by IEEE) MAC addresses.
	  During initialization, MAC addresses for each network interface are generated or
	  derived from a single base MAC address.
	  With four, Wi-Fi station, Wi-Fi softAP, Bluetooth and Ethernet each receive a
	  universally administered MAC address, generated by adding 0, 1, 2 and 3 to the final
	  octet of the base MAC address.
	  With two, the first two interfaces of the SoC receive a universally administered MAC
	  address, generated by adding 0 and 1 to the base MAC address: Wi-Fi station and
	  Bluetooth, Wi-Fi station and Wi-Fi softAP on ESP32-S2, or Ethernet on ESP32-P4.
	  With one, only the Wi-Fi station receives a universally administered MAC address.
	  The remaining interfaces receive local MAC addresses derived from the universal ones.
	  When using the default (Espressif-assigned) base MAC address, any setting can be used.
	  When using a custom universal MAC address range, the correct setting depends on the
	  allocation of MAC addresses in this range.

config ESP32_MAC_ADDRESSES_ONE
	bool "One"
	depends on SOC_SERIES_ESP32S2

config ESP32_MAC_ADDRESSES_TWO
	bool "Two"

config ESP32_MAC_ADDRESSES_FOUR
	bool "Four"
	depends on !(SOC_SERIES_ESP32S2 || SOC_SERIES_ESP32H2 || SOC_SERIES_ESP32P4)

endchoice # ESP32_MAC_ADDRESSES

config ESP32_MAC_ADDR_UNIVERSE_WIFI_AP
	def_bool ESP32_MAC_ADDRESSES_FOUR || (ESP32_MAC_ADDRESSES_TWO && SOC_SERIES_ESP32S2)

config ESP32_MAC_ADDR_UNIVERSE_BT
	def_bool !(SOC_SERIES_ESP32S2 || SOC_SERIES_ESP32P4)

config ESP32_MAC_ADDR_UNIVERSE_ETH
	def_bool ESP32_MAC_ADDRESSES_FOUR || SOC_SERIES_ESP32P4

config ESP32_UNIVERSAL_MAC_ADDRESSES_TWO
	bool "Two [DEPRECATED]"
	depends on SOC_SERIES_ESP32
	select DEPRECATED
	help
	  Deprecated. Use ESP32_MAC_ADDRESSES_TWO instead.

config ESP32_UNIVERSAL_MAC_ADDRESSES_FOUR
	bool "Four [DEPRECATED]"
	depends on SOC_SERIES_ESP32
	select DEPRECATED
	help
	  Deprecated. Use ESP32_MAC_ADDRESSES_FOUR instead.

config ESP32C2_UNIVERSAL_MAC_ADDRESSES_TWO
	bool "Two [DEPRECATED]"
	depends on SOC_SERIES_ESP32C2
	select DEPRECATED
	help
	  Deprecated. Use ESP32_MAC_ADDRESSES_TWO instead.

config ESP32C2_UNIVERSAL_MAC_ADDRESSES_FOUR
	bool "Four [DEPRECATED]"
	depends on SOC_SERIES_ESP32C2
	select DEPRECATED
	help
	  Deprecated. Use ESP32_MAC_ADDRESSES_FOUR instead.

