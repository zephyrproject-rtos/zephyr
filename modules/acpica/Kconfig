config ZEPHYR_ACPICA_MODULE
	bool

config ZEPHYR_ACPICA_MODULE_ACTIVE
	bool
	depends on ZEPHYR_ACPICA_MODULE

menu "ACPI driver support"

config ACPI
	bool
	select ZEPHYR_ACPICA_MODULE_ACTIVE

if ACPI

config ACPI_DSDT_SUPPORT
	bool  "Build source code for DSDT ACPICA support"
	default y if PCIE
	help
	  Build source code for DSDT support

endif #ACPI

endmenu
