config MBEDTLS_PSA_CRYPTO_CLIENT
	def_bool y

config TF_PSA_CRYPTO_CONFIG_FILE
	string "TF-PSA-Crypto configuration file"
	default "config-tf-psa-crypto.h"
	help
	  Specify the configuration header file to be used when building
	  TF-PSA-Crypto. The default one can be tweaked with Kconfig.

if TF_PSA_CRYPTO_CONFIG_FILE = "config-tf-psa-crypto.h"

config TF_PSA_CRYPTO_DRIVER_CONFIG_FILE
	string
	help
	  Optional driver configuration header to be included at the end of
	  TF_PSA_CRYPTO_CONFIG_FILE. This file is intended to be used to supply
	  configuration options needed by the driver dispatch interface.

config TF_PSA_CRYPTO_DRIVER_CONFIG
	def_bool TF_PSA_CRYPTO_DRIVER_CONFIG_FILE != ""

endif # TF_PSA_CRYPTO_CONFIG_FILE = "config-tf-psa-crypto.h"

config TF_PSA_CRYPTO_USER_CONFIG_FILE
	string "User configuration file for TF-PSA-Crypto"
	help
	  If defined, this is a header which will be included after TF_PSA_CRYPTO_CONFIG_FILE.
	  This allows you to modify the default configuration,
	  including the ability to undefine options that are enabled.

config TF_PSA_CRYPTO_USER_CONFIG
	def_bool TF_PSA_CRYPTO_USER_CONFIG_FILE != ""

config TF_PSA_CRYPTO_DISPATCH_DIR
	string
	default "${ZEPHYR_TF_PSA_CRYPTO_MODULE_DIR}/dispatch"
