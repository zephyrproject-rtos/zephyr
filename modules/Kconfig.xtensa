config ZEPHYR_XTENSA_MODULE
	bool

config ZEPHYR_XTENSA_MODULE_ACTIVE
	bool
	depends on ZEPHYR_XTENSA_MODULE

config XTENSA_HAL
	bool
	select ZEPHYR_XTENSA_MODULE_ACTIVE
	help
	  Build the Xtensa HAL module during build process.
	  This is selected by the Xtensa ARCH kconfig automatically.
