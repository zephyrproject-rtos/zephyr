config ZEPHYR_HAL_TELINK_MODULE
	bool

config ZEPHYR_HAL_TELINK_MODULE_ACTIVE
	bool
	depends on ZEPHYR_HAL_TELINK_MODULE

config HAS_TELINK_DRIVERS
	bool "Telink Drivers"
	select ZEPHYR_HAL_TELINK_MODULE_ACTIVE
	help
	  This option enables Telink Drivers APIs.
